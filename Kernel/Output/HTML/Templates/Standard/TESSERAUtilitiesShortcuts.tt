<section id="oooTile[% Data.TileID | html %]" class="oooTile TesseraUtilitiesTile" aria-label="Utilities">
<h2>Utilities</h2><div class="TesseraUtilitiesShortcuts">
[% FOREACH Tool IN Data.Tools %]<a href="[% Env('Baselink') | html %]Action=CustomerUtilities;Subaction=Launch;ID=[% Tool.ID | uri %]"[% IF Tool.External %] target="_blank" rel="noopener noreferrer"[% END %]>[% IF Tool.HasIcon %]<img src="[% Env('Baselink') | html %]Action=CustomerUtilities;Subaction=Icon;ID=[% Tool.ID | uri %]" alt="" width="40" height="40"/>[% ELSIF Tool.LegacyIcon %]<img src="[% Tool.LegacyIcon | html %]" width="40" height="40" alt=""/>[% END %]<span>[% Tool.Name | html %][% IF Tool.External %] &#8599;<span class="Hidden"> (opens in a new tab)</span>[% END %]</span></a>[% END %]
</div><p><a href="[% Env('Baselink') | html %]Action=CustomerUtilities">View all utilities &rarr;</a></p>[% IF Data.Unavailable %]<p role="status">Tool shortcuts are temporarily unavailable.</p>[% END %]</section>
