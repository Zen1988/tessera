# --
# Kernel/Output/HTML/Templates/Standard/CustomerTicketZTSMDiagnosis.tt
# --

[% IF Data.Inline %]
<div class="ZTSMDiagnosisPage ZTSMDiagnosisInline">
[% ELSE %]
<div id="oooContent" class="TicketZoom ZTSMDiagnosisPage ARIARoleMain">
[% END %]
    <style>
        .ZTSMDiagnosisPage .ZTSMDiagnosisLayout {
            --ZTSMNavigationOffset: 56px;
            width: 100%;
            max-width: 980px;
            min-height: 100vh;
            padding: 18px 18px 32px calc(var(--ZTSMNavigationOffset) + 28px);
            background: #f4f6fb;
            box-sizing: border-box;
        }
        .ZTSMDiagnosisInline .ZTSMDiagnosisLayout {
            max-width: none;
            min-height: 0;
            padding: 0;
            background: transparent;
        }
        .ZTSMDiagnosisShell {
            width: 100%;
        }
        .ZTSMDiagnosisShell h1 {
            margin: 0 0 12px;
            color: #07104a;
            font-size: 16px;
            line-height: 1.3;
        }
        .ZTSMDiagnosisFields {
            display: grid;
            gap: 12px;
        }
        .ZTSMDiagnosisField {
            display: grid;
            gap: 4px;
            padding: 10px;
            border: 2px solid #111;
            background: #fff;
            box-sizing: border-box;
        }
        .ZTSMDiagnosisFieldLarge {
            min-height: 120px;
        }
        .ZTSMDiagnosisField_ZIN-Plan {
            min-height: 180px;
        }
        .ZTSMDiagnosisField label {
            margin: 0;
            color: #555b82;
            font-size: 12px;
            font-weight: 700;
            line-height: 1.2;
        }
        .ZTSMDiagnosisField .Field,
        .ZTSMDiagnosisField .Value,
        .ZTSMDiagnosisField input,
        .ZTSMDiagnosisField select,
        .ZTSMDiagnosisField textarea,
        .ZTSMDiagnosisField .InputField_Container {
            width: 100%;
            min-width: 0;
            box-sizing: border-box;
        }
        .ZTSMDiagnosisField input,
        .ZTSMDiagnosisField select {
            min-height: 34px;
            padding: 6px 10px;
        }
        .ZTSMDiagnosisField textarea {
            min-height: 96px;
            resize: vertical;
        }
        .ZTSMDiagnosisField_ZIN-Plan textarea {
            min-height: 156px;
        }
        .ZTSMDiagnosisActions {
            margin-top: 12px;
            text-align: right;
        }
        @media (max-width: 760px) {
            .ZTSMDiagnosisPage .ZTSMDiagnosisLayout {
                padding-left: 18px;
            }
        }
    </style>

    [% IF Data.Inline %]
    <div class="ZTSMDiagnosisLayout">
    [% ELSE %]
    <div id="oooMainBox" class="ZTSMDiagnosisLayout">
    [% END %]
        <div class="ZTSMDiagnosisShell">
            <h1>[% Translate("Diagnosis") | html %] [% Data.TicketNumber | html %]</h1>
            <form action="[% Env("CGIHandle") | html %]" method="post" enctype="multipart/form-data" class="Validate PreventMultipleSubmits">
                <input type="hidden" name="Action" value="CustomerTicketZTSMAction"/>
                <input type="hidden" name="TicketID" value="[% Data.TicketID | html %]"/>
                <input type="hidden" name="RuntimeAction" value="Diagnose"/>
                <input type="hidden" name="Subaction" value="SubmitDiagnosis"/>

                [% Data.FieldsHTML %]

                <div class="ZTSMDiagnosisActions">
                    [% IF Data.Inline %]
                    <button type="button" class="CloseButton oooXS">[% Translate("Discard") | html %]</button>
                    [% ELSE %]
                    <a class="Button" href="[% Env("CGIHandle") | html %]?Action=CustomerTicketZoom;TicketID=[% Data.TicketID | uri %]">[% Translate("Cancel") | html %]</a>
                    [% END %]
                    <button type="submit" class="Primary">[% Translate("Submit Diagnosis") | html %]</button>
                </div>
            </form>
        </div>
    </div>

    <script>
    (function () {
        var root = document.currentScript ? document.currentScript.closest('.ZTSMDiagnosisPage') : null;
        root = root || document.querySelector('.ZTSMDiagnosisPage');

        function syncNavigationOffset() {
            var mainBox = root ? root.querySelector('.ZTSMDiagnosisLayout') : null;
            var navigation = document.getElementById('oooNavigation');
            if (!mainBox || !navigation) {
                return;
            }
            mainBox.style.setProperty('--ZTSMNavigationOffset', navigation.getBoundingClientRect().width + 'px');
        }

        function initRichText() {
            if (!window.jQuery || !window.Core || !Core.UI || !Core.UI.RichTextEditor || typeof Core.UI.RichTextEditor.InitEditor !== 'function') {
                return;
            }
            window.jQuery(root || document).find('textarea.DynamicFieldRichText').each(function () {
                var field = window.jQuery(this);
                if (field.data('ZTSMDiagnosisRichTextReady')) {
                    return;
                }
                Core.UI.RichTextEditor.InitEditor(field);
                field.data('ZTSMDiagnosisRichTextReady', true);
            });
        }

        syncNavigationOffset();
        initRichText();
        window.addEventListener('resize', syncNavigationOffset);
    }());
    </script>
</div>
