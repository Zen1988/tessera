    min-inline-size: 0 !important;
    overflow: visible !important;
    padding-bottom: 10px;
    box-sizing: border-box;
}

#NewCustomerTicket .ZTSMFieldSetScrollViewport {
    width: 100%;
    inline-size: 100%;
    max-width: 1120px;
    max-inline-size: 1120px;
    min-width: 0;
    min-inline-size: 0;
    overflow-x: auto;
    overflow-y: hidden;
    box-sizing: border-box;
    padding-bottom: 10px;
    scrollbar-gutter: stable;
}

#NewCustomerTicket .ZTSMFieldSetScrollViewport > .DynamicFieldSet {
    width: 100% !important;
