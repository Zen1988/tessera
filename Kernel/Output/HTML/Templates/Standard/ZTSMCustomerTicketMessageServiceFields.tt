<style>
/* ZTSM service extension layout v20260605-add-row-renumber */
#NewCustomerTicket #ZTSMServiceExtensionDynamicFieldsStart ~ .Row_DynamicField {
    width: 100%;
}

#NewCustomerTicket .ZTSMServiceExtensionField.MultiValue,
#NewCustomerTicket .ZTSMServiceExtensionField .DFSetOuterField {
    width: 100% !important;
    max-width: 1060px !important;
    min-width: 0 !important;
    overflow: visible !important;
    box-sizing: border-box;
    margin-left: auto;
    margin-right: auto;
}

#NewCustomerTicket .ZTSMServiceExtensionField.MultiValue > .FieldCell {
    width: 100% !important;
    max-width: 1060px !important;
    min-width: 0 !important;
    overflow-x: auto !important;
    overflow-y: visible !important;
    box-sizing: border-box;
    scrollbar-gutter: stable;
}

#NewCustomerTicket .ZTSMServiceExtensionField .DFSetOuterField > .DynamicFieldSet {
    width: 100% !important;
    inline-size: 100% !important;
    max-width: 1060px !important;
    max-inline-size: 1060px !important;
    min-width: 0 !important;
    min-inline-size: 0 !important;
    overflow: visible !important;
    padding-bottom: 10px;
    box-sizing: border-box;
}

#NewCustomerTicket .ZTSMFieldSetScrollViewport {
    width: 100%;
    inline-size: 100%;
    max-width: 1060px;
    max-inline-size: 1060px;
    min-width: 0;
    min-inline-size: 0;
    overflow-x: auto;
    overflow-y: hidden;
    box-sizing: border-box;
    padding-bottom: 10px;
    scrollbar-gutter: stable;
}

#NewCustomerTicket .ZTSMFieldSetScrollViewport > .DynamicFieldSet {
    width: 100% !important;
    inline-size: 100% !important;
    max-width: 1060px !important;
    max-inline-size: 1060px !important;
    min-width: 0 !important;
    min-inline-size: 0 !important;
    overflow: visible !important;
}

#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldSetLayoutHorizontal > .Row_DynamicField,
#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldSetLayoutHorizontal > .Row_DynamicField.MultiColumn {
    display: flex !important;
    flex-wrap: nowrap;
    align-items: stretch;
    gap: 18px;
    width: 100% !important;
    inline-size: 100% !important;
    min-width: 0 !important;
    min-inline-size: 0 !important;
    max-width: 100% !important;
    max-inline-size: 100% !important;
    overflow-x: auto !important;
    overflow-y: hidden !important;
    grid-template-columns: none !important;
    scrollbar-gutter: stable;
}

#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldSetLayoutHorizontal > .Row_DynamicField > .FieldCell,
#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldSetLayoutHorizontal > .Row_DynamicField.MultiColumn > .FieldCell {
    flex: 0 0 260px !important;
    width: 260px !important;
    min-width: 260px !important;
    max-width: 320px !important;
}

#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldSetLayoutHorizontal > .Row_DynamicField > .FieldCell.DynamicFieldDate,
#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldSetLayoutHorizontal > .Row_DynamicField > .FieldCell.DynamicFieldDateTime,
#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldSetLayoutHorizontal > .Row_DynamicField.MultiColumn > .FieldCell.DynamicFieldDate,
#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldSetLayoutHorizontal > .Row_DynamicField.MultiColumn > .FieldCell.DynamicFieldDateTime {
    flex-basis: 300px !important;
    width: 300px !important;
    min-width: 300px !important;
}

#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldSetLayoutHorizontal > .Row_DynamicField > .FieldCell > .Field,
#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldSetLayoutHorizontal > .Row_DynamicField > .FieldCell .InputField_Container,
#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldSetLayoutHorizontal > .Row_DynamicField > .FieldCell input:not([type="hidden"]),
#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldSetLayoutHorizontal > .Row_DynamicField > .FieldCell select,
#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldSetLayoutHorizontal > .Row_DynamicField > .FieldCell textarea {
    width: 100% !important;
    min-width: 0;
    box-sizing: border-box;
}

#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldSetLayoutVertical > .Row_DynamicField {
    display: grid;
    grid-template-columns: 1fr !important;
    gap: 14px;
}

#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldDate .oooDateContainer,
#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldDateTime .oooDateContainer {
    width: 100%;
    min-height: 72px;
    height: auto;
    position: relative;
    padding: 20px 46px 10px 14px;
    border: 1px solid #7d82ad;
    border-radius: 8px;
    box-sizing: border-box;
    color: #7f809d;
    white-space: normal;
}

#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldDate .oooDate,
#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldDateTime .oooDate {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 30px;
    width: 100%;
    box-sizing: border-box;
}

#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldDate .oooDateContainer > label,
#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldDateTime .oooDateContainer > label,
#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldDate .oooDateContainer > input[type="checkbox"]:checked ~ label,
#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldDateTime .oooDateContainer > input[type="checkbox"]:checked ~ label {
    position: absolute;
    top: -9px;
    left: 14px;
    width: auto;
    height: auto;
    padding: 0 6px;
    margin: 0;
    display: inline-block;
    background: #fff;
    color: #7f809d;
    font-size: 13px;
    line-height: 18px;
}

#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldDate .DatepickerIcon,
#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldDateTime .DatepickerIcon {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    padding-left: 0;
}

#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldDate .oooAltCheck,
#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldDateTime .oooAltCheck {
    display: none;
}

.ZTSMServicePayloadTools button {
    min-height: 0;
}

.ZTSMServicePayloadTools {
    position: fixed;
    right: 18px;
    top: 45%;
    transform: translateY(-50%);
    z-index: 9998;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 6px;
    border: 1px solid rgba(125, 130, 173, 0.28);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.78);
    box-shadow: 0 12px 30px rgba(10, 16, 48, 0.18);
    backdrop-filter: blur(10px);
}

.ZTSMServicePayloadToolbar {
    display: flex;
    flex-direction: column;
    gap: 4px;
    align-items: center;
}

.ZTSMServicePayloadIconButton {
    width: 38px;
    min-width: 38px;
    height: 38px;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: #151a45;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    line-height: 1;
    box-shadow: none !important;
    transition: background-color 0.16s ease, color 0.16s ease, transform 0.16s ease;
}

.ZTSMServicePayloadIconButton:hover,
.ZTSMServicePayloadIconButton:focus {
    background: rgba(8, 24, 255, 0.08);
    color: #0818ff;
    transform: translateX(-2px);
    outline: none;
}

.ZTSMServicePayloadIconButton[aria-pressed="true"] {
    background: rgba(8, 24, 255, 0.12);
    color: #0818ff;
}

.ZTSMServicePayloadDrawer {
    position: fixed;
    top: 72px;
    right: 72px;
    bottom: 24px;
    z-index: 9997;
    width: min(760px, calc(100vw - 104px));
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgba(125, 130, 173, 0.35);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 18px 48px rgba(10, 16, 48, 0.24);
    opacity: 0;
    pointer-events: none;
    transform: translateX(24px);
    transition: opacity 0.18s ease, transform 0.18s ease;
}

.ZTSMServicePayloadDrawer.ZTSMServicePayloadDrawerOpen {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(0);
}

.ZTSMServicePayloadDrawerHeader,
.ZTSMServicePayloadDrawerFooter {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 14px;
    border-color: rgba(125, 130, 173, 0.22);
}

.ZTSMServicePayloadDrawerHeader {
    border-bottom: 1px solid rgba(125, 130, 173, 0.22);
}

.ZTSMServicePayloadDrawerTitle {
    flex: 1 1 auto;
    color: #151a45;
    font-size: 14px;
    font-weight: 600;
    line-height: 20px;
}

.ZTSMServicePayloadDrawerFooter {
    border-top: 1px solid rgba(125, 130, 173, 0.22);
    justify-content: flex-end;
}

.ZTSMServicePayloadDrawerButton {
    min-height: 0;
    padding: 7px 12px;
    border: 1px solid rgba(125, 130, 173, 0.38);
    border-radius: 7px;
    background: #fff;
    color: #151a45;
    cursor: pointer;
    font-size: 13px;
    line-height: 18px;
    box-shadow: none !important;
}

.ZTSMServicePayloadDrawerButton:hover,
.ZTSMServicePayloadDrawerButton:focus {
    border-color: #0818ff;
    color: #0818ff;
    outline: none;
}

.ZTSMServicePayloadDrawerButtonPrimary {
    border-color: #0818ff;
    background: #0818ff;
    color: #fff;
}

.ZTSMServicePayloadDrawerButtonPrimary:hover,
.ZTSMServicePayloadDrawerButtonPrimary:focus {
    background: #0512c8;
    color: #fff;
}

.ZTSMServicePayloadCode {
    flex: 1 1 auto;
    width: 100%;
    min-height: 240px;
    height: 100%;
    border: 0;
    border-radius: 0;
    box-sizing: border-box;
    font-family: Consolas, Monaco, monospace;
    font-size: 13px;
    line-height: 1.45;
    overflow: auto;
    resize: none;
    padding: 14px;
    background: #fbfbfe;
    color: #20233f;
}

.ZTSMServicePayloadStatus {
    flex: 1 1 auto;
    color: #5b6078;
    text-align: left;
    font-size: 12px;
    line-height: 18px;
}

.ZTSMServicePayloadToast {
    position: absolute;
    right: 52px;
    top: 50%;
    width: max-content;
    max-width: 220px;
    padding: 6px 9px;
    border: 1px solid rgba(125, 130, 173, 0.28);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 8px 22px rgba(10, 16, 48, 0.16);
    color: #303452;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-50%) translateX(6px);
    transition: opacity 0.16s ease, transform 0.16s ease;
}

.ZTSMServicePayloadToast.ZTSMServicePayloadToastVisible {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
}

@media (max-width: 720px) {
    .ZTSMServicePayloadTools {
        right: 10px;
    }

    .ZTSMServicePayloadDrawer {
        top: 72px;
        right: 58px;
        bottom: 16px;
        width: calc(100vw - 74px);
    }
}
</style>
<script type="text/javascript" src="[% Config("Frontend::JavaScriptPath") %]thirdparty/sheetjs-0.20.3/xlsx.full.min.js"></script>
<script>
(function () {
    "use strict";

    function ZTSMFirst(Selector) {
        return document.querySelector(Selector);
    }

    function ZTSMServiceExtensionValue() {
        var Service = ZTSMFirst('#ServiceID, input[name="ServiceID"], select[name="ServiceID"]');

        if (!Service) {
            return '';
        }

        return Service.value || '';
    }

    function ZTSMServiceExtensionRefresh() {
        var Form = ZTSMFirst('#NewCustomerTicket'),
            Start = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsStart'),
            End = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsEnd'),
            Request,
            Data;

        if (!Form || !Start || !End) {
            return;
        }

        Data = new FormData(Form);
        Data.delete('Action');
        Data.delete('Subaction');
        Data.delete('ElementChanged');
        Data.append('Action', 'CustomerTicketMessage');
        Data.append('Subaction', 'ZTSMServiceExtensionDynamicFields');

        Request = new XMLHttpRequest();
        Request.open('POST', Form.getAttribute('action') || '[% Env("CGIHandle") %]', true);
        Request.onreadystatechange = function () {
            if (Request.readyState !== 4) {
                return;
            }
            if (Request.status < 200 || Request.status >= 300) {
                return;
            }

            ZTSMServiceExtensionReplace(Start, End, Request.responseText || '');
        };
        Request.send(Data);
    }

    function ZTSMServiceExtensionReplace(Start, End, HTML) {
        var Node = Start.nextSibling,
            Next;

        while (Node && Node !== End) {
            Next = Node.nextSibling;
            Node.parentNode.removeChild(Node);
            Node = Next;
        }

        End.insertAdjacentHTML('beforebegin', HTML);
        ZTSMServiceExtensionMark(Start, End);
        ZTSMServiceExtensionLayoutFix(Start, End);
        ZTSMServiceExtensionInitialize(Start, End);
        ZTSMServicePayloadToolsEnsure(Start, End);
    }

    function ZTSMServiceExtensionMark(Start, End) {
        var Node = Start.nextSibling;

        while (Node && Node !== End) {
            if (Node.nodeType === 1 && Node.classList && Node.classList.contains('Row_DynamicField')) {
                Node.classList.add('ZTSMServiceExtensionField');
            }
            Node = Node.nextSibling;
        }
    }

    function ZTSMServiceExtensionLayoutFix(Start, End) {
        var Root = Start && End ? Start.parentNode : document,
            Sets;

        if (!Root) {
            return;
        }

        Sets = Root.querySelectorAll('.ZTSMServiceExtensionField .DynamicFieldSetLayoutHorizontal');

        Array.prototype.forEach.call(Sets, function (Set) {
            var Row = Set.querySelector(':scope > .Row_DynamicField, :scope > .Row'),
                Outer = Set.closest('.ZTSMServiceExtensionField'),
                OuterField = Set.closest('.DFSetOuterField'),
                Viewport = Set.closest('.ZTSMFieldSetScrollViewport'),
                Cells;

            Set.dataset.ZTSMLayoutVersion = '20260605-add-row-renumber';

            if (!Viewport && OuterField) {
                Viewport = document.createElement('div');
                Viewport.className = 'ZTSMFieldSetScrollViewport';
                OuterField.insertBefore(Viewport, Set);
                Viewport.appendChild(Set);
            }

            if (Outer) {
                Outer.style.setProperty('width', '100%', 'important');
                Outer.style.setProperty('max-width', '1060px', 'important');
                Outer.style.setProperty('margin-left', 'auto', 'important');
                Outer.style.setProperty('margin-right', 'auto', 'important');
                Outer.style.setProperty('overflow', 'visible', 'important');
                Outer.style.setProperty('box-sizing', 'border-box', 'important');
            }

            if (OuterField) {
                OuterField.style.setProperty('width', '100%', 'important');
                OuterField.style.setProperty('max-width', '1060px', 'important');
                OuterField.style.setProperty('min-width', '0', 'important');
                OuterField.style.setProperty('margin-left', 'auto', 'important');
                OuterField.style.setProperty('margin-right', 'auto', 'important');
                OuterField.style.setProperty('overflow', 'visible', 'important');
                OuterField.style.setProperty('box-sizing', 'border-box', 'important');
            }

            if (Viewport) {
                ZTSMServiceExtensionViewportSize(Viewport);
                Viewport.style.setProperty('min-width', '0', 'important');
                Viewport.style.setProperty('min-inline-size', '0', 'important');
                Viewport.style.setProperty('overflow-x', 'auto', 'important');
                Viewport.style.setProperty('overflow-y', 'hidden', 'important');
                Viewport.style.setProperty('box-sizing', 'border-box', 'important');
                Viewport.style.setProperty('padding-bottom', '10px', 'important');
            }

            Set.style.removeProperty('width');
            Set.style.removeProperty('max-width');
            Set.style.removeProperty('min-width');
            Set.style.removeProperty('inline-size');
            Set.style.removeProperty('max-inline-size');
            Set.style.removeProperty('min-inline-size');
            Set.style.setProperty('width', '100%', 'important');
            Set.style.setProperty('inline-size', '100%', 'important');
            Set.style.setProperty('max-width', '1060px', 'important');
            Set.style.setProperty('max-inline-size', '1060px', 'important');
            Set.style.setProperty('min-width', '0', 'important');
            Set.style.setProperty('min-inline-size', '0', 'important');
            Set.style.setProperty('overflow', 'visible', 'important');
            Set.style.setProperty('box-sizing', 'border-box', 'important');
            Set.style.setProperty('padding-bottom', '10px', 'important');

            if (!Row) {
                return;
            }

            Row.dataset.ZTSMLayoutVersion = '20260605-add-row-renumber';

            Row.style.removeProperty('width');
            Row.style.removeProperty('max-width');
            Row.style.removeProperty('min-width');
            Row.style.removeProperty('overflow-x');
            Row.style.removeProperty('overflow-y');
            Row.style.setProperty('display', 'flex', 'important');
            Row.style.setProperty('flex-wrap', 'nowrap', 'important');
            Row.style.setProperty('align-items', 'stretch', 'important');
            Row.style.setProperty('gap', '18px', 'important');
            Row.style.setProperty('width', '100%', 'important');
            Row.style.setProperty('inline-size', '100%', 'important');
            Row.style.setProperty('min-width', '0', 'important');
            Row.style.setProperty('min-inline-size', '0', 'important');
            Row.style.setProperty('max-width', '100%', 'important');
            Row.style.setProperty('max-inline-size', '100%', 'important');
            Row.style.setProperty('overflow-x', 'auto', 'important');
            Row.style.setProperty('overflow-y', 'hidden', 'important');
            Row.style.setProperty('grid-template-columns', 'none', 'important');

            Cells = Row.querySelectorAll(':scope > .FieldCell');

            Array.prototype.forEach.call(Cells, function (Cell) {
                var Width = Cell.classList.contains('DynamicFieldDate') || Cell.classList.contains('DynamicFieldDateTime') ? '300px' : '260px';

                Cell.style.setProperty('flex', '0 0 ' + Width, 'important');
                Cell.style.setProperty('width', Width, 'important');
                Cell.style.setProperty('min-width', Width, 'important');
                Cell.style.setProperty('max-width', Width === '300px' ? '340px' : '320px', 'important');
            });
        });
    }

    function ZTSMServiceExtensionViewportSize(Viewport) {
        var Form = ZTSMFirst('#NewCustomerTicket'),
            FormRect,
            Width;

        if (!Viewport) {
            return;
        }

        if (Form && Form.getBoundingClientRect) {
            FormRect = Form.getBoundingClientRect();
            Width = Math.floor(FormRect.width - 96);
        }

        if (!Width || Width < 320) {
            Width = 960;
        }

        if (Width > 1060) {
            Width = 1060;
        }

        Viewport.style.setProperty('width', Width + 'px', 'important');
        Viewport.style.setProperty('inline-size', Width + 'px', 'important');
        Viewport.style.setProperty('max-width', '1060px', 'important');
        Viewport.style.setProperty('max-inline-size', '1060px', 'important');
    }

    function ZTSMServiceExtensionIndexedAttributeSet(Node, Attribute, Index) {
        var Value;

        if (!Node || !Node.getAttribute) {
            return;
        }

        Value = Node.getAttribute(Attribute);

        if (!Value) {
            return;
        }

        Node.setAttribute(Attribute, Value.replace(/^(.+)_(?:\d+|Template)([A-Za-z]*(?:\[\])?)$/, '$1_' + Index + '$2'));
    }

    function ZTSMServiceExtensionRowIndexSet(Cell, Index) {
        if (!Cell) {
            return;
        }

        Array.prototype.forEach.call(Cell.classList, function (ClassName) {
            if (/^MultiValue_(?:\d+|Template)$/.test(ClassName)) {
                Cell.classList.remove(ClassName);
            }
        });
        Cell.classList.add('MultiValue_' + Index);

        Array.prototype.forEach.call(Cell.querySelectorAll('[id], [name], label[for]'), function (Node) {
            ZTSMServiceExtensionIndexedAttributeSet(Node, 'id', Index);
            ZTSMServiceExtensionIndexedAttributeSet(Node, 'name', Index);
            ZTSMServiceExtensionIndexedAttributeSet(Node, 'for', Index);
        });
    }

    function ZTSMServiceExtensionElementHidden(Element) {
        var Rect;

        if (!Element || !Element.getBoundingClientRect) {
            return true;
        }

        Rect = Element.getBoundingClientRect();

        return !Rect.width && !Rect.height;
    }

    function ZTSMServicePayloadValidationIgnoreSync(Root) {
        Root = Root || document;

        Array.prototype.forEach.call(Root.querySelectorAll('.ZTSMServiceExtensionField input, .ZTSMServiceExtensionField select, .ZTSMServiceExtensionField textarea'), function (Element) {
            var Row = Element.closest ? Element.closest('.FieldCell[class*="MultiValue_"], .MultiValue_Template, .DFSetOuterField') : null,
                IsTemplate = !!(
                    (Row && Row.classList.contains('MultiValue_Template'))
                    || /_(?:Template)(?:[A-Za-z]*(?:\[\])?)?$/.test(Element.id || '')
                    || /_(?:Template)(?:[A-Za-z]*(?:\[\])?)?$/.test(Element.name || '')
                    || (Element.name && Element.name.indexOf('SetIndex_') === 0 && Element.value === 'Template')
                ),
                IsBlankHidden = ZTSMServiceExtensionElementHidden(Element) && !String(Element.value || '').trim(),
                ShouldIgnore = IsTemplate || IsBlankHidden;

            if (ShouldIgnore) {
                Element.classList.add('ValidationIgnore');
                Element.dataset.ZTSMServicePayloadValidationIgnore = '1';
            }
            else if (Element.dataset.ZTSMServicePayloadValidationIgnore === '1') {
                Element.classList.remove('ValidationIgnore');
                delete Element.dataset.ZTSMServicePayloadValidationIgnore;
            }
        });
    }

    function ZTSMServiceExtensionSetRowGet(Input) {
        if (!Input || !Input.closest) {
            return;
        }

        return Input.closest('.FieldCell[class*="MultiValue_"], .MultiValue_Template') || Input.closest('.DFSetOuterField');
    }

    function ZTSMServiceExtensionNormalizeLater() {
        [0, 25, 100, 250].forEach(function (Delay) {
            window.setTimeout(function () {
                var Start = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsStart'),
                    End = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsEnd');

            if (Start && End) {
                ZTSMServiceExtensionSetIndexNormalize(Start, End);
                ZTSMServiceExtensionLayoutFix(Start, End);
                ZTSMServiceExtensionDatepickerInit(Start, End);
                ZTSMServicePayloadToolsEnsure(Start, End);
            }
        }, Delay);
        });
    }

    function ZTSMServiceExtensionSetIndexNormalize(Start, End) {
        var Root = Start && End ? Start.parentNode : document,
            FieldContainers;

        if (!Root) {
            return;
        }

        FieldContainers = Root.querySelectorAll('.ZTSMServiceExtensionField');

        Array.prototype.forEach.call(FieldContainers, function (FieldContainer) {
            var RealRows = [],
                TemplateInput,
                TemplateCell,
                SeenCells = [],
                TemplateRows = [];

            Array.prototype.forEach.call(FieldContainer.querySelectorAll('input[type="hidden"][name^="SetIndex_"]'), function (Input) {
                var Cell = ZTSMServiceExtensionSetRowGet(Input),
                    IsTemplate = Input.value === 'Template' || (Cell && Cell.classList.contains('MultiValue_Template')),
                    IsHiddenTemplate = IsTemplate && ZTSMServiceExtensionElementHidden(Cell);

                if (IsHiddenTemplate) {
                    TemplateRows.push({
                        Cell: Cell,
                        Input: Input
                    });
                    return;
                }

                if (Cell && SeenCells.indexOf(Cell) === -1) {
                    SeenCells.push(Cell);
                    RealRows.push({
                        Cell: Cell,
                        Input: Input
                    });
                }
            });

            if (TemplateRows.length) {
                TemplateRows.forEach(function (Row, Index) {
                    if (Index === TemplateRows.length - 1) {
                        TemplateInput = Row.Input;
                        TemplateCell = Row.Cell && Row.Cell.classList.contains('MultiValue_Template') ? Row.Cell : Row.Input.closest('.MultiValue_Template');
                        Row.Input.value = 'Template';
                        return;
                    }

                    if (Row.Cell && SeenCells.indexOf(Row.Cell) === -1) {
                        SeenCells.push(Row.Cell);
                        RealRows.push(Row);
                    }
                });
            }

            RealRows.forEach(function (Row, Index) {
                ZTSMServiceExtensionRowIndexSet(Row.Cell, Index);
                Row.Input.value = String(Index);

                if (Row.Input.id) {
                    Row.Input.id = Row.Input.id.replace(/_(?:\d+|Template)$/, '_' + Index);
                }
            });

            if (TemplateInput) {
                TemplateInput.value = 'Template';

                if (TemplateInput.id) {
                    TemplateInput.id = TemplateInput.id.replace(/_(?:\d+|Template)$/, '_Template');
                }
                if (TemplateCell && TemplateCell.parentNode) {
                    TemplateCell.parentNode.appendChild(TemplateCell);
                }
            }
        });

        ZTSMServicePayloadValidationIgnoreSync(Root);
    }

    function ZTSMServiceExtensionSafeInit(InitFunction) {
        try {
            InitFunction();
        }
        catch (Error) {
            if (window.console && typeof window.console.warn === 'function') {
                window.console.warn('ZTSM service extension init skipped:', Error);
            }
        }
    }

    function ZTSMServicePayloadNormalize(Value) {
        return String(Value || '')
            .replace(/^DynamicField_/, '')
            .replace(/_(?:\d+|Template)(?:[A-Za-z]*(?:\[\])?)?$/, '')
            .replace(/[^a-z0-9]+/gi, '')
            .toLowerCase();
    }

    function ZTSMServicePayloadImportValue(Value) {
        var Text = Value === null || Value === undefined ? '' : String(Value).trim(),
            ExplicitID,
            LabelPrefix;

        if (Text === '-') {
            return '';
        }

        ExplicitID = Text.match(/::\s*(\d+)\s*$/);
        Text = Text.replace(/::\s*\d+\s*$/, '').trim();

        LabelPrefix = Text.match(/^[A-Za-z][A-Za-z0-9 _-]{1,40}:\s*(.+)$/);
        if (LabelPrefix) {
            Text = LabelPrefix[1].trim();
        }

        return ExplicitID ? Text + '::' + ExplicitID[1] : Text;
    }

    function ZTSMServicePayloadImportMatch(Value) {
        return ZTSMServicePayloadNormalize(ZTSMServicePayloadImportValue(Value));
    }

    function ZTSMServicePayloadImportValues(Value) {
        var Values;

        if (Array.isArray(Value)) {
            Values = Value;
        }
        else {
            Values = String(Value === null || Value === undefined ? '' : Value)
                .split(/[\r\n,;]+/);
        }

        return Values.map(function (Item) {
            return ZTSMServicePayloadImportValue(Item);
        }).filter(function (Item) {
            return Item !== '';
        });
    }

    function ZTSMServicePayloadDebugEnabled() {
        return !!(
            window.console
            && typeof window.console.log === 'function'
            && (
                window.ZTSMServicePayloadDebug
                || !window.localStorage
                || window.localStorage.getItem('ZTSMServicePayloadDebug') !== '0'
            )
        );
    }

    function ZTSMServicePayloadConsole(Method, Message, Data) {
        if (!ZTSMServicePayloadDebugEnabled()) {
            return;
        }

        Method = Method && window.console[Method] ? Method : 'log';
        if (Data !== undefined) {
            window.console[Method](Message, Data);
        }
        else {
            window.console[Method](Message);
        }
    }

    function ZTSMServicePayloadEventFire(Element) {
        var Event,
            IsModernizedInputField;

        if (!Element) {
            return;
        }

        IsModernizedInputField = !!ZTSMServicePayloadModernizedContainer(Element);
        ZTSMServicePayloadModernizedSelectRefresh(Element);

        Event = document.createEvent('Event');
        Event.initEvent('change', true, true);
        Element.dispatchEvent(Event);

        if (!IsModernizedInputField) {
            Event = document.createEvent('Event');
            Event.initEvent('input', true, true);
            Element.dispatchEvent(Event);
        }

        if (window.jQuery) {
            window.jQuery(Element).trigger('change');
        }

        window.setTimeout(function () {
            ZTSMServicePayloadModernizedSelectRefresh(Element);
        }, 0);
    }

    function ZTSMServicePayloadReferenceClear(Element, Hidden) {
        if (Hidden) {
            Hidden.value = '';
            ZTSMServicePayloadFieldLabelFloat(Hidden, false);
            ZTSMServicePayloadEventFire(Hidden);
        }
        if (Element) {
            Element.value = '';
            Element.classList.remove('oooFull');
            ZTSMServicePayloadFieldLabelFloat(Element, false);
            ZTSMServicePayloadEventFire(Element);
        }
    }

    function ZTSMServicePayloadReferenceSet(Element, Hidden, Label, Key) {
        var Changed = Hidden && String(Hidden.value || '') !== String(Key || '');

        if (window.jQuery && Element) {
            window.jQuery(Element).val(Label || '');
        }
        else if (Element) {
            Element.value = Label || '';
        }

        if (Hidden) {
            Hidden.value = Key || '';
        }

        ZTSMServicePayloadModernizedReferenceRefresh(Element || Hidden, Label || '');

        if (
            window.Core
            && Core.Agent
            && Core.Agent.DynamicFieldReferenceSearch
            && typeof Core.Agent.DynamicFieldReferenceSearch.AddTicketReference === 'function'
            && Element
        ) {
            Core.Agent.DynamicFieldReferenceSearch.AddTicketReference(Element.id, Label || '', Key || '');
        }

        if (Hidden && Changed) {
            ZTSMServicePayloadEventFire(Hidden);
        }
        if (Element) {
            ZTSMServicePayloadEventFire(Element);
        }
    }

    function ZTSMServicePayloadRenderedSelectionValues(Element) {
        var Values = [],
            Containers = [],
            Parent,
            Next,
            FieldContainer,
            FieldCell,
            Seen = {};

        function AddValue(Value) {
            Value = String(Value || '')
                .replace(/\s+/g, ' ')
                .replace(/^\s*[xX×]\s*/, '')
                .trim();

            if (Value && Value !== '-' && !Seen[Value]) {
                Seen[Value] = 1;
                Values.push(Value);
            }
        }

        if (!Element) {
            return Values;
        }

        Parent = Element.parentNode;
        Next = Element.nextElementSibling;
        FieldCell = Element.closest ? Element.closest('.FieldCell, .Row_DynamicField') : null;
        FieldContainer = Element.closest ? Element.closest('.ZTSMServiceExtensionField') : null;

        if (Next) {
            Containers.push(Next);
        }
        if (Parent) {
            Containers.push(Parent);
        }
        if (FieldCell) {
            Containers.push(FieldCell);
        }
        if (FieldContainer) {
            Containers.push(FieldContainer);
        }

        Containers.forEach(function (Container) {
            Array.prototype.forEach.call(Container.querySelectorAll('.select2-selection__choice, .select2-search-choice'), function (Choice) {
                AddValue(Choice.getAttribute('title') || Choice.textContent || '');
            });

            Array.prototype.forEach.call(Container.querySelectorAll('.select2-selection__rendered'), function (Rendered) {
                if (!Rendered.querySelector('.select2-selection__choice, .select2-search-choice')) {
                    AddValue(Rendered.textContent || '');
                }
            });
        });

        return Values;
    }

    function ZTSMServicePayloadCollectDebug(Element, Name, Value) {
        var SelectedOptions = [],
            Select2Data = [],
            JQueryValue,
            RenderedValues,
            FieldContainer,
            FieldText;

        if (!ZTSMServicePayloadDebugEnabled() || !Element) {
            return;
        }

        if (Element.options) {
            SelectedOptions = Array.prototype.filter.call(Element.options, function (Option) {
                return Option.selected;
            }).map(function (Option) {
                return {
                    value: Option.value,
                    text: String(Option.text || '').trim()
                };
            });
        }

        if (window.jQuery) {
            try {
                JQueryValue = window.jQuery(Element).val();
            }
            catch (Error) {
                JQueryValue = 'jQuery.val() failed: ' + Error.message;
            }
            try {
                Select2Data = window.jQuery(Element).select2 && window.jQuery(Element).select2('data');
            }
            catch (Error) {
                Select2Data = 'select2(data) failed: ' + Error.message;
            }
        }

        RenderedValues = ZTSMServicePayloadRenderedSelectionValues(Element);
        FieldContainer = Element.closest ? Element.closest('.ZTSMServiceExtensionField, .Row_DynamicField, .FieldCell') : null;
        FieldText = FieldContainer ? String(FieldContainer.textContent || '').replace(/\s+/g, ' ').trim().slice(0, 500) : '';

        ZTSMServicePayloadConsole('log', '[ZTSM payload collect] ' + Name, {
            outputValue: Value,
            tagName: Element.tagName,
            type: Element.type || '',
            name: Element.name || '',
            id: Element.id || '',
            className: Element.className || '',
            multiple: !!Element.multiple,
            nativeValue: Element.value,
            selectedOptions: SelectedOptions,
            jqueryValue: JQueryValue,
            select2Data: Select2Data,
            renderedValues: RenderedValues,
            fieldText: FieldText
        });
    }

    function ZTSMServicePayloadApplyDebug(Element, Name, RequestedValue, MatchedValue) {
        var SelectedOptions = [];

        if (!ZTSMServicePayloadDebugEnabled() || !Element) {
            return;
        }

        if (Element.options) {
            SelectedOptions = Array.prototype.filter.call(Element.options, function (Option) {
                return Option.selected;
            }).map(function (Option) {
                return {
                    value: Option.value,
                    text: String(Option.text || '').trim()
                };
            });
        }

        ZTSMServicePayloadConsole('log', '[ZTSM payload apply] ' + Name, {
            requestedValue: RequestedValue,
            matchedValue: MatchedValue,
            tagName: Element.tagName,
            type: Element.type || '',
            name: Element.name || '',
            id: Element.id || '',
            className: Element.className || '',
            multiple: !!Element.multiple,
            nativeValue: Element.value,
            selectedOptions: SelectedOptions
        });
    }

    function ZTSMServicePayloadSelectSet(Element, MatchedValue) {
        var MatchedString = String(MatchedValue === null || MatchedValue === undefined ? '' : MatchedValue),
            Found = false;

        Array.prototype.forEach.call(Element.options || [], function (Option) {
            var IsMatch = String(Option.value) === MatchedString;

            Option.selected = IsMatch;
            if (IsMatch) {
                Found = true;
            }
        });

        Element.value = Found ? MatchedString : MatchedString;

        if (window.jQuery) {
            window.jQuery(Element).val(Found ? MatchedString : MatchedString);
        }

        ZTSMServicePayloadModernizedSelectRefresh(Element);
        return Found;
    }

    function ZTSMServicePayloadModernizedContainer(Element) {
        var Previous,
            Parent,
            Container;

        if (!Element) {
            return null;
        }

        Previous = Element.previousElementSibling;
        if (Previous && /\bInputField_Container\b/.test(Previous.className || '')) {
            return Previous;
        }

        Container = Element.closest ? Element.closest('.InputField_Container') : null;
        if (Container) {
            return Container;
        }

        Parent = Element.parentNode;
        if (Parent && Parent.querySelector) {
            return Parent.querySelector('.InputField_Container');
        }

        return null;
    }

    function ZTSMServicePayloadModernizedSelectContainer(Element) {
        if (!Element || Element.tagName !== 'SELECT') {
            return null;
        }

        return ZTSMServicePayloadModernizedContainer(Element);
    }

    function ZTSMServicePayloadFieldLabel(Element) {
        var ID,
            Label,
            FieldCell,
            Container;

        if (!Element) {
            return null;
        }

        ID = Element.id || '';
        if (ID) {
            Label = document.querySelector('label[for="' + ID.replace(/"/g, '\\"') + '"]');
            if (!Label && ID.indexOf('Autocomplete_') === 0) {
                Label = document.querySelector('label[for="' + ID.replace(/^Autocomplete_/, '').replace(/"/g, '\\"') + '"]');
            }
            if (Label) {
                return Label;
            }
        }

        FieldCell = Element.closest ? Element.closest('.FieldCell, .Row_DynamicField') : null;
        if (FieldCell) {
            Label = FieldCell.querySelector('label');
            if (Label) {
                return Label;
            }
        }

        Container = ZTSMServicePayloadModernizedContainer(Element);
        if (Container && Container.parentNode && Container.parentNode.querySelector) {
            return Container.parentNode.querySelector('label');
        }

        return null;
    }

    function ZTSMServicePayloadFieldLabelFloat(Element, Active) {
        var Label = ZTSMServicePayloadFieldLabel(Element);

        if (!Label) {
            return;
        }

        Label.classList.remove('ZTSMServicePayloadLabelFloated');
    }

    function ZTSMServicePayloadModernizedReferenceRefresh(Element, Label) {
        var Container = ZTSMServicePayloadModernizedContainer(Element),
            InputContainer,
            Selection,
            TextNode,
            Remove,
            RemoveLink,
            SearchInput,
            Text = String(Label || '').trim();

        if (!Container || !Text) {
            return;
        }

        Container.classList.add('oooSelected');
        if (Container.parentNode && Container.parentNode.classList) {
            Container.parentNode.classList.add('oooSelected');
        }
        if (
            Container.parentNode
            && Container.parentNode.parentNode
            && Container.parentNode.parentNode.classList
            && /\bField\b/.test(Container.parentNode.parentNode.className || '')
        ) {
            Container.parentNode.parentNode.classList.add('oooSelected');
        }
        ZTSMServicePayloadFieldLabelFloat(Element, true);

        if (Element && Element.tagName !== 'SELECT') {
            Element.classList.add('oooFull');
            if ('value' in Element) {
                Element.value = Text;
            }
            Array.prototype.forEach.call(Container.querySelectorAll('.InputField_Selection, .InputField_SelectionFilter, .InputField_More'), function (Node) {
                Node.remove();
            });
            return;
        }

        InputContainer = Container.querySelector('.InputField_InputContainer') || Container;
        Array.prototype.forEach.call(Container.querySelectorAll('.InputField_Selection, .InputField_SelectionFilter, .InputField_More'), function (Node) {
            if (Node.parentNode === Container) {
                Node.remove();
            }
        });
        Array.prototype.forEach.call(InputContainer.querySelectorAll('.InputField_Selection, .InputField_SelectionFilter, .InputField_More'), function (Node) {
            Node.remove();
        });

        Selection = document.createElement('div');
        Selection.className = 'InputField_Selection';
        if (Element && Element.value) {
            Selection.setAttribute('data-value', Element.value);
        }
        InputContainer.appendChild(Selection);
        Selection.style.display = 'block';
        Selection.style.left = '24px';

        TextNode = Selection.querySelector('.Text');
        if (!TextNode) {
            TextNode = document.createElement('div');
            TextNode.className = 'Text';
            Selection.insertBefore(TextNode, Selection.firstChild);
        }
        TextNode.textContent = Text;

        Remove = Selection.querySelector('.Remove');
        if (!Remove) {
            Remove = document.createElement('div');
            Remove.className = 'Remove';
            Selection.appendChild(Remove);
        }

        RemoveLink = Remove.querySelector('a');
        if (!RemoveLink) {
            RemoveLink = document.createElement('a');
            RemoveLink.href = '#';
            RemoveLink.tabIndex = -1;
            RemoveLink.setAttribute('role', 'button');
            RemoveLink.textContent = 'x';
            Remove.appendChild(RemoveLink);
        }
        RemoveLink.title = 'Remove selection';
        RemoveLink.setAttribute('aria-label', 'Remove selection: ' + Text);
        RemoveLink.onclick = function (Event) {
            Event.preventDefault();
            if (Element) {
                ZTSMServicePayloadSelectSet(Element, '');
                ZTSMServicePayloadEventFire(Element);
            }
        };

        SearchInput = Container.querySelector('.InputField_Search');
        if (SearchInput && SearchInput !== Element) {
            SearchInput.value = '';
        }
    }

    function ZTSMServicePayloadModernizedSelectRefresh(Element) {
        var Container = ZTSMServicePayloadModernizedSelectContainer(Element),
            SelectedOptions,
            Text,
            Selection,
            TextNode,
            RemoveLink,
            SearchInput;

        if (!Container || !Element.options) {
            return;
        }

        SelectedOptions = Array.prototype.filter.call(Element.options, function (Option) {
            return Option.selected && String(Option.value || '') !== '';
        });

        if (!SelectedOptions.length) {
            Container.classList.remove('oooSelected');
            ZTSMServicePayloadFieldLabelFloat(Element, false);
            Selection = Container.querySelector('.InputField_Selection');
            if (Selection) {
                TextNode = Selection.querySelector('.Text');
                if (TextNode) {
                    TextNode.textContent = '';
                }
                Selection.style.display = 'none';
            }
            SearchInput = Container.querySelector('.InputField_Search');
            if (SearchInput) {
                SearchInput.value = '';
            }
            if (Container.querySelector('.InputField_InputContainer')) {
                Container.querySelector('.InputField_InputContainer').style.display = '';
            }
            return;
        }

        Text = SelectedOptions.map(function (Option) {
            return String(Option.text || Option.value || '').trim();
        }).filter(function (Value) {
            return Value !== '';
        }).join(', ');

        ZTSMServicePayloadModernizedReferenceRefresh(Element, Text);
    }

    function ZTSMServicePayloadSelectReferenceOptionEnsure(Element, Key, Text) {
        var KeyString = String(Key === null || Key === undefined ? '' : Key),
            FoundOption;

        Array.prototype.forEach.call(Element.options || [], function (Option) {
            if (String(Option.value) === KeyString) {
                FoundOption = Option;
            }
        });

        if (!FoundOption && KeyString !== '') {
            FoundOption = new Option(Text || KeyString, KeyString, true, true);
            Element.add(FoundOption);
        }

        if (FoundOption && Text) {
            FoundOption.text = Text;
            FoundOption.label = Text;
            FoundOption.title = Text;
            FoundOption.setAttribute('label', Text);
            FoundOption.setAttribute('title', Text);
            FoundOption.setAttribute('data-label', Text);
            FoundOption.setAttribute('data-value', Text);
        }

        return FoundOption;
    }

    function ZTSMServicePayloadSelectReferenceResolve(Element, Value, OriginalValue) {
        return new Promise(function (Resolve) {
            var URL,
                QueryString,
                XHR,
                Field = Element && (Element.id || Element.name) || '',
                Name = ZTSMServicePayloadFieldBaseName(Element);

            if (
                !Value
                || !window.Core
                || !Core.Config
                || !Element
                || Element.tagName !== 'SELECT'
                || !/\bDynamicFieldReference\b/.test(Element.className || '')
                || !Field
            ) {
                Resolve(false);
                return;
            }

            URL = Core.Config.Get('Baselink');
            QueryString = 'Action=CustomerTicketMessage;Subaction=ZTSMServicePayloadReferenceResolve'
                + ';Field=' + encodeURIComponent(Field)
                + ';Value=' + encodeURIComponent(OriginalValue || Value);

            XHR = new XMLHttpRequest();
            XHR.open('GET', URL + QueryString, true);
            XHR.onreadystatechange = function () {
                var Result,
                    Text;

                if (XHR.readyState !== 4) {
                    return;
                }

                if (XHR.status >= 200 && XHR.status < 300) {
                    try {
                        Result = JSON.parse(XHR.responseText || '{}');
                    }
                    catch (Error) {
                        Result = {};
                    }

                    if (Result && Result.Success && Result.Key !== undefined) {
                        Text = Result.Value || OriginalValue || Value;
                        ZTSMServicePayloadSelectReferenceOptionEnsure(Element, Result.Key, Text);
                        ZTSMServicePayloadSelectSet(Element, Result.Key);
                        ZTSMServicePayloadApplyDebug(Element, Name, OriginalValue || Value, Result.Key);
                        ZTSMServicePayloadEventFire(Element);
                        Resolve(true);
                        return;
                    }
                }

                ZTSMServicePayloadConsole('warn', '[ZTSM payload apply] reference select resolve failed ' + Name, {
                    requestedValue: OriginalValue || Value,
                    field: Field,
                    status: XHR.status,
                    responseText: XHR.responseText || ''
                });
                Resolve(false);
            };
            XHR.send();
        });
    }

    function ZTSMServicePayloadAutocompleteSettle(Root) {
        if (!window.jQuery) {
            return;
        }

        try {
            window.jQuery(Root || document).find('.DynamicFieldReference.ui-autocomplete-input').each(function () {
                var Field = window.jQuery(this);

                try {
                    Field.autocomplete('close');
                }
                catch (Error) {
                    // Ignore fields without an active autocomplete instance.
                }
                Field.trigger('change');
            });
        }
        catch (Error) {
            ZTSMServicePayloadConsole('warn', '[ZTSM payload apply] autocomplete settle failed', {
                message: Error && Error.message ? Error.message : String(Error || '')
            });
        }
    }

    function ZTSMServicePayloadFormSubmitReset() {
        var Form = ZTSMFirst('#NewCustomerTicket');

        if (!Form) {
            return;
        }

        ZTSMServicePayloadValidationIgnoreSync(Form);
        Form.classList.remove('oooSubmitted');
        if (window.jQuery) {
            try {
                if (Form.classList.contains('AlreadyDisabled') && window.Core && Core.Form && typeof Core.Form.EnableForm === 'function') {
                    Core.Form.EnableForm(window.jQuery(Form));
                }
                if (window.jQuery(Form).data('validator')) {
                    window.jQuery(Form).data('validator').resetForm();
                    window.jQuery(Form).data('validator').cancelSubmit = false;
                    window.jQuery(Form).data('validator').submitted = {};
                    window.jQuery(Form).data('validator').invalid = {};
                    window.jQuery(Form).data('validator').errorList = [];
                    window.jQuery(Form).data('validator').errorMap = {};
                    window.jQuery(Form).data('validator').pendingRequest = 0;
                }
            }
            catch (Error) {
                ZTSMServicePayloadConsole('warn', '[ZTSM payload apply] submit reset failed', {
                    message: Error && Error.message ? Error.message : String(Error || '')
                });
            }
        }
    }

    function ZTSMServicePayloadNativeSubmitTraceEnsure() {
        var OriginalSubmit;

        if (!window.HTMLFormElement || HTMLFormElement.prototype.ZTSMServicePayloadSubmitTrace) {
            return;
        }

        OriginalSubmit = HTMLFormElement.prototype.submit;
        HTMLFormElement.prototype.ZTSMServicePayloadSubmitTrace = OriginalSubmit;
        HTMLFormElement.prototype.submit = function () {
            if (this && this.id === 'NewCustomerTicket') {
                ZTSMServicePayloadConsole('log', '[ZTSM native submit called]', {
                    className: this.className || '',
                    action: this.action || '',
                    method: this.method || '',
                    disabledButtons: this.querySelectorAll ? this.querySelectorAll('button:disabled, input[type="submit"]:disabled').length : 0,
                    readonlyFields: this.querySelectorAll ? this.querySelectorAll('input[readonly]:not([type="hidden"]), textarea[readonly], select[readonly]').length : 0
                });
            }
            return OriginalSubmit.apply(this, arguments);
        };
    }

    function ZTSMServicePayloadValidatorErrorDetailsLog(Prefix, Validator) {
        var Details = ZTSMServicePayloadValidatorErrorDetails(Validator);

        if (!Details.length) {
            return Details;
        }

        ZTSMServicePayloadConsole('warn', Prefix + ' details', Details);
        try {
            ZTSMServicePayloadConsole('warn', Prefix + ' details JSON', JSON.stringify(Details));
        }
        catch (Error) {
            // Ignore serialization failures; object details were already logged.
        }
        return Details;
    }

    function ZTSMServicePayloadValidatorErrorDetails(Validator) {
        if (!Validator || !Validator.errorList) {
            return [];
        }

        return Validator.errorList.map(function (Item) {
            var Element = Item && Item.element,
                FieldContainer = Element && Element.closest ? Element.closest('.FieldCell, .Row_DynamicField, .ZTSMServiceExtensionField') : null;

            return {
                name: Element ? (Element.name || '') : '',
                id: Element ? (Element.id || '') : '',
                className: Element ? (Element.className || '') : '',
                value: Element && 'value' in Element ? Element.value : '',
                hidden: Element ? (Element.offsetParent === null) : '',
                message: Item && Item.message ? Item.message : '',
                fieldText: FieldContainer ? String(FieldContainer.textContent || '').replace(/\s+/g, ' ').trim().slice(0, 300) : ''
            };
        });
    }

    function ZTSMServicePayloadValueIsEmpty(Value) {
        if (Array.isArray(Value)) {
            return !Value.filter(function (Item) {
                return !ZTSMServicePayloadValueIsEmpty(Item);
            }).length;
        }

        return Value === null || Value === undefined || String(Value).trim() === '';
    }

    function ZTSMServicePayloadValueMerge(Current, Value) {
        var Values = [];

        if (ZTSMServicePayloadValueIsEmpty(Value)) {
            return Current;
        }

        if (!ZTSMServicePayloadValueIsEmpty(Current)) {
            Values = Array.isArray(Current) ? Current.slice(0) : [ Current ];
        }

        if (Array.isArray(Value)) {
            Value.forEach(function (Item) {
                if (!ZTSMServicePayloadValueIsEmpty(Item)) {
                    Values.push(Item);
                }
            });
        }
        else {
            Values.push(Value);
        }

        if (!Values.length) {
            return Current;
        }

        return Values.length === 1 ? Values[0] : Values;
    }

    function ZTSMServicePayloadFieldBaseName(Element) {
        var Name = Element && (Element.name || Element.id) || '';

        Name = Name.replace(/^Autocomplete_/, '');
        Name = Name.replace(/^DynamicField_/, '');
        Name = Name.replace(/(?:Day|Month|Year|Hour|Minute)$/, '');
        Name = Name.replace(/_(?:\d+|Template)(?:[A-Za-z]*(?:\[\])?)?$/, '');

        return Name;
    }

    function ZTSMServicePayloadLabelText(Element) {
        var ID = Element && Element.id,
            Label;

        if (!ID) {
            return '';
        }

        Label = document.querySelector('label[for="' + ID.replace(/"/g, '\\"') + '"]');
        if (!Label && Element.closest) {
            Label = Element.closest('.FieldCell, .Row_DynamicField');
            Label = Label ? Label.querySelector('label') : null;
        }

        return Label ? Label.textContent.replace(/\*/g, '').replace(/\s+/g, ' ').trim() : '';
    }

    function ZTSMServicePayloadObjectLookup(Object, Names) {
        var Wanted = {},
            Key;

        Names.forEach(function (Name) {
            Wanted[ZTSMServicePayloadNormalize(Name)] = 1;
        });

        for (Key in Object) {
            if (!Object.hasOwnProperty(Key)) {
                continue;
            }
            if (Wanted[ZTSMServicePayloadNormalize(Key)]) {
                return Object[Key];
            }
        }

        return undefined;
    }

    function ZTSMServicePayloadInputSet(Element, Value) {
        var TextValue = Value === null || Value === undefined ? '' : String(Value),
            ImportValue = ZTSMServicePayloadImportValue(TextValue),
            ImportMatch = ZTSMServicePayloadImportMatch(TextValue),
            LowerValue = ImportValue.toLowerCase(),
            ExplicitID,
            Hidden,
            Matched,
            MultiValues,
            MultiMatches;

        if (!Element || !Element.name) {
            return Promise.resolve();
        }

        if (Element.name.indexOf('Autocomplete_DynamicField_') === 0) {
            ExplicitID = ImportValue.match(/::\s*(\d+)\s*$/);
            Hidden = document.getElementById(Element.name.replace(/^Autocomplete_/, ''));

            if (ExplicitID && Hidden) {
                ZTSMServicePayloadReferenceSet(Element, Hidden, ImportValue.replace(/::\s*\d+\s*$/, ''), ExplicitID[1]);
                return Promise.resolve();
            }

            if (!ImportValue) {
                ZTSMServicePayloadReferenceClear(Element, Hidden);
                return Promise.resolve();
            }

            Element.value = ImportValue;
            ZTSMServicePayloadEventFire(Element);
            return ZTSMServicePayloadReferenceResolve(Element, ImportValue, TextValue);
        }

        if (Element.tagName === 'SELECT') {
            if (Element.multiple) {
                MultiValues = ZTSMServicePayloadImportValues(Value);
                MultiMatches = {};

                Array.prototype.forEach.call(Element.options || [], function (Option) {
                    var OptionValue = String(Option.value || ''),
                        OptionText = String(Option.text || '').trim(),
                        OptionMatches = MultiValues.some(function (Item) {
                            return OptionValue.toLowerCase() === Item.toLowerCase()
                                || OptionText.toLowerCase() === Item.toLowerCase()
                                || ZTSMServicePayloadImportMatch(OptionText) === ZTSMServicePayloadImportMatch(Item);
                        });

                    Option.selected = OptionMatches;
                    if (OptionMatches) {
                        MultiMatches[OptionValue] = 1;
                    }
                });

                if (window.jQuery) {
                    window.jQuery(Element).val(Object.keys(MultiMatches));
                }

                ZTSMServicePayloadEventFire(Element);
                return Promise.resolve();
            }

            Array.prototype.forEach.call(Element.options || [], function (Option) {
                if (Matched) {
                    return;
                }
                if (
                    String(Option.value).toLowerCase() === LowerValue
                    || String(Option.text || '').trim().toLowerCase() === LowerValue
                    || ZTSMServicePayloadImportMatch(Option.text || '') === ImportMatch
                ) {
                    Matched = Option.value;
                }
            });

            if (Matched !== undefined) {
                ZTSMServicePayloadSelectSet(Element, Matched);
                ZTSMServicePayloadApplyDebug(Element, ZTSMServicePayloadFieldBaseName(Element), Value, Matched);
                ZTSMServicePayloadEventFire(Element);
                return Promise.resolve();
            }

            return ZTSMServicePayloadSelectReferenceResolve(Element, ImportValue, TextValue).then(function (Resolved) {
                if (!Resolved) {
                    ZTSMServicePayloadSelectSet(Element, ImportValue);
                    ZTSMServicePayloadApplyDebug(Element, ZTSMServicePayloadFieldBaseName(Element), Value, ImportValue);
                    ZTSMServicePayloadEventFire(Element);
                }
            });
        }

        if (Element.type === 'checkbox') {
            Element.checked = /^(?:1|true|yes|y|on)$/i.test(TextValue);
            ZTSMServicePayloadEventFire(Element);
            return Promise.resolve();
        }

        Element.value = ImportValue;
        ZTSMServicePayloadEventFire(Element);
        return Promise.resolve();
    }

    function ZTSMServicePayloadOutputValue(Element) {
        var Selected,
            Values,
            Select2Data;

        if (!Element) {
            return '';
        }

        if (Element.name && Element.name.indexOf('Autocomplete_DynamicField_') === 0) {
            return Element.value || '';
        }

        if (Element.tagName === 'SELECT') {
            Selected = Array.prototype.filter.call(Element.options || [], function (Option) {
                return Option.selected;
            });
            Values = Selected.map(function (Option) {
                return String(Option.text || '').trim() || Option.value || '';
            }).filter(function (Value) {
                return Value !== '' && Value !== '-';
            });

            if (Element.multiple) {
                if (!Values.length && window.jQuery) {
                    try {
                        Select2Data = window.jQuery(Element).select2 && window.jQuery(Element).select2('data');
                    }
                    catch (Error) {
                        Select2Data = [];
                    }
                    Values = Array.prototype.map.call(Select2Data || [], function (Item) {
                        return String(Item.text || Item.id || '').trim();
                    }).filter(function (Value) {
                        return Value !== '' && Value !== '-';
                    });
                }
                if (!Values.length) {
                    Values = ZTSMServicePayloadRenderedSelectionValues(Element);
                }

                return Values;
            }

            if (!Values.length) {
                Values = ZTSMServicePayloadRenderedSelectionValues(Element);
            }

            return Values[0] || '';
        }

        if (Element.type === 'checkbox') {
            return Element.checked ? '1' : '';
        }

        if (!Element.value) {
            Values = ZTSMServicePayloadRenderedSelectionValues(Element);
            if (Values.length) {
                return Values.length === 1 ? Values[0] : Values;
            }
        }

        return Element.value || '';
    }

    function ZTSMServicePayloadReferenceResolveDirect(Element, Value, OriginalValue) {
        return new Promise(function (Resolve) {
            var URL,
                QueryString,
                XHR,
                Hidden;

            if (!Value || !window.Core || !Core.Config || !Element.id || Element.id.indexOf('Autocomplete_') !== 0) {
                Resolve(false);
                return;
            }

            Hidden = document.getElementById(Element.id.replace(/^Autocomplete_/, ''));
            if (!Hidden) {
                Resolve(false);
                return;
            }

            URL = Core.Config.Get('Baselink');
            QueryString = 'Action=CustomerTicketMessage;Subaction=ZTSMServicePayloadReferenceResolve'
                + ';Field=' + encodeURIComponent(Element.id)
                + ';Value=' + encodeURIComponent(OriginalValue || Value);

            XHR = new XMLHttpRequest();
            XHR.open('GET', URL + QueryString, true);
            XHR.onreadystatechange = function () {
                var Result;

                if (XHR.readyState !== 4) {
                    return;
                }

                if (XHR.status >= 200 && XHR.status < 300) {
                    try {
                        Result = JSON.parse(XHR.responseText || '{}');
                    }
                    catch (Error) {
                        Result = {};
                    }

                    if (Result && Result.Success && Result.Key !== undefined) {
                        ZTSMServicePayloadReferenceSet(Element, Hidden, Result.Value || Value, Result.Key);
                        Resolve(true);
                        return;
                    }
                }

                Resolve(false);
            };
            XHR.send();
        });
    }

    function ZTSMServicePayloadReferenceSearch(Element, Value, OriginalValue) {
        return new Promise(function (Resolve) {
            var URL,
                QueryString,
                XHR,
                Form,
                Hidden,
                SetIndex = '',
                SetOuterFieldList,
                MultiValueClass,
                SearchTerms = [],
                SearchIndex = 0;

            if (!Value || !window.Core || !Core.Config || !Element.id || Element.id.indexOf('Autocomplete_') !== 0) {
                Resolve();
                return;
            }

            Hidden = document.getElementById(Element.id.replace(/^Autocomplete_/, ''));
            if (!Hidden) {
                Resolve();
                return;
            }

            SetOuterFieldList = window.jQuery ? window.jQuery(Element).parents('.DFSetOuterField') : [];
            if (SetOuterFieldList.length) {
                MultiValueClass = Array.prototype.filter.call(SetOuterFieldList[0].parentElement.classList, function (ClassName) {
                    return /^MultiValue_\d+$/.test(ClassName);
                })[0];
                if (MultiValueClass) {
                    SetIndex = ';SetIndex=' + MultiValueClass.replace(/^MultiValue_/, '');
                }
            }

            SearchTerms.push(Value);
            if (OriginalValue && String(OriginalValue).trim() !== Value) {
                SearchTerms.push(String(OriginalValue).trim());
            }

            Form = Element.closest('form');
            URL = Core.Config.Get('Baselink');

            function SearchNext() {
                var Term = SearchTerms[SearchIndex] || Value;

                QueryString = 'Action=AgentReferenceSearch;Term=' + encodeURIComponent(Term)
                    + ';Field=' + encodeURIComponent(Element.id)
                    + SetIndex
                    + ';MaxResults=20;';

                if (window.Core && Core.AJAX && typeof Core.AJAX.SerializeForm === 'function' && Form && window.jQuery) {
                    QueryString += Core.AJAX.SerializeForm(window.jQuery(Form), {
                        Action: 1,
                        Subaction: 1,
                        Term: 1,
                        Field: 1,
                        MaxResults: 1
                    });
                }

                XHR = new XMLHttpRequest();
                XHR.open('GET', URL + QueryString, true);
                XHR.onreadystatechange = function () {
                var Result,
                    Match;

                if (XHR.readyState !== 4) {
                    return;
                }

                if (XHR.status >= 200 && XHR.status < 300) {
                    try {
                        Result = JSON.parse(XHR.responseText || '[]');
                    }
                    catch (Error) {
                        Result = [];
                    }

                    Match = (Result || []).filter(function (Item) {
                        return String(Item.Value || '').toLowerCase() === String(Value).toLowerCase()
                            || ZTSMServicePayloadImportMatch(Item.Value || '') === ZTSMServicePayloadImportMatch(Value)
                            || ZTSMServicePayloadImportMatch(Item.Value || '') === ZTSMServicePayloadImportMatch(OriginalValue || '')
                            || String(Item.Key || '') === String(Value);
                    })[0];

                    if (Match && Match.Key) {
                        ZTSMServicePayloadReferenceSet(Element, Hidden, Match.Value, Match.Key);
                        Resolve();
                        return;
                    }
                }

                SearchIndex++;
                if (SearchIndex < SearchTerms.length) {
                    SearchNext();
                    return;
                }

                ZTSMServicePayloadReferenceClear(Element, Hidden);
                Resolve();
                };
                XHR.send();
            }

            SearchNext();
        });
    }

    function ZTSMServicePayloadReferenceResolve(Element, Value, OriginalValue) {
        return ZTSMServicePayloadReferenceResolveDirect(Element, Value, OriginalValue).then(function (Resolved) {
            if (Resolved) {
                return;
            }

            return ZTSMServicePayloadReferenceSearch(Element, Value, OriginalValue);
        });
    }

    function ZTSMServicePayloadRowsFromWorksheet(Worksheet) {
        var Rows,
            Header;

        if (!window.XLSX || !Worksheet) {
            return [];
        }

        Rows = XLSX.utils.sheet_to_json(Worksheet, {
            header: 1,
            defval: ''
        });

        if (!Rows.length) {
            return [];
        }

        Header = Rows.shift().map(function (Value) {
            return String(Value || '').trim();
        });

        return Rows.filter(function (Row) {
            return Row.some(function (Value) {
                return String(Value || '').trim() !== '';
            });
        }).map(function (Row) {
            var Object = {};

            Header.forEach(function (Name, Index) {
                if (Name) {
                    Object[Name] = Row[Index];
                }
            });

            return Object;
        });
    }

    function ZTSMServicePayloadCSVParse(Text) {
        var Rows = [],
            Row = [],
            Value = '',
            Index,
            Char,
            Next,
            Headers;

        for (Index = 0; Index < Text.length; Index++) {
            Char = Text.charAt(Index);
            Next = Text.charAt(Index + 1);

            if (Char === '"') {
                Index++;
                while (Index < Text.length) {
                    Char = Text.charAt(Index);
                    Next = Text.charAt(Index + 1);
                    if (Char === '"' && Next === '"') {
                        Value += '"';
                        Index += 2;
                        continue;
                    }
                    if (Char === '"') {
                        break;
                    }
                    Value += Char;
                    Index++;
                }
                continue;
            }

            if (Char === ',') {
                Row.push(Value);
                Value = '';
                continue;
            }

            if (Char === '\n' || Char === '\r') {
                if (Char === '\r' && Next === '\n') {
                    Index++;
                }
                Row.push(Value);
                Rows.push(Row);
                Row = [];
                Value = '';
                continue;
            }

            Value += Char;
        }

        Row.push(Value);
        Rows.push(Row);
        Headers = (Rows.shift() || []).map(function (Header) {
            return String(Header || '').trim();
        });

        return Rows.filter(function (DataRow) {
            return DataRow.some(function (Cell) {
                return String(Cell || '').trim() !== '';
            });
        }).map(function (DataRow) {
            var Object = {};

            Headers.forEach(function (Header, CellIndex) {
                if (Header) {
                    Object[Header] = DataRow[CellIndex] || '';
                }
            });

            return Object;
        });
    }

    function ZTSMServicePayloadFileRead(File) {
        return new Promise(function (Resolve, Reject) {
            var Reader = new FileReader();

            Reader.onload = function (Event) {
                var Name = File.name || '',
                    Workbook,
                    Rows;

                try {
                    if (/\.csv$/i.test(Name)) {
                        Resolve(ZTSMServicePayloadCSVParse(String(Event.target.result || '')));
                        return;
                    }

                    if (!window.XLSX) {
                        Reject(new Error('XLSX library is not loaded.'));
                        return;
                    }

                    Workbook = XLSX.read(Event.target.result, {
                        type: 'array'
                    });
                    Rows = ZTSMServicePayloadRowsFromWorksheet(Workbook.Sheets[Workbook.SheetNames[0]]);
                    Resolve(Rows);
                }
                catch (Error) {
                    Reject(Error);
                }
            };
            Reader.onerror = Reject;

            if (/\.csv$/i.test(File.name || '')) {
                Reader.readAsText(File);
            }
            else {
                Reader.readAsArrayBuffer(File);
            }
        });
    }

    function ZTSMServicePayloadSetRows(FieldContainer) {
        var Rows = [];

        Array.prototype.forEach.call(FieldContainer.querySelectorAll('input[type="hidden"][name^="SetIndex_"]'), function (Input) {
            var Cell = ZTSMServiceExtensionSetRowGet(Input);

            if (!Cell || Input.value === 'Template' || Cell.classList.contains('MultiValue_Template') || ZTSMServiceExtensionElementHidden(Cell)) {
                return;
            }

            Rows.push(Cell);
        });

        return Rows;
    }

    function ZTSMServicePayloadSetRowsEnsure(FieldContainer, Count) {
        var Rows = ZTSMServicePayloadSetRows(FieldContainer),
            AddButton,
            Guard = 0;

        while (Rows.length < Count && Guard < Count + 5) {
            Guard++;
            AddButton = FieldContainer.querySelector('.AddValueRow');
            if (!AddButton) {
                break;
            }
            AddButton.click();
            ZTSMServiceExtensionSetIndexNormalize(ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsStart'), ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsEnd'));
            Rows = ZTSMServicePayloadSetRows(FieldContainer);
        }

        return Rows;
    }

    function ZTSMServicePayloadContainerName(FieldContainer) {
        var Input = FieldContainer.querySelector('input[type="hidden"][name^="SetIndex_"]'),
            SingleInput,
            Name;

        if (Input) {
            return Input.name.replace(/^SetIndex_/, '');
        }

        SingleInput = FieldContainer.querySelector('[name^="DynamicField_"], [name^="Autocomplete_DynamicField_"]');
        Name = ZTSMServicePayloadFieldBaseName(SingleInput);
        return Name || '';
    }

    function ZTSMServicePayloadControls(Row) {
        var Controls = [];

        Array.prototype.forEach.call(Row.querySelectorAll('select, textarea, input'), function (Element) {
            if (!Element.name || Element.type === 'hidden' || Element.name.indexOf('SetIndex_') === 0) {
                return;
            }
            if (Element.name.indexOf('DynamicField_') !== 0 && Element.name.indexOf('Autocomplete_DynamicField_') !== 0) {
                return;
            }
            if (Element.name.indexOf('DynamicField_') === 0 && document.getElementById('Autocomplete_' + Element.name)) {
                return;
            }

            Controls.push(Element);
        });

        return Controls;
    }

    function ZTSMServicePayloadRowApply(Row, Data, SetName) {
        var Work = [],
            FieldIndex = {};

        ZTSMServicePayloadControls(Row).forEach(function (Element) {
            var FieldName = ZTSMServicePayloadFieldBaseName(Element),
                Label = ZTSMServicePayloadLabelText(Element),
                Value = ZTSMServicePayloadObjectLookup(Data, [
                    FieldName,
                    'DynamicField_' + FieldName,
                    Label,
                    SetName + '.' + FieldName,
                    SetName + '.' + Label,
                    'DynamicField_' + SetName + '.' + FieldName
                ]),
                ValueIndex;

            if (Value === undefined) {
                return;
            }

            ValueIndex = FieldIndex[FieldName] || 0;
            FieldIndex[FieldName] = ValueIndex + 1;

            if (Array.isArray(Value) && !Element.multiple) {
                Value = Value[ValueIndex] !== undefined ? Value[ValueIndex] : '';
            }

            Work.push(ZTSMServicePayloadInputSet(Element, Value));
        });

        return Promise.all(Work);
    }

    function ZTSMServicePayloadApply(Payload) {
        var Start = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsStart'),
            End = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsEnd'),
            Root = Start && End ? Start.parentNode : document,
            Rows,
            Work = [];

        if (!Root) {
            return Promise.resolve();
        }

        Rows = Array.isArray(Payload) ? Payload : [ Payload || {} ];

        Array.prototype.forEach.call(Root.querySelectorAll('.ZTSMServiceExtensionField'), function (FieldContainer) {
            var SetName = ZTSMServicePayloadContainerName(FieldContainer),
                SetPayload,
                SetRows;

            if (!SetName) {
                return;
            }

            if (FieldContainer.querySelector('input[type="hidden"][name^="SetIndex_"]')) {
                SetPayload = ZTSMServicePayloadObjectLookup(Payload || {}, [ SetName, 'DynamicField_' + SetName ]);
                SetPayload = Array.isArray(SetPayload) ? SetPayload : Rows;
                SetRows = ZTSMServicePayloadSetRowsEnsure(FieldContainer, SetPayload.length);
                SetPayload.forEach(function (RowData, Index) {
                    if (SetRows[Index]) {
                        Work.push(ZTSMServicePayloadRowApply(SetRows[Index], RowData || {}, SetName));
                    }
                });
            }
            else {
                Work.push(ZTSMServicePayloadRowApply(FieldContainer, Rows[0] || {}, SetName));
            }
        });

        return Promise.all(Work).then(function () {
            ZTSMServiceExtensionSetIndexNormalize(Start, End);
            ZTSMServiceExtensionLayoutFix(Start, End);
            ZTSMServicePayloadAutocompleteSettle(Root);
            ZTSMServicePayloadFormSubmitReset();
        });
    }

    function ZTSMServicePayloadCollect() {
        var Start = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsStart'),
            End = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsEnd'),
            Root = Start && End ? Start.parentNode : document,
            Payload = {};

        if (!Root) {
            return Payload;
        }

        Array.prototype.forEach.call(Root.querySelectorAll('.ZTSMServiceExtensionField'), function (FieldContainer) {
            var SetName = ZTSMServicePayloadContainerName(FieldContainer),
                Rows;

            if (!SetName) {
                return;
            }

            if (FieldContainer.querySelector('input[type="hidden"][name^="SetIndex_"]')) {
                Payload[SetName] = [];
                Rows = ZTSMServicePayloadSetRows(FieldContainer);
                Rows.forEach(function (Row) {
                    var RowData = {};

                    ZTSMServicePayloadControls(Row).forEach(function (Element) {
                        var Name = ZTSMServicePayloadFieldBaseName(Element),
                            Value = ZTSMServicePayloadOutputValue(Element);

                        RowData[Name] = ZTSMServicePayloadValueMerge(RowData[Name], Value);
                        ZTSMServicePayloadCollectDebug(Element, SetName + '.' + Name, Value);
                    });
                    Payload[SetName].push(RowData);
                });
            }
            else {
                ZTSMServicePayloadControls(FieldContainer).forEach(function (Element) {
                    var Value = ZTSMServicePayloadOutputValue(Element);

                    Payload[SetName] = ZTSMServicePayloadValueMerge(Payload[SetName], Value);
                    ZTSMServicePayloadCollectDebug(Element, SetName, Value);
                });
            }
        });

        return Payload;
    }

    function ZTSMServicePayloadTemplateFields() {
        var Start = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsStart'),
            End = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsEnd'),
            Root = Start && End ? Start.parentNode : document,
            Fields = [],
            Seen = {};

        if (!Root) {
            return Fields;
        }

        Array.prototype.forEach.call(Root.querySelectorAll('.ZTSMServiceExtensionField'), function (FieldContainer) {
            var SetName,
                SetRows;

            if (ZTSMServiceExtensionElementHidden(FieldContainer)) {
                return;
            }

            SetName = ZTSMServicePayloadContainerName(FieldContainer);
            if (!SetName) {
                return;
            }

            SetRows = ZTSMServicePayloadSetRows(FieldContainer);
            ZTSMServicePayloadControls(SetRows[0] || FieldContainer).forEach(function (Element) {
                var FieldName = ZTSMServicePayloadFieldBaseName(Element),
                    Label = ZTSMServicePayloadLabelText(Element),
                    Header,
                    Key,
                    Required = Element.classList.contains('Validate_Required') || !!(
                        Element.id
                        && document.querySelector('label[for="' + Element.id.replace(/"/g, '\\"') + '"] .Marker')
                    );

                if (!FieldName) {
                    return;
                }

                Header = SetName && SetName !== FieldName ? SetName + '.' + FieldName : FieldName;
                Key = ZTSMServicePayloadNormalize(Header);
                if (Seen[Key]) {
                    return;
                }

                Seen[Key] = 1;
                Fields.push({
                    Header: Header,
                    Field: FieldName,
                    Group: SetName,
                    Label: Label || FieldName,
                    Required: Required ? 'Yes' : '',
                    Type: Element.tagName === 'SELECT' ? 'Dropdown name or value'
                        : Element.name.indexOf('Autocomplete_DynamicField_') === 0 ? 'Reference name or Name::ID'
                        : Element.type === 'checkbox' ? '1/true/yes or blank'
                        : 'Text'
                });
            });
        });

        return Fields;
    }

    function ZTSMServicePayloadCSVValue(Value) {
        Value = Value === null || Value === undefined ? '' : String(Value);
        return /[",\r\n]/.test(Value) ? '"' + Value.replace(/"/g, '""') + '"' : Value;
    }

    function ZTSMServicePayloadDownload(Name, Content, Type) {
        var Link = document.createElement('a'),
            BlobObject = new Blob([ Content ], {
                type: Type || 'text/plain'
            });

        Link.href = URL.createObjectURL(BlobObject);
        Link.download = Name;
        document.body.appendChild(Link);
        Link.click();
        document.body.removeChild(Link);
        setTimeout(function () {
            URL.revokeObjectURL(Link.href);
        }, 0);
    }

    function ZTSMServicePayloadTemplateDownload() {
        var Fields = ZTSMServicePayloadTemplateFields(),
            Headers,
            BlankRow,
            Workbook,
            TemplateSheet,
            InstructionRows,
            InstructionSheet,
            CSV;

        if (!Fields.length) {
            return false;
        }

        Headers = Fields.map(function (Field) {
            return Field.Header;
        });
        BlankRow = Headers.map(function () {
            return '';
        });

        if (window.XLSX) {
            Workbook = XLSX.utils.book_new();
            TemplateSheet = XLSX.utils.aoa_to_sheet([ Headers, BlankRow ]);
            InstructionRows = [
                [ 'Column header', 'Field label', 'Field name', 'Payload group', 'Required', 'Accepted value' ]
            ];
            Fields.forEach(function (Field) {
                InstructionRows.push([
                    Field.Header,
                    Field.Label,
                    Field.Field,
                    Field.Group,
                    Field.Required,
                    Field.Type
                ]);
            });
            InstructionSheet = XLSX.utils.aoa_to_sheet(InstructionRows);
            XLSX.utils.book_append_sheet(Workbook, TemplateSheet, 'Template');
            XLSX.utils.book_append_sheet(Workbook, InstructionSheet, 'Instructions');
            XLSX.writeFile(Workbook, 'tessera-service-payload-template.xlsx');
            return true;
        }

        CSV = [ Headers, BlankRow ].map(function (Row) {
            return Row.map(ZTSMServicePayloadCSVValue).join(',');
        }).join('\r\n');
        ZTSMServicePayloadDownload('tessera-service-payload-template.csv', CSV, 'text/csv;charset=utf-8');
        return true;
    }

    function ZTSMServicePayloadStatus(Tools, Message) {
        var Statuses = Tools ? Tools.querySelectorAll('.ZTSMServicePayloadStatus') : [];

        Array.prototype.forEach.call(Statuses, function (Status) {
            Status.textContent = Message || '';
            if (Status.classList.contains('ZTSMServicePayloadToast')) {
                Status.classList.toggle('ZTSMServicePayloadToastVisible', !!Message);
                if (Message) {
                    window.clearTimeout(Status.ZTSMServicePayloadToastTimer);
                    Status.ZTSMServicePayloadToastTimer = window.setTimeout(function () {
                        Status.classList.remove('ZTSMServicePayloadToastVisible');
                    }, 2600);
                }
            }
        });
    }

    function ZTSMServicePayloadCurrentSignature() {
        var Fields = ZTSMServicePayloadTemplateFields().map(function (Field) {
            return Field.Header + ':' + Field.Field;
        });

        return JSON.stringify({
            ServiceID: ZTSMServiceExtensionValue(),
            Fields: Fields
        });
    }

    function ZTSMServicePayloadCodeGenerate(Code) {
        if (!Code) {
            return;
        }

        Code.value = JSON.stringify(ZTSMServicePayloadCollect(), null, 2);
        Code.dataset.ZTSMServicePayloadSignature = ZTSMServicePayloadCurrentSignature();
        delete Code.dataset.ZTSMServicePayloadStale;
    }

    function ZTSMServicePayloadCodeInvalidate() {
        var Code = ZTSMFirst('#ZTSMServicePayloadTools .ZTSMServicePayloadCode');

        if (!Code) {
            return;
        }

        Code.dataset.ZTSMServicePayloadStale = '1';
    }

    function ZTSMServicePayloadToolsEnsure(Start, End) {
        var Existing = ZTSMFirst('#ZTSMServicePayloadTools'),
            Tools,
            Upload,
            Code,
            Drawer,
            TemplateButton,
            ImportButton,
            CodeButton,
            ApplyButtons,
            CloseButtons;

        if (!Start || !End) {
            return;
        }

        if (Existing) {
            return;
        }

        Tools = document.createElement('div');
        Tools.id = 'ZTSMServicePayloadTools';
        Tools.className = 'ZTSMServicePayloadTools';
        Tools.innerHTML = ''
            + '<div class="ZTSMServicePayloadToolbar">'
            + '<button type="button" class="ZTSMServicePayloadIconButton" data-ztsm-payload-template="1" title="Download template" aria-label="Download template"><i class="fa fa-download" aria-hidden="true"></i></button>'
            + '<button type="button" class="ZTSMServicePayloadIconButton" data-ztsm-payload-import="1" title="Upload template" aria-label="Upload template"><i class="fa fa-upload" aria-hidden="true"></i></button>'
            + '<button type="button" class="ZTSMServicePayloadIconButton" data-ztsm-payload-code="1" title="View JSON" aria-label="View JSON" aria-pressed="false"><i class="fa fa-code" aria-hidden="true"></i></button>'
            + '<button type="button" class="ZTSMServicePayloadIconButton Hidden" data-ztsm-payload-apply="1" title="Apply JSON" aria-label="Apply JSON"><i class="fa fa-check" aria-hidden="true"></i></button>'
            + '</div>'
            + '<span class="ZTSMServicePayloadStatus ZTSMServicePayloadToast" aria-live="polite"></span>'
            + '<input type="file" class="Hidden" accept=".xlsx,.xls,.csv,text/csv" data-ztsm-payload-file="1"/>'
            + '<div class="ZTSMServicePayloadDrawer" role="dialog" aria-modal="false" aria-labelledby="ZTSMServicePayloadDrawerTitle">'
            + '<div class="ZTSMServicePayloadDrawerHeader">'
            + '<div class="ZTSMServicePayloadDrawerTitle" id="ZTSMServicePayloadDrawerTitle">JSON Template Editor</div>'
            + '<button type="button" class="ZTSMServicePayloadIconButton" data-ztsm-payload-close="1" title="Close JSON editor" aria-label="Close JSON editor"><i class="fa fa-times" aria-hidden="true"></i></button>'
            + '</div>'
            + '<textarea class="ZTSMServicePayloadCode" spellcheck="false"></textarea>'
            + '<div class="ZTSMServicePayloadDrawerFooter">'
            + '<span class="ZTSMServicePayloadStatus"></span>'
            + '<button type="button" class="ZTSMServicePayloadDrawerButton" data-ztsm-payload-close="1">Cancel</button>'
            + '<button type="button" class="ZTSMServicePayloadDrawerButton ZTSMServicePayloadDrawerButtonPrimary" data-ztsm-payload-apply="1">Apply</button>'
            + '</div>'
            + '</div>';

        document.body.appendChild(Tools);

        Upload = Tools.querySelector('[data-ztsm-payload-file]');
        Code = Tools.querySelector('.ZTSMServicePayloadCode');
        Drawer = Tools.querySelector('.ZTSMServicePayloadDrawer');
        TemplateButton = Tools.querySelector('[data-ztsm-payload-template]');
        ImportButton = Tools.querySelector('[data-ztsm-payload-import]');
        CodeButton = Tools.querySelector('[data-ztsm-payload-code]');
        ApplyButtons = Tools.querySelectorAll('[data-ztsm-payload-apply]');
        CloseButtons = Tools.querySelectorAll('[data-ztsm-payload-close]');

        function DrawerToggle(Open) {
            var IsOpen = Open !== undefined ? Open : !Drawer.classList.contains('ZTSMServicePayloadDrawerOpen');

            if (IsOpen) {
                ZTSMServicePayloadCodeGenerate(Code);
                Drawer.classList.add('ZTSMServicePayloadDrawerOpen');
                Tools.querySelector('[data-ztsm-payload-apply]').classList.remove('Hidden');
                CodeButton.setAttribute('title', 'Hide service payload JSON');
                CodeButton.setAttribute('aria-label', 'Hide service payload JSON');
                CodeButton.setAttribute('aria-pressed', 'true');
                window.setTimeout(function () {
                    Code.focus();
                }, 0);
            }
            else {
                Drawer.classList.remove('ZTSMServicePayloadDrawerOpen');
                Tools.querySelector('[data-ztsm-payload-apply]').classList.add('Hidden');
                CodeButton.setAttribute('title', 'View JSON');
                CodeButton.setAttribute('aria-label', 'View JSON');
                CodeButton.setAttribute('aria-pressed', 'false');
            }
        }

        function PayloadApply() {
            var Payload,
                CurrentSignature = ZTSMServicePayloadCurrentSignature();

            if (
                Code.dataset.ZTSMServicePayloadStale === '1'
                || (Code.dataset.ZTSMServicePayloadSignature && Code.dataset.ZTSMServicePayloadSignature !== CurrentSignature)
            ) {
                ZTSMServicePayloadCodeGenerate(Code);
                ZTSMServicePayloadStatus(Tools, 'Service changed. Payload JSON regenerated; review before applying.');
                return;
            }

            try {
                Payload = JSON.parse(Code.value || '{}');
            }
            catch (Error) {
                ZTSMServicePayloadStatus(Tools, 'Invalid JSON.');
                return;
            }

            ZTSMServicePayloadStatus(Tools, 'Applying...');
            ZTSMServicePayloadApply(Payload).then(function () {
                ZTSMServicePayloadStatus(Tools, 'Payload applied.');
                ZTSMServicePayloadFormSubmitReset();
                DrawerToggle(false);
                Code.blur();
                CodeButton.focus();
            });
        }

        TemplateButton.addEventListener('click', function () {
            if (ZTSMServicePayloadTemplateDownload()) {
                ZTSMServicePayloadStatus(Tools, 'Template downloaded.');
            }
            else {
                ZTSMServicePayloadStatus(Tools, 'No service payload fields available.');
            }
        });

        ImportButton.addEventListener('click', function () {
            Upload.click();
        });

        Upload.addEventListener('change', function () {
            var File = Upload.files && Upload.files[0];

            if (!File) {
                return;
            }

            ZTSMServicePayloadStatus(Tools, 'Importing...');
            ZTSMServicePayloadFileRead(File).then(function (Rows) {
                return ZTSMServicePayloadApply(Rows).then(function () {
                    ZTSMServicePayloadStatus(Tools, Rows.length + ' row(s) imported.');
                    Upload.value = '';
                    ZTSMServicePayloadFormSubmitReset();
                    DrawerToggle(false);
                    CodeButton.focus();
                });
            }).catch(function (Error) {
                ZTSMServicePayloadStatus(Tools, Error && Error.message ? Error.message : 'Import failed.');
                Upload.value = '';
            });
        });

        CodeButton.addEventListener('click', function () {
            DrawerToggle();
        });

        Array.prototype.forEach.call(ApplyButtons, function (ApplyButton) {
            ApplyButton.addEventListener('click', PayloadApply);
        });

        Array.prototype.forEach.call(CloseButtons, function (CloseButton) {
            CloseButton.addEventListener('click', function () {
                DrawerToggle(false);
            });
        });
    }

    function ZTSMServiceExtensionDatepickerConfigEnsure() {
        var DatepickerConfig;

        if (!window.Core || !Core.Config || typeof Core.Config.Get !== 'function' || typeof Core.Config.Set !== 'function') {
            return {
                TimeVacationDays: {},
                TimeVacationDaysOneTime: {}
            };
        }

        DatepickerConfig = Core.Config.Get('Datepicker.VacationDays');

        if (DatepickerConfig && DatepickerConfig.TimeVacationDays && DatepickerConfig.TimeVacationDaysOneTime) {
            return DatepickerConfig;
        }

        DatepickerConfig = {
            TimeVacationDays: {},
            TimeVacationDaysOneTime: {}
        };

        Core.Config.Set('Datepicker.VacationDays', DatepickerConfig);

        return DatepickerConfig;
    }

    function ZTSMServiceExtensionDatepickerInit(Start, End) {
        var Root = Start && End ? Start.parentNode : document,
            DatepickerConfig;

        if (!Root || !window.Core || !Core.UI || !Core.UI.Datepicker || typeof Core.UI.Datepicker.Init !== 'function') {
            return;
        }
        if (!window.jQuery || !window.Core.App || typeof Core.App.EscapeSelector !== 'function') {
            return;
        }

        DatepickerConfig = ZTSMServiceExtensionDatepickerConfigEnsure();

        Array.prototype.forEach.call(Root.querySelectorAll('.ZTSMServiceExtensionField .Validate_DateYear'), function (YearField) {
            var Prefix,
                Suffix,
                DayID,
                Container = YearField.closest('.DynamicFieldDate'),
                $Container;

            if (!Container || !YearField.name || YearField.name.slice(-4) !== 'Year') {
                return;
            }

            Prefix = YearField.name.slice(0, -4);
            Suffix = YearField.id && YearField.id.length > Prefix.length ? YearField.id.slice(Prefix.length + 4) : '';
            DayID = Prefix + 'Day' + Suffix;

            if (document.getElementById(DayID + 'DatepickerIcon')) {
                return;
            }

            $Container = jQuery(Container);

            ZTSMServiceExtensionSafeInit(function () {
                Core.UI.Datepicker.Init({
                    Day: jQuery('#' + Core.App.EscapeSelector(Prefix + 'Day' + Suffix), $Container),
                    Month: jQuery('#' + Core.App.EscapeSelector(Prefix + 'Month' + Suffix), $Container),
                    Year: jQuery('#' + Core.App.EscapeSelector(Prefix + 'Year' + Suffix), $Container),
                    Hour: jQuery('#' + Core.App.EscapeSelector(Prefix + 'Hour' + Suffix), $Container),
                    Minute: jQuery('#' + Core.App.EscapeSelector(Prefix + 'Minute' + Suffix), $Container),
                    VacationDays: DatepickerConfig,
                    WeekDayStart: Core.Config.Get('CalendarWeekDayStart') || 1
                });
            });
        });
    }

    function ZTSMServiceSelectedTreeLabelsEnsure(Service) {
        Array.prototype.forEach.call(Service.options || [], function (Option) {
            var RawText,
                Leading;

            if (Option.dataset.ZTSMTreeLabel) {
                return;
            }

            RawText = String(Option.textContent || Option.innerText || '');
            Leading = RawText.match(/^[\u00a0\s]*/);

            Option.dataset.ZTSMTreeLabel = RawText;
            Option.dataset.ZTSMTreeDepth = Leading ? String(Math.floor(Leading[0].replace(/[^\u00a0]/g, '').length / 2)) : '0';
        });
    }

    function ZTSMServiceSelectedTreeLabelsRestore(Service) {
        Array.prototype.forEach.call(Service.options || [], function (Option) {
            if (!Option.dataset.ZTSMTreeLabel) {
                return;
            }
            if (Option.textContent !== Option.dataset.ZTSMTreeLabel) {
                Option.textContent = Option.dataset.ZTSMTreeLabel;
            }
        });
    }

    function ZTSMServiceSelectedFullPathGet(Service) {
        var Stack = [],
            SelectedValue = String(Service.value || ''),
            Result = '';

        ZTSMServiceSelectedTreeLabelsEnsure(Service);

        Array.prototype.forEach.call(Service.options || [], function (Option) {
            var RawText = String(Option.dataset.ZTSMTreeLabel || Option.textContent || Option.innerText || ''),
                Text = RawText.replace(/^\s+|\s+$/g, ''),
                Depth = parseInt(Option.dataset.ZTSMTreeDepth || '0', 10),
                IsRealOption = String(Option.value || '') !== '' && String(Option.value || '') !== '-';

            if (!Text || Text === '-') {
                return;
            }

            Stack = Stack.slice(0, Depth);
            Stack[Depth] = Text;

            if (IsRealOption && SelectedValue && String(Option.value) === SelectedValue) {
                Result = Stack.slice(0, Depth + 1).join('::');
            }
        });

        return Result;
    }

    function ZTSMServiceSelectedFullPathRefresh() {
        var Service = ZTSMFirst('select#ServiceID, select[name="ServiceID"]'),
            Label,
            Container,
            Selection,
            SearchInput;

        if (!Service || !Service.options || !Service.value) {
            return;
        }

        Label = ZTSMServiceSelectedFullPathGet(Service);
        if (!Label) {
            return;
        }

        Service.setAttribute('data-ztsm-full-service-label', Label);
        if (Service.options[Service.selectedIndex]) {
            Service.options[Service.selectedIndex].textContent = Label;
            Service.options[Service.selectedIndex].setAttribute('title', Label);
        }

        Container = ZTSMServicePayloadModernizedSelectContainer(Service);
        if (!Container) {
            return;
        }

        Container.classList.remove('ZTSMServiceFullPathSelected');
        Container.style.removeProperty('height');
        Container.style.removeProperty('min-height');

        Selection = Container.querySelector('.InputField_Selection');
        if (Selection) {
            Selection.textContent = Label;
            Selection.setAttribute('title', Label);
            Selection.setAttribute('data-value', Service.value);
            Selection.setAttribute('aria-label', Label);
            Selection.style.removeProperty('max-width');
            Selection.style.removeProperty('white-space');
            Selection.style.removeProperty('overflow');
            Selection.style.removeProperty('text-overflow');
            Selection.style.removeProperty('overflow-wrap');
            Selection.style.removeProperty('line-height');
        }

        SearchInput = Container.querySelector('.InputField_Search');
        if (SearchInput && document.activeElement !== SearchInput) {
            SearchInput.value = '';
            SearchInput.setAttribute('placeholder', '');
            SearchInput.setAttribute('title', Label);
        }
    }

    function ZTSMServiceSelectedTreeModePrepare() {
        var Service = ZTSMFirst('select#ServiceID, select[name="ServiceID"]');

        if (!Service || !Service.options) {
            return;
        }

        ZTSMServiceSelectedTreeLabelsRestore(Service);
    }

    function ZTSMServiceExtensionInitialize(Start, End) {
        var Node = Start.nextSibling,
            Event;

        ZTSMServiceExtensionDatepickerConfigEnsure();

        if (window.Core && Core.UI && Core.UI.InputFields && typeof Core.UI.InputFields.Init === 'function') {
            ZTSMServiceExtensionSafeInit(function () {
                Core.UI.InputFields.Init();
            });
        }
        if (window.Core && Core.Customer && Core.Customer.InputFields && typeof Core.Customer.InputFields.Init === 'function') {
            ZTSMServiceExtensionSafeInit(function () {
                Core.Customer.InputFields.Init();
            });
        }
        if (window.Core && Core.Agent && Core.Agent.DynamicFieldReferenceSearch && typeof Core.Agent.DynamicFieldReferenceSearch.Init === 'function') {
            ZTSMServiceExtensionSafeInit(function () {
                Core.Agent.DynamicFieldReferenceSearch.Init();
            });
        }
        ZTSMServiceExtensionSetIndexNormalize(Start, End);
        ZTSMServiceExtensionDatepickerInit(Start, End);

        while (Node && Node !== End) {
            if (Node.nodeType === 1) {
                Event = document.createEvent('Event');
                Event.initEvent('change', true, true);

                Array.prototype.forEach.call(Node.querySelectorAll('select, input, textarea'), function (Field) {
                    Field.dispatchEvent(Event);
                });
            }
            Node = Node.nextSibling;
        }

        ZTSMServiceExtensionSetIndexNormalize(Start, End);
        ZTSMServiceExtensionLayoutFix(Start, End);
        ZTSMServicePayloadToolsEnsure(Start, End);
        window.setTimeout(ZTSMServiceSelectedFullPathRefresh, 0);
    }

    function ZTSMServiceExtensionWatch() {
        var LastServiceID = ZTSMServiceExtensionValue(),
            Service = ZTSMFirst('#ServiceID, input[name="ServiceID"], select[name="ServiceID"]'),
            Events = [ 'change', 'input', 'keyup', 'paste', 'blur', 'select2:select', 'select2:unselect' ];

        ZTSMServicePayloadNativeSubmitTraceEnsure();

        if (!document.body.dataset.ZTSMServiceExtensionRowActionWatch) {
            document.body.dataset.ZTSMServiceExtensionRowActionWatch = '1';
            document.body.addEventListener('click', function (Event) {
                var Control = Event.target && Event.target.closest ? Event.target.closest('.AddValueRow, .RemoveValueRow') : null;

                if (!Control || !Control.closest('.ZTSMServiceExtensionField')) {
                    return;
                }

                ZTSMServiceExtensionNormalizeLater();
            });
        }

        if (!document.body.dataset.ZTSMServiceExtensionMutationWatch && window.MutationObserver) {
            document.body.dataset.ZTSMServiceExtensionMutationWatch = '1';
            new MutationObserver(function (Mutations) {
                var NeedsNormalize = false;

                Mutations.forEach(function (Mutation) {
                    if (NeedsNormalize) {
                        return;
                    }
                    Array.prototype.forEach.call(Mutation.addedNodes || [], function (Node) {
                        if (
                            Node
                            && Node.nodeType === 1
                            && Node.closest
                            && (
                                Node.closest('.ZTSMServiceExtensionField')
                                || (Node.querySelector && Node.querySelector('.ZTSMServiceExtensionField, input[type="hidden"][name^="SetIndex_"]'))
                            )
                        ) {
                            NeedsNormalize = true;
                        }
                    });
                });

                if (NeedsNormalize) {
                    ZTSMServiceExtensionNormalizeLater();
                }
            }).observe(document.body, {
                childList: true,
                subtree: true
            });
        }

        if (!document.body.dataset.ZTSMServiceExtensionSubmitWatch) {
            document.body.dataset.ZTSMServiceExtensionSubmitWatch = '1';
            document.body.addEventListener('invalid', function (Event) {
                var Element = Event.target;

                if (!Element || !Element.closest || !Element.closest('#NewCustomerTicket')) {
                    return;
                }

                ZTSMServicePayloadConsole('warn', '[ZTSM submit invalid]', {
                    name: Element.name || '',
                    id: Element.id || '',
                    className: Element.className || '',
                    value: Element.value || '',
                    validationMessage: Element.validationMessage || '',
                    fieldText: Element.closest('.FieldCell, .Row_DynamicField, .ZTSMServiceExtensionField')
                        ? String(Element.closest('.FieldCell, .Row_DynamicField, .ZTSMServiceExtensionField').textContent || '').replace(/\s+/g, ' ').trim().slice(0, 500)
                        : ''
                });
            }, true);
            document.body.addEventListener('click', function (Event) {
                var Start = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsStart'),
                    End = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsEnd'),
                    Control = Event.target && Event.target.closest ? Event.target.closest('#NewCustomerTicket button[type="submit"], #NewCustomerTicket input[type="submit"]') : null,
                    Form,
                    Invalid,
                    Validator;

                if (Start && End && Control) {
                    ZTSMServiceExtensionSetIndexNormalize(Start, End);
                    Form = Control.closest('form');
                    ZTSMServicePayloadFormSubmitReset();
                    if (Form && Form.querySelector) {
                        Invalid = Form.querySelector(':invalid');
                    }
                    if (Form && window.jQuery) {
                        Validator = window.jQuery(Form).data('validator');
                    }
                    ZTSMServicePayloadConsole('log', '[ZTSM submit click]', {
                        buttonText: String(Control.textContent || Control.value || '').replace(/\s+/g, ' ').trim(),
                        formClassName: Form ? (Form.className || '') : '',
                        disabledSubmits: Form && Form.querySelectorAll ? Form.querySelectorAll('button[type="submit"]:disabled, input[type="submit"]:disabled').length : 0,
                        validatorErrors: Validator && Validator.errorList ? Validator.errorList.length : '',
                        validatorErrorDetails: ZTSMServicePayloadValidatorErrorDetailsLog('[ZTSM submit click validator]', Validator),
                        validatorPending: Validator ? Validator.pendingRequest : '',
                        invalidName: Invalid ? (Invalid.name || '') : '',
                        invalidId: Invalid ? (Invalid.id || '') : '',
                        invalidValue: Invalid ? (Invalid.value || '') : '',
                        invalidMessage: Invalid ? (Invalid.validationMessage || '') : ''
                    });
                }
            }, true);
            document.body.addEventListener('submit', function (Event) {
                var Start = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsStart'),
                    End = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsEnd');

                if (Start && End && Event.target && Event.target.closest && Event.target.closest('#NewCustomerTicket')) {
                    ZTSMServiceExtensionSetIndexNormalize(Start, End);
                    ZTSMServicePayloadConsole('log', '[ZTSM submit event]', {
                        defaultPrevented: !!Event.defaultPrevented,
                        className: Event.target.className || '',
                        validatorErrorDetails: window.jQuery ? ZTSMServicePayloadValidatorErrorDetailsLog('[ZTSM submit event validator]', window.jQuery(Event.target).data('validator')) : [],
                        action: Event.target.action || '',
                        method: Event.target.method || ''
                    });
                    window.setTimeout(function () {
                        ZTSMServicePayloadConsole('log', '[ZTSM submit after handlers]', {
                            defaultPrevented: !!Event.defaultPrevented,
                            className: Event.target.className || '',
                            validatorErrorDetails: window.jQuery ? ZTSMServicePayloadValidatorErrorDetailsLog('[ZTSM submit after handlers validator]', window.jQuery(Event.target).data('validator')) : []
                        });
                    }, 0);
                }
            }, true);
        }

        if (!document.body.dataset.ZTSMServiceFullPathWatch) {
            document.body.dataset.ZTSMServiceFullPathWatch = '1';
            [ 'mousedown', 'focus', 'click' ].forEach(function (EventName) {
                document.body.addEventListener(EventName, function (Event) {
                    var Element = Event.target;

                    if (
                        !Element
                        || !Element.closest
                        || !Element.closest('#ServiceID, [name="ServiceID"], .InputField_Container, .InputField_InputContainer')
                    ) {
                        return;
                    }

                    ZTSMServiceSelectedTreeModePrepare();
                }, true);
            });
            [ 'change', 'input', 'blur' ].forEach(function (EventName) {
                document.body.addEventListener(EventName, function (Event) {
                    var Element = Event.target;

                    if (
                        !Element
                        || !Element.matches
                        || !Element.matches('select#ServiceID, select[name="ServiceID"], input#ServiceID, input[name="ServiceID"]')
                    ) {
                        return;
                    }

                    ZTSMServiceSelectedFullPathRefresh();
                    window.setTimeout(ZTSMServiceSelectedFullPathRefresh, 0);
                }, true);
            });
        }

        if (Service) {
            Events.forEach(function (EventName) {
                Service.addEventListener(EventName, function () {
                    var CurrentServiceID = ZTSMServiceExtensionValue();

                    ZTSMServiceSelectedFullPathRefresh();
                    window.setTimeout(ZTSMServiceSelectedFullPathRefresh, 0);
                    if (CurrentServiceID === LastServiceID) {
                        return;
                    }

                    LastServiceID = CurrentServiceID;
                    ZTSMServicePayloadCodeInvalidate();
                    window.setTimeout(ZTSMServiceExtensionRefresh, 0);
                });
            });
        }

        window.setInterval(function () {
            var CurrentServiceID = ZTSMServiceExtensionValue();

            if (CurrentServiceID === LastServiceID) {
                return;
            }

            LastServiceID = CurrentServiceID;
            ZTSMServicePayloadCodeInvalidate();
            ZTSMServiceExtensionRefresh();
            window.setTimeout(ZTSMServiceSelectedFullPathRefresh, 0);
        }, 500);

        window.addEventListener('resize', function () {
            var Start = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsStart'),
                End = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsEnd');

            if (Start && End) {
                ZTSMServiceExtensionSetIndexNormalize(Start, End);
                ZTSMServiceExtensionLayoutFix(Start, End);
                ZTSMServicePayloadToolsEnsure(Start, End);
            }
        });
    }

    function ZTSMReady() {
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function () {
                var Start = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsStart'),
                    End = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsEnd');

                if (Start && End) {
                    ZTSMServiceExtensionMark(Start, End);
                    ZTSMServiceExtensionSetIndexNormalize(Start, End);
                    ZTSMServiceExtensionLayoutFix(Start, End);
                    ZTSMServicePayloadToolsEnsure(Start, End);
                }
                ZTSMServiceExtensionWatch();
                window.setTimeout(ZTSMServiceSelectedFullPathRefresh, 0);
            });
        }
        else {
            var Start = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsStart'),
                End = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsEnd');

            if (Start && End) {
                ZTSMServiceExtensionMark(Start, End);
                ZTSMServiceExtensionSetIndexNormalize(Start, End);
                ZTSMServiceExtensionLayoutFix(Start, End);
                ZTSMServicePayloadToolsEnsure(Start, End);
            }
            ZTSMServiceExtensionWatch();
            window.setTimeout(ZTSMServiceSelectedFullPathRefresh, 0);
        }
    }

    ZTSMReady();
}());
</script>
