}

#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldSetLayoutHorizontal > .Row_DynamicField > .FieldCell.DynamicFieldDate,
#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldSetLayoutHorizontal > .Row_DynamicField > .FieldCell.DynamicFieldDateTime,
#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldSetLayoutHorizontal > .Row_DynamicField.MultiColumn > .FieldCell.DynamicFieldDate,
#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldSetLayoutHorizontal > .Row_DynamicField.MultiColumn > .FieldCell.DynamicFieldDateTime {
    flex: 1.05 1 0 !important;
    width: auto !important;
    min-width: 210px !important;
    max-width: none !important;
}

#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldSetLayoutHorizontal > .Row_DynamicField > .FieldCell > .Field,
#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldSetLayoutHorizontal > .Row_DynamicField > .FieldCell .InputField_Container,
#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldSetLayoutHorizontal > .Row_DynamicField > .FieldCell input:not([type="hidden"]),
#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldSetLayoutHorizontal > .Row_DynamicField > .FieldCell select,
#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldSetLayoutHorizontal > .Row_DynamicField > .FieldCell textarea {
    width: 100% !important;
    min-width: 0;
    box-sizing: border-box;
}

#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldSetLayoutVertical > .Row_DynamicField {
    display: grid;
    grid-template-columns: 1fr !important;
    gap: 14px;
}

#NewCustomerTicket .ZTSMServiceExtensionField.ZTSMServiceExtensionRichTextRow .FieldCell,
#NewCustomerTicket .ZTSMServiceExtensionField .Field.RichTextField,
#NewCustomerTicket .ZTSMServiceExtensionField .Field.RichText,
#NewCustomerTicket .ZTSMServiceExtensionField .Field.RichTextField .RichTextHolder,
#NewCustomerTicket .ZTSMServiceExtensionField .Field.RichText .RichTextHolder,
#NewCustomerTicket .ZTSMServiceExtensionField .Field.RichTextField textarea.RichText,
#NewCustomerTicket .ZTSMServiceExtensionField .Field.RichText textarea.RichText,
#NewCustomerTicket .ZTSMServiceExtensionField .Field.RichTextField .ck,
#NewCustomerTicket .ZTSMServiceExtensionField .Field.RichText .ck,
#NewCustomerTicket .ZTSMServiceExtensionField .Field.RichTextField .ck-editor,
#NewCustomerTicket .ZTSMServiceExtensionField .Field.RichText .ck-editor,
#NewCustomerTicket .ZTSMServiceExtensionField .Field.RichTextField .ck-editor__main,
#NewCustomerTicket .ZTSMServiceExtensionField .Field.RichText .ck-editor__main,
#NewCustomerTicket .ZTSMServiceExtensionField .Field.RichTextField .ck-editor__editable,
#NewCustomerTicket .ZTSMServiceExtensionField .Field.RichText .ck-editor__editable {
    width: 100% !important;
    max-width: none !important;
    min-width: 0 !important;
    box-sizing: border-box !important;
}

#NewCustomerTicket .ZTSMServiceExtensionField .Field.RichTextField,
#NewCustomerTicket .ZTSMServiceExtensionField .Field.RichText {
    margin-left: 0 !important;
    margin-right: 0 !important;
}

#NewCustomerTicket .ZTSMServiceExtensionField .ck-editor__top[role="presentation"],
#NewCustomerTicket .ZTSMServiceExtensionField .ck-editor__top {
    display: flex !important;
    flex-direction: column !important;
    align-items: stretch !important;
    width: 100% !important;
    max-width: none !important;
    min-width: 0 !important;
    box-sizing: border-box !important;
    overflow: visible !important;
}

#NewCustomerTicket .ZTSMServiceExtensionField .ck-editor__top > .Tooltip.oooTooltip.ZTSMServiceExtensionRichTextInlineHelp {
    order: -1 !important;
}

#NewCustomerTicket .ZTSMServiceExtensionField .ck-editor__top > .ck-sticky-panel {
    width: 100% !important;
    max-width: none !important;
    min-width: 0 !important;
    box-sizing: border-box !important;
}

#NewCustomerTicket .ZTSMServiceExtensionField .ZTSMServiceExtensionRichTextInlineHelp {
    display: flex !important;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    position: relative !important;
    top: auto !important;
    left: auto !important;
    right: auto !important;
    bottom: auto !important;
    width: 100% !important;
    min-height: 32px;
    padding: 4px 10px;
    background: #f4f4f7;
    border: 0;
    border-bottom: 0;
    border-radius: 8px 8px 0 0;
    box-sizing: border-box;
    transform: none !important;
    float: none !important;
    overflow: visible !important;
}

#NewCustomerTicket .ZTSMServiceExtensionField .ZTSMServiceExtensionRichTextInlineHelp > label.ZTSMServiceExtensionRichTextLabel,
#NewCustomerTicket .ZTSMServiceExtensionField .ck-sticky-panel > label.ZTSMServiceExtensionRichTextLabel,
#NewCustomerTicket .ZTSMServiceExtensionField .ck-editor__top > label.ZTSMServiceExtensionRichTextLabel {
    display: inline-flex !important;
    align-items: center;
    flex: 1 1 auto;
    position: relative !important;
    top: auto !important;
    left: auto !important;
    right: auto !important;
    bottom: auto !important;
    width: auto !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    color: #7f809d !important;
    font-size: 14px !important;
    font-weight: 600 !important;
    line-height: 1.35 !important;
    text-align: left !important;
    transform: none !important;
    pointer-events: auto !important;
}

#NewCustomerTicket .ZTSMServiceExtensionField .ZTSMServiceExtensionRichTextInlineHelp > i {
    flex: 0 0 auto;
    margin: 0 0 0 auto !important;
}

#NewCustomerTicket .ZTSMServiceExtensionField .ZTSMServiceExtensionRichTextInlineHelp > .Content {
    display: none !important;
    position: absolute !important;
    top: 100% !important;
    left: 10px !important;
    right: auto !important;
    z-index: 9999 !important;
    width: 520px !important;
    max-width: calc(100vw - 48px) !important;
    margin: 6px 0 0 0 !important;
    padding: 12px 14px !important;
    color: #00063d !important;
    background: #fff !important;
    border: 1px solid #c9ccd7 !important;
    border-radius: 6px !important;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18) !important;
    white-space: normal !important;
    overflow-wrap: anywhere !important;
    word-break: normal !important;
    line-height: 1.4 !important;
    box-sizing: border-box !important;
}

#NewCustomerTicket .ZTSMServiceExtensionField .ZTSMServiceExtensionRichTextInlineHelp:hover > .Content,
#NewCustomerTicket .ZTSMServiceExtensionField .ZTSMServiceExtensionRichTextInlineHelp:focus-within > .Content {
    display: block !important;
}

#NewCustomerTicket .ZTSMServiceExtensionField .Field.RichTextField > label,
#NewCustomerTicket .ZTSMServiceExtensionField .Field.RichText > label {
    display: none !important;
}

#NewCustomerTicket .ZTSMServiceExtensionField fieldset.RichTextHolder,
#NewCustomerTicket .ZTSMServiceExtensionField .Field.RichTextField .RichTextHolder,
#NewCustomerTicket .ZTSMServiceExtensionField .Field.RichText .RichTextHolder {
    display: block;
    overflow: visible;
    padding-top: 0 !important;
}

#NewCustomerTicket .ZTSMServiceExtensionField .Field.RichTextField textarea.RichText,
#NewCustomerTicket .ZTSMServiceExtensionField .Field.RichText textarea.RichText {
    min-height: 260px !important;
}

/* OTOBO 11.1 resizes RichTextHolder and calculates the editable height from
 * that live value. Do not retain the old TESSERA minimum on CKEditor itself:
 * label + toolbar + that minimum can exceed the holder and overlap the next
 * vertical DynamicField Set member. */
#NewCustomerTicket .ZTSMServiceExtensionField .Field.RichTextField .ck-editor__editable,
#NewCustomerTicket .ZTSMServiceExtensionField .Field.RichText .ck-editor__editable {
    min-height: 0 !important;
}

#NewCustomerTicket .ZTSMServiceExtensionField .Field.RichTextField .ck-editor__editable_inline,
#NewCustomerTicket .ZTSMServiceExtensionField .Field.RichText .ck-editor__editable_inline {
    padding: 18px 20px !important;
}

#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldDate .oooDateContainer,
#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldDateTime .oooDateContainer {
    width: 100%;
    min-height: 72px;
    height: auto;
    position: relative;
    padding: 20px 46px 10px 14px;
    border: 1px solid #7d82ad;
    border-radius: 8px;
    box-sizing: border-box;
    color: #7f809d;
    white-space: normal;
}

#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldDate .oooDate,
#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldDateTime .oooDate {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 30px;
    width: 100%;
    box-sizing: border-box;
}

#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldDate .oooDateContainer > label,
#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldDateTime .oooDateContainer > label,
#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldDate .oooDateContainer > input[type="checkbox"]:checked ~ label,
#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldDateTime .oooDateContainer > input[type="checkbox"]:checked ~ label {
    position: absolute;
    top: -9px;
    left: 14px;
    width: auto;
    height: auto;
    padding: 0 6px;
    margin: 0;
    display: inline-block;
    background: #fff;
    color: #7f809d;
    font-size: 13px;
    line-height: 18px;
}

#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldDate .DatepickerIcon,
#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldDateTime .DatepickerIcon {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    padding-left: 0;
}

#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldDate .oooAltCheck,
#NewCustomerTicket .ZTSMServiceExtensionField .DynamicFieldDateTime .oooAltCheck {
    display: none;
}

#NewCustomerTicket .ZTSMServiceExtensionField label.ZTSMServicePayloadLabelFloated,
#NewCustomerTicket .ZTSMServiceExtensionField .ZTSMServicePayloadHasValue > label {
    position: absolute !important;
    top: -9px !important;
    left: 14px !important;
    width: auto !important;
    height: auto !important;
    max-width: calc(100% - 96px) !important;
    padding: 0 6px !important;
    margin: 0 !important;
    display: inline-block !important;
    background: #fff !important;
    color: #7f809d !important;
    font-size: 13px !important;
    line-height: 18px !important;
    transform: none !important;
    z-index: 3 !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    pointer-events: auto !important;
}

#NewCustomerTicket .ZTSMServiceExtensionField .ZTSMServicePayloadHasValue {
    position: relative !important;
}

#NewCustomerTicket .ZTSMServiceExtensionField .ZTSMServicePayloadHasValue input:not([type="hidden"]),
#NewCustomerTicket .ZTSMServiceExtensionField .ZTSMServicePayloadHasValue select,
#NewCustomerTicket .ZTSMServiceExtensionField .ZTSMServicePayloadHasValue textarea,
#NewCustomerTicket .ZTSMServiceExtensionField .ZTSMServicePayloadHasValue .InputField_Container {
    min-height: 70px !important;
    padding-top: 18px !important;
    padding-bottom: 8px !important;
    box-sizing: border-box !important;
}

.ZTSMServicePayloadTools button {
    min-height: 0;
}

.ZTSMServicePayloadTools {
    position: fixed;
    right: 18px;
    top: 45%;
    transform: translateY(-50%);
    z-index: 9998;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 6px;
    border: 1px solid rgba(125, 130, 173, 0.28);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.78);
    box-shadow: 0 12px 30px rgba(10, 16, 48, 0.18);
    backdrop-filter: blur(10px);
}

.ZTSMServicePayloadToolbar {
    display: flex;
    flex-direction: column;
    gap: 4px;
    align-items: center;
}

.ZTSMServicePayloadIconButton {
    width: 38px;
    min-width: 38px;
    height: 38px;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: #151a45;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    line-height: 1;
    box-shadow: none !important;
    transition: background-color 0.16s ease, color 0.16s ease, transform 0.16s ease;
}

.ZTSMServicePayloadIconButton:hover,
.ZTSMServicePayloadIconButton:focus {
    background: rgba(8, 24, 255, 0.08);
    color: #0818ff;
    transform: translateX(-2px);
    outline: none;
}

.ZTSMServicePayloadIconButton[aria-pressed="true"] {
    background: rgba(8, 24, 255, 0.12);
    color: #0818ff;
}

.ZTSMServicePayloadDrawer {
    position: fixed;
    top: 72px;
    right: 72px;
    bottom: 24px;
    z-index: 9997;
    width: min(760px, calc(100vw - 104px));
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgba(125, 130, 173, 0.35);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 18px 48px rgba(10, 16, 48, 0.24);
    opacity: 0;
    pointer-events: none;
    transform: translateX(24px);
    transition: opacity 0.18s ease, transform 0.18s ease;
}

.ZTSMServicePayloadDrawer.ZTSMServicePayloadDrawerOpen {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(0);
}

.ZTSMServicePayloadDrawerHeader,
.ZTSMServicePayloadDrawerFooter {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 14px;
    border-color: rgba(125, 130, 173, 0.22);
}

.ZTSMServicePayloadDrawerHeader {
    border-bottom: 1px solid rgba(125, 130, 173, 0.22);
}

.ZTSMServicePayloadDrawerTitle {
    flex: 1 1 auto;
    color: #151a45;
    font-size: 14px;
    font-weight: 600;
    line-height: 20px;
}

.ZTSMServicePayloadDrawerFooter {
    border-top: 1px solid rgba(125, 130, 173, 0.22);
    justify-content: flex-end;
}

.ZTSMServicePayloadDrawerButton {
    min-height: 0;
    padding: 7px 12px;
    border: 1px solid rgba(125, 130, 173, 0.38);
    border-radius: 7px;
    background: #fff;
    color: #151a45;
    cursor: pointer;
    font-size: 13px;
    line-height: 18px;
    box-shadow: none !important;
}

.ZTSMServicePayloadDrawerButton:hover,
.ZTSMServicePayloadDrawerButton:focus {
    border-color: #0818ff;
    color: #0818ff;
    outline: none;
}

.ZTSMServicePayloadDrawerButtonPrimary {
    border-color: #0818ff;
    background: #0818ff;
    color: #fff;
}

.ZTSMServicePayloadDrawerButtonPrimary:hover,
.ZTSMServicePayloadDrawerButtonPrimary:focus {
    background: #0512c8;
    color: #fff;
}

.ZTSMServicePayloadCode {
    flex: 1 1 auto;
    width: 100%;
    min-height: 240px;
    height: 100%;
    border: 0;
    border-radius: 0;
    box-sizing: border-box;
    font-family: Consolas, Monaco, monospace;
    font-size: 13px;
    line-height: 1.45;
    overflow: auto;
    resize: none;
    padding: 14px;
    background: #fbfbfe;
    color: #20233f;
}

.ZTSMServicePayloadStatus {
    flex: 1 1 auto;
    color: #5b6078;
    text-align: left;
    font-size: 12px;
    line-height: 18px;
}

.ZTSMServicePayloadToast {
    position: absolute;
    right: 52px;
    top: 50%;
    width: max-content;
    max-width: 220px;
    padding: 6px 9px;
    border: 1px solid rgba(125, 130, 173, 0.28);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 8px 22px rgba(10, 16, 48, 0.16);
    color: #303452;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-50%) translateX(6px);
    transition: opacity 0.16s ease, transform 0.16s ease;
}

.ZTSMServicePayloadToast.ZTSMServicePayloadToastVisible {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
}



/* ZTSM richtext CKEditor header final cleanup
 * Final DOM target:
 * .ck-editor__top[role="presentation"]
 *   > .Tooltip.oooTooltip.ZTSMServiceExtensionRichTextInlineHelp
 *       > label + i + .Content
 *   > .ck-sticky-panel
 */
#NewCustomerTicket .ZTSMServiceExtensionField .ck-editor__top[role="presentation"],
#NewCustomerTicket .ZTSMServiceExtensionField .ck-editor__top {
    display: flex !important;
    flex-direction: column !important;
    align-items: stretch !important;
    background: #fff !important;
    width: 100% !important;
    max-width: none !important;
    min-width: 0 !important;
    box-sizing: border-box !important;
    overflow: visible !important;
}

#NewCustomerTicket .ZTSMServiceExtensionField .ck-editor__top[role="presentation"] > .Tooltip.oooTooltip.ZTSMServiceExtensionRichTextInlineHelp,
#NewCustomerTicket .ZTSMServiceExtensionField .ck-editor__top > .Tooltip.oooTooltip.ZTSMServiceExtensionRichTextInlineHelp {
    order: -1 !important;
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 12px !important;
    position: relative !important;
    top: auto !important;
    left: auto !important;
    right: auto !important;
    bottom: auto !important;
    width: 100% !important;
    max-width: none !important;
    min-width: 0 !important;
    min-height: 34px !important;
    margin: 0 !important;
    padding: 6px 10px !important;
    background: #fff !important;
    border: 1px solid #c9ccd7 !important;
    border-bottom: 0 !important;
    border-radius: 8px 8px 0 0 !important;
    box-sizing: border-box !important;
    transform: none !important;
    float: none !important;
    overflow: visible !important;
    z-index: 3 !important;
}

#NewCustomerTicket .ZTSMServiceExtensionField .ck-editor__top[role="presentation"] > .Tooltip.oooTooltip.ZTSMServiceExtensionRichTextInlineHelp > label,
#NewCustomerTicket .ZTSMServiceExtensionField .ck-editor__top > .Tooltip.oooTooltip.ZTSMServiceExtensionRichTextInlineHelp > label {
    display: inline-flex !important;
    align-items: center !important;
    flex: 1 1 auto !important;
    min-width: 0 !important;
    width: auto !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    color: #7f809d !important;
    font-size: 10px !important;
    font-weight: 600 !important;
    line-height: 1.3 !important;
    text-align: left !important;
    white-space: normal !important;
    overflow-wrap: anywhere !important;
    position: relative !important;
    top: auto !important;
    left: auto !important;
    right: auto !important;
    bottom: auto !important;
    transform: none !important;
    pointer-events: auto !important;
}

#NewCustomerTicket .ZTSMServiceExtensionField .ck-editor__top[role="presentation"] > .Tooltip.oooTooltip.ZTSMServiceExtensionRichTextInlineHelp > i,
#NewCustomerTicket .ZTSMServiceExtensionField .ck-editor__top > .Tooltip.oooTooltip.ZTSMServiceExtensionRichTextInlineHelp > i {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    flex: 0 0 auto !important;
    margin: 0 0 0 auto !important;
    padding: 0 !important;
    color: #00063d !important;
    cursor: help !important;
    position: relative !important;
    z-index: 4 !important;
}

#NewCustomerTicket .ZTSMServiceExtensionField .ck-editor__top[role="presentation"] > .Tooltip.oooTooltip.ZTSMServiceExtensionRichTextInlineHelp > .Content,
#NewCustomerTicket .ZTSMServiceExtensionField .ck-editor__top > .Tooltip.oooTooltip.ZTSMServiceExtensionRichTextInlineHelp > .Content {
    display: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
    position: absolute !important;
    top: calc(100% + 6px) !important;
    left: 0 !important;
    right: auto !important;
    width: min(720px, 100%) !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 12px 14px !important;
    color: #00063d !important;
    background: #fff !important;
    border: 1px solid #c9ccd7 !important;
    border-radius: 8px !important;
    box-shadow: 0 10px 28px rgba(10, 16, 48, 0.18) !important;
    white-space: normal !important;
    overflow-wrap: anywhere !important;
    word-break: normal !important;
    line-height: 1.45 !important;
    box-sizing: border-box !important;
    z-index: 9999 !important;
}

/* Override legacy OTOBO tooltip rule; do not show help when hovering the whole header row. */
#NewCustomerTicket .ZTSMServiceExtensionField .ck-editor__top[role="presentation"] > .Tooltip.oooTooltip.ZTSMServiceExtensionRichTextInlineHelp:hover > .Content,
#NewCustomerTicket .ZTSMServiceExtensionField .ck-editor__top > .Tooltip.oooTooltip.ZTSMServiceExtensionRichTextInlineHelp:hover > .Content,
#NewCustomerTicket .ZTSMServiceExtensionField .ZTSMServiceExtensionRichTextInlineHelp:hover > .Content,
#NewCustomerTicket .ZTSMServiceExtensionField .ZTSMServiceExtensionRichTextInlineHelp:focus-within > .Content {
    display: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
}

/* Show only when the help icon is intentionally hovered/focused. Works because JS keeps order: label, i, .Content. */
#NewCustomerTicket .ZTSMServiceExtensionField .ck-editor__top[role="presentation"] > .Tooltip.oooTooltip.ZTSMServiceExtensionRichTextInlineHelp > i:hover + .Content,
#NewCustomerTicket .ZTSMServiceExtensionField .ck-editor__top[role="presentation"] > .Tooltip.oooTooltip.ZTSMServiceExtensionRichTextInlineHelp > i:focus + .Content,
#NewCustomerTicket .ZTSMServiceExtensionField .ck-editor__top > .Tooltip.oooTooltip.ZTSMServiceExtensionRichTextInlineHelp > i:hover + .Content,
#NewCustomerTicket .ZTSMServiceExtensionField .ck-editor__top > .Tooltip.oooTooltip.ZTSMServiceExtensionRichTextInlineHelp > i:focus + .Content,
#NewCustomerTicket .ZTSMServiceExtensionField .ck-editor__top[role="presentation"] > .Tooltip.oooTooltip.ZTSMServiceExtensionRichTextInlineHelp > .Content:hover,
#NewCustomerTicket .ZTSMServiceExtensionField .ck-editor__top > .Tooltip.oooTooltip.ZTSMServiceExtensionRichTextInlineHelp > .Content:hover {
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
}

#NewCustomerTicket .ZTSMServiceExtensionField .ZTSMServiceExtensionRichTextInlineHelp > label .Marker {
    display: inline !important;
    margin-left: 2px !important;
    color: #7f809d !important;
    font-size: 10px !important;
    font-weight: 600 !important;
    line-height: 1.3 !important;
}

#NewCustomerTicket .ZTSMServiceExtensionField .ZTSMServiceExtensionRichTextInlineHelp > .Content,
#NewCustomerTicket .ZTSMServiceExtensionField .ZTSMServiceExtensionRichTextInlineHelp > .Content * {
    max-width: 100% !important;
    white-space: normal !important;
    overflow-wrap: anywhere !important;
    word-break: break-word !important;
    box-sizing: border-box !important;
}

@media (max-width: 720px) {
    .ZTSMServicePayloadTools {
        right: 10px;
    }

    .ZTSMServicePayloadDrawer {
        top: 72px;
        right: 58px;
        bottom: 16px;
        width: calc(100vw - 74px);
    }

}
</style>
<input type="hidden" name="ZTSMServiceBrowserTimezoneOffset" value="" />
<input type="hidden" name="ZTSMServiceSubmitTraceID" value="" />
<script type="text/javascript" src="[% Config("Frontend::JavaScriptPath") %]thirdparty/sheetjs-0.20.3/xlsx.full.min.js"></script>
<script>
(function () {
    "use strict";

    function ZTSMFirst(Selector) {
        return document.querySelector(Selector);
    }

    function ZTSMServiceElement() {
        return ZTSMFirst('select#ServiceID, select[name="ServiceID"]')
            || ZTSMFirst('input[type="hidden"]#ServiceID, input[type="hidden"][name="ServiceID"]')
            || ZTSMFirst('#ServiceID, input[name="ServiceID"]');
    }

    function ZTSMServiceExtensionValue() {
        var Service = ZTSMServiceElement();

        if (!Service) {
            return '';
        }

        return Service.value || '';
    }

    function ZTSMServiceExtensionPreferenceTargets() {
        return [
            {
                label: 'Application',
                name: 'ZTicket-Application'
            },
            {
                label: 'Environment',
                name: 'ZTicket-Env'
            },
            {
                label: 'Location',
                name: 'ZTicket-Location'
            }
        ];
    }

    function ZTSMServiceExtensionPreferenceFieldFind(Root, FieldName) {
        var Selectors = [
                '[name="DynamicField_' + FieldName + '"]',
                '[id="DynamicField_' + FieldName + '"]',
                '[name="Autocomplete_DynamicField_' + FieldName + '"]',
                '[id="Autocomplete_DynamicField_' + FieldName + '"]',
                '[name="' + FieldName + '"]',
                '[id="' + FieldName + '"]'
            ],
            Element = null;

        Root = Root || document;

        Selectors.some(function (Selector) {
            try {
                Element = Root.querySelector(Selector);
            }
            catch (Error) {
                Element = null;
            }
            return !!Element;
        });

        return Element;
    }

    function ZTSMServiceExtensionPreferenceFieldSnapshot(Root, FieldName) {
        var Element = ZTSMServiceExtensionPreferenceFieldFind(Root, FieldName),
            SelectedOptions = [],
            JQueryValue,
            RenderedValues = [],
            Container,
            ContainerText = '';

        if (!Element) {
            return {
                exists: false
            };
        }

        if (Element.options) {
            SelectedOptions = Array.prototype.filter.call(Element.options, function (Option) {
                return Option.selected;
            }).map(function (Option) {
                return {
                    value: Option.value,
                    text: String(Option.text || '').trim()
                };
            });
        }

        if (window.jQuery) {
            try {
                JQueryValue = window.jQuery(Element).val();
            }
            catch (Error) {
                JQueryValue = 'jQuery.val() failed: ' + Error.message;
            }
        }

        RenderedValues = ZTSMServicePayloadRenderedSelectionValues(Element);
        Container = Element.closest ? Element.closest('.ZTSMServiceExtensionField, .Row_DynamicField, .FieldCell') : null;
        ContainerText = Container ? String(Container.textContent || '').replace(/\s+/g, ' ').trim().slice(0, 300) : '';

        return {
            exists: true,
            tagName: Element.tagName,
            type: Element.type || '',
            id: Element.id || '',
            name: Element.name || '',
            nativeValue: Element.value || '',
            jqueryValue: JQueryValue,
            selectedOptions: SelectedOptions,
            renderedValues: RenderedValues,
            containerText: ContainerText
        };
    }

    function ZTSMServiceExtensionPreferenceSnapshot(Root) {
        var Snapshot = {};

        ZTSMServiceExtensionPreferenceTargets().forEach(function (Target) {
            Snapshot[Target.label] = ZTSMServiceExtensionPreferenceFieldSnapshot(Root, Target.name);
        });

        return Snapshot;
    }

    function ZTSMServiceExtensionPreferenceFormDataSnapshot(Data) {
        var Snapshot = {};

        ZTSMServiceExtensionPreferenceTargets().forEach(function (Target) {
            var Key = 'DynamicField_' + Target.name;

            Snapshot[Target.label] = {
                key: Key,
                values: Data && typeof Data.getAll === 'function' ? Data.getAll(Key) : []
            };
        });

        return Snapshot;
    }

    function ZTSMServiceExtensionPreferenceResponseSnapshot(HTML) {
        var Container = document.createElement('div');

        Container.innerHTML = HTML || '';

        return ZTSMServiceExtensionPreferenceSnapshot(Container);
    }

    function ZTSMServiceExtensionRequesterDefaultsDebug(HTML) {
        var Container = document.createElement('div'),
            Node;

        Container.innerHTML = HTML || '';
        Node = Container.querySelector('#ZTSMRequesterDefaultsDebug');

        if (!Node) {
            return {
                exists: false
            };
        }

        try {
            return {
                exists: true,
                data: JSON.parse(Node.textContent || '{}')
            };
        }
        catch (Error) {
            return {
                exists: true,
                parseError: Error.message,
                raw: Node.textContent || ''
            };
        }
    }

    function ZTSMServiceExtensionRefresh(Options) {
        var Form = ZTSMFirst('#NewCustomerTicket'),
            Start = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsStart'),
            End = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsEnd'),
            Request,
            Data;

        if (!Form || !Start || !End) {
            if (window.console && typeof window.console.error === 'function') {
                window.console.error('[TESSERA service-extension]', 'refresh-missing-node', {
                    hasForm: !!Form,
                    hasStart: !!Start,
                    hasEnd: !!End
                });
            }
            return;
        }

        if (ZTSMServicePayloadDebugEnabled()) {
            window.console.log('[TESSERA service-extension]', 'refresh-start', {
                serviceID: ZTSMServiceExtensionValue(),
                requesterID: (Form.querySelector('[name="ZTSMRaiseOnBehalfCustomerUserID"]') || {}).value || '',
                elementChanged: Options && Options.ElementChanged ? Options.ElementChanged : '',
                currentValues: ZTSMServiceExtensionPreferenceSnapshot(document)
            });
        }

        Data = new FormData(Form);
        Data.delete('Action');
        Data.delete('Subaction');
        Data.delete('ElementChanged');
        Data.delete('ServiceID');
        Data.append('Action', 'CustomerTicketMessage');
        Data.append('Subaction', 'ZTSMServiceExtensionDynamicFields');
        Data.append('ServiceID', ZTSMServiceExtensionValue());
        if (Options && Options.ElementChanged) {
            Data.append('ElementChanged', Options.ElementChanged);
        }
        if (Options && Options.ElementChanged === 'ZTSMRaiseOnBehalfCustomerUserID') {
            ZTSMServiceExtensionPreferenceTargets().forEach(function (Target) {
                Data.delete('DynamicField_' + Target.name);
            });
        }

        if (ZTSMServicePayloadDebugEnabled()) {
            window.console.log('[TESSERA service-extension]', 'refresh-request-values', {
                requesterID: Data.get('ZTSMRaiseOnBehalfCustomerUserID') || '',
                elementChanged: Data.get('ElementChanged') || '',
                postedValues: ZTSMServiceExtensionPreferenceFormDataSnapshot(Data)
            });
        }

        Request = new XMLHttpRequest();
        Request.open('POST', Form.getAttribute('action') || '[% Env("CGIHandle") %]', true);
        Request.onreadystatechange = function () {
            if (Request.readyState !== 4) {
                return;
            }
            if (Request.status < 200 || Request.status >= 300) {
                if (window.console && typeof window.console.error === 'function') {
                    window.console.error('[TESSERA service-extension]', 'refresh-http-error', {
                        status: Request.status,
                        responseText: (Request.responseText || '').slice(0, 500)
                    });
                }
                return;
            }

            if (ZTSMServicePayloadDebugEnabled()) {
                window.console.log('[TESSERA service-extension]', 'refresh-response', {
                    status: Request.status,
                    length: (Request.responseText || '').length,
                    responseValues: ZTSMServiceExtensionPreferenceResponseSnapshot(Request.responseText || ''),
                    backendDefaults: ZTSMServiceExtensionRequesterDefaultsDebug(Request.responseText || '')
                });
            }
            ZTSMServiceExtensionReplace(Start, End, Request.responseText || '');
        };
        Request.send(Data);
    }

    window.ZTSMServiceExtensionRefresh = ZTSMServiceExtensionRefresh;
    window.ZTSMServiceExtensionPreferenceSnapshot = ZTSMServiceExtensionPreferenceSnapshot;

    window.ZTSMRichTextMoveNow = function () {
        var Start = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsStart'),
            End = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsEnd');

        if (Start && End) {
            ZTSMServiceExtensionRichTextPrepare(Start, End);
        }
    };


    function ZTSMServiceExtensionReplace(Start, End, HTML) {
        var Node = Start.nextSibling,
            Next;

        while (Node && Node !== End) {
            Next = Node.nextSibling;
            Node.parentNode.removeChild(Node);
            Node = Next;
        }

        End.insertAdjacentHTML('beforebegin', HTML);
        ZTSMServiceExtensionMark(Start, End);
        ZTSMServiceExtensionLayoutFix(Start, End);
        ZTSMServiceExtensionInitialize(Start, End);
        ZTSMServicePayloadToolsEnsure(Start, End);
        if (window.ZTSMReferencePickerEnhance) {
            window.ZTSMReferencePickerEnhance(Start.parentNode || document);
        }
    }

    function ZTSMServiceExtensionHasRenderedRows(Start, End) {
        var Node = Start ? Start.nextSibling : null;

        while (Node && Node !== End) {
            if (Node.nodeType === 1 && Node.classList && Node.classList.contains('Row_DynamicField')) {
                return true;
            }
            Node = Node.nextSibling;
        }

        return false;
    }

    function ZTSMServiceExtensionMark(Start, End) {
        var Node = Start.nextSibling;

        while (Node && Node !== End) {
            if (Node.nodeType === 1 && Node.classList && Node.classList.contains('Row_DynamicField')) {
                Node.classList.add('ZTSMServiceExtensionField');
                if (Node.querySelector && Node.querySelector('.Field.RichTextField, .Field.RichText')) {
                    Node.classList.add('ZTSMServiceExtensionRichTextRow');
                }
            }
            Node = Node.nextSibling;
        }
    }

    function ZTSMServiceExtensionRichTextChromeTarget(Holder) {
        var Editor = Holder ? Holder.querySelector('.ck.ck-editor, .ck-editor') : null;

        if (!Editor) {
            return null;
        }

        /* Strict target: only CKEditor top chrome.
         * Never return RichTextHolder and never return ck-sticky-panel.
         */
        return Editor.querySelector('.ck-editor__top[role="presentation"], .ck-editor__top');
    }

    function ZTSMServiceExtensionRichTextLabelFind(Cell, Textarea) {
        var TextareaID = Textarea ? Textarea.id : '',
            Labels = Cell ? Cell.querySelectorAll('label') : [],
            Match = null;

        Array.prototype.some.call(Labels, function (Candidate) {
            var ForValue = Candidate.getAttribute('for') || '',
                IDValue = Candidate.id || '';

            if (Candidate.classList && Candidate.classList.contains('ck-voice-label')) {
                return false;
            }

            if (TextareaID && ForValue === TextareaID) {
                Match = Candidate;
                return true;
            }

            if (IDValue.indexOf('LabelDynamicField_') === 0) {
                Match = Candidate;
                return true;
            }

            return false;
        });

        return Match;
    }

    function ZTSMServiceExtensionRichTextTooltipFind(Cell, Holder) {
        var Tooltip = null;

        if (Holder) {
            Tooltip = Holder.querySelector(':scope > .Tooltip.oooTooltip.ZTSMServiceExtensionRichTextInlineHelp')
                || Holder.querySelector(':scope > .Tooltip.oooTooltip')
                || Holder.querySelector('.Tooltip.oooTooltip.ZTSMServiceExtensionRichTextInlineHelp')
                || Holder.querySelector('.Tooltip.oooTooltip');
        }

        if (!Tooltip && Cell) {
            Tooltip = Cell.querySelector(':scope > .Tooltip.oooTooltip.ZTSMServiceExtensionRichTextInlineHelp')
                || Cell.querySelector(':scope > .Tooltip.oooTooltip')
                || Cell.querySelector('.Tooltip.oooTooltip.ZTSMServiceExtensionRichTextInlineHelp')
                || Cell.querySelector('.Tooltip.oooTooltip');
        }

        return Tooltip;
    }


    function ZTSMServiceExtensionRichTextTopInsert(Target, Node) {
        var StickyPanel;

        if (!Target || !Node) {
            return false;
        }

        StickyPanel = Target.querySelector(':scope > .ck-sticky-panel');

        if (StickyPanel && StickyPanel !== Node) {
            Target.insertBefore(Node, StickyPanel);
            return true;
        }

        if (Target.firstElementChild !== Node) {
            Target.insertBefore(Node, Target.firstElementChild || null);
            return true;
        }

        return false;
    }

    function ZTSMServiceExtensionRichTextReflow(Holder) {
        if (!Holder || !window.jQuery) {
            return;
        }

        /* OTOBO 11.1 measures CKEditor before TESSERA adds its caption to
         * .ck-editor__top. Re-run the holder's native resize handler after
         * that DOM move so the editable area and following Set rows reflow
         * from the live toolbar height. This preserves user resizing.
         */
        window.requestAnimationFrame(function () {
            window.jQuery(Holder).triggerHandler('resize');
        });
    }

    function ZTSMServiceExtensionRichTextTooltipNormalize(Tooltip) {
        var Icon,
            Content;

        if (!Tooltip) {
            return;
        }

        Tooltip.classList.add('ZTSMServiceExtensionRichTextInlineHelp');

        Icon = Tooltip.querySelector(':scope > i') || Tooltip.querySelector('i');
        Content = Tooltip.querySelector(':scope > .Content') || Tooltip.querySelector('.Content');

        if (Icon) {
            Icon.setAttribute('role', 'button');
            Icon.setAttribute('tabindex', '0');
            Icon.setAttribute('aria-label', 'Show field help');
            if (Icon.parentNode !== Tooltip) {
                Tooltip.appendChild(Icon);
            }
        }

        if (Content && Content.parentNode !== Tooltip) {
            Tooltip.appendChild(Content);
        }
        else if (Content && Icon && Content.previousElementSibling !== Icon) {
            Tooltip.insertBefore(Content, Icon.nextSibling);
        }
    }

    function ZTSMServiceExtensionStyleSet(Node, Name, Value) {
        if (Node && Node.style) {
            Node.style.setProperty(Name, Value, 'important');
        }
    }


    function ZTSMServiceExtensionRichTextContentWrapApply(Content) {
        if (!Content || !Content.querySelectorAll) {
            return;
        }

        ZTSMServiceExtensionStyleSet(Content, 'overflow', 'hidden');
        ZTSMServiceExtensionStyleSet(Content, 'overflow-x', 'hidden');
        ZTSMServiceExtensionStyleSet(Content, 'max-inline-size', '100%');
        ZTSMServiceExtensionStyleSet(Content, 'contain', 'layout paint');

        Array.prototype.forEach.call(Content.querySelectorAll('*'), function (Node) {
            ZTSMServiceExtensionStyleSet(Node, 'max-width', '100%');
            ZTSMServiceExtensionStyleSet(Node, 'white-space', 'normal');
            ZTSMServiceExtensionStyleSet(Node, 'overflow-wrap', 'anywhere');
            ZTSMServiceExtensionStyleSet(Node, 'word-break', 'break-word');
            ZTSMServiceExtensionStyleSet(Node, 'box-sizing', 'border-box');
        });

        Array.prototype.forEach.call(Content.querySelectorAll('p, div, li'), function (Node) {
            ZTSMServiceExtensionStyleSet(Node, 'margin-left', '0');
            ZTSMServiceExtensionStyleSet(Node, 'margin-right', '0');
        });
    }

    function ZTSMServiceExtensionRichTextTooltipStyleApply(Tooltip) {
        var Label = Tooltip ? Tooltip.querySelector(':scope > label') : null,
            Icon = Tooltip ? Tooltip.querySelector(':scope > i') : null,
            Content = Tooltip ? Tooltip.querySelector(':scope > .Content') : null,
            MandatoryStar = null,
            Show,
            Hide;

        if (!Tooltip) {
            return;
        }

        ZTSMServiceExtensionStyleSet(Tooltip, 'display', 'flex');
        ZTSMServiceExtensionStyleSet(Tooltip, 'flex-direction', 'row');
        ZTSMServiceExtensionStyleSet(Tooltip, 'align-items', 'center');
        ZTSMServiceExtensionStyleSet(Tooltip, 'justify-content', 'space-between');
        ZTSMServiceExtensionStyleSet(Tooltip, 'gap', '12px');
        ZTSMServiceExtensionStyleSet(Tooltip, 'position', 'relative');
        ZTSMServiceExtensionStyleSet(Tooltip, 'top', 'auto');
        ZTSMServiceExtensionStyleSet(Tooltip, 'left', 'auto');
        ZTSMServiceExtensionStyleSet(Tooltip, 'right', 'auto');
        ZTSMServiceExtensionStyleSet(Tooltip, 'bottom', 'auto');
        ZTSMServiceExtensionStyleSet(Tooltip, 'width', '100%');
        ZTSMServiceExtensionStyleSet(Tooltip, 'max-width', 'none');
        ZTSMServiceExtensionStyleSet(Tooltip, 'min-width', '0');
        ZTSMServiceExtensionStyleSet(Tooltip, 'min-height', '34px');
        ZTSMServiceExtensionStyleSet(Tooltip, 'margin', '0');
        ZTSMServiceExtensionStyleSet(Tooltip, 'padding', '6px 10px');
        ZTSMServiceExtensionStyleSet(Tooltip, 'background', '#fff');
        ZTSMServiceExtensionStyleSet(Tooltip, 'border', '1px solid #c9ccd7');
        ZTSMServiceExtensionStyleSet(Tooltip, 'border-bottom', '0');
        ZTSMServiceExtensionStyleSet(Tooltip, 'border-radius', '8px 8px 0 0');
        ZTSMServiceExtensionStyleSet(Tooltip, 'box-sizing', 'border-box');
        ZTSMServiceExtensionStyleSet(Tooltip, 'transform', 'none');
        ZTSMServiceExtensionStyleSet(Tooltip, 'float', 'none');
        ZTSMServiceExtensionStyleSet(Tooltip, 'overflow', 'visible');
        ZTSMServiceExtensionStyleSet(Tooltip, 'z-index', '3');

        if (Label) {
            ZTSMServiceExtensionStyleSet(Label, 'display', 'inline-flex');
            ZTSMServiceExtensionStyleSet(Label, 'align-items', 'center');
            ZTSMServiceExtensionStyleSet(Label, 'flex', '1 1 auto');
            ZTSMServiceExtensionStyleSet(Label, 'min-width', '0');
            ZTSMServiceExtensionStyleSet(Label, 'width', 'auto');
            ZTSMServiceExtensionStyleSet(Label, 'margin', '0');
            ZTSMServiceExtensionStyleSet(Label, 'padding', '0');
            ZTSMServiceExtensionStyleSet(Label, 'color', '#7f809d');
            ZTSMServiceExtensionStyleSet(Label, 'font-size', '10px');
            ZTSMServiceExtensionStyleSet(Label, 'font-weight', '600');
            ZTSMServiceExtensionStyleSet(Label, 'line-height', '1.3');
            ZTSMServiceExtensionStyleSet(Label, 'letter-spacing', '0.5px');
            ZTSMServiceExtensionStyleSet(Label, 'white-space', 'normal');
            ZTSMServiceExtensionStyleSet(Label, 'overflow-wrap', 'anywhere');
            ZTSMServiceExtensionStyleSet(Label, 'position', 'relative');
            ZTSMServiceExtensionStyleSet(Label, 'transform', 'none');
            MandatoryStar = Label.querySelector(':scope > .Marker');
            if (MandatoryStar) {
                ZTSMServiceExtensionStyleSet(MandatoryStar, 'display', 'inline');
                ZTSMServiceExtensionStyleSet(MandatoryStar, 'margin-left', '2px');
                ZTSMServiceExtensionStyleSet(MandatoryStar, 'color', '#7f809d');
                ZTSMServiceExtensionStyleSet(MandatoryStar, 'font-size', '10px');
                ZTSMServiceExtensionStyleSet(MandatoryStar, 'font-weight', '600');
                ZTSMServiceExtensionStyleSet(MandatoryStar, 'line-height', '1.3');
                ZTSMServiceExtensionStyleSet(MandatoryStar, 'letter-spacing', '0.5px');
            }
        }

        if (Icon) {
            ZTSMServiceExtensionStyleSet(Icon, 'display', 'inline-flex');
            ZTSMServiceExtensionStyleSet(Icon, 'align-items', 'center');
            ZTSMServiceExtensionStyleSet(Icon, 'justify-content', 'center');
            ZTSMServiceExtensionStyleSet(Icon, 'flex', '0 0 auto');
            ZTSMServiceExtensionStyleSet(Icon, 'margin', '0 0 0 auto');
            ZTSMServiceExtensionStyleSet(Icon, 'padding', '0');
            ZTSMServiceExtensionStyleSet(Icon, 'color', '#00063d');
            ZTSMServiceExtensionStyleSet(Icon, 'cursor', 'help');
            ZTSMServiceExtensionStyleSet(Icon, 'position', 'relative');
            ZTSMServiceExtensionStyleSet(Icon, 'z-index', '4');
        }

        if (Content) {
            Hide = function () {
                ZTSMServiceExtensionStyleSet(Content, 'display', 'none');
                ZTSMServiceExtensionStyleSet(Content, 'visibility', 'hidden');
                ZTSMServiceExtensionStyleSet(Content, 'opacity', '0');
            };
            Show = function () {
                ZTSMServiceExtensionStyleSet(Content, 'display', 'block');
                ZTSMServiceExtensionStyleSet(Content, 'visibility', 'visible');
                ZTSMServiceExtensionStyleSet(Content, 'opacity', '1');
            };

            ZTSMServiceExtensionStyleSet(Content, 'position', 'absolute');
            ZTSMServiceExtensionStyleSet(Content, 'top', 'calc(100% + 6px)');
            ZTSMServiceExtensionStyleSet(Content, 'left', '0');
            ZTSMServiceExtensionStyleSet(Content, 'right', 'auto');
            ZTSMServiceExtensionStyleSet(Content, 'width', 'calc(100% - 20px)');
            ZTSMServiceExtensionStyleSet(Content, 'max-width', 'calc(100% - 20px)');
            ZTSMServiceExtensionStyleSet(Content, 'margin', '0');
            ZTSMServiceExtensionStyleSet(Content, 'padding', '14px 18px');
            ZTSMServiceExtensionStyleSet(Content, 'color', '#00063d');
            ZTSMServiceExtensionStyleSet(Content, 'background', '#fff');
            ZTSMServiceExtensionStyleSet(Content, 'border', '1px solid #c9ccd7');
            ZTSMServiceExtensionStyleSet(Content, 'border-radius', '8px');
            ZTSMServiceExtensionStyleSet(Content, 'box-shadow', '0 10px 28px rgba(10, 16, 48, 0.18)');
            ZTSMServiceExtensionStyleSet(Content, 'white-space', 'normal');
            ZTSMServiceExtensionStyleSet(Content, 'overflow-wrap', 'anywhere');
            ZTSMServiceExtensionStyleSet(Content, 'word-break', 'break-word');
            ZTSMServiceExtensionStyleSet(Content, 'line-height', '1.45');
            ZTSMServiceExtensionStyleSet(Content, 'box-sizing', 'border-box');
            ZTSMServiceExtensionStyleSet(Content, 'z-index', '9999');
            ZTSMServiceExtensionRichTextContentWrapApply(Content);
            Hide();

            if (!Tooltip.dataset.ZTSMRichTextHelpBound) {
                Tooltip.dataset.ZTSMRichTextHelpBound = '1';
                if (Icon) {
                    Icon.addEventListener('mouseenter', Show);
                    Icon.addEventListener('focus', Show);
                    Icon.addEventListener('mouseleave', function () {
                        window.setTimeout(function () {
                            if (!Content.matches(':hover')) {
                                Hide();
                            }
                        }, 120);
                    });
                    Icon.addEventListener('blur', function () {
                        window.setTimeout(function () {
                            if (!Content.matches(':hover')) {
                                Hide();
                            }
                        }, 120);
                    });
                }
                Content.addEventListener('mouseenter', Show);
                Content.addEventListener('mouseleave', Hide);
            }
        }
    }

    function ZTSMServiceExtensionRichTextPrepare(Start, End) {
        var Root = Start && End ? Start.parentNode : document,
            Fields;

        if (!Root) {
            return;
        }

        Fields = Root.querySelectorAll('.ZTSMServiceExtensionField .Field.RichTextField, .ZTSMServiceExtensionField .Field.RichText');

        Array.prototype.forEach.call(Fields, function (Field) {
            var Cell = Field.closest ? Field.closest('.FieldCell') : null,
                Holder = Field.querySelector('.RichTextHolder'),
                Textarea = Field.querySelector('textarea.RichText'),
                Target = Holder ? ZTSMServiceExtensionRichTextChromeTarget(Holder) : null,
                Tooltip = null,
                Label = null,
                Captions = null;

            if (!Cell || !Holder || !Textarea) {
                return;
            }

            Cell.classList.add('ZTSMServiceExtensionRichTextCell');
            Field.classList.add('ZTSMServiceExtensionRichTextField');
            Field.classList.add('RichTextField');
            Textarea.classList.add('DynamicFieldRichText');
            Holder.style.setProperty('padding-top', '0', 'important');

            /* CKEditor creates .ck-editor__top after init.
             * If it is not ready yet, do nothing now; delayed calls will retry.
             */
            if (!Target) {
                return;
            }

            Label = ZTSMServiceExtensionRichTextLabelFind(Cell, Textarea);
            Tooltip = ZTSMServiceExtensionRichTextTooltipFind(Cell, Holder);

            if (Label) {
                Label.classList.add('ZTSMServiceExtensionRichTextLabel');
            }

            if (Tooltip) {
                ZTSMServiceExtensionRichTextTooltipNormalize(Tooltip);

                if (Label && Label.parentNode !== Tooltip) {
                    Tooltip.insertBefore(Label, Tooltip.firstChild);
                }

                ZTSMServiceExtensionRichTextTooltipNormalize(Tooltip);
                if (ZTSMServiceExtensionRichTextTopInsert(Target, Tooltip)) {
                    ZTSMServiceExtensionRichTextReflow(Holder);
                }
                ZTSMServiceExtensionRichTextTooltipStyleApply(Tooltip);
            }
            else if (Label) {
                if (ZTSMServiceExtensionRichTextTopInsert(Target, Label)) {
                    ZTSMServiceExtensionRichTextReflow(Holder);
                }
            }

            Captions = Cell.querySelectorAll('.ZTSMServiceExtensionRichTextCaption');
            Array.prototype.forEach.call(Captions, function (Caption) {
                if (!Caption.querySelector('label')) {
                    Caption.parentNode.removeChild(Caption);
                }
            });
        });
    }

    function ZTSMServiceExtensionRichTextEditorLabelEnsure(Cell, Holder, Textarea) {
        var ExistingLabel,
            SourceLabel,
            Label;

        if (!Cell || !Holder || !Textarea || !Textarea.id) {
            return;
        }

        ExistingLabel = Holder.querySelector('label[for^="RichText"]');
        if (ExistingLabel) {
            return;
        }

        SourceLabel = ZTSMServiceExtensionRichTextLabelFind(Cell, Textarea);
        Label = document.createElement('label');
        Label.setAttribute('for', 'RichText' + Textarea.id);
        Label.className = 'Hidden ZTSMServiceExtensionRichTextEditorLabel';
        Label.textContent = SourceLabel ? SourceLabel.textContent : (Textarea.getAttribute('title') || Textarea.name || Textarea.id);
        Holder.insertBefore(Label, Holder.firstChild || null);
    }

    function ZTSMServiceExtensionRichTextEditorsInit(Start, End) {
        var Root = Start && End ? Start.parentNode : document,
            Textareas;

        if (
            !Root
            || !window.Core
            || !Core.UI
            || !Core.UI.RichTextEditor
            || typeof Core.UI.RichTextEditor.InitEditor !== 'function'
            || !window.CKEditor5Wrapper
            || !window.jQuery
        ) {
            return;
        }

        Textareas = Root.querySelectorAll('.ZTSMServiceExtensionField textarea.RichText');
        Array.prototype.forEach.call(Textareas, function (Textarea) {
            var Holder = Textarea.closest ? Textarea.closest('.RichTextHolder') : null,
                Cell = Textarea.closest ? Textarea.closest('.FieldCell') : null;

            if (
                !Textarea.id
                || Textarea.classList.contains('HasCKEInstance')
                || Textarea.dataset.ZTSMRichTextInit === '1'
                || (Holder && Holder.querySelector('.ck.ck-editor, .ck-editor, .cke_chrome'))
            ) {
                return;
            }

            ZTSMServiceExtensionRichTextEditorLabelEnsure(Cell, Holder, Textarea);
            Textarea.classList.add('DynamicFieldRichText');
            Textarea.dataset.ZTSMRichTextInit = '1';

            ZTSMServiceExtensionSafeInit(function () {
                ZTSMServiceExtensionRichTextConfigEnsure();
                Core.UI.RichTextEditor.InitEditor(window.jQuery(Textarea));
            });
        });
    }

    function ZTSMServiceExtensionRichTextConfigEnsure() {
        var UserLanguage;

        if (!window.Core || !Core.Config || typeof Core.Config.Get !== 'function' || typeof Core.Config.Set !== 'function') {
            return;
        }

        UserLanguage = Core.Config.Get('UserLanguage');
        if (typeof UserLanguage === 'string' && UserLanguage) {
            return;
        }

        UserLanguage = (document.documentElement && document.documentElement.lang)
            || (window.navigator && (window.navigator.language || window.navigator.userLanguage))
            || 'en';
        Core.Config.Set('UserLanguage', UserLanguage);
    }

    function ZTSMServiceExtensionLayoutFix(Start, End) {
        var Root = Start && End ? Start.parentNode : document,
            Sets;

        if (!Root) {
            return;
        }

        Sets = Root.querySelectorAll('.ZTSMServiceExtensionField .DynamicFieldSetLayoutHorizontal');

        Array.prototype.forEach.call(Sets, function (Set) {
            var Row = Set.querySelector(':scope > .Row_DynamicField, :scope > .Row'),
                Outer = Set.closest('.ZTSMServiceExtensionField'),
                OuterField = Set.closest('.DFSetOuterField'),
                Viewport = Set.closest('.ZTSMFieldSetScrollViewport'),
                Cells;

            Set.dataset.ZTSMLayoutVersion = '20260706-richtext-label-wrap';

            if (!Viewport && OuterField) {
                Viewport = document.createElement('div');
                Viewport.className = 'ZTSMFieldSetScrollViewport';
                OuterField.insertBefore(Viewport, Set);
                Viewport.appendChild(Set);
            }

            if (Outer) {
                Outer.style.setProperty('width', '100%', 'important');
                Outer.style.setProperty('max-width', '1120px', 'important');
                Outer.style.setProperty('margin-left', 'auto', 'important');
                Outer.style.setProperty('margin-right', 'auto', 'important');
                Outer.style.setProperty('overflow', 'visible', 'important');
                Outer.style.setProperty('box-sizing', 'border-box', 'important');
            }

            if (OuterField) {
                OuterField.style.setProperty('width', '100%', 'important');
                OuterField.style.setProperty('max-width', '1120px', 'important');
                OuterField.style.setProperty('min-width', '0', 'important');
                OuterField.style.setProperty('margin-left', 'auto', 'important');
                OuterField.style.setProperty('margin-right', 'auto', 'important');
                OuterField.style.setProperty('overflow', 'visible', 'important');
                OuterField.style.setProperty('box-sizing', 'border-box', 'important');
            }

            if (Viewport) {
                ZTSMServiceExtensionViewportSize(Viewport);
                Viewport.style.setProperty('min-width', '0', 'important');
                Viewport.style.setProperty('min-inline-size', '0', 'important');
                Viewport.style.setProperty('overflow-x', 'auto', 'important');
                Viewport.style.setProperty('overflow-y', 'hidden', 'important');
                Viewport.style.setProperty('box-sizing', 'border-box', 'important');
                Viewport.style.setProperty('padding-bottom', '10px', 'important');
            }

            Set.style.removeProperty('width');
            Set.style.removeProperty('max-width');
            Set.style.removeProperty('min-width');
            Set.style.removeProperty('inline-size');
            Set.style.removeProperty('max-inline-size');
            Set.style.removeProperty('min-inline-size');
            Set.style.setProperty('width', '100%', 'important');
            Set.style.setProperty('inline-size', '100%', 'important');
            Set.style.setProperty('max-width', '1120px', 'important');
            Set.style.setProperty('max-inline-size', '1120px', 'important');
            Set.style.setProperty('min-width', '0', 'important');
            Set.style.setProperty('min-inline-size', '0', 'important');
            Set.style.setProperty('overflow', 'visible', 'important');
            Set.style.setProperty('box-sizing', 'border-box', 'important');
            Set.style.setProperty('padding-bottom', '10px', 'important');

            if (!Row) {
                return;
            }

            Row.dataset.ZTSMLayoutVersion = '20260706-richtext-label-wrap';

            Row.style.removeProperty('width');
            Row.style.removeProperty('max-width');
            Row.style.removeProperty('min-width');
            Row.style.removeProperty('overflow-x');
            Row.style.removeProperty('overflow-y');
            Row.style.setProperty('display', 'flex', 'important');
            Row.style.setProperty('flex-wrap', 'nowrap', 'important');
            Row.style.setProperty('align-items', 'stretch', 'important');
            Row.style.setProperty('gap', '10px', 'important');
            Row.style.setProperty('width', '100%', 'important');
            Row.style.setProperty('inline-size', '100%', 'important');
            Row.style.setProperty('min-width', '0', 'important');
            Row.style.setProperty('min-inline-size', '0', 'important');
            Row.style.setProperty('max-width', '100%', 'important');
            Row.style.setProperty('max-inline-size', '100%', 'important');
            Row.style.setProperty('overflow-x', 'auto', 'important');
            Row.style.setProperty('overflow-y', 'hidden', 'important');
            Row.style.setProperty('grid-template-columns', 'none', 'important');

            Cells = Row.querySelectorAll(':scope > .FieldCell');

            Array.prototype.forEach.call(Cells, function (Cell) {
                var MinWidth = Cell.classList.contains('DynamicFieldDate') || Cell.classList.contains('DynamicFieldDateTime') ? '210px' : '190px',
                    Flex = Cell.classList.contains('DynamicFieldDate') || Cell.classList.contains('DynamicFieldDateTime') ? '1.05 1 0' : '1 1 0';

                Cell.style.setProperty('flex', Flex, 'important');
                Cell.style.setProperty('width', 'auto', 'important');
                Cell.style.setProperty('min-width', MinWidth, 'important');
                Cell.style.setProperty('max-width', 'none', 'important');
            });
        });
    }

    function ZTSMServiceExtensionViewportSize(Viewport) {
        var Form = ZTSMFirst('#NewCustomerTicket'),
            FormRect,
            Width;

        if (!Viewport) {
            return;
        }

        if (Form && Form.getBoundingClientRect) {
            FormRect = Form.getBoundingClientRect();
            Width = Math.floor(FormRect.width - 24);
        }

        if (!Width || Width < 320) {
            Width = 960;
        }

        if (Width > 1120) {
            Width = 1120;
        }

        Viewport.style.setProperty('width', Width + 'px', 'important');
        Viewport.style.setProperty('inline-size', Width + 'px', 'important');
        Viewport.style.setProperty('max-width', '1120px', 'important');
        Viewport.style.setProperty('max-inline-size', '1120px', 'important');
    }

    function ZTSMServiceExtensionNestedIndexedAttributeSet(Node, Attribute, Index, ParentSetName) {
        var Value,
            ParentSetIndexName;

        if (!Node || !Node.getAttribute) {
            return false;
        }

        Value = Node.getAttribute(Attribute);

        if (!Value) {
            return false;
        }

        ParentSetIndexName = ParentSetName ? 'SetIndex_' + ParentSetName : '';
        if (ParentSetIndexName && Value === ParentSetIndexName) {
            return false;
        }

        if (/^SetIndex_/.test(Value) && /_(?:\d+|Template)$/.test(Value)) {
            Node.setAttribute(Attribute, Value.replace(/_(?:\d+|Template)$/, '_' + Index));
            return true;
        }

        if (
            /^(?:Autocomplete_)?DynamicField_|^LabelDynamicField_/.test(Value)
            && /_(?:\d+|Template)_(?:\d+|Template)([A-Za-z]*(?:\[\])?)?$/.test(Value)
        ) {
            Node.setAttribute(Attribute, Value.replace(/^(.+)_(?:\d+|Template)(_(?:\d+|Template)(?:[A-Za-z]*(?:\[\])?)?)$/, '$1_' + Index + '$2'));
            return true;
        }

        return false;
    }

    function ZTSMServiceExtensionIndexedAttributeSet(Node, Attribute, Index, ParentSetName) {
        var Value;

        if (!Node || !Node.getAttribute) {
            return;
        }

        if (ZTSMServiceExtensionNestedIndexedAttributeSet(Node, Attribute, Index, ParentSetName)) {
            return;
        }

        Value = Node.getAttribute(Attribute);

        if (!Value) {
            return;
        }

        Node.setAttribute(Attribute, Value.replace(/^(.+)_(?:\d+|Template)([A-Za-z]*(?:\[\])?)$/, '$1_' + Index + '$2'));
    }

    function ZTSMServiceExtensionRowIndexSet(Cell, Index, ParentSetName) {
        if (!Cell) {
            return;
        }

        Array.prototype.forEach.call(Cell.classList, function (ClassName) {
            if (/^MultiValue_(?:\d+|Template)$/.test(ClassName)) {
                Cell.classList.remove(ClassName);
            }
        });
        Cell.classList.add('MultiValue_' + Index);

        Array.prototype.forEach.call(Cell.querySelectorAll('[id], [name], label[for], [data-ztsm-reference-picker-for]'), function (Node) {
            ZTSMServiceExtensionIndexedAttributeSet(Node, 'id', Index, ParentSetName);
            ZTSMServiceExtensionIndexedAttributeSet(Node, 'name', Index, ParentSetName);
            ZTSMServiceExtensionIndexedAttributeSet(Node, 'for', Index, ParentSetName);
            ZTSMServiceExtensionIndexedAttributeSet(Node, 'data-ztsm-reference-picker-for', Index, ParentSetName);
        });
    }

    function ZTSMServiceExtensionNestedSetBaseName(Name) {
        Name = String(Name || '').replace(/^SetIndex_/, '');
        return Name.replace(/_(?:\d+|Template)$/, '');
    }

    function ZTSMServiceExtensionNestedRowIndexSet(Cell, SetName, ParentIndex, RowIndex) {
        var Prefix = SetName ? SetName.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') : '';

        if (!Cell || !SetName) {
            return;
        }

        Array.prototype.forEach.call(Cell.querySelectorAll('[id], [name], label[for], [data-ztsm-reference-picker-for]'), function (Node) {
            [ 'id', 'name', 'for', 'data-ztsm-reference-picker-for' ].forEach(function (Attribute) {
                var Value = Node.getAttribute && Node.getAttribute(Attribute),
                    NewValue;

                if (!Value) {
                    return;
                }

                if (Attribute === 'name' && Value.indexOf('SetIndex_') === 0) {
                    if (ZTSMServiceExtensionNestedSetBaseName(Value) === SetName) {
                        Node.setAttribute(Attribute, 'SetIndex_' + SetName + '_' + ParentIndex);
                    }
                    return;
                }

                NewValue = Value.replace(
                    new RegExp('^((?:Autocomplete_)?DynamicField_.+_' + Prefix + ')_(?:\\d+|Template)_(?:\\d+|Template)([A-Za-z]*(?:\\[\\])?)?$'),
                    '$1_' + ParentIndex + '_' + RowIndex + '$2'
                );
                NewValue = NewValue.replace(
                    new RegExp('^(LabelDynamicField_.+_' + Prefix + ')_(?:\\d+|Template)_(?:\\d+|Template)([A-Za-z]*(?:\\[\\])?)?$'),
                    '$1_' + ParentIndex + '_' + RowIndex + '$2'
                );

                if (NewValue !== Value) {
                    Node.setAttribute(Attribute, NewValue);
                }
            });
        });
    }

    function ZTSMServiceExtensionNestedSetIndexCompact(Root) {
        Root = Root || document;

        Array.prototype.forEach.call(Root.querySelectorAll('input[type="hidden"][name="SetIndex_ZCompute-VM"]'), function (VMInput) {
            var ParentIndex = VMInput.value,
                VMCell,
                Groups = {};

            if (ParentIndex === 'Template') {
                return;
            }

            VMCell = ZTSMServiceExtensionSetRowGet(VMInput);
            if (!VMCell) {
                return;
            }

            Array.prototype.forEach.call(VMCell.querySelectorAll('input[type="hidden"][name^="SetIndex_"]'), function (NestedInput) {
                var SetName,
                    RowCell,
                    IsTemplate;

                if (NestedInput === VMInput || NestedInput.name === 'SetIndex_ZCompute-VM') {
                    return;
                }

                SetName = ZTSMServiceExtensionNestedSetBaseName(NestedInput.name);
                if (!SetName) {
                    return;
                }

                RowCell = ZTSMServiceExtensionSetRowGet(NestedInput);
                IsTemplate = NestedInput.value === 'Template' || (RowCell && RowCell.classList.contains('MultiValue_Template'));
                if (!Groups[SetName]) {
                    Groups[SetName] = {
                        Rows: [],
                        Templates: []
                    };
                }

                if (IsTemplate || !RowCell || ZTSMServiceExtensionElementHidden(RowCell)) {
                    Groups[SetName].Templates.push({
                        Cell: RowCell,
                        Input: NestedInput
                    });
                    return;
                }

                if (!Groups[SetName].Rows.some(function (Row) { return Row.Cell === RowCell; })) {
                    Groups[SetName].Rows.push({
                        Cell: RowCell,
                        Input: NestedInput
                    });
                }
            });

            Object.keys(Groups).forEach(function (SetName) {
                Groups[SetName].Rows.forEach(function (Row, RowIndex) {
                    Row.Input.name = 'SetIndex_' + SetName + '_' + ParentIndex;
                    Row.Input.value = String(RowIndex);
                    ZTSMServiceExtensionNestedRowIndexSet(Row.Cell, SetName, ParentIndex, RowIndex);
                });

                Groups[SetName].Templates.forEach(function (Row) {
                    Row.Input.name = 'SetIndex_' + SetName + '_' + ParentIndex;
                    Row.Input.value = 'Template';
                    ZTSMServiceExtensionNestedRowIndexSet(Row.Cell, SetName, ParentIndex, 'Template');
                });
            });
        });
    }

    function ZTSMServiceExtensionElementHidden(Element) {
        var Rect;

        if (!Element || !Element.getBoundingClientRect) {
            return true;
        }

        Rect = Element.getBoundingClientRect();

        return !Rect.width && !Rect.height;
    }

    function ZTSMServicePayloadValidationIgnoreSync(Root) {
        Root = Root || document;

        Array.prototype.forEach.call(Root.querySelectorAll('.ZTSMServiceExtensionField input, .ZTSMServiceExtensionField select, .ZTSMServiceExtensionField textarea'), function (Element) {
            var Row = Element.closest ? Element.closest('.FieldCell[class*="MultiValue_"], .MultiValue_Template, .DFSetOuterField') : null,
                IsTemplate = !!(
                    (Row && Row.classList.contains('MultiValue_Template'))
                    || /_(?:Template)(?:[A-Za-z]*(?:\[\])?)?$/.test(Element.id || '')
                    || /_(?:Template)(?:[A-Za-z]*(?:\[\])?)?$/.test(Element.name || '')
                    || (Element.name && Element.name.indexOf('SetIndex_') === 0 && Element.value === 'Template')
                ),
                IsBlankHidden = ZTSMServiceExtensionElementHidden(Element) && !String(Element.value || '').trim(),
                ShouldIgnore = IsTemplate || IsBlankHidden;

            if (ShouldIgnore) {
                Element.classList.add('ValidationIgnore');
                Element.dataset.ZTSMServicePayloadValidationIgnore = '1';
            }
            else if (Element.dataset.ZTSMServicePayloadValidationIgnore === '1') {
                Element.classList.remove('ValidationIgnore');
                delete Element.dataset.ZTSMServicePayloadValidationIgnore;
            }
        });
    }

    function ZTSMServicePayloadHiddenRichTextValidationSync(Root) {
        Root = Root || document;

        Array.prototype.forEach.call(Root.querySelectorAll('textarea.RichText[name="Body"], textarea#RichText[name="Body"]'), function (Element) {
            var Holder = Element.closest ? Element.closest('.RichTextHolder, .RichTextField, .Field, .Row') : null,
                IsHidden = ZTSMServiceExtensionElementHidden(Element) || (Holder && ZTSMServiceExtensionElementHidden(Holder));

            if (IsHidden) {
                if (Element.classList.contains('Validate_Required') || Element.classList.contains('Validate_Required_IfVisible')) {
                    Element.dataset.ZTSMRequiredClass = Element.classList.contains('Validate_Required') ? 'Validate_Required' : 'Validate_Required_IfVisible';
                    Element.classList.remove('Validate_Required');
                    Element.classList.remove('Validate_Required_IfVisible');
                }
                Element.classList.add('ValidationIgnore');
                Element.dataset.ZTSMHiddenRichTextValidationIgnore = '1';
                if (window.jQuery) {
                    try {
                        window.jQuery(Element).rules('remove', 'required');
                    }
                    catch (Error) {
                        // Ignore if the validator has not registered the field yet.
                    }
                }
            }
            else if (Element.dataset.ZTSMHiddenRichTextValidationIgnore === '1') {
                Element.classList.remove('ValidationIgnore');
                delete Element.dataset.ZTSMHiddenRichTextValidationIgnore;
                if (Element.dataset.ZTSMRequiredClass) {
                    Element.classList.add(Element.dataset.ZTSMRequiredClass);
                    delete Element.dataset.ZTSMRequiredClass;
                }
            }
        });
    }

    function ZTSMServicePayloadValidationStateSync(Root) {
        ZTSMServicePayloadValidationIgnoreSync(Root);
        ZTSMServicePayloadHiddenRichTextValidationSync(Root);
    }

    function ZTSMServiceExtensionSetRowGet(Input) {
        if (!Input || !Input.closest) {
            return;
        }

        return Input.closest('.FieldCell[class*="MultiValue_"], .MultiValue_Template') || Input.closest('.DFSetOuterField');
    }

    function ZTSMServiceExtensionNormalizeLater() {
        [0, 25, 100, 250].forEach(function (Delay) {
            window.setTimeout(function () {
                var Start = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsStart'),
                    End = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsEnd');

            if (Start && End) {
                ZTSMServiceExtensionSetIndexNormalize(Start, End);
                ZTSMServiceExtensionLayoutFix(Start, End);
                ZTSMServiceExtensionDatepickerInit(Start, End);
                ZTSMServicePayloadToolsEnsure(Start, End);
            }
        }, Delay);
        });
    }

    function ZTSMServiceExtensionMutationNeedsNormalize(Node) {
        if (!Node || Node.nodeType !== 1 || !Node.matches || !Node.querySelector) {
            return false;
        }

        if (Node.closest && Node.closest('.ck, .ck-editor, .cke, .cke_chrome')) {
            return false;
        }

        return Node.matches('.AddValueRow, .RemoveValueRow')
            || !!Node.querySelector('.AddValueRow, .RemoveValueRow');
    }

    function ZTSMServiceExtensionSetIndexNormalize(Start, End) {
        var Root = Start && End ? Start.parentNode : document,
            FieldContainers;

        if (!Root) {
            return;
        }

        FieldContainers = Root.querySelectorAll('.ZTSMServiceExtensionField');

        Array.prototype.forEach.call(FieldContainers, function (FieldContainer) {
            var RealRows = [],
                TemplateInput,
                TemplateCell,
                SeenCells = [],
                TemplateRows = [],
                ContainerSetInput = FieldContainer.querySelector('input[type="hidden"][name^="SetIndex_"]'),
                ContainerSetName = ContainerSetInput ? ZTSMServiceExtensionNestedSetBaseName(ContainerSetInput.name) : '';

            Array.prototype.forEach.call(FieldContainer.querySelectorAll('input[type="hidden"][name^="SetIndex_"]'), function (Input) {
                var Cell = ZTSMServiceExtensionSetRowGet(Input),
                    SetName = ZTSMServiceExtensionNestedSetBaseName(Input.name),
                    IsTemplate = Input.value === 'Template' || (Cell && Cell.classList.contains('MultiValue_Template')),
                    IsHiddenTemplate = IsTemplate && ZTSMServiceExtensionElementHidden(Cell);

                if (ContainerSetName && SetName !== ContainerSetName) {
                    return;
                }

                if (IsHiddenTemplate) {
                    TemplateRows.push({
                        Cell: Cell,
                        Input: Input
                    });
                    return;
                }

                if (Cell && SeenCells.indexOf(Cell) === -1) {
                    SeenCells.push(Cell);
                    RealRows.push({
                        Cell: Cell,
                        Input: Input
                    });
                }
            });

            if (TemplateRows.length) {
                TemplateRows.forEach(function (Row) {
                    Row.Input.value = 'Template';

                    if (!TemplateInput) {
                        TemplateInput = Row.Input;
                        TemplateCell = Row.Cell && Row.Cell.classList.contains('MultiValue_Template') ? Row.Cell : Row.Input.closest('.MultiValue_Template');
                    }
                });
            }

            RealRows.forEach(function (Row, Index) {
                ZTSMServiceExtensionRowIndexSet(Row.Cell, Index, Row.Input.name.replace(/^SetIndex_/, ''));
                Row.Input.value = String(Index);

                if (Row.Input.id) {
                    Row.Input.id = Row.Input.id.replace(/_(?:\d+|Template)$/, '_' + Index);
                }
            });

            if (TemplateInput) {
                TemplateInput.value = 'Template';

                if (TemplateInput.id) {
                    TemplateInput.id = TemplateInput.id.replace(/_(?:\d+|Template)$/, '_Template');
                }
                if (TemplateCell && TemplateCell.parentNode) {
                    TemplateCell.parentNode.appendChild(TemplateCell);
                }
            }
        });

        ZTSMServiceExtensionNestedSetIndexCompact(Root);
        ZTSMServicePayloadValidationStateSync(Root);
    }

    function ZTSMServiceExtensionSafeInit(InitFunction) {
        try {
            InitFunction();
        }
        catch (Error) {
            if (window.console && typeof window.console.warn === 'function') {
                window.console.warn('ZTSM service extension init skipped:', Error);
            }
        }
    }

    function ZTSMServicePayloadNormalize(Value) {
        return String(Value || '')
            .replace(/^DynamicField_/, '')
            .replace(/_(?:\d+|Template)(?:[A-Za-z]*(?:\[\])?)?$/, '')
            .replace(/[^a-z0-9]+/gi, '')
            .toLowerCase();
    }

    function ZTSMServicePayloadImportValue(Value) {
        var Text = Value === null || Value === undefined ? '' : String(Value).trim(),
            ExplicitID,
            LabelPrefix;

        if (Text === '-') {
            return '';
        }

        ExplicitID = Text.match(/::\s*(\d+)\s*$/);
        Text = Text.replace(/::\s*\d+\s*$/, '').trim();

        LabelPrefix = Text.match(/^[A-Za-z][A-Za-z0-9 _-]{1,40}:\s*(.+)$/);
        if (LabelPrefix) {
            Text = LabelPrefix[1].trim();
        }

        return ExplicitID ? Text + '::' + ExplicitID[1] : Text;
    }

    function ZTSMServicePayloadImportMatch(Value) {
        return ZTSMServicePayloadNormalize(ZTSMServicePayloadImportValue(Value));
    }

    function ZTSMServicePayloadImportValues(Value) {
        var Values;

        if (Array.isArray(Value)) {
            Values = Value;
        }
        else {
            Values = String(Value === null || Value === undefined ? '' : Value)
                .split(/[\r\n,;]+/);
        }

        return Values.map(function (Item) {
            return ZTSMServicePayloadImportValue(Item);
        }).filter(function (Item) {
            return Item !== '';
        });
    }

    function ZTSMServicePayloadDebugEnabled() {
        return !!(
            window.console
            && typeof window.console.log === 'function'
            && (
                window.ZTSMServicePayloadDebug === true
                || (window.localStorage && window.localStorage.getItem('ZTSMServicePayloadDebug') === '1')
            )
        );
    }

    function ZTSMServicePayloadConsole(Method, Message, Data) {
        if (!ZTSMServicePayloadDebugEnabled()) {
            return;
        }

        Method = Method && window.console[Method] ? Method : 'log';
        if (Data !== undefined) {
            window.console[Method](Message, Data);
        }
        else {
            window.console[Method](Message);
        }
    }

    function ZTSMServicePayloadEventFire(Element) {
        var Event,
            IsModernizedInputField;

        if (!Element) {
            return;
        }

        IsModernizedInputField = !!ZTSMServicePayloadModernizedContainer(Element);
        ZTSMServicePayloadModernizedSelectRefresh(Element);

        Event = document.createEvent('Event');
        Event.initEvent('change', true, true);
        Element.dispatchEvent(Event);

        if (!IsModernizedInputField) {
            Event = document.createEvent('Event');
            Event.initEvent('input', true, true);
            Element.dispatchEvent(Event);
        }

        if (window.jQuery) {
            window.jQuery(Element).trigger('change');
        }

        window.setTimeout(function () {
            ZTSMServicePayloadModernizedSelectRefresh(Element);
        }, 0);
    }

    function ZTSMServicePayloadReferenceClear(Element, Hidden) {
        if (Hidden) {
            Hidden.value = '';
            ZTSMServicePayloadFieldLabelFloat(Hidden, false);
            ZTSMServicePayloadEventFire(Hidden);
        }
        if (Element) {
            Element.value = '';
            Element.classList.remove('oooFull');
            ZTSMServicePayloadFieldLabelFloat(Element, false);
            ZTSMServicePayloadEventFire(Element);
        }
    }

    function ZTSMServicePayloadReferenceSet(Element, Hidden, Label, Key) {
        var Changed = Hidden && String(Hidden.value || '') !== String(Key || '');

        if (window.jQuery && Element) {
            window.jQuery(Element).val(Label || '');
        }
        else if (Element) {
            Element.value = Label || '';
        }

        if (Hidden) {
            Hidden.value = Key || '';
        }

        ZTSMServicePayloadModernizedReferenceRefresh(Element || Hidden, Label || '');

        if (
            window.Core
            && Core.Agent
            && Core.Agent.DynamicFieldReferenceSearch
            && typeof Core.Agent.DynamicFieldReferenceSearch.AddTicketReference === 'function'
            && Element
        ) {
            Core.Agent.DynamicFieldReferenceSearch.AddTicketReference(Element.id, Label || '', Key || '');
        }

        if (Hidden && Changed) {
            ZTSMServicePayloadEventFire(Hidden);
        }
        if (Element) {
            ZTSMServicePayloadEventFire(Element);
        }
    }

    function ZTSMServicePayloadRenderedSelectionValues(Element) {
        var Values = [],
            Containers = [],
            Parent,
            Next,
            FieldContainer,
            FieldCell,
            Seen = {};

        function AddValue(Value) {
            Value = String(Value || '')
                .replace(/\s+/g, ' ')
                .replace(/^\s*[xXÃ—]\s*/, '')
                .trim();

            if (Value && Value !== '-' && !Seen[Value]) {
                Seen[Value] = 1;
                Values.push(Value);
            }
        }

        if (!Element) {
            return Values;
        }

        Parent = Element.parentNode;
        Next = Element.nextElementSibling;
        FieldCell = Element.closest ? Element.closest('.FieldCell, .Row_DynamicField') : null;
        FieldContainer = Element.closest ? Element.closest('.ZTSMServiceExtensionField') : null;

        if (Next) {
            Containers.push(Next);
        }
        if (Parent) {
            Containers.push(Parent);
        }
        if (FieldCell) {
            Containers.push(FieldCell);
        }
        if (FieldContainer) {
            Containers.push(FieldContainer);
        }

        Containers.forEach(function (Container) {
            Array.prototype.forEach.call(Container.querySelectorAll('.select2-selection__choice, .select2-search-choice'), function (Choice) {
                AddValue(Choice.getAttribute('title') || Choice.textContent || '');
            });

            Array.prototype.forEach.call(Container.querySelectorAll('.select2-selection__rendered'), function (Rendered) {
                if (!Rendered.querySelector('.select2-selection__choice, .select2-search-choice')) {
                    AddValue(Rendered.textContent || '');
                }
            });
        });

        return Values;
    }

    function ZTSMServicePayloadCollectDebug(Element, Name, Value) {
        var SelectedOptions = [],
            Select2Data = [],
            JQueryValue,
            RenderedValues,
            FieldContainer,
            FieldText;

        if (!ZTSMServicePayloadDebugEnabled() || !Element) {
            return;
        }

        if (Element.options) {
            SelectedOptions = Array.prototype.filter.call(Element.options, function (Option) {
                return Option.selected;
            }).map(function (Option) {
                return {
                    value: Option.value,
                    text: String(Option.text || '').trim()
                };
            });
        }

        if (window.jQuery) {
            try {
                JQueryValue = window.jQuery(Element).val();
            }
            catch (Error) {
                JQueryValue = 'jQuery.val() failed: ' + Error.message;
            }
            try {
                Select2Data = window.jQuery(Element).select2 && window.jQuery(Element).select2('data');
            }
            catch (Error) {
                Select2Data = 'select2(data) failed: ' + Error.message;
            }
        }

        RenderedValues = ZTSMServicePayloadRenderedSelectionValues(Element);
        FieldContainer = Element.closest ? Element.closest('.ZTSMServiceExtensionField, .Row_DynamicField, .FieldCell') : null;
        FieldText = FieldContainer ? String(FieldContainer.textContent || '').replace(/\s+/g, ' ').trim().slice(0, 500) : '';

        ZTSMServicePayloadConsole('log', '[ZTSM payload collect] ' + Name, {
            outputValue: Value,
            tagName: Element.tagName,
            type: Element.type || '',
            name: Element.name || '',
            id: Element.id || '',
            className: Element.className || '',
            multiple: !!Element.multiple,
            nativeValue: Element.value,
            selectedOptions: SelectedOptions,
            jqueryValue: JQueryValue,
            select2Data: Select2Data,
            renderedValues: RenderedValues,
            fieldText: FieldText
        });
    }

    function ZTSMServicePayloadApplyDebug(Element, Name, RequestedValue, MatchedValue) {
        var SelectedOptions = [];

        if (!ZTSMServicePayloadDebugEnabled() || !Element) {
            return;
        }

        if (Element.options) {
            SelectedOptions = Array.prototype.filter.call(Element.options, function (Option) {
                return Option.selected;
            }).map(function (Option) {
                return {
                    value: Option.value,
                    text: String(Option.text || '').trim()
                };
            });
        }

        ZTSMServicePayloadConsole('log', '[ZTSM payload apply] ' + Name, {
            requestedValue: RequestedValue,
            matchedValue: MatchedValue,
            tagName: Element.tagName,
            type: Element.type || '',
            name: Element.name || '',
            id: Element.id || '',
            className: Element.className || '',
            multiple: !!Element.multiple,
            nativeValue: Element.value,
            selectedOptions: SelectedOptions
        });
    }

    function ZTSMServicePayloadSelectSet(Element, MatchedValue) {
        var MatchedString = String(MatchedValue === null || MatchedValue === undefined ? '' : MatchedValue),
            Found = false;

        Array.prototype.forEach.call(Element.options || [], function (Option) {
            var IsMatch = String(Option.value) === MatchedString;

            Option.selected = IsMatch;
            if (IsMatch) {
                Found = true;
            }
        });

        Element.value = Found ? MatchedString : MatchedString;

        if (window.jQuery) {
            window.jQuery(Element).val(Found ? MatchedString : MatchedString);
        }

        ZTSMServicePayloadModernizedSelectRefresh(Element);
        return Found;
    }

    function ZTSMServicePayloadModernizedContainer(Element) {
        var Previous,
            FieldCell,
            Container;

        if (!Element) {
            return null;
        }

        FieldCell = Element.closest ? Element.closest('.FieldCell, .Row_DynamicField') : null;
        Previous = Element.previousElementSibling;
        if (
            Previous
            && /\bInputField_Container\b/.test(Previous.className || '')
            && (
                !FieldCell
                || (Previous.closest && Previous.closest('.FieldCell, .Row_DynamicField') === FieldCell)
            )
        ) {
            return Previous;
        }

        Container = Element.closest ? Element.closest('.InputField_Container') : null;
        if (
            Container
            && (
                !FieldCell
                || (Container.closest && Container.closest('.FieldCell, .Row_DynamicField') === FieldCell)
            )
        ) {
            return Container;
        }

        return null;
    }

    function ZTSMServicePayloadModernizedSelectContainer(Element) {
        if (!Element || Element.tagName !== 'SELECT') {
            return null;
        }

        return ZTSMServicePayloadModernizedContainer(Element);
    }

    function ZTSMServicePayloadFieldLabel(Element) {
        var ID,
            Label,
            FieldCell;

        if (!Element) {
            return null;
        }

        ID = Element.id || '';
        if (ID) {
            Label = document.querySelector('label[for="' + ID.replace(/"/g, '\\"') + '"]');
            if (!Label && ID.indexOf('Autocomplete_') === 0) {
                Label = document.querySelector('label[for="' + ID.replace(/^Autocomplete_/, '').replace(/"/g, '\\"') + '"]');
            }
            if (Label) {
                return Label;
            }
        }

        FieldCell = Element.closest ? Element.closest('.FieldCell, .Row_DynamicField') : null;
        if (FieldCell) {
            Label = FieldCell.querySelector('label');
            if (Label) {
                return Label;
            }
        }

        return null;
    }

    function ZTSMServicePayloadFieldLabelFloat(Element, Active) {
        var Label = ZTSMServicePayloadFieldLabel(Element),
            FieldCell = Element && Element.closest ? Element.closest('.FieldCell, .Row_DynamicField, .Field') : null;

        if (!Label) {
            return;
        }

        if (Active) {
            Label.classList.add('ZTSMServicePayloadLabelFloated');
            if (FieldCell && FieldCell.classList) {
                FieldCell.classList.add('ZTSMServicePayloadHasValue');
            }
            return;
        }

        Label.classList.remove('ZTSMServicePayloadLabelFloated');
        if (FieldCell && FieldCell.classList) {
            FieldCell.classList.remove('ZTSMServicePayloadHasValue');
        }
    }

    function ZTSMServicePayloadModernizedReferenceRefresh(Element, Label) {
        var Container = ZTSMServicePayloadModernizedContainer(Element),
            InputContainer,
            Selection,
            TextNode,
            Remove,
            RemoveLink,
            SearchInput,
            Text = String(Label || '').trim();

        if (!Container || !Text) {
            return;
        }

        Container.classList.add('oooSelected');
        ZTSMServicePayloadFieldLabelFloat(Element, true);

        if (Element && Element.tagName !== 'SELECT') {
            Element.classList.add('oooFull');
            if ('value' in Element) {
                Element.value = Text;
            }
            Array.prototype.forEach.call(Container.querySelectorAll('.InputField_Selection, .InputField_SelectionFilter, .InputField_More'), function (Node) {
                Node.remove();
            });
            return;
        }

        InputContainer = Container.querySelector('.InputField_InputContainer') || Container;
        Array.prototype.forEach.call(Container.querySelectorAll('.InputField_Selection, .InputField_SelectionFilter, .InputField_More'), function (Node) {
            if (Node.parentNode === Container) {
                Node.remove();
            }
        });
        Array.prototype.forEach.call(InputContainer.querySelectorAll('.InputField_Selection, .InputField_SelectionFilter, .InputField_More'), function (Node) {
            Node.remove();
        });

        Selection = document.createElement('div');
        Selection.className = 'InputField_Selection';
        if (Element && Element.value) {
            Selection.setAttribute('data-value', Element.value);
        }
        InputContainer.appendChild(Selection);
        Selection.style.display = 'block';
        Selection.style.left = '24px';

        TextNode = Selection.querySelector('.Text');
        if (!TextNode) {
            TextNode = document.createElement('div');
            TextNode.className = 'Text';
            Selection.insertBefore(TextNode, Selection.firstChild);
        }
        TextNode.textContent = Text;

        Remove = Selection.querySelector('.Remove');
        if (!Remove) {
            Remove = document.createElement('div');
            Remove.className = 'Remove';
            Selection.appendChild(Remove);
        }

        RemoveLink = Remove.querySelector('a');
        if (!RemoveLink) {
            RemoveLink = document.createElement('a');
            RemoveLink.href = '#';
            RemoveLink.tabIndex = -1;
            RemoveLink.setAttribute('role', 'button');
            RemoveLink.textContent = 'x';
            Remove.appendChild(RemoveLink);
        }
        RemoveLink.title = 'Remove selection';
        RemoveLink.setAttribute('aria-label', 'Remove selection: ' + Text);
        RemoveLink.onclick = function (Event) {
            Event.preventDefault();
            if (Element) {
                ZTSMServicePayloadSelectSet(Element, '');
                ZTSMServicePayloadEventFire(Element);
            }
        };

        SearchInput = Container.querySelector('.InputField_Search');
        if (SearchInput && SearchInput !== Element) {
            SearchInput.value = '';
        }
    }

    function ZTSMServicePayloadModernizedSelectRefresh(Element) {
        var Container = ZTSMServicePayloadModernizedSelectContainer(Element),
            SelectedOptions,
            Text,
            Selection,
            TextNode,
            RemoveLink,
            SearchInput;

        if (!Container || !Element.options) {
            return;
        }

        SelectedOptions = Array.prototype.filter.call(Element.options, function (Option) {
            return Option.selected && String(Option.value || '') !== '';
        });

        if (!SelectedOptions.length) {
            Container.classList.remove('oooSelected');
            ZTSMServicePayloadFieldLabelFloat(Element, false);
            Selection = Container.querySelector('.InputField_Selection');
            if (Selection) {
                TextNode = Selection.querySelector('.Text');
                if (TextNode) {
                    TextNode.textContent = '';
                }
                Selection.style.display = 'none';
            }
            SearchInput = Container.querySelector('.InputField_Search');
            if (SearchInput) {
                SearchInput.value = '';
            }
            if (Container.querySelector('.InputField_InputContainer')) {
                Container.querySelector('.InputField_InputContainer').style.display = '';
            }
            return;
        }

        Text = SelectedOptions.map(function (Option) {
            return String(Option.text || Option.value || '').trim();
        }).filter(function (Value) {
            return Value !== '';
        }).join(', ');

        ZTSMServicePayloadModernizedReferenceRefresh(Element, Text);
    }

    function ZTSMServicePayloadVisibleSelectionRefresh(Root) {
        Root = Root || document;

        Array.prototype.forEach.call(Root.querySelectorAll('.ZTSMServiceExtensionField select'), function (Element) {
            if (window.jQuery) {
                try {
                    window.jQuery(Element).trigger('change.select2');
                }
                catch (Error) {
                    ZTSMServicePayloadConsole('warn', '[ZTSM cosmetic select2 refresh failed]', Error.message);
                }
            }
            ZTSMServicePayloadModernizedSelectRefresh(Element);
            window.setTimeout(function () {
                ZTSMServicePayloadModernizedSelectRefresh(Element);
            }, 0);
        });

        Array.prototype.forEach.call(Root.querySelectorAll('.ZTSMServiceExtensionField input[name^="Autocomplete_DynamicField_"]'), function (Element) {
            var Text = String(Element.value || '').trim();

            if (Text) {
                ZTSMServicePayloadModernizedReferenceRefresh(Element, Text);
                window.setTimeout(function () {
                    ZTSMServicePayloadModernizedReferenceRefresh(Element, Text);
                }, 0);
            }
        });
    }

    window.ZTSMServicePayloadVisibleSelectionRefresh = ZTSMServicePayloadVisibleSelectionRefresh;

    function ZTSMHostnamePolicyFields() {
        return [
            'ZTicket-Location',
            'ZTicket-Env',
            'ZTicket-Application',
            'ZTicket-FunctionProfile',
            'ZTicket-Custom',
            'ZCompute-Image',
            'ZCompute-CpuCore',
            'ZCompute-GPU',
            'ZCompute-RAM',
            'ZStorage-FS',
            'ZTicket-NetworkPool',
            'ZTicket-IpAddress'
        ];
    }

    function ZTSMHostnamePolicyRowFields() {
        return [
            'ZTicket-FunctionProfile',
            'ZTicket-Custom',
            'ZCompute-Image',
            'ZCompute-CpuCore',
            'ZCompute-GPU',
            'ZCompute-RAM',
            'ZStorage-FS',
            'ZTicket-NetworkPool',
            'ZTicket-IpAddress'
        ];
    }

    function ZTSMHostnamePolicyNetworkAdapterRows(Root) {
        var Rows = [];

        Root = Root || document;
        Array.prototype.forEach.call(Root.querySelectorAll('input[type="hidden"][name="SetIndex_ZTicket-NetworkAdapter"]'), function (Input) {
            var Row;

            if (Input.value === 'Template') {
                return;
            }

            Row = Input.closest ? Input.closest('.DynamicFieldSet') : null;
            if (!Row) {
                return;
            }

            Rows.push({
                index: Input.value,
                element: Row
            });
        });

        return Rows;
    }

    function ZTSMHostnamePolicyVMRows(Form) {
        var Rows = [];

        Form = Form || document.getElementById('NewCustomerTicket');
        if (!Form) {
            return Rows;
        }

        Array.prototype.forEach.call(Form.querySelectorAll('input[type="hidden"][name="SetIndex_ZCompute-VM"]'), function (Input) {
            var Row;

            if (Input.value === 'Template') {
                return;
            }

            Row = Input.closest ? Input.closest('.DynamicFieldSet') : null;
            if (!Row) {
                return;
            }

            Rows.push({
                index: Input.value,
                element: Row
            });
        });

        return Rows;
    }

    function ZTSMHostnamePolicyFieldMatches(Element, FieldName) {
        return ZTSMServicePayloadFieldBaseName(Element) === FieldName;
    }

    function ZTSMHostnamePolicyElementFind(Root, FieldName) {
        var Match = null;

        Root = Root || document;
        Array.prototype.some.call(Root.querySelectorAll('input, select, textarea'), function (Element) {
            if (!Element.name || Element.name.indexOf('SetIndex_') === 0) {
                return false;
            }

            if (!ZTSMHostnamePolicyFieldMatches(Element, FieldName)) {
                return false;
            }

            if (Element.name.indexOf('Autocomplete_DynamicField_') !== 0) {
                Match = Element;
                return true;
            }

            if (!Match) {
                Match = Element;
            }

            return false;
        });

        return Match;
    }

    function ZTSMHostnamePolicyValue(FieldName, Root) {
        var Element = ZTSMHostnamePolicyElementFind(Root || document, FieldName)
                || ZTSMServiceExtensionPreferenceFieldFind(document, FieldName),
            Hidden;

        if (!Element) {
            return '';
        }

        if (Element.name && Element.name.indexOf('Autocomplete_DynamicField_') === 0) {
            Hidden = document.getElementById(Element.name.replace(/^Autocomplete_/, ''));
            if (Hidden && Hidden.value) {
                return Hidden.value;
            }
        }

        return Element.value || '';
    }

    function ZTSMHostnamePolicyRowHostnameField(Row) {
        var Field = ZTSMHostnamePolicyElementFind(Row, 'ZTicket-Hostname');

        if (Field) {
            Field.readOnly = true;
            Field.setAttribute('readonly', 'readonly');
        }

        return Field;
    }

    function ZTSMHostnamePolicyRowIpAddressField(Row) {
        return ZTSMHostnamePolicyElementFind(Row, 'ZTicket-IpAddress');
    }

    function ZTSMNetworkPoolIpAddressEditableApply(Row, Allocation) {
        var Field = ZTSMHostnamePolicyRowIpAddressField(Row),
            Editable = String(Allocation || '').toLowerCase() === 'manual';

        if (!Field) {
            return;
        }

        Field.disabled = !Editable;
        Field.readOnly = !Editable;
        Field.setAttribute('data-ztsm-network-allocation', Allocation || '');

        if (Editable) {
            Field.removeAttribute('disabled');
            Field.removeAttribute('readonly');
            Field.setAttribute('title', 'Manual IP address');
            return;
        }

        Field.setAttribute('disabled', 'disabled');
        Field.setAttribute('readonly', 'readonly');
        Field.setAttribute('title', Allocation ? 'IP address is controlled by ' + Allocation + ' allocation' : 'Select a manual network pool to enter an IP address');
    }

    function ZTSMNetworkPoolContextFields() {
        return [
            'ZTicket-Application',
            'ZTicket-Env',
            'ZTicket-Location',
            'ZTicket-Platform'
        ];
    }

    function ZTSMNetworkPoolContextQueryString() {
        var Parts = [];

        ZTSMNetworkPoolContextFields().forEach(function (FieldName) {
            var Value = ZTSMHostnamePolicyValue(FieldName, document);

            Parts.push(
                'DynamicField_' + encodeURIComponent(FieldName) + '=' + encodeURIComponent(Value || '')
            );
        });

        return Parts.join(';');
    }

    function ZTSMNetworkPoolContextComplete() {
        return ZTSMNetworkPoolContextFields().every(function (FieldName) {
            return String(ZTSMHostnamePolicyValue(FieldName, document) || '').trim() !== '';
        });
    }

    function ZTSMNetworkPoolDropdownClear(Element) {
        var EmptyOption;

        if (!Element || Element.tagName !== 'SELECT') {
            return;
        }

        EmptyOption = Array.prototype.filter.call(Element.options || [], function (Option) {
            return String(Option.value || '') === '';
        })[0];

        Element.innerHTML = '';
        if (EmptyOption) {
            Element.add(EmptyOption);
        }
        else {
            Element.add(new Option('', '', true, true));
        }

        ZTSMServicePayloadSelectSet(Element, '');
        ZTSMServicePayloadModernizedSelectRefresh(Element);
        ZTSMServicePayloadEventFire(Element);
    }

    function ZTSMNetworkPoolDropdownRefresh() {
        var Form = document.getElementById('NewCustomerTicket'),
            URL,
            SerializedForm = '',
            ExplicitContext = '',
            ContextComplete;

        if (
            !Form
            || !window.Core
            || !Core.Config
        ) {
            return;
        }

        URL = Core.Config.Get('Baselink');
        if (window.Core && Core.AJAX && typeof Core.AJAX.SerializeForm === 'function' && window.jQuery) {
            SerializedForm = Core.AJAX.SerializeForm(window.jQuery(Form), {
                Action: 1,
                Subaction: 1,
                Term: 1,
                Field: 1,
                MaxResults: 1
            });
        }
        ExplicitContext = ZTSMNetworkPoolContextQueryString();
        ContextComplete = ZTSMNetworkPoolContextComplete();

        ZTSMHostnamePolicyVMRows(Form).forEach(function (VMRow) {
            ZTSMHostnamePolicyNetworkAdapterRows(VMRow.element).forEach(function (AdapterRow) {
                var Element = ZTSMHostnamePolicyElementFind(AdapterRow.element, 'ZTicket-NetworkPool'),
                    Current,
                    QueryString,
                    XHR;

                if (!Element || Element.tagName !== 'SELECT') {
                    return;
                }

                if (!ContextComplete) {
                    ZTSMNetworkPoolDropdownClear(Element);
                    return;
                }

                Current = String(Element.value || '');
                QueryString = 'Action=AgentReferenceSearch;Term=;Field=' + encodeURIComponent(Element.id || Element.name)
                    + ';MaxResults=200;' + SerializedForm + ';' + ExplicitContext;

                XHR = new XMLHttpRequest();
                XHR.open('GET', URL + QueryString, true);
                XHR.onreadystatechange = function () {
                    var Results,
                        HasCurrent = false,
                        EmptyOption;

                    if (XHR.readyState !== 4 || XHR.status < 200 || XHR.status >= 300) {
                        return;
                    }

                    try {
                        Results = JSON.parse(XHR.responseText || '[]');
                    }
                    catch (Error) {
                        Results = [];
                    }

                    if (!Array.isArray(Results)) {
                        return;
                    }

                    EmptyOption = Array.prototype.filter.call(Element.options || [], function (Option) {
                        return String(Option.value || '') === '';
                    })[0];
                    Element.innerHTML = '';
                    if (EmptyOption) {
                        Element.add(EmptyOption);
                    }

                    Results.forEach(function (Item) {
                        var Option = document.createElement('option'),
                            Key = String(Item.Key === null || Item.Key === undefined ? '' : Item.Key);

                        Option.value = Key;
                        Option.text = Item.Value || Item.Label || Key;
                        Option.setAttribute('data-label', Option.text);
                        Element.add(Option);
                        if (Key === Current) {
                            HasCurrent = true;
                        }
                    });

                    if (Current && HasCurrent) {
                        ZTSMServicePayloadSelectSet(Element, Current);
                    }
                    else if (Current) {
                        ZTSMServicePayloadSelectSet(Element, '');
                    }

                    ZTSMServicePayloadModernizedSelectRefresh(Element);
                    ZTSMServicePayloadEventFire(Element);
                };
                XHR.send();
            });
        });
    }

    function ZTSMNetworkPoolDropdownRefreshLater() {
        window.clearTimeout(window.ZTSMNetworkPoolDropdownTimer);
        window.ZTSMNetworkPoolDropdownTimer = window.setTimeout(ZTSMNetworkPoolDropdownRefresh, 150);
    }

    function ZTSMHostnamePolicyResolvedField(Form) {
        var Field;

        Form = Form || document.getElementById('NewCustomerTicket');
        if (!Form) {
            return null;
        }

        Field = Form.querySelector('input[name="ZTSMHostnamePolicyResolved"]');
        if (!Field) {
            Field = document.createElement('input');
            Field.type = 'hidden';
            Field.name = 'ZTSMHostnamePolicyResolved';
            Form.appendChild(Field);
        }

        return Field;
    }

    function ZTSMHostnamePolicyResolve() {
        var Form = document.getElementById('NewCustomerTicket'),
            URL,
            Rows,
            Token,
            Aggregate = [];

        if (
            !Form
            || !window.Core
            || !Core.Config
            || typeof Core.Config.Get !== 'function'
        ) {
            return;
        }

        URL = Core.Config.Get('Baselink');
        Rows = ZTSMHostnamePolicyVMRows(Form);
        Token = String(Date.now()) + '-' + String(Math.random());
        window.ZTSMHostnamePolicyToken = Token;

        if (!Rows.length) {
            Rows = [
                {
                    index: 0,
                    element: Form
                }
            ];
        }

        Rows.forEach(function (Row) {
            var Parts = [
                    'Action=CustomerTicketMessage',
                    'Subaction=ZTSMHostnamePolicyResolve',
                    'HostnamePolicyRow=' + encodeURIComponent(Row.index)
                ],
                XHR = new XMLHttpRequest();

            ZTSMHostnamePolicyFields().forEach(function (FieldName) {
                var Root = ZTSMHostnamePolicyRowFields().indexOf(FieldName) === -1 ? document : Row.element;

                Parts.push(
                    'HostnamePolicyField_' + encodeURIComponent(FieldName)
                        + '=' + encodeURIComponent(ZTSMHostnamePolicyValue(FieldName, Root))
                );
            });

            XHR.open('POST', URL, true);
            XHR.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded; charset=UTF-8');
            XHR.onreadystatechange = function () {
                var Result,
                    Resolved,
                    Hostname;

                if (
                    XHR.readyState !== 4
                    || XHR.status < 200
                    || XHR.status >= 300
                    || window.ZTSMHostnamePolicyToken !== Token
                ) {
                    return;
                }

                try {
                    Result = JSON.parse(XHR.responseText || '{}');
                }
                catch (Error) {
                    Result = {};
                }

                if (!Result || !Result.Success) {
                    return;
                }

                Hostname = Result.Hostname || '';
                Resolved = ZTSMHostnamePolicyRowHostnameField(Row.element);
                if (Resolved) {
                    Resolved.value = Hostname;
                    Resolved.setAttribute('data-ztsm-hostname-policy-value', Hostname);
                    Resolved.setAttribute('data-ztsm-hostname-policy-enforced', Result.EnforceGlobalPolicy ? '1' : '0');
                    if (Result.EnforceGlobalPolicy && Hostname) {
                        Resolved.setAttribute('title', 'Generated hostname: ' + Hostname);
                    }
                }

                Aggregate.push({
                    Row: Row.index,
                    Hostname: Hostname,
                    EnforceGlobalPolicy: Result.EnforceGlobalPolicy ? 1 : 0
                });

                Resolved = ZTSMHostnamePolicyResolvedField(Form);
                if (Resolved) {
                    Resolved.value = JSON.stringify(Aggregate);
                }

                if (Row.networkAdapterRow) {
                    ZTSMNetworkPoolIpAddressEditableApply(Row.element, Result.NetworkAllocation || '');
                }
            };
            XHR.send(Parts.join('&'));
        });

        ZTSMHostnamePolicyVMRows(Form).forEach(function (VMRow) {
            ZTSMHostnamePolicyNetworkAdapterRows(VMRow.element).forEach(function (AdapterRow) {
                var Parts = [
                        'Action=CustomerTicketMessage',
                        'Subaction=ZTSMHostnamePolicyResolve',
                        'HostnamePolicyRow=' + encodeURIComponent(VMRow.index + '-' + AdapterRow.index)
                    ],
                    XHR = new XMLHttpRequest();

                ZTSMHostnamePolicyFields().forEach(function (FieldName) {
                    var Root = ZTSMHostnamePolicyRowFields().indexOf(FieldName) === -1 ? document : VMRow.element;

                    if (FieldName === 'ZTicket-NetworkPool' || FieldName === 'ZTicket-IpAddress') {
                        Root = AdapterRow.element;
                    }

                    Parts.push(
                        'HostnamePolicyField_' + encodeURIComponent(FieldName)
                            + '=' + encodeURIComponent(ZTSMHostnamePolicyValue(FieldName, Root))
                    );
                });

                XHR.open('POST', URL, true);
                XHR.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded; charset=UTF-8');
                XHR.onreadystatechange = function () {
                    var Result;

                    if (
                        XHR.readyState !== 4
                        || XHR.status < 200
                        || XHR.status >= 300
                        || window.ZTSMHostnamePolicyToken !== Token
                    ) {
                        return;
                    }

                    try {
                        Result = JSON.parse(XHR.responseText || '{}');
                    }
                    catch (Error) {
                        Result = {};
                    }

                    if (!Result || !Result.Success) {
                        return;
                    }

                    ZTSMNetworkPoolIpAddressEditableApply(AdapterRow.element, Result.NetworkAllocation || '');
                };
                XHR.send(Parts.join('&'));
            });
        });
    }

    function ZTSMHostnamePolicyHostnameFieldsLock() {
        var Form = document.getElementById('NewCustomerTicket');

        if (!Form) {
            return;
        }

        ZTSMHostnamePolicyVMRows(Form).forEach(function (Row) {
            ZTSMHostnamePolicyRowHostnameField(Row.element);
            ZTSMHostnamePolicyNetworkAdapterRows(Row.element).forEach(function (AdapterRow) {
                ZTSMNetworkPoolIpAddressEditableApply(AdapterRow.element, '');
            });
        });
    }

    function ZTSMHostnamePolicyResolveLater() {
        window.clearTimeout(window.ZTSMHostnamePolicyTimer);
        window.ZTSMHostnamePolicyTimer = window.setTimeout(ZTSMHostnamePolicyResolve, 120);
    }

    function ZTSMServicePayloadSelectReferenceOptionEnsure(Element, Key, Text) {
        var KeyString = String(Key === null || Key === undefined ? '' : Key),
            FoundOption;

        Array.prototype.forEach.call(Element.options || [], function (Option) {
            if (String(Option.value) === KeyString) {
                FoundOption = Option;
            }
        });

        if (!FoundOption && KeyString !== '') {
            FoundOption = new Option(Text || KeyString, KeyString, true, true);
            Element.add(FoundOption);
        }

        if (FoundOption && Text) {
            FoundOption.text = Text;
            FoundOption.label = Text;
            FoundOption.title = Text;
            FoundOption.setAttribute('label', Text);
            FoundOption.setAttribute('title', Text);
            FoundOption.setAttribute('data-label', Text);
            FoundOption.setAttribute('data-value', Text);
        }

        return FoundOption;
    }

    function ZTSMServicePayloadSelectReferenceResolve(Element, Value, OriginalValue) {
        return new Promise(function (Resolve) {
            var URL,
                QueryString,
                XHR,
                Field = Element && (Element.id || Element.name) || '',
                Name = ZTSMServicePayloadFieldBaseName(Element);

            if (
                !Value
                || !window.Core
                || !Core.Config
                || !Element
                || Element.tagName !== 'SELECT'
                || !/\bDynamicFieldReference\b/.test(Element.className || '')
                || !Field
            ) {
                Resolve(false);
                return;
            }

            URL = Core.Config.Get('Baselink');
            QueryString = 'Action=CustomerTicketMessage;Subaction=ZTSMServicePayloadReferenceResolve'
                + ';Field=' + encodeURIComponent(Field)
                + ';Value=' + encodeURIComponent(OriginalValue || Value);

            XHR = new XMLHttpRequest();
            XHR.open('GET', URL + QueryString, true);
            XHR.onreadystatechange = function () {
                var Result,
                    Text;

                if (XHR.readyState !== 4) {
                    return;
                }

                if (XHR.status >= 200 && XHR.status < 300) {
                    try {
                        Result = JSON.parse(XHR.responseText || '{}');
                    }
                    catch (Error) {
                        Result = {};
                    }

                    if (Result && Result.Success && Result.Key !== undefined) {
                        Text = Result.Value || OriginalValue || Value;
                        ZTSMServicePayloadSelectReferenceOptionEnsure(Element, Result.Key, Text);
                        ZTSMServicePayloadSelectSet(Element, Result.Key);
                        ZTSMServicePayloadApplyDebug(Element, Name, OriginalValue || Value, Result.Key);
                        ZTSMServicePayloadEventFire(Element);
                        Resolve(true);
                        return;
                    }
                }

                ZTSMServicePayloadConsole('warn', '[ZTSM payload apply] reference select resolve failed ' + Name, {
                    requestedValue: OriginalValue || Value,
                    field: Field,
                    status: XHR.status,
                    responseText: XHR.responseText || ''
                });
                Resolve(false);
            };
            XHR.send();
        });
    }

    function ZTSMServicePayloadAutocompleteSettle(Root) {
        if (!window.jQuery) {
            return;
        }

        try {
            window.jQuery(Root || document).find('.DynamicFieldReference.ui-autocomplete-input').each(function () {
                var Field = window.jQuery(this);

                try {
                    Field.autocomplete('close');
                }
                catch (Error) {
                    // Ignore fields without an active autocomplete instance.
                }
                Field.trigger('change');
            });
        }
        catch (Error) {
            ZTSMServicePayloadConsole('warn', '[ZTSM payload apply] autocomplete settle failed', {
                message: Error && Error.message ? Error.message : String(Error || '')
            });
        }
    }

    function ZTSMServicePayloadFormSubmitReset() {
        var Form = ZTSMFirst('#NewCustomerTicket');

        if (!Form) {
            return;
        }

        ZTSMServicePayloadValidationStateSync(Form);
        Form.classList.remove('oooSubmitted');
        if (window.jQuery) {
            try {
                if (Form.classList.contains('AlreadyDisabled') && window.Core && Core.Form && typeof Core.Form.EnableForm === 'function') {
                    Core.Form.EnableForm(window.jQuery(Form));
                }
                if (window.jQuery(Form).data('validator')) {
                    window.jQuery(Form).data('validator').resetForm();
                    window.jQuery(Form).data('validator').cancelSubmit = false;
                    window.jQuery(Form).data('validator').submitted = {};
                    window.jQuery(Form).data('validator').invalid = {};
                    window.jQuery(Form).data('validator').errorList = [];
                    window.jQuery(Form).data('validator').errorMap = {};
                    window.jQuery(Form).data('validator').pendingRequest = 0;
                }
            }
            catch (Error) {
                ZTSMServicePayloadConsole('warn', '[ZTSM payload apply] submit reset failed', {
                    message: Error && Error.message ? Error.message : String(Error || '')
                });
            }
        }
    }

    function ZTSMServicePayloadNativeSubmitTraceEnsure() {
        var OriginalSubmit;

        if (!window.HTMLFormElement || HTMLFormElement.prototype.ZTSMServicePayloadSubmitTrace) {
            return;
        }

        OriginalSubmit = HTMLFormElement.prototype.submit;
        HTMLFormElement.prototype.ZTSMServicePayloadSubmitTrace = OriginalSubmit;
        HTMLFormElement.prototype.submit = function () {
            if (this && this.id === 'NewCustomerTicket') {
                ZTSMServicePayloadConsole('log', '[ZTSM native submit called]', {
                    className: this.className || '',
                    action: this.action || '',
                    method: this.method || '',
                    disabledButtons: this.querySelectorAll ? this.querySelectorAll('button:disabled, input[type="submit"]:disabled').length : 0,
                    readonlyFields: this.querySelectorAll ? this.querySelectorAll('input[readonly]:not([type="hidden"]), textarea[readonly], select[readonly]').length : 0
                });
            }
            return OriginalSubmit.apply(this, arguments);
        };
    }

    function ZTSMServicePayloadValidatorErrorDetailsLog(Prefix, Validator) {
        var Details = ZTSMServicePayloadValidatorErrorDetails(Validator);

        if (!Details.length) {
            return Details;
        }

        ZTSMServicePayloadConsole('warn', Prefix + ' details', Details);
        try {
            ZTSMServicePayloadConsole('warn', Prefix + ' details JSON', JSON.stringify(Details));
        }
        catch (Error) {
            // Ignore serialization failures; object details were already logged.
        }
        return Details;
    }

    function ZTSMServicePayloadValidatorErrorDetails(Validator) {
        if (!Validator || !Validator.errorList) {
            return [];
        }

        return Validator.errorList.map(function (Item) {
            var Element = Item && Item.element,
                FieldContainer = Element && Element.closest ? Element.closest('.FieldCell, .Row_DynamicField, .ZTSMServiceExtensionField') : null;

            return {
                name: Element ? (Element.name || '') : '',
                id: Element ? (Element.id || '') : '',
                className: Element ? (Element.className || '') : '',
                value: Element && 'value' in Element ? Element.value : '',
                hidden: Element ? (Element.offsetParent === null) : '',
                message: Item && Item.message ? Item.message : '',
                fieldText: FieldContainer ? String(FieldContainer.textContent || '').replace(/\s+/g, ' ').trim().slice(0, 300) : ''
            };
        });
    }

    function ZTSMServicePayloadValueIsEmpty(Value) {
        if (Array.isArray(Value)) {
            return !Value.filter(function (Item) {
                return !ZTSMServicePayloadValueIsEmpty(Item);
            }).length;
        }

        return Value === null || Value === undefined || String(Value).trim() === '';
    }

    function ZTSMServicePayloadValueMerge(Current, Value) {
        var Values = [];

        if (ZTSMServicePayloadValueIsEmpty(Value)) {
            return Current;
        }

        if (!ZTSMServicePayloadValueIsEmpty(Current)) {
            Values = Array.isArray(Current) ? Current.slice(0) : [ Current ];
        }

        if (Array.isArray(Value)) {
            Value.forEach(function (Item) {
                if (!ZTSMServicePayloadValueIsEmpty(Item)) {
                    Values.push(Item);
                }
            });
        }
        else {
            Values.push(Value);
        }

        if (!Values.length) {
            return Current;
        }

        return Values.length === 1 ? Values[0] : Values;
    }

    function ZTSMServicePayloadFieldBaseName(Element) {
        var Name = Element && (Element.name || Element.id) || '';

        Name = Name.replace(/^Autocomplete_/, '');
        Name = Name.replace(/^DynamicField_/, '');
        Name = Name.replace(/(?:Day|Month|Year|Hour|Minute)$/, '');
        Name = Name.replace(/_[^_]+_(?:\d+|Template)_(?:\d+|Template)(?:[A-Za-z]*(?:\[\])?)?$/, '');
        Name = Name.replace(/_(?:\d+|Template)(?:[A-Za-z]*(?:\[\])?)?$/, '');

        return Name;
    }

    function ZTSMServicePayloadLabelText(Element) {
        var ID = Element && Element.id,
            Label;

        if (!ID) {
            return '';
        }

        Label = document.querySelector('label[for="' + ID.replace(/"/g, '\\"') + '"]');
        if (!Label && Element.closest) {
            Label = Element.closest('.FieldCell, .Row_DynamicField');
            Label = Label ? Label.querySelector('label') : null;
        }

        return Label ? Label.textContent.replace(/\*/g, '').replace(/\s+/g, ' ').trim() : '';
    }

    function ZTSMServicePayloadObjectLookup(Object, Names) {
        var Wanted = {},
            Key;

        Names.forEach(function (Name) {
            Wanted[ZTSMServicePayloadNormalize(Name)] = 1;
        });

        for (Key in Object) {
            if (!Object.hasOwnProperty(Key)) {
                continue;
            }
            if (Wanted[ZTSMServicePayloadNormalize(Key)]) {
                return Object[Key];
            }
        }

        return undefined;
    }

    function ZTSMServicePayloadInputSet(Element, Value) {
        var TextValue = Value === null || Value === undefined ? '' : String(Value),
            ImportValue = ZTSMServicePayloadImportValue(TextValue),
            ImportMatch = ZTSMServicePayloadImportMatch(TextValue),
            LowerValue = ImportValue.toLowerCase(),
            ExplicitID,
            Hidden,
            Matched,
            MultiValues,
            MultiMatches;

        if (!Element || !Element.name) {
            return Promise.resolve();
        }

        if (Element.name.indexOf('Autocomplete_DynamicField_') === 0) {
            ExplicitID = ImportValue.match(/::\s*(\d+)\s*$/);
            Hidden = document.getElementById(Element.name.replace(/^Autocomplete_/, ''));

            if (ExplicitID && Hidden) {
                ZTSMServicePayloadReferenceSet(Element, Hidden, ImportValue.replace(/::\s*\d+\s*$/, ''), ExplicitID[1]);
                return Promise.resolve();
            }

            if (!ImportValue) {
                ZTSMServicePayloadReferenceClear(Element, Hidden);
                return Promise.resolve();
            }

            Element.value = ImportValue;
            ZTSMServicePayloadEventFire(Element);
            return ZTSMServicePayloadReferenceResolve(Element, ImportValue, TextValue);
        }

        if (Element.tagName === 'SELECT') {
            if (Element.multiple) {
                MultiValues = ZTSMServicePayloadImportValues(Value);
                MultiMatches = {};

                Array.prototype.forEach.call(Element.options || [], function (Option) {
                    var OptionValue = String(Option.value || ''),
                        OptionText = String(Option.text || '').trim(),
                        OptionMatches = MultiValues.some(function (Item) {
                            return OptionValue.toLowerCase() === Item.toLowerCase()
                                || OptionText.toLowerCase() === Item.toLowerCase()
                                || ZTSMServicePayloadImportMatch(OptionText) === ZTSMServicePayloadImportMatch(Item);
                        });

                    Option.selected = OptionMatches;
                    if (OptionMatches) {
                        MultiMatches[OptionValue] = 1;
                    }
                });

                if (window.jQuery) {
                    window.jQuery(Element).val(Object.keys(MultiMatches));
                }

                ZTSMServicePayloadEventFire(Element);
                return Promise.resolve();
            }

            Array.prototype.forEach.call(Element.options || [], function (Option) {
                if (Matched) {
                    return;
                }
                if (
                    String(Option.value).toLowerCase() === LowerValue
                    || String(Option.text || '').trim().toLowerCase() === LowerValue
                    || ZTSMServicePayloadImportMatch(Option.text || '') === ImportMatch
                ) {
                    Matched = Option.value;
                }
            });

            if (Matched !== undefined) {
                ZTSMServicePayloadSelectSet(Element, Matched);
                ZTSMServicePayloadApplyDebug(Element, ZTSMServicePayloadFieldBaseName(Element), Value, Matched);
                ZTSMServicePayloadEventFire(Element);
                return Promise.resolve();
            }

            return ZTSMServicePayloadSelectReferenceResolve(Element, ImportValue, TextValue).then(function (Resolved) {
                if (!Resolved) {
                    ZTSMServicePayloadSelectSet(Element, ImportValue);
                    ZTSMServicePayloadApplyDebug(Element, ZTSMServicePayloadFieldBaseName(Element), Value, ImportValue);
                    ZTSMServicePayloadEventFire(Element);
                }
            });
        }

        if (Element.type === 'checkbox') {
            Element.checked = /^(?:1|true|yes|y|on)$/i.test(TextValue);
            ZTSMServicePayloadEventFire(Element);
            return Promise.resolve();
        }

        Element.value = ImportValue;
        ZTSMServicePayloadEventFire(Element);
        return Promise.resolve();
    }

    function ZTSMServicePayloadOutputValue(Element) {
        var Selected,
            Values,
            Select2Data;

        if (!Element) {
            return '';
        }

        if (Element.name && Element.name.indexOf('Autocomplete_DynamicField_') === 0) {
            return Element.value || '';
        }

        if (Element.tagName === 'SELECT') {
            Selected = Array.prototype.filter.call(Element.options || [], function (Option) {
                return Option.selected;
            });
            Values = Selected.map(function (Option) {
                return String(Option.text || '').trim() || Option.value || '';
            }).filter(function (Value) {
                return Value !== '' && Value !== '-';
            });

            if (Element.multiple) {
                if (!Values.length && window.jQuery) {
                    try {
                        Select2Data = window.jQuery(Element).select2 && window.jQuery(Element).select2('data');
                    }
                    catch (Error) {
                        Select2Data = [];
                    }
                    Values = Array.prototype.map.call(Select2Data || [], function (Item) {
                        return String(Item.text || Item.id || '').trim();
                    }).filter(function (Value) {
                        return Value !== '' && Value !== '-';
                    });
                }
                if (!Values.length) {
                    Values = ZTSMServicePayloadRenderedSelectionValues(Element);
                }

                return Values;
            }

            if (!Values.length) {
                Values = ZTSMServicePayloadRenderedSelectionValues(Element);
            }

            return Values[0] || '';
        }

        if (Element.type === 'checkbox') {
            return Element.checked ? '1' : '';
        }

        if (!Element.value) {
            Values = ZTSMServicePayloadRenderedSelectionValues(Element);
            if (Values.length) {
                return Values.length === 1 ? Values[0] : Values;
            }
        }

        return Element.value || '';
    }

    function ZTSMServicePayloadReferenceResolveDirect(Element, Value, OriginalValue) {
        return new Promise(function (Resolve) {
            var URL,
                QueryString,
                XHR,
                Hidden;

            if (!Value || !window.Core || !Core.Config || !Element.id || Element.id.indexOf('Autocomplete_') !== 0) {
                Resolve(false);
                return;
            }

            Hidden = document.getElementById(Element.id.replace(/^Autocomplete_/, ''));
            if (!Hidden) {
                Resolve(false);
                return;
            }

            URL = Core.Config.Get('Baselink');
            QueryString = 'Action=CustomerTicketMessage;Subaction=ZTSMServicePayloadReferenceResolve'
                + ';Field=' + encodeURIComponent(Element.id)
                + ';Value=' + encodeURIComponent(OriginalValue || Value);

            XHR = new XMLHttpRequest();
            XHR.open('GET', URL + QueryString, true);
            XHR.onreadystatechange = function () {
                var Result;

                if (XHR.readyState !== 4) {
                    return;
                }

                if (XHR.status >= 200 && XHR.status < 300) {
                    try {
                        Result = JSON.parse(XHR.responseText || '{}');
                    }
                    catch (Error) {
                        Result = {};
                    }

                    if (Result && Result.Success && Result.Key !== undefined) {
                        ZTSMServicePayloadReferenceSet(Element, Hidden, Result.Value || Value, Result.Key);
                        Resolve(true);
                        return;
                    }
                }

                Resolve(false);
            };
            XHR.send();
        });
    }

    function ZTSMServicePayloadReferenceSearch(Element, Value, OriginalValue) {
        return new Promise(function (Resolve) {
            var URL,
                QueryString,
                XHR,
                Form,
                Hidden,
                SetIndex = '',
                SetOuterFieldList,
                MultiValueClass,
                SearchTerms = [],
                SearchIndex = 0;

            if (!Value || !window.Core || !Core.Config || !Element.id || Element.id.indexOf('Autocomplete_') !== 0) {
                Resolve();
                return;
            }

            Hidden = document.getElementById(Element.id.replace(/^Autocomplete_/, ''));
            if (!Hidden) {
                Resolve();
                return;
            }

            SetOuterFieldList = window.jQuery ? window.jQuery(Element).parents('.DFSetOuterField') : [];
            if (SetOuterFieldList.length) {
                MultiValueClass = Array.prototype.filter.call(SetOuterFieldList[0].parentElement.classList, function (ClassName) {
                    return /^MultiValue_\d+$/.test(ClassName);
                })[0];
                if (MultiValueClass) {
                    SetIndex = ';SetIndex=' + MultiValueClass.replace(/^MultiValue_/, '');
                }
            }

            SearchTerms.push(Value);
            if (OriginalValue && String(OriginalValue).trim() !== Value) {
                SearchTerms.push(String(OriginalValue).trim());
            }

            Form = Element.closest('form');
            URL = Core.Config.Get('Baselink');

            function SearchNext() {
                var Term = SearchTerms[SearchIndex] || Value;

                QueryString = 'Action=AgentReferenceSearch;Term=' + encodeURIComponent(Term)
                    + ';Field=' + encodeURIComponent(Element.id)
                    + SetIndex
                    + ';MaxResults=20;';

                if (window.Core && Core.AJAX && typeof Core.AJAX.SerializeForm === 'function' && Form && window.jQuery) {
                    QueryString += Core.AJAX.SerializeForm(window.jQuery(Form), {
                        Action: 1,
                        Subaction: 1,
                        Term: 1,
                        Field: 1,
                        MaxResults: 1
                    });
                }

                XHR = new XMLHttpRequest();
                XHR.open('GET', URL + QueryString, true);
                XHR.onreadystatechange = function () {
                var Result,
                    Match;

                if (XHR.readyState !== 4) {
                    return;
                }

                if (XHR.status >= 200 && XHR.status < 300) {
                    try {
                        Result = JSON.parse(XHR.responseText || '[]');
                    }
                    catch (Error) {
                        Result = [];
                    }

                    Match = (Result || []).filter(function (Item) {
                        return String(Item.Value || '').toLowerCase() === String(Value).toLowerCase()
                            || ZTSMServicePayloadImportMatch(Item.Value || '') === ZTSMServicePayloadImportMatch(Value)
                            || ZTSMServicePayloadImportMatch(Item.Value || '') === ZTSMServicePayloadImportMatch(OriginalValue || '')
                            || String(Item.Key || '') === String(Value);
                    })[0];

                    if (Match && Match.Key) {
                        ZTSMServicePayloadReferenceSet(Element, Hidden, Match.Value, Match.Key);
                        Resolve();
                        return;
                    }
                }

                SearchIndex++;
                if (SearchIndex < SearchTerms.length) {
                    SearchNext();
                    return;
                }

                ZTSMServicePayloadReferenceClear(Element, Hidden);
                Resolve();
                };
                XHR.send();
            }

            SearchNext();
        });
    }

    function ZTSMServicePayloadReferenceResolve(Element, Value, OriginalValue) {
        return ZTSMServicePayloadReferenceResolveDirect(Element, Value, OriginalValue).then(function (Resolved) {
            if (Resolved) {
                return;
            }

            return ZTSMServicePayloadReferenceSearch(Element, Value, OriginalValue);
        });
    }

    function ZTSMServicePayloadRowsFromWorksheet(Worksheet) {
        var Rows,
            Header;

        if (!window.XLSX || !Worksheet) {
            return [];
        }

        Rows = XLSX.utils.sheet_to_json(Worksheet, {
            header: 1,
            defval: ''
        });

        if (!Rows.length) {
            return [];
        }

        Header = Rows.shift().map(function (Value) {
            return String(Value || '').trim();
        });

        return Rows.filter(function (Row) {
            return Row.some(function (Value) {
                return String(Value || '').trim() !== '';
            });
        }).map(function (Row) {
            var Object = {};

            Header.forEach(function (Name, Index) {
                if (Name) {
                    Object[Name] = Row[Index];
                }
            });

            return Object;
        });
    }

    function ZTSMServicePayloadCSVParse(Text) {
        var Rows = [],
            Row = [],
            Value = '',
            Index,
            Char,
            Next,
            Headers;

        for (Index = 0; Index < Text.length; Index++) {
            Char = Text.charAt(Index);
            Next = Text.charAt(Index + 1);

            if (Char === '"') {
                Index++;
                while (Index < Text.length) {
                    Char = Text.charAt(Index);
                    Next = Text.charAt(Index + 1);
                    if (Char === '"' && Next === '"') {
                        Value += '"';
                        Index += 2;
                        continue;
                    }
                    if (Char === '"') {
                        break;
                    }
                    Value += Char;
                    Index++;
                }
                continue;
            }

            if (Char === ',') {
                Row.push(Value);
                Value = '';
                continue;
            }

            if (Char === '\n' || Char === '\r') {
                if (Char === '\r' && Next === '\n') {
                    Index++;
                }
                Row.push(Value);
                Rows.push(Row);
                Row = [];
                Value = '';
                continue;
            }

            Value += Char;
        }

        Row.push(Value);
        Rows.push(Row);
        Headers = (Rows.shift() || []).map(function (Header) {
            return String(Header || '').trim();
        });

        return Rows.filter(function (DataRow) {
            return DataRow.some(function (Cell) {
                return String(Cell || '').trim() !== '';
            });
        }).map(function (DataRow) {
            var Object = {};

            Headers.forEach(function (Header, CellIndex) {
                if (Header) {
                    Object[Header] = DataRow[CellIndex] || '';
                }
            });

            return Object;
        });
    }

    function ZTSMServicePayloadFileRead(File) {
        return new Promise(function (Resolve, Reject) {
            var Reader = new FileReader();

            Reader.onload = function (Event) {
                var Name = File.name || '',
                    Workbook,
                    Rows;

                try {
                    if (/\.csv$/i.test(Name)) {
                        Resolve(ZTSMServicePayloadCSVParse(String(Event.target.result || '')));
                        return;
                    }

                    if (!window.XLSX) {
                        Reject(new Error('XLSX library is not loaded.'));
                        return;
                    }

                    Workbook = XLSX.read(Event.target.result, {
                        type: 'array'
                    });
                    Rows = ZTSMServicePayloadRowsFromWorksheet(Workbook.Sheets[Workbook.SheetNames[0]]);
                    Resolve(Rows);
                }
                catch (Error) {
                    Reject(Error);
                }
            };
            Reader.onerror = Reject;

            if (/\.csv$/i.test(File.name || '')) {
                Reader.readAsText(File);
            }
            else {
                Reader.readAsArrayBuffer(File);
            }
        });
    }

    function ZTSMServicePayloadSetRows(FieldContainer) {
        var Rows = [],
            ContainerSetInput = FieldContainer ? FieldContainer.querySelector('input[type="hidden"][name^="SetIndex_"]') : null,
            ContainerSetName = ContainerSetInput ? ZTSMServiceExtensionNestedSetBaseName(ContainerSetInput.name) : '';

        Array.prototype.forEach.call(FieldContainer.querySelectorAll('input[type="hidden"][name^="SetIndex_"]'), function (Input) {
            var Cell = ZTSMServiceExtensionSetRowGet(Input),
                SetName = ZTSMServiceExtensionNestedSetBaseName(Input.name);

            if (ContainerSetName && SetName !== ContainerSetName) {
                return;
            }

            if (!Cell || Input.value === 'Template' || Cell.classList.contains('MultiValue_Template') || ZTSMServiceExtensionElementHidden(Cell)) {
                return;
            }

            Rows.push(Cell);
        });

        return Rows;
    }

    function ZTSMServicePayloadSetRowsEnsure(FieldContainer, Count) {
        var Rows = ZTSMServicePayloadSetRows(FieldContainer),
            AddButton,
            Guard = 0;

        while (Rows.length < Count && Guard < Count + 5) {
            Guard++;
            AddButton = FieldContainer.querySelector('.AddValueRow');
            if (!AddButton) {
                break;
            }
            AddButton.click();
            ZTSMServiceExtensionSetIndexNormalize(ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsStart'), ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsEnd'));
            Rows = ZTSMServicePayloadSetRows(FieldContainer);
        }

        return Rows;
    }

    function ZTSMServicePayloadContainerName(FieldContainer) {
        var Input = FieldContainer.querySelector('input[type="hidden"][name^="SetIndex_"]'),
            SingleInput,
            Name;

        if (Input) {
            return Input.name.replace(/^SetIndex_/, '');
        }

        SingleInput = FieldContainer.querySelector('[name^="DynamicField_"], [name^="Autocomplete_DynamicField_"]');
        Name = ZTSMServicePayloadFieldBaseName(SingleInput);
        return Name || '';
    }

    function ZTSMServicePayloadControls(Row) {
        var Controls = [];

        Array.prototype.forEach.call(Row.querySelectorAll('select, textarea, input'), function (Element) {
            var OwnerRow;

            if (!Element.name || Element.type === 'hidden' || Element.name.indexOf('SetIndex_') === 0) {
                return;
            }
            if (Element.name.indexOf('DynamicField_') !== 0 && Element.name.indexOf('Autocomplete_DynamicField_') !== 0) {
                return;
            }
            if (Element.name.indexOf('DynamicField_') === 0 && document.getElementById('Autocomplete_' + Element.name)) {
                return;
            }

            OwnerRow = Element.closest && Element.closest('.FieldCell[class*="MultiValue_"], .MultiValue_Template');
            if (OwnerRow && OwnerRow !== Row) {
                return;
            }

            Controls.push(Element);
        });

        return Controls;
    }

    function ZTSMServicePayloadNestedSets(Row) {
        var Sets = {};

        Array.prototype.forEach.call(Row.querySelectorAll('input[type="hidden"][name^="SetIndex_"]'), function (Input) {
            var SetName = ZTSMServiceExtensionNestedSetBaseName(Input.name),
                SetRow = ZTSMServiceExtensionSetRowGet(Input),
                ParentRow,
                Container;

            if (!SetName || !SetRow || SetRow === Row) {
                return;
            }

            ParentRow = SetRow.parentElement && SetRow.parentElement.closest('.FieldCell[class*="MultiValue_"], .MultiValue_Template');
            if (ParentRow !== Row) {
                return;
            }

            Container = Input.closest('.DFSetOuterField') || SetRow.parentNode;
            if (!Container) {
                return;
            }

            if (!Sets[SetName]) {
                Sets[SetName] = {
                    Containers: [],
                    Rows: []
                };
            }
            if (Sets[SetName].Containers.indexOf(Container) === -1) {
                Sets[SetName].Containers.push(Container);
            }
            if (
                Input.value !== 'Template'
                && !SetRow.classList.contains('MultiValue_Template')
                && !ZTSMServiceExtensionElementHidden(SetRow)
                && Sets[SetName].Rows.indexOf(SetRow) === -1
            ) {
                Sets[SetName].Rows.push(SetRow);
            }
        });

        return Sets;
    }

    function ZTSMServicePayloadRowCollect(Row) {
        var RowData = {},
            NestedSets = ZTSMServicePayloadNestedSets(Row);

        ZTSMServicePayloadControls(Row).forEach(function (Element) {
            var Name = ZTSMServicePayloadFieldBaseName(Element),
                Value = ZTSMServicePayloadOutputValue(Element);

            RowData[Name] = ZTSMServicePayloadValueMerge(RowData[Name], Value);
            ZTSMServicePayloadCollectDebug(Element, Name, Value);
        });

        Object.keys(NestedSets).forEach(function (SetName) {
            RowData[SetName] = NestedSets[SetName].Rows.map(function (NestedRow) {
                return ZTSMServicePayloadRowCollect(NestedRow);
            });
        });

        return RowData;
    }

    function ZTSMServicePayloadLegacyNestedRows(Data, SetInfo) {
        var Rows = SetInfo ? SetInfo.Rows : [],
            FieldNames = {},
            Count = 0,
            Found = false,
            Result = [];

        if (!Rows.length) {
            return;
        }

        ZTSMServicePayloadControls(Rows[0]).forEach(function (Element) {
            var Name = ZTSMServicePayloadFieldBaseName(Element),
                Value = ZTSMServicePayloadObjectLookup(Data || {}, [ Name, 'DynamicField_' + Name ]);

            if (Value === undefined) {
                return;
            }

            Found = true;
            FieldNames[Name] = Value;
            Count = Math.max(Count, Array.isArray(Value) ? Value.length : 1);
        });

        if (!Found) {
            return;
        }

        Array.apply(null, Array(Count)).forEach(function (_, Index) {
            var RowData = {};

            Object.keys(FieldNames).forEach(function (Name) {
                var Value = FieldNames[Name];
                RowData[Name] = Array.isArray(Value) ? Value[Index] : (Index === 0 ? Value : '');
            });
            Result.push(RowData);
        });

        return Result;
    }

    function ZTSMServicePayloadNestedRowsEnsure(ParentRow, SetName, SetInfo, Count) {
        var Rows = SetInfo ? SetInfo.Rows.slice(0) : [],
            AddButton,
            Guard = 0,
            Refreshed;

        while (Rows.length < Count && Guard < Count + 5) {
            Guard++;
            AddButton = SetInfo && SetInfo.Containers[0] ? SetInfo.Containers[0].querySelector('.AddValueRow') : null;
            if (!AddButton) {
                AddButton = ParentRow.querySelector('.AddValueRow');
            }
            if (!AddButton) {
                break;
            }

            AddButton.click();
            ZTSMServiceExtensionSetIndexNormalize(ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsStart'), ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsEnd'));
            Refreshed = ZTSMServicePayloadNestedSets(ParentRow)[SetName];
            SetInfo = Refreshed || SetInfo;
            Rows = SetInfo ? SetInfo.Rows.slice(0) : Rows;
        }

        return Rows;
    }

    function ZTSMServicePayloadRowApply(Row, Data, SetName) {
        var Work = [],
            FieldIndex = {},
            NestedSets = ZTSMServicePayloadNestedSets(Row);

        ZTSMServicePayloadControls(Row).forEach(function (Element) {
            var FieldName = ZTSMServicePayloadFieldBaseName(Element),
                Label = ZTSMServicePayloadLabelText(Element),
                Value = ZTSMServicePayloadObjectLookup(Data, [
                    FieldName,
                    'DynamicField_' + FieldName,
                    Label,
                    SetName + '.' + FieldName,
                    SetName + '.' + Label,
                    'DynamicField_' + SetName + '.' + FieldName
                ]),
                ValueIndex;

            if (Value === undefined) {
                return;
            }

            ValueIndex = FieldIndex[FieldName] || 0;
            FieldIndex[FieldName] = ValueIndex + 1;

            if (Array.isArray(Value) && !Element.multiple) {
                Value = Value[ValueIndex] !== undefined ? Value[ValueIndex] : '';
            }

            Work.push(ZTSMServicePayloadInputSet(Element, Value));
        });

        Object.keys(NestedSets).forEach(function (NestedSetName) {
            var NestedPayload = ZTSMServicePayloadObjectLookup(Data || {}, [
                    NestedSetName,
                    'DynamicField_' + NestedSetName,
                    SetName + '.' + NestedSetName
                ]),
                NestedRows;

            if (NestedPayload === undefined) {
                NestedPayload = ZTSMServicePayloadLegacyNestedRows(Data, NestedSets[NestedSetName]);
                if (NestedPayload === undefined) {
                    return;
                }
            }

            NestedPayload = Array.isArray(NestedPayload) ? NestedPayload : [ NestedPayload || {} ];
            NestedRows = ZTSMServicePayloadNestedRowsEnsure(Row, NestedSetName, NestedSets[NestedSetName], NestedPayload.length);
            NestedPayload.forEach(function (NestedRowData, Index) {
                if (NestedRows[Index]) {
                    Work.push(ZTSMServicePayloadRowApply(NestedRows[Index], NestedRowData || {}, NestedSetName));
                }
            });
        });

        return Promise.all(Work);
    }

    function ZTSMServicePayloadApply(Payload) {
        var Start = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsStart'),
            End = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsEnd'),
            Root = Start && End ? Start.parentNode : document,
            Rows,
            Work = [];

        if (!Root) {
            return Promise.resolve();
        }

        Rows = Array.isArray(Payload) ? Payload : [ Payload || {} ];

        Array.prototype.forEach.call(Root.querySelectorAll('.ZTSMServiceExtensionField'), function (FieldContainer) {
            var SetName = ZTSMServicePayloadContainerName(FieldContainer),
                SetPayload,
                SetRows;

            if (!SetName) {
                return;
            }

            if (FieldContainer.querySelector('input[type="hidden"][name^="SetIndex_"]')) {
                SetPayload = ZTSMServicePayloadObjectLookup(Payload || {}, [ SetName, 'DynamicField_' + SetName ]);
                SetPayload = Array.isArray(SetPayload) ? SetPayload : Rows;
                SetRows = ZTSMServicePayloadSetRowsEnsure(FieldContainer, SetPayload.length);
                SetPayload.forEach(function (RowData, Index) {
                    if (SetRows[Index]) {
                        Work.push(ZTSMServicePayloadRowApply(SetRows[Index], RowData || {}, SetName));
                    }
                });
            }
            else {
                Work.push(ZTSMServicePayloadRowApply(FieldContainer, Rows[0] || {}, SetName));
            }
        });

        return Promise.all(Work).then(function () {
            ZTSMServiceExtensionSetIndexNormalize(Start, End);
            ZTSMServiceExtensionLayoutFix(Start, End);
            ZTSMServicePayloadAutocompleteSettle(Root);
            ZTSMServicePayloadFormSubmitReset();
        });
    }

    function ZTSMServicePayloadCollect() {
        var Start = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsStart'),
            End = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsEnd'),
            Root = Start && End ? Start.parentNode : document,
            Payload = {};

        if (!Root) {
            return Payload;
        }

        Array.prototype.forEach.call(Root.querySelectorAll('.ZTSMServiceExtensionField'), function (FieldContainer) {
            var SetName = ZTSMServicePayloadContainerName(FieldContainer),
                Rows;

            if (!SetName) {
                return;
            }

            if (FieldContainer.querySelector('input[type="hidden"][name^="SetIndex_"]')) {
                Payload[SetName] = [];
                Rows = ZTSMServicePayloadSetRows(FieldContainer);
                Rows.forEach(function (Row) {
                    Payload[SetName].push(ZTSMServicePayloadRowCollect(Row));
                });
            }
            else {
                ZTSMServicePayloadControls(FieldContainer).forEach(function (Element) {
                    var Value = ZTSMServicePayloadOutputValue(Element);

                    Payload[SetName] = ZTSMServicePayloadValueMerge(Payload[SetName], Value);
                    ZTSMServicePayloadCollectDebug(Element, SetName, Value);
                });
            }
        });

        return Payload;
    }

    function ZTSMServicePayloadTemplateFields() {
        var Start = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsStart'),
            End = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsEnd'),
            Root = Start && End ? Start.parentNode : document,
            Fields = [],
            Seen = {};

        if (!Root) {
            return Fields;
        }

        Array.prototype.forEach.call(Root.querySelectorAll('.ZTSMServiceExtensionField'), function (FieldContainer) {
            var SetName,
                SetRows;

            if (ZTSMServiceExtensionElementHidden(FieldContainer)) {
                return;
            }

            SetName = ZTSMServicePayloadContainerName(FieldContainer);
            if (!SetName) {
                return;
            }

            SetRows = ZTSMServicePayloadSetRows(FieldContainer);
            ZTSMServicePayloadControls(SetRows[0] || FieldContainer).forEach(function (Element) {
                var FieldName = ZTSMServicePayloadFieldBaseName(Element),
                    Label = ZTSMServicePayloadLabelText(Element),
                    Header,
                    Key,
                    Required = Element.classList.contains('Validate_Required') || !!(
                        Element.id
                        && document.querySelector('label[for="' + Element.id.replace(/"/g, '\\"') + '"] .Marker')
                    );

                if (!FieldName) {
                    return;
                }

                Header = SetName && SetName !== FieldName ? SetName + '.' + FieldName : FieldName;
                Key = ZTSMServicePayloadNormalize(Header);
                if (Seen[Key]) {
                    return;
                }

                Seen[Key] = 1;
                Fields.push({
                    Header: Header,
                    Field: FieldName,
                    Group: SetName,
                    Label: Label || FieldName,
                    Required: Required ? 'Yes' : '',
                    Type: Element.tagName === 'SELECT' ? 'Dropdown name or value'
                        : Element.name.indexOf('Autocomplete_DynamicField_') === 0 ? 'Reference name or Name::ID'
                        : Element.type === 'checkbox' ? '1/true/yes or blank'
                        : 'Text'
                });
            });
        });

        return Fields;
    }

    function ZTSMServicePayloadCSVValue(Value) {
        Value = Value === null || Value === undefined ? '' : String(Value);
        return /[",\r\n]/.test(Value) ? '"' + Value.replace(/"/g, '""') + '"' : Value;
    }

    function ZTSMServicePayloadDownload(Name, Content, Type) {
        var Link = document.createElement('a'),
            BlobObject = new Blob([ Content ], {
                type: Type || 'text/plain'
            });

        Link.href = URL.createObjectURL(BlobObject);
        Link.download = Name;
        document.body.appendChild(Link);
        Link.click();
        document.body.removeChild(Link);
        setTimeout(function () {
            URL.revokeObjectURL(Link.href);
        }, 0);
    }

    function ZTSMServicePayloadTemplateDownload() {
        var Fields = ZTSMServicePayloadTemplateFields(),
            Headers,
            BlankRow,
            Workbook,
            TemplateSheet,
            InstructionRows,
            InstructionSheet,
            CSV;

        if (!Fields.length) {
            return false;
        }

        Headers = Fields.map(function (Field) {
            return Field.Header;
        });
        BlankRow = Headers.map(function () {
            return '';
        });

        if (window.XLSX) {
            Workbook = XLSX.utils.book_new();
            TemplateSheet = XLSX.utils.aoa_to_sheet([ Headers, BlankRow ]);
            InstructionRows = [
                [ 'Column header', 'Field label', 'Field name', 'Payload group', 'Required', 'Accepted value' ]
            ];
            Fields.forEach(function (Field) {
                InstructionRows.push([
                    Field.Header,
                    Field.Label,
                    Field.Field,
                    Field.Group,
                    Field.Required,
                    Field.Type
                ]);
            });
            InstructionSheet = XLSX.utils.aoa_to_sheet(InstructionRows);
            XLSX.utils.book_append_sheet(Workbook, TemplateSheet, 'Template');
            XLSX.utils.book_append_sheet(Workbook, InstructionSheet, 'Instructions');
            XLSX.writeFile(Workbook, 'tessera-service-payload-template.xlsx');
            return true;
        }

        CSV = [ Headers, BlankRow ].map(function (Row) {
            return Row.map(ZTSMServicePayloadCSVValue).join(',');
        }).join('\r\n');
        ZTSMServicePayloadDownload('tessera-service-payload-template.csv', CSV, 'text/csv;charset=utf-8');
        return true;
    }

    function ZTSMServicePayloadStatus(Tools, Message) {
        var Statuses = Tools ? Tools.querySelectorAll('.ZTSMServicePayloadStatus') : [];

        Array.prototype.forEach.call(Statuses, function (Status) {
            Status.textContent = Message || '';
            if (Status.classList.contains('ZTSMServicePayloadToast')) {
                Status.classList.toggle('ZTSMServicePayloadToastVisible', !!Message);
                if (Message) {
                    window.clearTimeout(Status.ZTSMServicePayloadToastTimer);
                    Status.ZTSMServicePayloadToastTimer = window.setTimeout(function () {
                        Status.classList.remove('ZTSMServicePayloadToastVisible');
                    }, 2600);
                }
            }
        });
    }

    function ZTSMServicePayloadCurrentSignature() {
        var Fields = ZTSMServicePayloadTemplateFields().map(function (Field) {
            return Field.Header + ':' + Field.Field;
        });

        return JSON.stringify({
            ServiceID: ZTSMServiceExtensionValue(),
            Fields: Fields
        });
    }

    function ZTSMServicePayloadCodeGenerate(Code) {
        if (!Code) {
            return;
        }

        Code.value = JSON.stringify(ZTSMServicePayloadCollect(), null, 2);
        Code.dataset.ZTSMServicePayloadSignature = ZTSMServicePayloadCurrentSignature();
        delete Code.dataset.ZTSMServicePayloadStale;
    }

    function ZTSMServicePayloadCodeInvalidate() {
        var Code = ZTSMFirst('#ZTSMServicePayloadTools .ZTSMServicePayloadCode');

        if (!Code) {
            return;
        }

        Code.dataset.ZTSMServicePayloadStale = '1';
    }

    function ZTSMServicePayloadToolsEnsure(Start, End) {
        var Existing = ZTSMFirst('#ZTSMServicePayloadTools'),
            Tools,
            Upload,
            Code,
            Drawer,
            TemplateButton,
            ImportButton,
            CodeButton,
            ApplyButtons,
            CloseButtons;

        if (!Start || !End) {
            return;
        }

        if (Existing) {
            return;
        }

        Tools = document.createElement('div');
        Tools.id = 'ZTSMServicePayloadTools';
        Tools.className = 'ZTSMServicePayloadTools';
        Tools.innerHTML = ''
            + '<div class="ZTSMServicePayloadToolbar">'
            + '<button type="button" class="ZTSMServicePayloadIconButton" data-ztsm-payload-template="1" title="Download template" aria-label="Download template"><i class="fa fa-download" aria-hidden="true"></i></button>'
            + '<button type="button" class="ZTSMServicePayloadIconButton" data-ztsm-payload-import="1" title="Upload template" aria-label="Upload template"><i class="fa fa-upload" aria-hidden="true"></i></button>'
            + '<button type="button" class="ZTSMServicePayloadIconButton" data-ztsm-payload-code="1" title="View JSON" aria-label="View JSON" aria-pressed="false"><i class="fa fa-code" aria-hidden="true"></i></button>'
            + '<button type="button" class="ZTSMServicePayloadIconButton Hidden" data-ztsm-payload-apply="1" title="Apply JSON" aria-label="Apply JSON"><i class="fa fa-check" aria-hidden="true"></i></button>'
            + '</div>'
            + '<span class="ZTSMServicePayloadStatus ZTSMServicePayloadToast" aria-live="polite"></span>'
            + '<input type="file" class="Hidden" accept=".xlsx,.xls,.csv,text/csv" data-ztsm-payload-file="1"/>'
            + '<div class="ZTSMServicePayloadDrawer" role="dialog" aria-modal="false" aria-labelledby="ZTSMServicePayloadDrawerTitle">'
            + '<div class="ZTSMServicePayloadDrawerHeader">'
            + '<div class="ZTSMServicePayloadDrawerTitle" id="ZTSMServicePayloadDrawerTitle">JSON Template Editor</div>'
            + '<button type="button" class="ZTSMServicePayloadIconButton" data-ztsm-payload-close="1" title="Close JSON editor" aria-label="Close JSON editor"><i class="fa fa-times" aria-hidden="true"></i></button>'
            + '</div>'
            + '<textarea class="ZTSMServicePayloadCode" spellcheck="false"></textarea>'
            + '<div class="ZTSMServicePayloadDrawerFooter">'
            + '<span class="ZTSMServicePayloadStatus"></span>'
            + '<button type="button" class="ZTSMServicePayloadDrawerButton" data-ztsm-payload-close="1">Cancel</button>'
            + '<button type="button" class="ZTSMServicePayloadDrawerButton ZTSMServicePayloadDrawerButtonPrimary" data-ztsm-payload-apply="1">Apply</button>'
            + '</div>'
            + '</div>';

        document.body.appendChild(Tools);

        Upload = Tools.querySelector('[data-ztsm-payload-file]');
        Code = Tools.querySelector('.ZTSMServicePayloadCode');
        Drawer = Tools.querySelector('.ZTSMServicePayloadDrawer');
        TemplateButton = Tools.querySelector('[data-ztsm-payload-template]');
        ImportButton = Tools.querySelector('[data-ztsm-payload-import]');
        CodeButton = Tools.querySelector('[data-ztsm-payload-code]');
        ApplyButtons = Tools.querySelectorAll('[data-ztsm-payload-apply]');
        CloseButtons = Tools.querySelectorAll('[data-ztsm-payload-close]');

        function DrawerToggle(Open) {
            var IsOpen = Open !== undefined ? Open : !Drawer.classList.contains('ZTSMServicePayloadDrawerOpen');

            if (IsOpen) {
                ZTSMServicePayloadCodeGenerate(Code);
                Drawer.classList.add('ZTSMServicePayloadDrawerOpen');
                Tools.querySelector('[data-ztsm-payload-apply]').classList.remove('Hidden');
                CodeButton.setAttribute('title', 'Hide service payload JSON');
                CodeButton.setAttribute('aria-label', 'Hide service payload JSON');
                CodeButton.setAttribute('aria-pressed', 'true');
                window.setTimeout(function () {
                    Code.focus();
                }, 0);
            }
            else {
                Drawer.classList.remove('ZTSMServicePayloadDrawerOpen');
                Tools.querySelector('[data-ztsm-payload-apply]').classList.add('Hidden');
                CodeButton.setAttribute('title', 'View JSON');
                CodeButton.setAttribute('aria-label', 'View JSON');
                CodeButton.setAttribute('aria-pressed', 'false');
            }
        }

        function PayloadApply() {
            var Payload,
                CurrentSignature = ZTSMServicePayloadCurrentSignature();

            if (
                Code.dataset.ZTSMServicePayloadStale === '1'
                || (Code.dataset.ZTSMServicePayloadSignature && Code.dataset.ZTSMServicePayloadSignature !== CurrentSignature)
            ) {
                ZTSMServicePayloadCodeGenerate(Code);
                ZTSMServicePayloadStatus(Tools, 'Service changed. Payload JSON regenerated; review before applying.');
                return;
            }

            try {
                Payload = JSON.parse(Code.value || '{}');
            }
            catch (Error) {
                ZTSMServicePayloadStatus(Tools, 'Invalid JSON.');
                return;
            }

            ZTSMServicePayloadStatus(Tools, 'Applying...');
            ZTSMServicePayloadApply(Payload).then(function () {
                ZTSMServicePayloadStatus(Tools, 'Payload applied.');
                ZTSMServicePayloadFormSubmitReset();
                DrawerToggle(false);
                Code.blur();
                CodeButton.focus();
            });
        }

        TemplateButton.addEventListener('click', function () {
            if (ZTSMServicePayloadTemplateDownload()) {
                ZTSMServicePayloadStatus(Tools, 'Template downloaded.');
            }
            else {
                ZTSMServicePayloadStatus(Tools, 'No service payload fields available.');
            }
        });

        ImportButton.addEventListener('click', function () {
            Upload.click();
        });

        Upload.addEventListener('change', function () {
            var File = Upload.files && Upload.files[0];

            if (!File) {
                return;
            }

            ZTSMServicePayloadStatus(Tools, 'Importing...');
            ZTSMServicePayloadFileRead(File).then(function (Rows) {
                return ZTSMServicePayloadApply(Rows).then(function () {
                    ZTSMServicePayloadStatus(Tools, Rows.length + ' row(s) imported.');
                    Upload.value = '';
                    ZTSMServicePayloadFormSubmitReset();
                    DrawerToggle(false);
                    CodeButton.focus();
                });
            }).catch(function (Error) {
                ZTSMServicePayloadStatus(Tools, Error && Error.message ? Error.message : 'Import failed.');
                Upload.value = '';
            });
        });

        CodeButton.addEventListener('click', function () {
            DrawerToggle();
        });

        Array.prototype.forEach.call(ApplyButtons, function (ApplyButton) {
            ApplyButton.addEventListener('click', PayloadApply);
        });

        Array.prototype.forEach.call(CloseButtons, function (CloseButton) {
            CloseButton.addEventListener('click', function () {
                DrawerToggle(false);
            });
        });
    }

    function ZTSMServiceExtensionDatepickerConfigEnsure() {
        var DatepickerConfig;

        if (!window.Core || !Core.Config || typeof Core.Config.Get !== 'function' || typeof Core.Config.Set !== 'function') {
            return {
                TimeVacationDays: {},
                TimeVacationDaysOneTime: {}
            };
        }

        DatepickerConfig = Core.Config.Get('Datepicker.VacationDays');

        if (DatepickerConfig && DatepickerConfig.TimeVacationDays && DatepickerConfig.TimeVacationDaysOneTime) {
            return DatepickerConfig;
        }

        DatepickerConfig = {
            TimeVacationDays: {},
            TimeVacationDaysOneTime: {}
        };

        Core.Config.Set('Datepicker.VacationDays', DatepickerConfig);

        return DatepickerConfig;
    }

    function ZTSMServiceExtensionDateTimeDebug(Prefix, Suffix, DayField, MonthField, YearField, HourField, MinuteField, DatepickerOptions) {
        var DateObject,
            NowObject;

        if (!ZTSMServicePayloadDebugEnabled() || !window.console || !window.console.log) {
            return;
        }

        DateObject = new Date(
            YearField && YearField.value,
            MonthField && MonthField.value ? MonthField.value - 1 : 0,
            DayField && DayField.value,
            HourField && HourField.value ? HourField.value : 0,
            MinuteField && MinuteField.value ? MinuteField.value : 0,
            0,
            0
        );
        NowObject = new Date();

        window.console.log('[TESSERA service-extension]', 'datetime-validation-link', {
            prefix: Prefix,
            suffix: Suffix,
            value: {
                year: YearField && YearField.value,
                month: MonthField && MonthField.value,
                day: DayField && DayField.value,
                hour: HourField && HourField.value,
                minute: MinuteField && MinuteField.value
            },
            dateISO: isNaN(DateObject.getTime()) ? null : DateObject.toISOString(),
            nowISO: NowObject.toISOString(),
            dateEpoch: isNaN(DateObject.getTime()) ? null : DateObject.getTime(),
            nowEpoch: NowObject.getTime(),
            dateNotInFuture: !!(DatepickerOptions && DatepickerOptions.DateNotInFuture),
            dateInFuture: !!(DatepickerOptions && DatepickerOptions.DateInFuture),
            dayClass: DayField && DayField.className
        });
    }

    function ZTSMServiceExtensionDateTimeServerErrorsLog(Root) {
        Root = Root || document;

        if (!window.console || typeof window.console.warn !== 'function') {
            return;
        }

        Array.prototype.forEach.call(Root.querySelectorAll('.ZTSMServiceExtensionField .DynamicFieldDate select.ServerError, .ZTSMServiceExtensionField .DynamicFieldDate input.ServerError'), function (Element) {
            var Container = Element.closest('.DynamicFieldDate'),
                Prefix,
                YearField,
                MonthField,
                DayField,
                HourField,
                MinuteField,
                UsedField,
                SubmittedDate,
                BrowserNow,
                DeltaSeconds,
                MessageNode,
                Message,
                Restriction,
                BrowserOffset,
                FieldName;

            if (!Container || Container.dataset.ZTSMDateTimeServerErrorLogged === '1') {
                return;
            }

            YearField = ZTSMServiceExtensionDateTimePartFind(Container, '', 'Year')
                || Container.querySelector('.Validate_DateYear');
            Prefix = YearField && YearField.name
                ? YearField.name.replace(/Year$/, '')
                : (Element.name || Element.id || '').replace(/(?:Year|Month|Day|Hour|Minute|Second|Used)$/, '');
            YearField = YearField || ZTSMServiceExtensionDateTimePartFind(Container, Prefix, 'Year');
            MonthField = ZTSMServiceExtensionDateTimePartFind(Container, Prefix, 'Month');
            DayField = ZTSMServiceExtensionDateTimePartFind(Container, Prefix, 'Day');
            HourField = ZTSMServiceExtensionDateTimePartFind(Container, Prefix, 'Hour');
            MinuteField = ZTSMServiceExtensionDateTimePartFind(Container, Prefix, 'Minute');
            UsedField = ZTSMServiceExtensionDateTimePartFind(Container, Prefix, 'Used');
            BrowserNow = new Date();
            BrowserOffset = BrowserNow.getTimezoneOffset();
            FieldName = Prefix.replace(/^DynamicField_/, '').replace(/-$/, '');
            MessageNode = Container.querySelector('.TooltipErrorMessage[id$="ServerError"] p, .TooltipErrorMessage p');
            Message = MessageNode ? String(MessageNode.textContent || '').replace(/\s+/g, ' ').trim() : '';
            Restriction = DayField && (
                DayField.classList.contains('Validate_DateNotInFuture')
                || DayField.dataset.ZTSMDateRestriction === 'not-in-future'
            ) ? 'not-in-future'
                : DayField && (
                    DayField.classList.contains('Validate_DateInFuture')
                    || DayField.dataset.ZTSMDateRestriction === 'future-only'
                ) ? 'future-only'
                : 'unknown';

            if (YearField && MonthField && DayField) {
                SubmittedDate = new Date(
                    YearField.value,
                    MonthField.value ? MonthField.value - 1 : 0,
                    DayField.value,
                    HourField && HourField.value ? HourField.value : 0,
                    MinuteField && MinuteField.value ? MinuteField.value : 0,
                    0,
                    0
                );
            }

            DeltaSeconds = SubmittedDate && !isNaN(SubmittedDate.getTime())
                ? Math.round((SubmittedDate.getTime() - BrowserNow.getTime()) / 1000)
                : null;

            Container.dataset.ZTSMDateTimeServerErrorLogged = '1';
            window.console.warn(
                '[TESSERA service-extension] Date/DateTime server validation error:'
                + ' field=' + FieldName
                + ' message="' + Message + '"'
                + ' submittedLocal="' + (YearField ? YearField.value : '') + '-' + (MonthField ? MonthField.value : '') + '-' + (DayField ? DayField.value : '')
                + ' ' + (HourField ? HourField.value : '00') + ':' + (MinuteField ? MinuteField.value : '00') + '"'
                + ' submittedISO=' + (SubmittedDate && !isNaN(SubmittedDate.getTime()) ? SubmittedDate.toISOString() : 'invalid')
                + ' browserNowISO=' + BrowserNow.toISOString()
                + ' deltaSeconds=' + DeltaSeconds
                + ' browserOffsetMinutes=' + BrowserOffset
                + ' restriction=' + Restriction
                + ' used=' + (UsedField ? UsedField.checked : 'n/a')
                + ' prefix=' + Prefix
            );
        });
    }

    function ZTSMServiceExtensionDateTimePartFind(Container, Prefix, Part) {
        var Fields;

        if (!Container) {
            return null;
        }

        Fields = Container.querySelectorAll('select, input');
        return Array.prototype.filter.call(Fields, function (Field) {
            if (Prefix) {
                return Field.name === Prefix + Part
                    || Field.id === Prefix + Part
                    || (Field.id && Field.id.indexOf(Prefix + Part) === 0);
            }
            return Field.name && Field.name.slice(-Part.length) === Part;
        })[0] || null;
    }

    function ZTSMServiceExtensionDatepickerInit(Start, End) {
        var Root = Start && End ? Start.parentNode : document,
            DatepickerConfig;

        if (!Root || !window.Core || !Core.UI || !Core.UI.Datepicker || typeof Core.UI.Datepicker.Init !== 'function') {
            return;
        }
        if (!window.jQuery || !window.Core.App || typeof Core.App.EscapeSelector !== 'function') {
            return;
        }

        DatepickerConfig = ZTSMServiceExtensionDatepickerConfigEnsure();

        Array.prototype.forEach.call(Root.querySelectorAll('.ZTSMServiceExtensionField .Validate_DateYear'), function (YearField) {
            var Prefix,
                Suffix,
                DayID,
                Container = YearField.closest('.DynamicFieldDate'),
                DayField,
                MonthField,
                HourField,
                MinuteField,
                DatepickerOptions,
                $Container;

            if (!Container || !YearField.name || YearField.name.slice(-4) !== 'Year') {
                return;
            }

            Prefix = YearField.name.slice(0, -4);
            Suffix = YearField.id && YearField.id.length > Prefix.length ? YearField.id.slice(Prefix.length + 4) : '';
            DayID = Prefix + 'Day' + Suffix;
            DayField = document.getElementById(DayID);
            MonthField = document.getElementById(Prefix + 'Month' + Suffix);
            HourField = document.getElementById(Prefix + 'Hour' + Suffix);
            MinuteField = document.getElementById(Prefix + 'Minute' + Suffix);

            if (DayField && Suffix) {
                DayField.classList.add('Validate_DateYear_' + Prefix + 'Year' + Suffix);
                DayField.classList.add('Validate_DateMonth_' + Prefix + 'Month' + Suffix);

                if (HourField && MinuteField) {
                    DayField.classList.add('Validate_DateHour_' + Prefix + 'Hour' + Suffix);
                    DayField.classList.add('Validate_DateMinute_' + Prefix + 'Minute' + Suffix);
                }
            }

            $Container = jQuery(Container);
            DatepickerOptions = {
                Day: jQuery('#' + Core.App.EscapeSelector(Prefix + 'Day' + Suffix), $Container),
                Month: jQuery('#' + Core.App.EscapeSelector(Prefix + 'Month' + Suffix), $Container),
                Year: jQuery('#' + Core.App.EscapeSelector(Prefix + 'Year' + Suffix), $Container),
                Hour: jQuery('#' + Core.App.EscapeSelector(Prefix + 'Hour' + Suffix), $Container),
                Minute: jQuery('#' + Core.App.EscapeSelector(Prefix + 'Minute' + Suffix), $Container),
                VacationDays: DatepickerConfig,
                WeekDayStart: Core.Config.Get('CalendarWeekDayStart') || 1
            };

            if (DayField && DayField.classList.contains('Validate_DateInFuture')) {
                DayField.dataset.ZTSMDateRestriction = 'future-only';
                DayField.classList.remove('Validate_DateInFuture');
            }
            if (DayField && DayField.classList.contains('Validate_DateNotInFuture')) {
                DayField.dataset.ZTSMDateRestriction = 'not-in-future';
                DayField.classList.remove('Validate_DateNotInFuture');
            }

            ZTSMServiceExtensionDateTimeDebug(Prefix, Suffix, DayField, MonthField, YearField, HourField, MinuteField, DatepickerOptions);

            if (document.getElementById(DayID + 'DatepickerIcon')) {
                return;
            }

            ZTSMServiceExtensionSafeInit(function () {
                Core.UI.Datepicker.Init(DatepickerOptions);
            });
        });
    }

    function ZTSMServiceSelectedTreeLabelsEnsure(Service) {
        Array.prototype.forEach.call(Service.options || [], function (Option) {
            var RawText,
                Leading;

            if (Option.dataset.ZTSMTreeLabel) {
                return;
            }

            RawText = String(Option.textContent || Option.innerText || '');
            Leading = RawText.match(/^[\u00a0\s]*/);

            Option.dataset.ZTSMTreeLabel = RawText;
            Option.dataset.ZTSMTreeDepth = Leading ? String(Math.floor(Leading[0].replace(/[^\u00a0]/g, '').length / 2)) : '0';
        });
    }

    function ZTSMServiceSelectedTreeLabelsRestore(Service) {
        Array.prototype.forEach.call(Service.options || [], function (Option) {
            if (!Option.dataset.ZTSMTreeLabel) {
                return;
            }
            if (Option.textContent !== Option.dataset.ZTSMTreeLabel) {
                Option.textContent = Option.dataset.ZTSMTreeLabel;
            }
        });
    }

    function ZTSMServiceSelectedFullPathGet(Service) {
        var Stack = [],
            SelectedValue = String(Service.value || ''),
            Result = '';

        ZTSMServiceSelectedTreeLabelsEnsure(Service);

        Array.prototype.forEach.call(Service.options || [], function (Option) {
            var RawText = String(Option.dataset.ZTSMTreeLabel || Option.textContent || Option.innerText || ''),
                Text = RawText.replace(/^\s+|\s+$/g, ''),
                Depth = parseInt(Option.dataset.ZTSMTreeDepth || '0', 10),
                IsRealOption = String(Option.value || '') !== '' && String(Option.value || '') !== '-';

            if (!Text || Text === '-') {
                return;
            }

            Stack = Stack.slice(0, Depth);
            Stack[Depth] = Text;

            if (IsRealOption && SelectedValue && String(Option.value) === SelectedValue) {
                Result = Stack.slice(0, Depth + 1).join('::');
            }
        });

        return Result;
    }

    function ZTSMServiceSelectedFullPathRefresh() {
        var Service = ZTSMFirst('select#ServiceID, select[name="ServiceID"]'),
            Label,
            Container,
            Selection,
            SearchInput;

        if (!Service || !Service.options || !Service.value) {
            return;
        }

        Label = ZTSMServiceSelectedFullPathGet(Service);
        if (!Label) {
            return;
        }

        Service.setAttribute('data-ztsm-full-service-label', Label);
        if (Service.options[Service.selectedIndex]) {
            Service.options[Service.selectedIndex].textContent = Label;
            Service.options[Service.selectedIndex].setAttribute('title', Label);
        }

        Container = ZTSMServicePayloadModernizedSelectContainer(Service);
        if (!Container) {
            return;
        }

        Container.classList.remove('ZTSMServiceFullPathSelected');
        Container.style.removeProperty('height');
        Container.style.removeProperty('min-height');

        Selection = Container.querySelector('.InputField_Selection');
        if (Selection) {
            Selection.textContent = Label;
            Selection.setAttribute('title', Label);
            Selection.setAttribute('data-value', Service.value);
            Selection.setAttribute('aria-label', Label);
            Selection.style.removeProperty('max-width');
            Selection.style.removeProperty('white-space');
            Selection.style.removeProperty('overflow');
            Selection.style.removeProperty('text-overflow');
            Selection.style.removeProperty('overflow-wrap');
            Selection.style.removeProperty('line-height');
        }

        SearchInput = Container.querySelector('.InputField_Search');
        if (SearchInput && document.activeElement !== SearchInput) {
            SearchInput.value = '';
            SearchInput.setAttribute('placeholder', '');
            SearchInput.setAttribute('title', Label);
        }
    }

    function ZTSMServiceSelectedTreeModePrepare() {
        var Service = ZTSMFirst('select#ServiceID, select[name="ServiceID"]');

        if (!Service || !Service.options) {
            return;
        }

        ZTSMServiceSelectedTreeLabelsRestore(Service);
    }

    function ZTSMServiceExtensionInitialize(Start, End) {
        var Node = Start.nextSibling,
            Event;

        ZTSMServiceExtensionDatepickerConfigEnsure();

        if (window.Core && Core.UI && Core.UI.InputFields && typeof Core.UI.InputFields.Init === 'function') {
            ZTSMServiceExtensionSafeInit(function () {
                Core.UI.InputFields.Init();
            });
        }
        if (window.Core && Core.Customer && Core.Customer.InputFields && typeof Core.Customer.InputFields.Init === 'function') {
            ZTSMServiceExtensionSafeInit(function () {
                Core.Customer.InputFields.Init();
            });
        }
        ZTSMServiceExtensionRichTextEditorsInit(Start, End);
        ZTSMServiceExtensionRichTextPrepare(Start, End);
        window.setTimeout(function () {
            ZTSMServiceExtensionRichTextPrepare(Start, End);
        }, 100);
        window.setTimeout(function () {
            ZTSMServiceExtensionRichTextPrepare(Start, End);
        }, 300);
        ZTSMServiceExtensionSetIndexNormalize(Start, End);
        ZTSMServiceExtensionDatepickerInit(Start, End);
        ZTSMServiceExtensionDateTimeServerErrorsLog(Start.parentNode || document);

        while (Node && Node !== End) {
            if (Node.nodeType === 1) {
                Event = document.createEvent('Event');
                Event.initEvent('change', true, true);

                Array.prototype.forEach.call(Node.querySelectorAll('select, input, textarea'), function (Field) {
                    if (
                        Field.closest('.RichTextHolder, .RichTextField, .ck, .ck-editor, .cke, .cke_chrome')
                        || Field.classList.contains('Validate_DateDay')
                        || Field.classList.contains('Validate_DateMonth')
                        || Field.classList.contains('Validate_DateYear')
                        || Field.classList.contains('Validate_DateHour')
                        || Field.classList.contains('Validate_DateMinute')
                    ) {
                        return;
                    }
                    Field.dispatchEvent(Event);
                });
            }
            Node = Node.nextSibling;
        }

        ZTSMServiceExtensionSetIndexNormalize(Start, End);
        ZTSMServiceExtensionLayoutFix(Start, End);
        ZTSMServicePayloadVisibleSelectionRefresh(Start.parentNode || document);
        ZTSMNetworkPoolDropdownRefreshLater();
        ZTSMHostnamePolicyResolveLater();
        if (ZTSMServicePayloadDebugEnabled()) {
            window.console.log('[TESSERA service-extension]', 'refresh-applied-values', {
                values: ZTSMServiceExtensionPreferenceSnapshot(document)
            });
        }
        ZTSMServicePayloadToolsEnsure(Start, End);
        window.setTimeout(ZTSMServiceSelectedFullPathRefresh, 0);
        window.setTimeout(function () {
            ZTSMServicePayloadVisibleSelectionRefresh(Start.parentNode || document);
            ZTSMNetworkPoolDropdownRefreshLater();
            ZTSMHostnamePolicyResolveLater();
            if (ZTSMServicePayloadDebugEnabled()) {
                window.console.log('[TESSERA service-extension]', 'refresh-applied-values-after-visible-refresh', {
                    values: ZTSMServiceExtensionPreferenceSnapshot(document)
                });
            }
        }, 50);
    }

    function ZTSMServiceExtensionWatch() {
        var LastServiceID = '',
            Service = ZTSMServiceElement(),
            ServiceCheckTimer,
            Events = [ 'change', 'input', 'keyup', 'paste', 'blur', 'select2:select', 'select2:unselect' ];

        ZTSMServicePayloadNativeSubmitTraceEnsure();

        function ZTSMServiceChangedHandle(Reason) {
            var CurrentServiceID = ZTSMServiceExtensionValue(),
                Start = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsStart'),
                End = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsEnd'),
                HasRenderedRows = Start && End ? ZTSMServiceExtensionHasRenderedRows(Start, End) : true;

            if (!CurrentServiceID || (CurrentServiceID === LastServiceID && HasRenderedRows)) {
                return;
            }

            LastServiceID = CurrentServiceID;
            ZTSMServicePayloadCodeInvalidate();
            ZTSMServiceSelectedFullPathRefresh();
            window.setTimeout(ZTSMServiceSelectedFullPathRefresh, 0);
            window.setTimeout(function () {
                ZTSMServiceExtensionRefresh({
                    ElementChanged: 'ServiceID',
                    Reason: Reason || 'service-change'
                });
            }, 0);
        }

        function ZTSMServiceChangedCheckLater(Reason) {
            window.clearTimeout(ServiceCheckTimer);
            ServiceCheckTimer = window.setTimeout(function () {
                ZTSMServiceChangedHandle(Reason);
            }, 80);
        }

        if (!document.body.dataset.ZTSMServiceExtensionRowActionWatch) {
            document.body.dataset.ZTSMServiceExtensionRowActionWatch = '1';
            document.body.addEventListener('click', function (Event) {
                var Control = Event.target && Event.target.closest ? Event.target.closest('.AddValueRow, .RemoveValueRow') : null,
                    Scope;

                if (!Control || !Control.closest('.ZTSMServiceExtensionField')) {
                    return;
                }

                Scope = Control.closest('.ZTSMServiceExtensionField') || document;
                ZTSMServiceExtensionNormalizeLater();
                if (window.ZTSMReferencePickerEnhance) {
                    window.ZTSMReferencePickerEnhance(Scope);
                    window.setTimeout(function () {
                        window.ZTSMReferencePickerEnhance(Scope);
                    }, 120);
                    window.setTimeout(function () {
                        window.ZTSMReferencePickerEnhance(Scope);
                    }, 350);
                }
            });
        }

        function ZTSMServiceSubmitTraceSync(Form, Stage) {
            var TicketForm = document.getElementById('NewCustomerTicket'),
                TargetForms = Form ? [Form] : Array.prototype.slice.call(document.querySelectorAll('form')),
                TraceID = '';

            if (TicketForm && TargetForms.indexOf(TicketForm) === -1) {
                TargetForms.unshift(TicketForm);
            }

            TargetForms.forEach(function (TargetForm) {
                var OffsetField,
                    TraceField;

                if (!TargetForm || !TargetForm.querySelector) {
                    return;
                }

                OffsetField = TargetForm.querySelector('input[name="ZTSMServiceBrowserTimezoneOffset"]');
                if (!OffsetField) {
                    OffsetField = document.createElement('input');
                    OffsetField.type = 'hidden';
                    OffsetField.name = 'ZTSMServiceBrowserTimezoneOffset';
                    TargetForm.appendChild(OffsetField);
                }
                OffsetField.value = String((new Date()).getTimezoneOffset());

                TraceField = TargetForm.querySelector('input[name="ZTSMServiceSubmitTraceID"]');
                if (!TraceField) {
                    TraceField = document.createElement('input');
                    TraceField.type = 'hidden';
                    TraceField.name = 'ZTSMServiceSubmitTraceID';
                    TargetForm.appendChild(TraceField);
                }
                if (!TraceField.value || Stage === 'click') {
                    TraceField.value = String(Date.now()) + '-' + Math.random().toString(36).slice(2, 10);
                }
                TraceID = TraceField.value;
            });

            return TraceID;
        }

        function ZTSMServiceBrowserTimezoneOffsetSync(Form) {
            return ZTSMServiceSubmitTraceSync(Form, 'offset-sync');
        }

        function ZTSMServiceSubmitTraceContext(Form, Stage) {
            var TraceID = ZTSMServiceSubmitTraceSync(Form, Stage),
                OffsetField = Form && Form.querySelector ? Form.querySelector('input[name="ZTSMServiceBrowserTimezoneOffset"]') : null,
                TraceField = Form && Form.querySelector ? Form.querySelector('input[name="ZTSMServiceSubmitTraceID"]') : null;

            return {
                traceID: TraceID || (TraceField ? TraceField.value : ''),
                browserOffsetMinutes: OffsetField ? OffsetField.value : '',
                browserNowISO: (new Date()).toISOString()
            };
        }

        ZTSMServiceBrowserTimezoneOffsetSync();

        if (!document.body.dataset.ZTSMHostnamePolicyWatch) {
            document.body.dataset.ZTSMHostnamePolicyWatch = '1';
            [ 'change', 'input', 'keyup', 'paste', 'blur', 'select2:select', 'select2:unselect' ].forEach(function (EventName) {
                document.body.addEventListener(EventName, function (Event) {
                    var Element = Event.target,
                        FieldName;

                    if (!Element || !Element.closest || !Element.closest('#NewCustomerTicket')) {
                        return;
                    }

                    FieldName = ZTSMServicePayloadFieldBaseName(Element);
                    if (ZTSMNetworkPoolContextFields().indexOf(FieldName) !== -1) {
                        ZTSMNetworkPoolDropdownRefreshLater();
                    }
                    if (ZTSMHostnamePolicyFields().indexOf(FieldName) === -1) {
                        return;
                    }

                    ZTSMHostnamePolicyResolveLater();
                }, true);
            });
        }

        ZTSMNetworkPoolDropdownRefreshLater();
        ZTSMHostnamePolicyHostnameFieldsLock();

        if (!document.body.dataset.ZTSMServiceExtensionSubmitWatch) {
            document.body.dataset.ZTSMServiceExtensionSubmitWatch = '1';
            document.body.addEventListener('invalid', function (Event) {
                var Element = Event.target;

                if (!Element || !Element.closest || !Element.closest('#NewCustomerTicket')) {
                    return;
                }

                ZTSMServicePayloadConsole('warn', '[ZTSM submit invalid]', Object.assign(ZTSMServiceSubmitTraceContext(Element.closest('form'), 'invalid'), {
                    name: Element.name || '',
                    id: Element.id || '',
                    className: Element.className || '',
                    value: Element.value || '',
                    validationMessage: Element.validationMessage || '',
                    fieldText: Element.closest('.FieldCell, .Row_DynamicField, .ZTSMServiceExtensionField')
                        ? String(Element.closest('.FieldCell, .Row_DynamicField, .ZTSMServiceExtensionField').textContent || '').replace(/\s+/g, ' ').trim().slice(0, 500)
                        : ''
                }));
            }, true);
            document.body.addEventListener('click', function (Event) {
                var Start = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsStart'),
                    End = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsEnd'),
                    Control = Event.target && Event.target.closest ? Event.target.closest('#NewCustomerTicket button[type="submit"], #NewCustomerTicket input[type="submit"]') : null,
                    Form,
                    Invalid,
                    Validator,
                    TraceContext;

                if (Start && End && Control) {
                    Form = Control.closest('form');
                    TraceContext = ZTSMServiceSubmitTraceContext(Form, 'click');
                    ZTSMServicePayloadFormSubmitReset();
                    if (Form && Form.querySelector) {
                        Invalid = Form.querySelector(':invalid');
                    }
                    if (Form && window.jQuery) {
                        Validator = window.jQuery(Form).data('validator');
                    }
                    ZTSMServicePayloadConsole('log', '[ZTSM submit click]', Object.assign(TraceContext, {
                        buttonText: String(Control.textContent || Control.value || '').replace(/\s+/g, ' ').trim(),
                        formClassName: Form ? (Form.className || '') : '',
                        formCheckValidity: Form && Form.checkValidity ? Form.checkValidity() : '',
                        disabledSubmits: Form && Form.querySelectorAll ? Form.querySelectorAll('button[type="submit"]:disabled, input[type="submit"]:disabled').length : 0,
                        validatorErrors: Validator && Validator.errorList ? Validator.errorList.length : '',
                        validatorErrorDetails: ZTSMServicePayloadValidatorErrorDetailsLog('[ZTSM submit click validator]', Validator),
                        validatorPending: Validator ? Validator.pendingRequest : '',
                        invalidName: Invalid ? (Invalid.name || '') : '',
                        invalidId: Invalid ? (Invalid.id || '') : '',
                        invalidValue: Invalid ? (Invalid.value || '') : '',
                        invalidMessage: Invalid ? (Invalid.validationMessage || '') : ''
                    }));
                }
            }, true);
            document.body.addEventListener('submit', function (Event) {
                var Start = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsStart'),
                    End = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsEnd'),
                    TraceContext;

                if (Start && End && Event.target && Event.target.closest && Event.target.closest('#NewCustomerTicket')) {
                    TraceContext = ZTSMServiceSubmitTraceContext(Event.target, 'submit');
                    ZTSMServicePayloadConsole('log', '[ZTSM submit event]', Object.assign(TraceContext, {
                        defaultPrevented: !!Event.defaultPrevented,
                        className: Event.target.className || '',
                        validatorErrorDetails: window.jQuery ? ZTSMServicePayloadValidatorErrorDetailsLog('[ZTSM submit event validator]', window.jQuery(Event.target).data('validator')) : [],
                        action: Event.target.action || '',
                        method: Event.target.method || ''
                    }));
                    window.setTimeout(function () {
                        ZTSMServicePayloadConsole('log', '[ZTSM submit after handlers]', Object.assign(ZTSMServiceSubmitTraceContext(Event.target, 'submit-after'), {
                            defaultPrevented: !!Event.defaultPrevented,
                            className: Event.target.className || '',
                            validatorErrorDetails: window.jQuery ? ZTSMServicePayloadValidatorErrorDetailsLog('[ZTSM submit after handlers validator]', window.jQuery(Event.target).data('validator')) : []
                        }));
                    }, 0);
                }
            }, true);
        }

        if (!document.body.dataset.ZTSMServiceFullPathWatch) {
            document.body.dataset.ZTSMServiceFullPathWatch = '1';
            [ 'mousedown', 'focus', 'click' ].forEach(function (EventName) {
                document.body.addEventListener(EventName, function (Event) {
                    var Element = Event.target;

                    if (
                        !Element
                        || !Element.closest
                        || !Element.closest('#ServiceID, [name="ServiceID"], .InputField_Container, .InputField_InputContainer')
                    ) {
                        return;
                    }

                    ZTSMServiceSelectedTreeModePrepare();
                    ZTSMServiceChangedCheckLater(EventName);
                    window.setTimeout(function () {
                        ZTSMServiceChangedHandle(EventName + '-settle');
                    }, 250);
                    window.setTimeout(function () {
                        ZTSMServiceChangedHandle(EventName + '-settle-late');
                    }, 600);
                }, true);
            });
            document.body.addEventListener('mouseup', function (Event) {
                var Element = Event.target,
                    Start = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsStart'),
                    End = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsEnd');

                if (
                    !Element
                    || !Element.closest
                    || !Element.closest('.InputField_Selection, .InputField_Dropdown, .InputField_Option, .select2-results__option, .select2-selection__choice, .select2-selection__rendered')
                ) {
                    return;
                }

                if (!Start || !End || !Service) {
                    return;
                }

                ZTSMServiceChangedCheckLater('service-ui-mouseup');
                window.setTimeout(function () {
                    ZTSMServiceChangedHandle('service-ui-mouseup-settle');
                }, 250);
                window.setTimeout(function () {
                    ZTSMServiceChangedHandle('service-ui-mouseup-settle-late');
                }, 600);
            }, true);
            document.body.addEventListener('keydown', function (Event) {
                if (Event.key !== 'Enter' && Event.key !== ' ') {
                    return;
                }
                if (!Event.target || !Event.target.closest || !Event.target.closest('#ServiceID, [name="ServiceID"], .InputField_Container, .InputField_InputContainer')) {
                    return;
                }

                ZTSMServiceChangedCheckLater('service-ui-key');
                window.setTimeout(function () {
                    ZTSMServiceChangedHandle('service-ui-key-settle');
                }, 250);
                window.setTimeout(function () {
                    ZTSMServiceChangedHandle('service-ui-key-settle-late');
                }, 600);
            }, true);
            [ 'select2:select', 'select2:unselect' ].forEach(function (EventName) {
                document.body.addEventListener(EventName, function () {
                    ZTSMServiceChangedCheckLater(EventName);
                }, true);
            });
            document.addEventListener('ZTSMReferencePicker:applied', function (Event) {
                var Detail = Event.detail || {},
                    Element = Detail.element || Event.target,
                    Hidden = Detail.hidden,
                    Field = Detail.field || '',
                    IsServicePicker = false;

                if (Element && Element.matches && Element.matches('select#ServiceID, select[name="ServiceID"], input#ServiceID, input[name="ServiceID"]')) {
                    IsServicePicker = true;
                }
                if (Hidden && Hidden.matches && Hidden.matches('input#ServiceID, input[name="ServiceID"]')) {
                    IsServicePicker = true;
                }
                if (Field === 'ServiceID' || Field === 'Service') {
                    IsServicePicker = true;
                }
                if (!IsServicePicker) {
                    return;
                }

                ZTSMServiceSelectedFullPathRefresh();
                ZTSMServiceChangedHandle('reference-picker-apply');
                window.setTimeout(function () {
                    ZTSMServiceSelectedFullPathRefresh();
                    ZTSMServiceChangedHandle('reference-picker-apply-settle');
                }, 0);
                window.setTimeout(function () {
                    ZTSMServiceChangedHandle('reference-picker-apply-late');
                }, 250);
            }, true);
            [ 'change', 'input', 'blur' ].forEach(function (EventName) {
                document.body.addEventListener(EventName, function (Event) {
                    var Element = Event.target;

                    if (
                        !Element
                        || !Element.matches
                        || !Element.matches('select#ServiceID, select[name="ServiceID"], input#ServiceID, input[name="ServiceID"]')
                    ) {
                        return;
                    }

                    ZTSMServiceSelectedFullPathRefresh();
                    window.setTimeout(ZTSMServiceSelectedFullPathRefresh, 0);
                    ZTSMServiceChangedCheckLater(EventName);
                }, true);
            });
            if (window.jQuery && !document.body.dataset.ZTSMServiceExtensionJQueryWatch) {
                document.body.dataset.ZTSMServiceExtensionJQueryWatch = '1';
                window.jQuery(document).on(
                    'change.ZTSMServiceExtension input.ZTSMServiceExtension blur.ZTSMServiceExtension select2:select.ZTSMServiceExtension select2:unselect.ZTSMServiceExtension',
                    'select#ServiceID, select[name="ServiceID"], input#ServiceID, input[name="ServiceID"], #ServiceID, [name="ServiceID"]',
                    function (Event) {
                        ZTSMServiceSelectedFullPathRefresh();
                        window.setTimeout(ZTSMServiceSelectedFullPathRefresh, 0);
                        ZTSMServiceChangedCheckLater((Event && Event.type ? Event.type : 'jquery-service') + '-jquery');
                        window.setTimeout(function () {
                            ZTSMServiceChangedHandle('jquery-service-settle');
                        }, 120);
                        window.setTimeout(function () {
                            ZTSMServiceChangedHandle('jquery-service-late');
                        }, 450);
                    }
                );
                window.jQuery(document).on('ajaxComplete.ZTSMServiceExtension', function () {
                    var Start = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsStart'),
                        End = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsEnd');

                    if (!Start || !End || !ZTSMServiceExtensionValue()) {
                        return;
                    }
                    if (ZTSMServiceExtensionHasRenderedRows(Start, End)) {
                        return;
                    }

                    ZTSMServiceSelectedFullPathRefresh();
                    ZTSMServiceChangedHandle('jquery-ajax-complete-empty-payload');
                });
            }
        }

        if (Service) {
            Events.forEach(function (EventName) {
                Service.addEventListener(EventName, function () {
                    ZTSMServiceSelectedFullPathRefresh();
                    window.setTimeout(ZTSMServiceSelectedFullPathRefresh, 0);
                    ZTSMServiceChangedCheckLater(EventName);
                });
            });

        }

        window.setTimeout(function () {
            var Start = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsStart'),
                End = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsEnd');

            if (
                Start
                && End
                && ZTSMServiceExtensionValue()
                && !ZTSMServiceExtensionHasRenderedRows(Start, End)
            ) {
                LastServiceID = ZTSMServiceExtensionValue();
                ZTSMServiceExtensionRefresh({
                    ElementChanged: 'ServiceID',
                    Reason: 'initial-service-value'
                });
            }
        }, 0);


        window.addEventListener('resize', function () {
            var Start = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsStart'),
                End = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsEnd');

            if (Start && End) {
                ZTSMServiceExtensionSetIndexNormalize(Start, End);
                ZTSMServiceExtensionLayoutFix(Start, End);
                ZTSMServicePayloadToolsEnsure(Start, End);
            }
        });
    }

    function ZTSMReady() {
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function () {
                var Start = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsStart'),
                    End = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsEnd');

                if (Start && End) {
                    ZTSMServiceExtensionMark(Start, End);
                    ZTSMServiceExtensionSetIndexNormalize(Start, End);
                    ZTSMServiceExtensionLayoutFix(Start, End);
                    ZTSMServiceExtensionInitialize(Start, End);
                    ZTSMServicePayloadToolsEnsure(Start, End);
                }
                ZTSMServiceExtensionWatch();
                window.setTimeout(ZTSMServiceSelectedFullPathRefresh, 0);
                if (window.ZTSMReferencePickerEnhance) {
                    window.ZTSMReferencePickerEnhance(document);
                }
            });
        }
        else {
            var Start = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsStart'),
                End = ZTSMFirst('#ZTSMServiceExtensionDynamicFieldsEnd');

            if (Start && End) {
                ZTSMServiceExtensionMark(Start, End);
                ZTSMServiceExtensionSetIndexNormalize(Start, End);
                ZTSMServiceExtensionLayoutFix(Start, End);
                ZTSMServiceExtensionInitialize(Start, End);
                ZTSMServicePayloadToolsEnsure(Start, End);
            }
            ZTSMServiceExtensionWatch();
            window.setTimeout(ZTSMServiceSelectedFullPathRefresh, 0);
            if (window.ZTSMReferencePickerEnhance) {
                window.ZTSMReferencePickerEnhance(document);
            }
        }
    }

    ZTSMReady();
}());
</script>
