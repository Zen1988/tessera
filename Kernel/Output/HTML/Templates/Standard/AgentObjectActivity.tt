<div class="LayoutPopup ARIARoleMain"><div class="Header"><h1>[% Translate("Activity Articles") | html %]: [% Data.ObjectType | html %] [% Data.Number | html %] - [% Data.Name | html %]</h1><p><a href="[% Env("Baselink") %]Action=[% Data.ReturnAction | html %]">[% Translate("Cancel & close") | html %]</a></p></div><div class="Content"><table class="DataTable"><thead><tr><th>[% Translate("Time") | html %]</th><th>[% Translate("Source") | html %]</th><th>[% Translate("Subject") | html %]</th><th>[% Translate("Body") | html %]</th><th>[% Translate("Author") | html %]</th></tr></thead><tbody>[% FOREACH A IN Data.Activities %]<tr><td>[% A.CreateTime | html %]</td><td>[% A.Source | html %]</td><td><strong>[% A.Subject | html %]</strong><br>[% A.EventType | html %]</td><td><pre>[% A.Body | html %]</pre>[% IF A.Payload %]<details><summary>[% Translate("Technical payload") | html %]</summary><pre>[% A.Payload | html %]</pre></details>[% END %]</td><td>[% A.CreateBy | html %]</td></tr>[% END %]</tbody></table></div></div>
