[% IF Data.FullPage %]
<div class="LayoutPopup ARIARoleMain">
    <div class="Header"><h1>[% Translate("Delete MELT Object") | html %]</h1></div>
    <div class="Content">
[% END %]
<fieldset class="TableLike W300px">

    <label>[% Translate("Name") | html %]:</label>
    <p class="Value">
        [% Data.Name | html %]
    </p>
    <div class="Clear"></div>

    <label>[% Translate("Number") | html %]:</label>
    <p class="Value">
        [% Translate(Data.Number) | html %]
    </p>
    <div class="Clear"></div>


</fieldset>
<p class="SpacingTop Center">
    [% Translate("Do you really want to delete this MELT Object?") | html %]
</p>
[% IF Data.FullPage %]
        <form action="[% Env("CGIHandle") %]" method="post" class="Center SpacingTop">
            <input type="hidden" name="Action" value="AgentMELTObjectDelete"/>
            <input type="hidden" name="Subaction" value="MELTObjectDelete"/>
            <input type="hidden" name="MELTObjectID" value="[% Data.MELTObjectID | html %]"/>
            <input type="hidden" name="ChallengeToken" value="[% Env("ChallengeToken") | html %]"/>
            <button class="CallForAction Primary" type="submit"><span>[% Translate("Delete") | html %]</span></button>
            <a class="CallForAction" href="[% Env("Baselink") %]Action=AgentMELTObjectZoom;MELTObjectID=[% Data.MELTObjectID | uri %]"><span>[% Translate("Cancel") | html %]</span></a>
        </form>
    </div>
</div>
[% END %]

