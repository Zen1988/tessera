<div class="LayoutPopup ARIARoleMain"><div class="Header">
<h1>[% Translate("Asset Activity Articles") | html %]: [% Data.Number | html %] - [% Data.Name | html %]</h1>
<p><a href="[% Env("Baselink") %]Action=AgentITSMConfigItemZoom;ConfigItemID=[% Data.ConfigItemID | uri %]">[% Translate("Cancel & close") | html %]</a></p></div>
<div class="Content"><table class="DataTable"><thead><tr><th>[% Translate("Time") | html %]</th><th>[% Translate("Source") | html %]</th><th>[% Translate("Subject") | html %]</th><th>[% Translate("Body") | html %]</th><th>[% Translate("Author") | html %]</th></tr></thead><tbody>
[% FOREACH Activity IN Data.Activities %]<tr><td>[% Activity.CreateTime | html %]</td><td>[% Activity.Source | html %]</td><td><strong>[% Activity.Subject | html %]</strong><br>[% Activity.EventType | html %]</td><td><pre>[% Activity.Body | html %]</pre>[% IF Activity.Payload %]<details><summary>[% Translate("Technical payload") | html %]</summary><pre>[% Activity.Payload | html %]</pre></details>[% END %]</td><td>[% Activity.CreateBy | html %]</td></tr>[% END %]
</tbody></table></div></div>
