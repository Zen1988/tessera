# --
# Kernel/Output/HTML/Templates/Standard/CustomerTicketZTSMRiskAssessment.tt
# --

[% IF Data.Inline %]
<div class="ZTSMRiskAssessmentPage ZTSMRiskAssessmentInline">
[% ELSE %]
<div id="oooContent" class="TicketZoom ZTSMRiskAssessmentPage ARIARoleMain">
[% END %]
    <style>
        .ZTSMRiskAssessmentPage .ZTSMRiskAssessmentReferenceControl .ZTSMReferencePickerButton {
            right: 10px !important;
        }

        .ZTSMRiskAssessmentPage .ZTSMRiskAssessmentReferenceControl { position: relative; }
        .ZTSMRiskAssessmentPage .ZTSMRiskAssessmentField .DynamicFieldReference {
            padding-right: 56px;
        }

        .ZTSMRiskAssessmentPage .ZTSMRiskAssessmentField[aria-invalid="true"] {
            outline: 2px solid #b42318;
            outline-offset: 4px;
            border-radius: 4px;
        }
        .ZTSMRiskAssessmentPage .ZTSMRiskAssessmentFieldError {
            display: block;
            color: #b42318;
            font-size: 0.875rem;
        }

        .ZTSMRiskAssessmentPage .ZTSMRiskAssessmentLayout {
            --ZTSMNavigationOffset: 56px;
            --ZTSMRiskViewportHeight: 720px;
            width: 100%;
            max-width: 1180px;
            min-height: 100vh;
            padding: 16px 18px 32px calc(var(--ZTSMNavigationOffset) + 28px);
            background: #f4f6fb;
            transition: padding-left 0.3s ease;
        }
        .ZTSMRiskAssessmentInline .ZTSMRiskAssessmentLayout {
            max-width: none;
            min-height: 0;
            padding: 0;
            background: transparent;
        }
        .ZTSMRiskAssessmentInline {
            width: 100%;
            margin: 0;
        }
        .ZTSMRiskAssessmentShell {
            padding: 0;
            width: 100%;
            max-width: none;
            margin: 0;
        }
        .ZTSMRiskAssessmentShell h1 {
            margin: 0 0 8px;
            font-size: 16px;
            line-height: 1.3;
        }
        .ZTSMRiskAssessmentRows {
            display: flex;
            flex-direction: column;
            gap: 8px;
            max-height: none;
            overflow: visible;
            padding-right: 4px;
            scrollbar-gutter: stable;
        }
        .ZTSMRiskAssessmentRow {
            padding: 12px;
            border: 1px solid #d6d9e6;
            border-radius: 8px;
            background: #fff;
            box-shadow: 0 8px 18px rgba(3, 10, 46, 0.05);
        }
        .ZTSMRiskAssessmentRowHead {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 10px;
            color: #11194f;
            font-size: 12px;
        }
        .ZTSMRiskAssessmentRowBody,
        .ZTSMRiskAssessmentRowLayout {
            display: grid;
            grid-template-columns: minmax(170px, 0.42fr) minmax(0, 1fr);
            gap: 10px 12px;
            align-items: stretch;
        }
        .ZTSMRiskAssessmentBand,
        .ZTSMRiskAssessmentStack,
        .ZTSMRiskAssessmentEquation,
        .ZTSMRiskAssessmentTargets {
            min-width: 0;
        }
        .ZTSMRiskAssessmentBandStatement,
        .ZTSMRiskAssessmentTargets {
            grid-column: 1 / -1;
        }
        .ZTSMRiskAssessmentBandStatement .ZTSMRiskAssessmentField input {
            height: 34px !important;
            font-size: 13px;
        }
        .ZTSMRiskAssessmentStack {
            display: grid;
            gap: 8px;
        }
        .ZTSMRiskAssessmentBandDetail,
        .ZTSMRiskAssessmentBandPlan {
            display: grid;
        }
        .ZTSMRiskAssessmentEquation {
            grid-column: 1 / -1;
            display: grid;
            grid-template-columns: minmax(96px, 0.8fr) 16px minmax(96px, 0.8fr) 16px minmax(90px, 0.7fr) minmax(104px, 0.6fr);
            gap: 6px;
            align-items: end;
        }
        .ZTSMRiskAssessmentEquation .ZTSMRiskAssessmentCaption {
            min-height: 28px;
            margin-bottom: 2px;
            font-size: 10px;
            line-height: 1.15;
        }
        .ZTSMRiskAssessmentEquation .ZTSMRiskAssessmentField select,
        .ZTSMRiskAssessmentEquation .ZTSMRiskAssessmentField input {
            min-height: 30px;
            height: 30px !important;
            padding: 4px 8px;
            text-align: center;
        }
        .ZTSMRiskAssessmentOperator {
            align-self: center;
            justify-self: center;
            color: #020847;
            font-size: 14px;
            line-height: 1;
        }
        .ZTSMRiskAssessmentLevel {
            min-height: 30px;
            padding: 6px 8px;
            border-radius: 999px;
            color: #fff;
            font-size: 11px;
            font-weight: 700;
            line-height: 18px;
            text-align: center;
            box-sizing: border-box;
            background: #8a8ea8;
        }
        .ZTSMRiskLevelNA {
            background: #8a8ea8;
        }
        .ZTSMRiskAssessmentTargets {
            display: grid;
            grid-template-columns: minmax(180px, 0.9fr) minmax(240px, 1.35fr);
            gap: 8px 12px;
            align-items: start;
        }
        .ZTSMRiskAssessmentTargets .ZTSMRiskAssessmentField_ZRM-RiskTargetGO {
            min-width: 0;
        }
        .ZTSMRiskAssessmentTargets .ZTSMRiskAssessmentField_ZRM-RiskTargetGO input,
        .ZTSMRiskAssessmentTargets .ZTSMRiskAssessmentField_ZRM-RiskTargetCI input {
            width: 100% !important;
            max-width: 100%;
        }
        .ZTSMRiskAssessmentGrid {
            display: grid;
            gap: 8px 12px;
            margin-bottom: 8px;
            align-items: start;
        }
        .ZTSMRiskAssessmentGrid2 {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .ZTSMRiskAssessmentGrid3 {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
        .ZTSMRiskAssessmentPage .ZTSMRiskAssessmentRow .ZTSMRiskAssessmentCaption {
            display: block !important;
            visibility: visible !important;
            opacity: 1 !important;
            position: static !important;
            float: none !important;
            width: auto !important;
            height: auto !important;
            transform: none !important;
            margin: 0 0 5px;
            color: #24315d;
            font-size: 12px;
            font-weight: 700;
            line-height: 1.3;
        }
        .ZTSMRiskAssessmentField input,
        .ZTSMRiskAssessmentField select,
        .ZTSMRiskAssessmentField textarea,
        .ZTSMRiskAssessmentField .InputField_Container {
            width: 100%;
            min-width: 0;
            box-sizing: border-box;
            font-size: 12px;
        }
        .ZTSMRiskAssessmentField input,
        .ZTSMRiskAssessmentField select {
            min-height: 34px;
            line-height: 20px;
            padding: 6px 10px;
        }
        .ZTSMRiskAssessmentField select:not([multiple]) {
            height: 34px !important;
        }
        .ZTSMRiskAssessmentField select[multiple] {
            min-height: 68px;
            height: auto !important;
        }
        .ZTSMRiskAssessmentField .Field,
        .ZTSMRiskAssessmentField .Value {
            margin: 0;
            padding: 0;
        }
        .ZTSMRiskAssessmentField {
            min-height: 0;
        }
        .ZTSMRiskAssessmentPage .ZTSMRiskAssessmentField .Field,
        .ZTSMRiskAssessmentPage .ZTSMRiskAssessmentField .Value,
        .ZTSMRiskAssessmentPage .ZTSMRiskAssessmentField .InputField_Container,
        .ZTSMRiskAssessmentPage .ZTSMRiskAssessmentField .InputField_InputContainer {
            min-height: 0 !important;
            height: auto !important;
        }
        .ZTSMRiskReferenceSuggestions {
            display: none;
            max-height: 180px;
            overflow: auto;
            margin-top: 4px;
            border: 1px solid #cdd3ea;
            border-radius: 4px;
            background: #fff;
            box-shadow: 0 8px 18px rgba(3, 10, 46, 0.12);
            position: relative;
            z-index: 20;
        }
        .ZTSMRiskReferenceSuggestion {
            display: block;
            width: 100%;
            padding: 6px 8px;
            border: 0;
            background: #fff;
            color: #11194f;
            text-align: left;
            font-size: 12px;
            line-height: 1.3;
            cursor: pointer;
        }
        .ZTSMRiskReferenceSuggestion:hover,
        .ZTSMRiskReferenceSuggestion:focus {
            background: #eef2ff;
            outline: none;
        }
        .ZTSMRiskAssessmentField .InputField_InputContainer,
        .ZTSMRiskAssessmentField .InputField_Selection {
            width: 100%;
            box-sizing: border-box;
        }
        .ZTSMRiskAssessmentField .InputField_Selection {
            min-height: 30px;
            padding: 5px 8px;
            font-size: 12px;
        }
        .ZTSMRiskAssessmentPage .ZTSMRiskAssessmentField textarea {
            height: 94px !important;
            min-height: 94px !important;
            max-height: 180px !important;
            resize: vertical;
            overflow: auto;
        }
        .ZTSMRiskAssessmentPage .ZTSMRiskAssessmentField_ZRM-RiskDetail textarea,
        .ZTSMRiskAssessmentPage .ZTSMRiskAssessmentField_ZRM-RiskPlan textarea {
            height: 120px !important;
            min-height: 120px !important;
            max-height: 220px !important;
        }
        .ZTSMRiskAssessmentRemove,
        .ZTSMRiskAssessmentAdd {
            width: 36px !important;
            min-width: 36px;
            max-width: 36px;
            height: 28px !important;
            min-height: 28px;
            border-radius: 4px;
            padding: 0;
            line-height: 26px;
        }
        .ZTSMRiskAssessmentAdd {
            float: none;
        }
        .ZTSMRiskAssessmentOutcome {
            display: grid;
            grid-template-columns: minmax(180px, 0.3fr) minmax(260px, 0.7fr);
            gap: 12px;
            align-items: center;
            margin: 0 0 16px;
            padding: 14px 16px;
            border: 1px solid #cbd3e5;
            border-radius: 8px;
            background: #f7f9fc;
        }
        .ZTSMRiskAssessmentOutcomeCaption {
            display: block !important;
            visibility: visible !important;
            margin: 0;
            font-weight: 700;
            color: #30385f;
        }
        .ZTSMRiskAssessmentOutcome select {
            width: 100%;
            min-height: 36px;
        }
        .ZTSMRiskAssessmentRemarks {
            margin-top: 8px;
        }
        @media (max-width: 720px) {
            .ZTSMRiskAssessmentOutcome {
                grid-template-columns: 1fr;
            }
        }
        .ZTSMRiskAssessmentRemarks label {
            display: block;
            margin-bottom: 4px;
            font-size: 12px;
            font-weight: 700;
            color: #555b82;
        }
        .ZTSMRiskAssessmentRemarks textarea {
            width: 100%;
            min-height: 72px;
            max-height: 110px;
            box-sizing: border-box;
            font-size: 12px;
        }
        .ZTSMRiskAssessmentActions {
            margin-top: 8px;
            text-align: right;
        }
        @media (max-width: 980px) {
            .ZTSMRiskAssessmentRowBody,
            .ZTSMRiskAssessmentRowLayout,
            .ZTSMRiskAssessmentEquation {
                grid-template-columns: 1fr;
            }
            .ZTSMRiskAssessmentBandStatement,
            .ZTSMRiskAssessmentEquation,
            .ZTSMRiskAssessmentTargets {
                grid-column: auto;
            }
            .ZTSMRiskAssessmentTargets {
                grid-template-columns: 1fr;
            }
            .ZTSMRiskAssessmentOperator {
                display: none;
            }
            .ZTSMRiskAssessmentGrid2,
            .ZTSMRiskAssessmentGrid3 {
                grid-template-columns: 1fr;
            }
        }
    </style>

    [% IF Data.Inline %]
    <div class="ZTSMRiskAssessmentLayout">
    [% ELSE %]
    <div id="oooMainBox" class="ZTSMRiskAssessmentLayout">
    [% END %]
    <div class="ZTSMRiskAssessmentShell">
        <h1>[% Translate("Risk Assessment") | html %] [% Data.TicketNumber | html %]</h1>
        <form action="[% Env("CGIHandle") | html %]" method="post" class="Validate PreventMultipleSubmits">
            <input type="hidden" name="Action" value="CustomerTicketZTSMAction"/>
            <input type="hidden" name="TicketID" value="[% Data.TicketID | html %]"/>
            <input type="hidden" id="ZTSMRiskAssessmentRuntimeAction" name="RuntimeAction" value="Assess"/>
            <input type="hidden" name="Subaction" value="SubmitRiskAssessment"/>

            [% Data.WorkspaceHTML %]

            <div class="ZTSMRiskAssessmentActions">
                <button type="button" class="ZTSMRiskAssessmentAdd">+</button>
            </div>

            <div class="ZTSMRiskAssessmentRemarks">
                <label for="Remarks">[% Translate("Remarks") | html %]</label>
                <textarea id="Remarks" name="Remarks" rows="5"></textarea>
            </div>

            [% Data.OutcomeHTML %]

            <div class="ZTSMRiskAssessmentActions">
                [% IF Data.Inline %]
                <button type="button" class="CloseButton oooXS">[% Translate("Discard") | html %]</button>
                [% ELSE %]
                <a class="Button" href="[% Env("CGIHandle") | html %]?Action=CustomerTicketZoom;TicketID=[% Data.TicketID | uri %]">[% Translate("Cancel") | html %]</a>
                [% END %]
                <button type="submit" class="oooXS" onclick="var Field = document.getElementById('ZTSMRiskAssessmentRuntimeAction'); if (Field) { Field.value = 'CloseDuplicate'; }">[% Translate("Duplicate") | html %]</button>
                <button type="submit" class="oooXS" onclick="var Field = document.getElementById('ZTSMRiskAssessmentRuntimeAction'); if (Field) { Field.value = 'CloseNoAction'; }">[% Translate("No Action") | html %]</button>
                <button type="submit" class="Primary" data-assessment-submit="1" onclick="var Field = document.getElementById('ZTSMRiskAssessmentRuntimeAction'); if (Field) { Field.value = 'Assess'; }">[% Translate("Submit Assessment") | html %]</button>
            </div>
        </form>
    </div>
    </div>

    <script>
    (function () {
        var root = document.currentScript ? document.currentScript.closest('.ZTSMRiskAssessmentPage') : null;
        root = root || document.querySelector('.ZTSMRiskAssessmentPage');
        var debugPrefix = '[ZTSM RiskAssessment]';

        function debugLog(message, data) {
            if (!window.console || typeof window.console.warn !== 'function') {
                return;
            }

            if (data !== undefined) {
                try {
                    window.console.warn(debugPrefix + ' ' + message + ' ' + JSON.stringify(data));
                }
                catch (error) {
                    window.console.warn(debugPrefix + ' ' + message, data);
                }
                return;
            }

            window.console.warn(debugPrefix + ' ' + message);
        }

        debugLog('script loaded', {
            hasRoot: !!root,
            hasJQuery: !!window.jQuery,
            hasCore: !!window.Core,
            hasReferenceWidget: !!(
                window.Core
                && Core.Agent
                && Core.Agent.DynamicFieldReferenceSearch
                && typeof Core.Agent.DynamicFieldReferenceSearch.InitElement === 'function'
            )
        });

        function preventGlobalInputModernizer(scope) {
            if (!scope || !scope.querySelectorAll) {
                return;
            }
            scope.querySelectorAll('select.Modernize, .Modernize').forEach(function (field) {
                field.classList.remove('Modernize');
            });
        }

        preventGlobalInputModernizer(root);

        function syncNavigationOffset() {
            var mainBox = root ? root.querySelector('.ZTSMRiskAssessmentLayout') : null;
            var navigation = document.getElementById('oooNavigation');
            if (!mainBox || !navigation) {
                return;
            }
            mainBox.style.setProperty('--ZTSMNavigationOffset', navigation.getBoundingClientRect().width + 'px');
        }

        var addButton = root ? root.querySelector('.ZTSMRiskAssessmentAdd') : null;
        var body = root ? root.querySelector('#ZTSMRiskAssessmentRows') : null;
        var template = root ? root.querySelector('#ZTSMRiskAssessmentTemplate') : null;
        var nextIndex = body ? body.querySelectorAll('.ZTSMRiskAssessmentRow').length : 0;

        function syncViewportSize() {
            var mainBox = root ? root.querySelector('.ZTSMRiskAssessmentLayout') : null;
            var navigation = document.getElementById('oooNavigation');
            var navWidth = navigation ? navigation.getBoundingClientRect().width : 0;
            if (!mainBox) {
                return;
            }
            mainBox.style.setProperty('--ZTSMRiskViewportHeight', Math.max(360, window.innerHeight) + 'px');
        }

        function syncRowNumbers() {
            if (!body) {
                return;
            }
            body.querySelectorAll('.ZTSMRiskAssessmentRow').forEach(function (row, index) {
                var number = row.querySelector('.ZTSMRiskAssessmentRowNumber');
                if (number) {
                    number.textContent = String(index + 1);
                }
            });
        }

        function bindRemove(scope) {
            var buttons = (scope || document).querySelectorAll('.ZTSMRiskAssessmentRemove');
            buttons.forEach(function (button) {
                button.onclick = function () {
                    var row = button.closest('.ZTSMRiskAssessmentRow');
                    if (!row) {
                        return;
                    }
                    if (body.querySelectorAll('.ZTSMRiskAssessmentRow').length <= 1) {
                        row.querySelectorAll('input[type="text"], input[type="hidden"], textarea').forEach(function (field) { field.value = ''; });
                        row.querySelectorAll('select').forEach(function (field) { field.selectedIndex = 0; });
                        return;
                    }
                    row.remove();
                    syncRowNumbers();
                };
            });
        }

        function fieldValue(row, fieldName) {
            var field = row.querySelector('[name="' + fieldName + '"]');
            if (!field) {
                return '';
            }

            if (field.tagName === 'SELECT') {
                var option = field.options[field.selectedIndex];
                return option ? (option.text || option.value || '') : '';
            }

            return field.value || '';
        }

        function scoreValue(value) {
            var label = String(value || '').trim();
            return /^[1-9][0-9]*$/.test(label) ? Number(label) : 0;
        }

        function setField(row, fieldName, value) {
            row.querySelectorAll('[name="' + fieldName + '"]').forEach(function (field) {
                if (String(field.value || '') === String(value || '')) {
                    return;
                }
                field.value = value;
                field.setAttribute('readonly', 'readonly');
            });
        }

        function updateRiskLevel(row, fieldName, score, level) {
            var badge = row.querySelector('.ZTSMRiskAssessmentLevel[data-score-field="' + fieldName + '"]');
            if (!badge) { return; }
            badge.className = 'ZTSMRiskAssessmentLevel ZTSMRiskLevelNA';
            badge.textContent = level ? level.Summary : (score ? String(score) + ' - Unmapped' : 'N/A');
            badge.style.backgroundColor = level ? level.Color : '';
            badge.style.color = level ? level.TextColor : '';
            badge.setAttribute('title', 'Risk Level: ' + badge.textContent + ' (current Framework matrix)');
        }

        function updateFrameworkScales(row) {
            var index = row.getAttribute('data-row-index');
            var framework = fieldValue(row, 'RA_' + index + '_ZRM-Framework');
            if (row.ztsmScaleKey === framework) { return; }
            row.ztsmScaleKey = framework;
            row.ztsmScaleReady = false;
            if (row.ztsmScaleRequest) { row.ztsmScaleRequest.abort(); }
            var fields = [];
            ['Inherent', 'Residual'].forEach(function (phase) {
                ['Likelihood', 'Impact'].forEach(function (kind) {
                    var field = row.querySelector('[name="RA_' + index + '_ZRM-' + phase + kind + '"]');
                    if (!field) { return; }
                    if (!field.ztsmScaleOptions) { field.ztsmScaleOptions = Array.from(field.options).map(function (option) { return option.cloneNode(true); }); }
                    field.disabled = true;
                    fields.push({field: field, kind: kind});
                });
            });
            var message = row.querySelector('.ZTSMRiskAssessmentScaleError');
            if (!message) {
                message = document.createElement('div');
                message.className = 'ZTSMRiskAssessmentScaleError MessageBox Error';
                message.setAttribute('role', 'status');
                row.appendChild(message);
            }
            message.textContent = framework ? 'Loading Framework scales...' : 'Select a Framework with valid likelihood and impact scales.';
            message.hidden = false;
            if (!framework || !window.jQuery) { return; }
            row.ztsmScaleRequest = jQuery.ajax({
                url: '[% Env("CGIHandle") | html %]?Action=CustomerTicketZTSMAction;TicketID=[% Data.TicketID | uri %];Subaction=RiskAssessmentScales;FrameworkID=' + encodeURIComponent(framework),
                method: 'GET', dataType: 'json',
                success: function (data) {
                    if (row.ztsmScaleKey !== framework) { return; }
                    var scales = data && data.Success && data.Scales;
                    if (!scales || !Number.isInteger(scales.Likelihood) || scales.Likelihood < 1 || !Number.isInteger(scales.Impact) || scales.Impact < 1) {
                        message.textContent = 'The selected Framework needs valid likelihood and impact scales.';
                        return;
                    }
                    var cleared = false;
                    fields.forEach(function (item) {
                        var field = item.field, selected = field.value;
                        field.replaceChildren();
                        field.ztsmScaleOptions.forEach(function (option) {
                            var label = option.text.trim();
                            if (option.value === '' || (/^[1-9][0-9]*$/.test(label) && Number(label) <= scales[item.kind])) {
                                field.appendChild(option.cloneNode(true));
                            }
                        });
                        field.value = selected;
                        if (selected && field.value !== selected) { field.value = ''; cleared = true; }
                        field.disabled = false;
                    });
                    row.ztsmScaleReady = true;
                    message.textContent = cleared ? 'A previous score is outside this Framework scale. Please select it again.' : '';
                    message.hidden = !cleared;
                    recalculateRow(row);
                },
                error: function () {
                    if (row.ztsmScaleKey !== framework) { return; }
                    row.ztsmScaleKey = null;
                    message.textContent = 'Framework scales could not be loaded. Please reselect the Framework.';
                }
            });
        }

        function updateFrameworkLevels(row, inherent, residual) {
            var index = row.getAttribute('data-row-index');
            var framework = fieldValue(row, 'RA_' + index + '_ZRM-Framework');
            var key = [framework, inherent, residual].join('|');
            if (row.ztsmLevelKey === key) { return; }
            row.ztsmLevelKey = key;
            if (row.ztsmLevelRequest && row.ztsmLevelRequest.abort) { row.ztsmLevelRequest.abort(); }
            updateRiskLevel(row, 'ZRM-InherentCalculatedRisk', inherent);
            updateRiskLevel(row, 'ZRM-ResidualCalculatedRisk', residual);
            if (!framework || !window.jQuery) { return; }
            row.ztsmLevelRequest = jQuery.ajax({
                url: '[% Env("CGIHandle") | html %]?Action=CustomerTicketZTSMAction'
                    + ';TicketID=[% Data.TicketID | uri %];Subaction=RiskScoreLevels'
                    + ';FrameworkID=' + encodeURIComponent(framework)
                    + ';InherentScore=' + encodeURIComponent(inherent)
                    + ';ResidualScore=' + encodeURIComponent(residual),
                method: 'GET', dataType: 'json',
                success: function (data) {
                    if (row.ztsmLevelKey !== key || !data || !data.Success || !data.Levels) { return; }
                    updateRiskLevel(row, 'ZRM-InherentCalculatedRisk', inherent, data.Levels.Inherent);
                    updateRiskLevel(row, 'ZRM-ResidualCalculatedRisk', residual, data.Levels.Residual);
                },
                error: function () { if (row.ztsmLevelKey === key) { row.ztsmLevelKey = null; } }
            });
        }

        function setEditableField(row, fieldName, value) {
            row.querySelectorAll('[name="' + fieldName + '"]').forEach(function (field) {
                if (field.tagName === 'SELECT' && Array.isArray(value)) {
                    Array.prototype.forEach.call(field.options, function (option) {
                        option.selected = value.some(function (item) {
                            return String(item) === String(option.value) || String(item) === String(option.text);
                        });
                    });
                }
                else if (field.tagName === 'SELECT') {
                    var matched = false;
                    Array.prototype.forEach.call(field.options, function (option) {
                        var selected = String(value) === String(option.value) || String(value) === String(option.text);
                        option.selected = selected;
                        matched = matched || selected;
                    });
                    if (!matched) {
                        field.value = value || '';
                    }
                }
                else {
                    field.value = Array.isArray(value) ? value[0] || '' : value;
                }
                field.dispatchEvent(new Event('change', { bubbles: true }));
            });
        }

        function recalculateRow(row) {
            var index = row.getAttribute('data-row-index');
            if (!index) {
                return;
            }

            var inherentLikelihood = scoreValue(fieldValue(row, 'RA_' + index + '_ZRM-InherentLikelihood'));
            var inherentImpact = scoreValue(fieldValue(row, 'RA_' + index + '_ZRM-InherentImpact'));
            var residualLikelihood = scoreValue(fieldValue(row, 'RA_' + index + '_ZRM-ResidualLikelihood'));
            var residualImpact = scoreValue(fieldValue(row, 'RA_' + index + '_ZRM-ResidualImpact'));
            var riskPlan = row.querySelector('[name="RA_' + index + '_ZRM-RiskPlan"]');

            var inherentRisk = inherentLikelihood && inherentImpact
                ? inherentLikelihood * inherentImpact : '';
            var residualRisk = residualLikelihood && residualImpact ? residualLikelihood * residualImpact : '';

            setField(row, 'RA_' + index + '_ZRM-InherentCalculatedRisk', inherentRisk);
            setField(row, 'RA_' + index + '_ZRM-ResidualCalculatedRisk', residualRisk);
            updateFrameworkScales(row);
            updateFrameworkLevels(row, inherentRisk, residualRisk);

            if (riskPlan) {
                if (inherentRisk && residualRisk && residualRisk < inherentRisk) {
                    riskPlan.setAttribute('required', 'required');
                }
                else {
                    riskPlan.removeAttribute('required');
                }
            }
        }

        function bindCalculation(scope) {
            (scope || root || document).querySelectorAll('.ZTSMRiskAssessmentRow').forEach(function (row) {
                row.querySelectorAll('select, input').forEach(function (field) {
                    if (field.name && field.name.match(/ZRM-(?:Inherent|Residual)CalculatedRisk$/)) {
                        return;
                    }
                    field.addEventListener('change', function () {
                        recalculateRow(row);
                    });
                    field.addEventListener('input', function () {
                        recalculateRow(row);
                    });
                });
                recalculateRow(row);
            });
        }

        function initializeReferenceFields(scope) {
            if (typeof window.ZTSMReferencePickerEnhance === 'function') {
                window.ZTSMReferencePickerEnhance(scope || root || document);
            }
        }

        document.addEventListener('ZTSMReferencePicker:applied', function (event) {
            var detail = event.detail || {};
            if (!root || !detail.element || !root.contains(detail.element)) { return; }
            detail.element.dispatchEvent(new CustomEvent('ztsm:risk-reference-selected', {
                bubbles: true,
                detail: {field: detail.field, key: detail.value, value: detail.label}
            }));
        });

        function bindRiskStatementDefaults(scope) {
            if (!window.jQuery) {
                return;
            }

            (scope || root || document).querySelectorAll('.ZTSMRiskAssessmentRow').forEach(function (row) {
                var index = row.getAttribute('data-row-index');
                if (index === null || index === undefined || row.dataset.ztsmRiskDefaultsReady) {
                    return;
                }

                row.dataset.ztsmRiskDefaultsReady = '1';

                var hiddenSelector = '[name="RA_' + index + '_ZRM-RiskStatement"]';
                var visibleSelector = '[name="Autocomplete_DynamicField_ZRM-RiskStatement_' + index + '"], [data-dynamic-field="ZRM-RiskStatement"]';
                var requestTimer;
                var pendingDefaultsRequest;
                var initialStatement = fieldValue(row, 'RA_' + index + '_ZRM-RiskStatement');
                var firstDefaultsResponse = true;
                var appliedStatement = initialStatement;

                function riskStatementHidden() {
                    return row.querySelector(hiddenSelector);
                }

                function riskStatementVisible() {
                    return row.querySelector(visibleSelector);
                }

                function loadDefaults() {
                    var hidden = riskStatementHidden();
                    var visible = riskStatementVisible();
                    var riskStatementID = hidden ? (hidden.value || '') : '';
                    var riskStatementLabel = visible ? (visible.value || '') : '';
                    debugLog('load defaults requested', {
                        rowIndex: index,
                        hiddenFound: !!hidden,
                        visibleFound: !!visible,
                        riskStatementID: riskStatementID,
                        riskStatementLabel: riskStatementLabel
                    });
                    var url = '[% Env("CGIHandle") | html %]?'
                        + 'Action=CustomerTicketZTSMAction'
                        + ';TicketID=[% Data.TicketID | uri %]'
                        + ';Subaction=RiskStatementDefaults'
                        + ';RiskStatementID=' + encodeURIComponent(riskStatementID)
                        + ';RiskStatementLabel=' + encodeURIComponent(riskStatementLabel);

                    if (pendingDefaultsRequest && pendingDefaultsRequest.abort) {
                        pendingDefaultsRequest.abort();
                    }

                    debugLog('defaults ajax request', {
                        url: url
                    });
                    pendingDefaultsRequest = jQuery.ajax({
                        url: url,
                        method: 'GET',
                        dataType: 'json',
                        success: function (data) {
                            debugLog('defaults ajax success', data);
                            if (!data || !data.Success || !data.Fields) {
                                debugLog('defaults ajax returned no usable fields', data);
                                return;
                            }

                            if (data.RiskStatementID && hidden && String(hidden.value || '') !== String(data.RiskStatementID)) {
                                debugLog('writing resolved risk statement ID', {
                                    oldValue: hidden.value || '',
                                    newValue: data.RiskStatementID
                                });
                                hidden.value = data.RiskStatementID;
                            }

                            Object.keys(data.Fields).forEach(function (field) {
                                if (field === 'ZRM-Framework' && String(riskStatementID) === String(appliedStatement)
                                    && (!firstDefaultsResponse || fieldValue(row, 'RA_' + index + '_ZRM-Framework'))) { return; }
                                debugLog('defaulting field', {
                                    field: field,
                                    value: data.Fields[field]
                                });
                                setEditableField(row, 'RA_' + index + '_' + field, data.Fields[field]);
                                if (field === 'ZRM-Framework') {
                                    var frameworkGroup = row.querySelector('.ZTSMRiskAssessmentField_ZRM-Framework');
                                    var frameworkDisplay = frameworkGroup && frameworkGroup.querySelector('.DynamicFieldReference');
                                    if (frameworkDisplay) {
                                        frameworkDisplay.value = data.FrameworkLabel || '';
                                    }
                                }
                            });
                            firstDefaultsResponse = false;
                            appliedStatement = data.RiskStatementID || riskStatementID;
                            recalculateRow(row);
                        },
                        error: function (xhr, status, error) {
                            debugLog('defaults ajax error', {
                                status: status,
                                error: error,
                                responseText: xhr && xhr.responseText ? xhr.responseText.substring(0, 1000) : ''
                            });
                        }
                    });
                }

                function scheduleDefaults() {
                    var hidden = riskStatementHidden();
                    var visible = riskStatementVisible();
                    debugLog('defaults scheduled', {
                        rowIndex: index,
                        hiddenValue: hidden ? hidden.value || '' : '',
                        visibleValue: visible ? visible.value || '' : ''
                    });
                    clearTimeout(requestTimer);
                    requestTimer = setTimeout(loadDefaults, 120);
                }

                var hidden = riskStatementHidden();
                if (hidden) {
                    hidden.addEventListener('change', function () {
                        debugLog('hidden risk statement changed', {
                            rowIndex: index,
                            value: hidden.value || ''
                        });
                        scheduleDefaults();
                    });
                    hidden.addEventListener('input', function () {
                        debugLog('hidden risk statement input', {
                            rowIndex: index,
                            value: hidden.value || ''
                        });
                        scheduleDefaults();
                    });
                }
                else {
                    debugLog('hidden risk statement field not found', {
                        rowIndex: index,
                        selector: hiddenSelector
                    });
                }

                var visible = riskStatementVisible();
                if (visible) {
                    visible.addEventListener('change', function () {
                        debugLog('visible risk statement changed', {
                            rowIndex: index,
                            value: visible.value || ''
                        });
                        scheduleDefaults();
                    });
                    visible.addEventListener('input', function () {
                        debugLog('visible risk statement input', {
                            rowIndex: index,
                            value: visible.value || ''
                        });
                        scheduleDefaults();
                    });
                    visible.addEventListener('blur', function () {
                        debugLog('visible risk statement blur', {
                            rowIndex: index,
                            value: visible.value || ''
                        });
                        scheduleDefaults();
                    });
                    visible.addEventListener('ztsm:risk-reference-selected', function (event) {
                        debugLog('visible risk reference selected event', {
                            rowIndex: index,
                            detail: event.detail || null
                        });
                        scheduleDefaults();
                    });
                }
                else {
                    debugLog('visible risk statement field not found', {
                        rowIndex: index,
                        selector: visibleSelector
                    });
                }

                row.addEventListener('change', function (event) {
                    if (!event.target || !event.target.matches(hiddenSelector + ', ' + visibleSelector)) {
                        return;
                    }
                    scheduleDefaults();
                });

                row.addEventListener('input', function (event) {
                    if (!event.target || !event.target.matches(visibleSelector)) {
                        return;
                    }
                    scheduleDefaults();
                });

                row.addEventListener('ztsm:risk-reference-selected', function (event) {
                    if (
                        !event.target
                        || !event.target.matches(visibleSelector)
                        || !event.detail
                        || event.detail.field !== 'ZRM-RiskStatement'
                    ) {
                        return;
                    }
                    scheduleDefaults();
                });

                scheduleDefaults();
            });
        }

        if (addButton && body && template) {
            addButton.onclick = function () {
                var html = template.innerHTML.replace(/__INDEX__/g, String(nextIndex++));
                var wrapper = document.createElement('div');
                wrapper.innerHTML = html;
                while (wrapper.firstElementChild) {
                    body.appendChild(wrapper.firstElementChild);
                }
                preventGlobalInputModernizer(body);
                bindRemove(body);
                bindCalculation(body);
                bindRiskStatementDefaults(body);
                syncRowNumbers();
                initializeReferenceFields(body);
            };
        }

        var assessmentForm = root ? root.querySelector('form') : null;
        var validationAttempted = false;

        function requiredFieldHasValue(group) {
            var name = group.getAttribute('data-field-name');
            return Array.prototype.some.call(group.querySelectorAll('input, select, textarea'), function (control) {
                if (control.disabled || (control.name !== name && control.name.indexOf(name + '_') !== 0)) {
                    return false;
                }
                if ((control.type === 'checkbox' || control.type === 'radio') && !control.checked) {
                    return false;
                }
                if (control.tagName === 'SELECT') {
                    return Array.prototype.some.call(control.selectedOptions, function (option) {
                        return option.value.trim() !== '';
                    });
                }
                return control.value.trim() !== '';
            });
        }

        function validateAssessmentRequiredFields(focusFirst) {
            var firstInvalid = null;
            root.querySelectorAll('.ZTSMRiskAssessmentField[data-required="1"]').forEach(function (group) {
                var valid = requiredFieldHasValue(group);
                var control = group.querySelector('input:not([type="hidden"]), select, textarea');
                var errorID = group.getAttribute('aria-labelledby') + '_Error';
                var error = group.querySelector('.ZTSMRiskAssessmentFieldError');
                group.setAttribute('aria-invalid', valid ? 'false' : 'true');
                if (control) {
                    control.setAttribute('aria-required', 'true');
                    control.setAttribute('aria-invalid', valid ? 'false' : 'true');
                    var descriptions = (control.getAttribute('aria-describedby') || '').split(/\s+/).filter(function (id) {
                        return id && id !== errorID;
                    });
                    if (!valid) { descriptions.push(errorID); }
                    control.setAttribute('aria-describedby', descriptions.join(' '));
                }
                if (!valid && !error) {
                    error = document.createElement('span');
                    error.id = errorID;
                    error.className = 'ZTSMRiskAssessmentFieldError';
                    error.textContent = 'Please fill in this required field.';
                    group.appendChild(error);
                }
                if (valid && error) { error.remove(); }
                if (!valid && !firstInvalid) { firstInvalid = control || group; }
            });
            root.querySelectorAll('.ZTSMRiskAssessmentRow').forEach(function (row) {
                if (!row.ztsmScaleReady && !firstInvalid) {
                    firstInvalid = row.querySelector('[name^="Autocomplete_"][name*="ZRM-Framework"]') || row.querySelector('input:not([type="hidden"])');
                }
            });
            var outcome = assessmentForm.querySelector('[name="RiskAssessmentOutcome"]');
            if (outcome) {
                outcome.setAttribute('aria-invalid', outcome.value.trim() ? 'false' : 'true');
                if (!outcome.value.trim() && !firstInvalid) { firstInvalid = outcome; }
            }
            var summary = assessmentForm.querySelector('.ZTSMRiskAssessmentValidationSummary');
            if (firstInvalid && !summary) {
                summary = document.createElement('div');
                summary.className = 'MessageBox Error ZTSMRiskAssessmentValidationSummary';
                summary.setAttribute('role', 'alert');
                assessmentForm.prepend(summary);
            }
            if (summary) {
                summary.textContent = firstInvalid ? 'Please complete required fields and resolve Framework scale errors before submitting.' : '';
                summary.hidden = !firstInvalid;
            }
            if (firstInvalid && focusFirst) {
                firstInvalid.focus();
                firstInvalid.scrollIntoView({block: 'center'});
            }
            return !firstInvalid;
        }

        if (assessmentForm) {
            function stopInvalidAssessment(event) {
                validationAttempted = true;
                if (!validateAssessmentRequiredFields(true)) {
                    event.preventDefault();
                    event.stopImmediatePropagation();
                }
            }
            assessmentForm.addEventListener('click', function (event) {
                if (event.target.closest('[data-assessment-submit="1"]')) {
                    stopInvalidAssessment(event);
                }
            }, true);
            assessmentForm.addEventListener('submit', function (event) {
                if (event.submitter && !event.submitter.matches('[data-assessment-submit="1"]')) { return; }
                stopInvalidAssessment(event);
            }, true);
            ['input', 'change'].forEach(function (eventName) {
                assessmentForm.addEventListener(eventName, function () {
                    if (validationAttempted) { validateAssessmentRequiredFields(false); }
                });
            });
        }

        bindRemove(root);
        bindCalculation(root);
        bindRiskStatementDefaults(root);
        syncRowNumbers();
        initializeReferenceFields(root);
        syncNavigationOffset();
        syncViewportSize();
        window.addEventListener('resize', syncNavigationOffset);
        window.addEventListener('resize', syncViewportSize);
    }());
    </script>
</div>
