<main class="ChangePortal" aria-labelledby="ChangePortalTitle">
[% IF Data.Announcement %]
[% A = Data.Announcement %]
<a class="ChangePortal__back" href="[% Env('Baselink') | html %]Action=CustomerChangeAnnouncement">&larr; All major change announcements</a>
<header class="ChangePortal__hero"><div><p class="ChangePortal__eyebrow">APPROVED MAJOR CHANGE</p><h1 id="ChangePortalTitle">[% A.Title | html %]</h1><p class="ChangePortal__summary">[% A.Summary | html %]</p><span class="ChangePortal__badge">Change type: [% A.ChangeType | html %]</span></div><aside class="ChangePortal__book" aria-label="Change runbook"><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M8 7h25a5 5 0 0 1 5 5v29H12a5 5 0 0 1-5-5V8m5 25h26M15 14h15M15 20h15" fill="none" stroke="currentColor" stroke-width="3"/></svg><p>Change runbook</p><h2>[% IF A.Template %][% A.Template | html %][% ELSIF A.BlueBook %][% A.BlueBook | html %][% ELSE %]Submitted execution plan[% END %]</h2><p>Pre-check &middot; Implementation<br/>Post-Change &middot; Rollback</p></aside></header>
<section class="ChangePortal__facts" aria-label="Change overview"><div><h2>Requester</h2><p>[% A.Requester | html %]</p></div><div><h2>Environment</h2><p>[% A.Environment || 'Not specified' | html %]</p></div><div><h2>Application / system</h2><p>[% A.Application || 'Not specified' | html %]</p></div><div><h2>Scheduled window ([% Data.TimeZone || 'system time' | html %])</h2><p>[% A.Start || 'Not scheduled' | html %]<br/>[% A.Finish | html %]</p></div><div><h2>Service</h2><p>[% A.Service || 'Not specified' | html %]</p></div><div><h2>Change reference</h2><p>[% A.TicketNumber | html %]</p></div></section>
<section class="ChangePortal__section"><h2>Description</h2><p class="ChangePortal__text">[% A.Description | html %]</p></section>
<section class="ChangePortal__section"><h2>Affected configuration items</h2>[% IF A.Assets.size %]<ul class="ChangePortal__assets">[% FOREACH CI IN A.Assets %]<li>[% CI | html %]</li>[% END %]</ul>[% ELSE %]<p>No affected configuration items listed.</p>[% END %]</section>
<section class="ChangePortal__section" aria-labelledby="RunbookTitle"><h2 id="RunbookTitle">Submitted change runbook</h2><p>Reviewed steps from the submitted change plan.</p>[% FOREACH Phase IN A.Phases %]<details class="ChangePortal__phase" open><summary>[% Phase.Name | html %] <span>[% Phase.Steps.size | html %] [% IF Phase.Steps.size == 1 %]step[% ELSE %]steps[% END %]</span></summary><ol>[% FOREACH Step IN Phase.Steps %]<li value="[% Step.Sequence | html %]"><p class="ChangePortal__schedule">Level [% Step.Level | html %] &middot; Step [% Step.Sequence | html %][% IF Step.Mandatory %] &middot; Required step[% END %][% IF Step.Strict %] &middot; Scheduled timing enforced[% END %]</p><h3>[% Step.Activity || 'Step' | html %]</h3>[% IF Step.Start OR Step.Finish %]<p class="ChangePortal__schedule">[% Step.Start | html %] &mdash; [% Step.Finish | html %]</p>[% END %]<p class="ChangePortal__text">[% Step.Description | html %]</p></li>[% END %]</ol></details>[% END %][% UNLESS A.Phases.size %]<p>No submitted runbook steps are available.</p>[% END %]</section>
[% ELSE %]
<header><p class="ChangePortal__eyebrow">WORKPLACE ANNOUNCEMENTS</p><h1 id="ChangePortalTitle">Major changes</h1><p>Approved changes shared with all authenticated portal users.</p></header>
<div class="ChangePortal__cards">[% FOREACH A IN Data.Announcements %]<a class="ChangePortal__card" href="[% Env('Baselink') | html %]Action=CustomerChangeAnnouncement;TicketID=[% A.TicketID | uri %]"><span class="ChangePortal__badge">[% A.Environment || 'Change' | html %]</span><h2>[% A.Title | html %]</h2><p>[% A.Summary | html %]</p><p>[% A.Start || 'Schedule pending' | html %]</p><span>Read announcement &rarr;</span></a>[% END %]</div>[% UNLESS Data.Announcements.size %]<p role="status">No major change announcements are currently available.</p>[% END %]
[% END %]
</main>
