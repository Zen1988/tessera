    <CodeInstall Type="post"><![CDATA[
        die 'TESSERA managed FAQ installation failed.'
            if !$Kernel::OM->Get('Kernel::System::TESSERA::FAQInstaller')->Ensure();
        my $BootstrapObject = $Kernel::OM->Get('Kernel::System::GovernanceDB::Bootstrap');
        $BootstrapObject->InstallDefaults();
    ]]></CodeInstall>

    <CodeUpgrade Type="post"><![CDATA[
        die 'TESSERA managed FAQ installation failed.'
            if !$Kernel::OM->Get('Kernel::System::TESSERA::FAQInstaller')->Ensure();
        my $BootstrapObject = $Kernel::OM->Get('Kernel::System::GovernanceDB::Bootstrap');
        $BootstrapObject->InstallDefaults();
    ]]></CodeUpgrade>

    <CodeReinstall Type="post"><![CDATA[
        die 'TESSERA managed FAQ installation failed.'
            if !$Kernel::OM->Get('Kernel::System::TESSERA::FAQInstaller')->Ensure();
        my $BootstrapObject = $Kernel::OM->Get('Kernel::System::GovernanceDB::Bootstrap');
        $BootstrapObject->InstallDefaults();
    ]]></CodeReinstall>

    <DatabaseInstall Type="post">
        <TableCreate Type="post" Name="ztsm_configitem_activity">
            <Column Name="id" Required="true" PrimaryKey="true" AutoIncrement="true" Type="BIGINT"/>
            <Column Name="configitem_id" Required="false" Type="BIGINT"/>
            <Column Name="configitem_number" Required="false" Size="100" Type="VARCHAR"/>
            <Column Name="event_type" Required="true" Size="100" Type="VARCHAR"/>
            <Column Name="source" Required="true" Size="100" Type="VARCHAR"/>
