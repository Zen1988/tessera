<?xml version="1.0" encoding="utf-8"?>
<otobo_package version="1.1">
    <Name>TESSERA-Base</Name>
    <Version>0.0.146</Version>
    <Framework>11.1.x</Framework>
    <Vendor>Zen CHAN (NCS)</Vendor>
    <URL>https://tessera.local/</URL>
    <License>GNU GENERAL PUBLIC LICENSE Version 3, 29 June 2007</License>
    <Description Lang="en">TESSERA foundation bringing Ticketing and Governance as Code capabilities to OTOBO.</Description>
    <PackageMerge Name="GovernanceDB" TargetVersion="0.1.128"/>
    <IntroInstall Type="post" Lang="en" Title="TESSERA-Base">
        Developed by Zen CHAN (NCS), TESSERA-Base brings Ticketing and Governance as Code capabilities to OTOBO. This package provides the TESSERA base runtime and preserves the existing GovernanceDB schema and namespaces. It does not remove or migrate existing ITSM ConfigItem data.
    </IntroInstall>
    <IntroUninstall Type="pre" Lang="en" Title="TESSERA-Base">
        This package owns the TESSERA base runtime and GovernanceDB tables and settings. Existing ITSM ConfigItem tables are not touched.
    </IntroUninstall>

    <ModuleRequired Version="2.0">GD</ModuleRequired>
