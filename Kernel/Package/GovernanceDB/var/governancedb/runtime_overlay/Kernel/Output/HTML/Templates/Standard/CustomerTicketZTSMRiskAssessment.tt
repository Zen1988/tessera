# --
# Kernel/Output/HTML/Templates/Standard/CustomerTicketZTSMRiskAssessment.tt
# --

<div id="oooContent" class="TicketZoom ZTSMRiskAssessmentPage ARIARoleMain">
    <style>
        .ZTSMRiskAssessmentPage #oooMainBox.ZTSMRiskAssessmentLayout {
            --ZTSMNavigationOffset: 56px;
            --ZTSMRiskViewportWidth: 1200px;
            --ZTSMRiskViewportHeight: 720px;
            width: auto;
            max-width: none;
            min-height: 100vh;
            padding: 16px 18px 32px calc(var(--ZTSMNavigationOffset) + 28px);
            background: #f4f6fb;
            transition: padding-left 0.3s ease;
        }
        .ZTSMRiskAssessmentShell {
            padding: 0;
            max-width: min(1280px, calc(var(--ZTSMRiskViewportWidth) - 36px));
        }
        .ZTSMRiskAssessmentShell h1 {
            margin: 0 0 8px;
            font-size: 16px;
            line-height: 1.3;
        }
        .ZTSMRiskAssessmentRows {
            display: flex;
            flex-direction: column;
            gap: 8px;
            max-height: max(360px, calc(var(--ZTSMRiskViewportHeight) - 220px));
            overflow: auto;
            padding-right: 4px;
            scrollbar-gutter: stable;
        }
        .ZTSMRiskAssessmentRow {
            padding: 10px;
            border: 1px solid #d6d9e6;
            border-radius: 8px;
            background: #fff;
            box-shadow: 0 8px 18px rgba(3, 10, 46, 0.05);
        }
        .ZTSMRiskAssessmentRowHead {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 10px;
            color: #11194f;
            font-size: 12px;
        }
        .ZTSMRiskAssessmentGrid {
            display: grid;
            gap: 8px 12px;
            margin-bottom: 8px;
            align-items: start;
        }
        .ZTSMRiskAssessmentGrid2 {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .ZTSMRiskAssessmentGrid3 {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
        .ZTSMRiskAssessmentField label {
            display: block;
            margin: 0 0 3px;
            color: #555b82;
            font-size: 11px;
            font-weight: 700;
            line-height: 1.2;
        }
        .ZTSMRiskAssessmentField input,
        .ZTSMRiskAssessmentField select,
        .ZTSMRiskAssessmentField textarea,
        .ZTSMRiskAssessmentField .InputField_Container {
            width: 100%;
            min-width: 0;
            box-sizing: border-box;
            font-size: 12px;
        }
        .ZTSMRiskAssessmentField input,
        .ZTSMRiskAssessmentField select {
            height: 28px !important;
            min-height: 28px;
            max-height: 28px;
            line-height: 18px;
            padding-top: 4px;
            padding-bottom: 4px;
        }
        .ZTSMRiskAssessmentField .Field,
        .ZTSMRiskAssessmentField .Value {
            margin: 0;
            padding: 0;
        }
        .ZTSMRiskAssessmentField {
            min-height: 0;
        }
        #oooContent.ZTSMRiskAssessmentPage .ZTSMRiskAssessmentField_ZRM-RiskDetail,
        #oooContent.ZTSMRiskAssessmentPage .ZTSMRiskAssessmentField_ZRM-RiskPlan {
            max-height: 130px;
            overflow: hidden;
        }
        #oooContent.ZTSMRiskAssessmentPage .ZTSMRiskAssessmentField .Field,
        #oooContent.ZTSMRiskAssessmentPage .ZTSMRiskAssessmentField .Value,
        #oooContent.ZTSMRiskAssessmentPage .ZTSMRiskAssessmentField .InputField_Container,
        #oooContent.ZTSMRiskAssessmentPage .ZTSMRiskAssessmentField .InputField_InputContainer {
            min-height: 0 !important;
            height: auto !important;
        }
        .ZTSMRiskReferenceSuggestions {
            display: none;
            max-height: 180px;
            overflow: auto;
            margin-top: 4px;
            border: 1px solid #cdd3ea;
            border-radius: 4px;
            background: #fff;
            box-shadow: 0 8px 18px rgba(3, 10, 46, 0.12);
            position: relative;
            z-index: 20;
        }
        .ZTSMRiskReferenceSuggestion {
            display: block;
            width: 100%;
            padding: 6px 8px;
            border: 0;
            background: #fff;
            color: #11194f;
            text-align: left;
            font-size: 12px;
            line-height: 1.3;
            cursor: pointer;
        }
        .ZTSMRiskReferenceSuggestion:hover,
        .ZTSMRiskReferenceSuggestion:focus {
            background: #eef2ff;
            outline: none;
        }
        .ZTSMRiskAssessmentField .InputField_InputContainer,
        .ZTSMRiskAssessmentField .InputField_Selection {
            width: 100%;
            box-sizing: border-box;
        }
        .ZTSMRiskAssessmentField .InputField_Selection {
            min-height: 30px;
            padding: 5px 8px;
            font-size: 12px;
        }
        #oooContent.ZTSMRiskAssessmentPage .ZTSMRiskAssessmentField textarea {
            height: 56px !important;
            min-height: 56px !important;
            max-height: 90px !important;
            resize: vertical;
            overflow: auto;
        }
        #oooContent.ZTSMRiskAssessmentPage .ZTSMRiskAssessmentField_ZRM-RiskDetail textarea,
        #oooContent.ZTSMRiskAssessmentPage .ZTSMRiskAssessmentField_ZRM-RiskPlan textarea {
            height: 64px !important;
            min-height: 64px !important;
            max-height: 100px !important;
        }
        #oooContent.ZTSMRiskAssessmentPage .ZTSMRiskAssessmentField .ck-editor,
        #oooContent.ZTSMRiskAssessmentPage .ZTSMRiskAssessmentField .ck-editor__main,
        #oooContent.ZTSMRiskAssessmentPage .ZTSMRiskAssessmentField .ck-editor__editable,
        #oooContent.ZTSMRiskAssessmentPage .ZTSMRiskAssessmentField .cke,
        #oooContent.ZTSMRiskAssessmentPage .ZTSMRiskAssessmentField .cke_inner,
        #oooContent.ZTSMRiskAssessmentPage .ZTSMRiskAssessmentField .cke_contents {
            min-height: 64px !important;
            max-height: 100px !important;
        }
        .ZTSMRiskAssessmentRemove,
        .ZTSMRiskAssessmentAdd {
            width: 36px !important;
            min-width: 36px;
            max-width: 36px;
            height: 28px !important;
            min-height: 28px;
            border-radius: 4px;
            padding: 0;
            line-height: 26px;
        }
        .ZTSMRiskAssessmentAdd {
            float: none;
        }
        .ZTSMRiskAssessmentRemarks {
            margin-top: 8px;
        }
        .ZTSMRiskAssessmentRemarks label {
            display: block;
            margin-bottom: 4px;
            font-size: 12px;
            font-weight: 700;
            color: #555b82;
        }
        .ZTSMRiskAssessmentRemarks textarea {
            width: 100%;
            min-height: 72px;
            max-height: 110px;
            box-sizing: border-box;
            font-size: 12px;
        }
        .ZTSMRiskAssessmentActions {
            margin-top: 8px;
            text-align: right;
        }
        @media (max-width: 980px) {
            .ZTSMRiskAssessmentGrid2,
            .ZTSMRiskAssessmentGrid3 {
                grid-template-columns: 1fr;
            }
        }
    </style>

    <div id="oooMainBox" class="ZTSMRiskAssessmentLayout">
    <div class="ZTSMRiskAssessmentShell">
        <h1>[% Translate("Risk Assessment") | html %] [% Data.TicketNumber | html %]</h1>
        <form action="[% Env("CGIHandle") | html %]" method="post" class="Validate PreventMultipleSubmits">
            <input type="hidden" name="Action" value="CustomerTicketZTSMAction"/>
            <input type="hidden" name="TicketID" value="[% Data.TicketID | html %]"/>
            <input type="hidden" name="RuntimeAction" value="Assess"/>
            <input type="hidden" name="Subaction" value="SubmitRiskAssessment"/>

            [% Data.WorkspaceHTML %]

            <div class="ZTSMRiskAssessmentActions">
                <button type="button" class="ZTSMRiskAssessmentAdd">+</button>
            </div>

            <div class="ZTSMRiskAssessmentRemarks">
                <label for="Remarks">[% Translate("Remarks") | html %]</label>
                <textarea id="Remarks" name="Remarks" rows="5"></textarea>
            </div>

            <div class="ZTSMRiskAssessmentActions">
                <a class="Button" href="[% Env("CGIHandle") | html %]?Action=CustomerTicketZoom;TicketID=[% Data.TicketID | uri %]">[% Translate("Cancel") | html %]</a>
                <button type="submit" class="Primary">[% Translate("Submit Assessment") | html %]</button>
            </div>
        </form>
    </div>
    </div>

    <script>
    (function () {
        function preventGlobalInputModernizer(scope) {
            if (!scope || !scope.querySelectorAll) {
                return;
            }
            scope.querySelectorAll('.ZTSMRiskAssessmentPage select.Modernize, .ZTSMRiskAssessmentPage .Modernize').forEach(function (field) {
                field.classList.remove('Modernize');
            });
        }

        preventGlobalInputModernizer(document);

        function syncNavigationOffset() {
            var mainBox = document.querySelector('.ZTSMRiskAssessmentPage #oooMainBox.ZTSMRiskAssessmentLayout');
            var navigation = document.getElementById('oooNavigation');
            if (!mainBox || !navigation) {
                return;
            }
            mainBox.style.setProperty('--ZTSMNavigationOffset', navigation.getBoundingClientRect().width + 'px');
        }

        var addButton = document.querySelector('.ZTSMRiskAssessmentAdd');
        var body = document.getElementById('ZTSMRiskAssessmentRows');
        var template = document.getElementById('ZTSMRiskAssessmentTemplate');
        var nextIndex = body ? body.querySelectorAll('.ZTSMRiskAssessmentRow').length : 0;

        function syncViewportSize() {
            var mainBox = document.querySelector('.ZTSMRiskAssessmentPage #oooMainBox.ZTSMRiskAssessmentLayout');
            var navigation = document.getElementById('oooNavigation');
            var navWidth = navigation ? navigation.getBoundingClientRect().width : 0;
            if (!mainBox) {
                return;
            }
            mainBox.style.setProperty('--ZTSMRiskViewportWidth', Math.max(320, window.innerWidth - navWidth) + 'px');
            mainBox.style.setProperty('--ZTSMRiskViewportHeight', Math.max(360, window.innerHeight) + 'px');
        }

        function syncRowNumbers() {
            if (!body) {
                return;
            }
            body.querySelectorAll('.ZTSMRiskAssessmentRow').forEach(function (row, index) {
                var number = row.querySelector('.ZTSMRiskAssessmentRowNumber');
                if (number) {
                    number.textContent = String(index + 1);
                }
            });
        }

        function bindRemove(scope) {
            var buttons = (scope || document).querySelectorAll('.ZTSMRiskAssessmentRemove');
            buttons.forEach(function (button) {
                button.onclick = function () {
                    var row = button.closest('.ZTSMRiskAssessmentRow');
                    if (!row) {
                        return;
                    }
                    if (body.querySelectorAll('.ZTSMRiskAssessmentRow').length <= 1) {
                        row.querySelectorAll('input[type="text"], input[type="hidden"], textarea').forEach(function (field) { field.value = ''; });
                        row.querySelectorAll('select').forEach(function (field) { field.selectedIndex = 0; });
                        return;
                    }
                    row.remove();
                    syncRowNumbers();
                };
            });
        }

        function fieldValue(row, fieldName) {
            var field = row.querySelector('[name="' + fieldName + '"]');
            if (!field) {
                return '';
            }

            if (field.tagName === 'SELECT') {
                var option = field.options[field.selectedIndex];
                return option ? (option.text || option.value || '') : '';
            }

            return field.value || '';
        }

        function scoreValue(value) {
            value = String(value || '').toLowerCase();

            var numeric = value.match(/(?:^|[^0-9])([1-5])(?:[^0-9]|$)/);
            if (numeric) {
                return Number(numeric[1]);
            }

            if (value.indexOf('very low') >= 0 || value.indexOf('negligible') >= 0) {
                return 1;
            }
            if (value.indexOf('very high') >= 0 || value.indexOf('critical') >= 0) {
                return 5;
            }
            if (value.indexOf('high') >= 0 || value.indexOf('major') >= 0) {
                return 4;
            }
            if (value.indexOf('medium') >= 0 || value.indexOf('moderate') >= 0) {
                return 3;
            }
            if (value.indexOf('low') >= 0 || value.indexOf('minor') >= 0) {
                return 2;
            }
            return 0;
        }

        function setField(row, fieldName, value) {
            row.querySelectorAll('[name="' + fieldName + '"]').forEach(function (field) {
                field.value = value;
                field.setAttribute('readonly', 'readonly');
            });
        }

        function recalculateRow(row) {
            var index = row.getAttribute('data-row-index');
            if (!index) {
                return;
            }

            var inherentLikelihood = scoreValue(fieldValue(row, 'RA_' + index + '_ZRM-InherentLikelihood'));
            var inherentImpact = scoreValue(fieldValue(row, 'RA_' + index + '_ZRM-InherentImpact'));
            var residualLikelihood = scoreValue(fieldValue(row, 'RA_' + index + '_ZRM-ResidualLikelihood'));
            var residualImpact = scoreValue(fieldValue(row, 'RA_' + index + '_ZRM-ResidualImpact'));

            setField(row, 'RA_' + index + '_ZRM-InherentCalculatedRisk', inherentLikelihood && inherentImpact ? inherentLikelihood * inherentImpact : '');
            setField(row, 'RA_' + index + '_ZRM-ResidualCalculatedRisk', residualLikelihood && residualImpact ? residualLikelihood * residualImpact : '');
        }

        function bindCalculation(scope) {
            (scope || document).querySelectorAll('.ZTSMRiskAssessmentRow').forEach(function (row) {
                row.querySelectorAll('select, input').forEach(function (field) {
                    field.addEventListener('change', function () {
                        recalculateRow(row);
                    });
                    field.addEventListener('input', function () {
                        recalculateRow(row);
                    });
                });
                recalculateRow(row);
            });
        }

        function initializeReferenceFields() {
            if (!window.jQuery) {
                return;
            }

            jQuery('.ZTSMRiskAssessmentField .DynamicFieldReference').each(function () {
                var field = jQuery(this);
                if (field.data('ZTSMReferenceReady')) {
                    return;
                }

                if (
                    window.Core
                    && Core.Agent
                    && Core.Agent.DynamicFieldReferenceSearch
                    && typeof Core.Agent.DynamicFieldReferenceSearch.InitElement === 'function'
                    && Core.Config
                    && typeof Core.Config.Get === 'function'
                ) {
                    var autoComplete = Core.Config.Get('Autocomplete') || {};
                    var autoCompleteActive = true;
                    if (
                        autoComplete.DynamicFieldReference
                        && typeof autoComplete.DynamicFieldReference.AutoCompleteActive !== 'undefined'
                    ) {
                        autoCompleteActive = autoComplete.DynamicFieldReference.AutoCompleteActive !== '0';
                    }
                    Core.Agent.DynamicFieldReferenceSearch.InitElement(field, autoCompleteActive);
                    field.data('ZTSMReferenceReady', true);
                    return;
                }

                var suggestions = jQuery('<div class="ZTSMRiskReferenceSuggestions" />').insertAfter(field);
                var pendingRequest;
                var requestTimer;

                function hideSuggestions() {
                    suggestions.hide().empty();
                }

                function selectReference(key, value) {
                    field.prev('input[type=hidden]').val(key).trigger('change');
                    field.val(value);
                    field.data('ZTSMSelectedLabel', value);
                    hideSuggestions();
                }

                function renderSuggestions(result) {
                    suggestions.empty();
                    if (!Array.isArray(result) || !result.length) {
                        hideSuggestions();
                        return;
                    }

                    result.forEach(function (item) {
                        jQuery('<button type="button" class="ZTSMRiskReferenceSuggestion" />')
                            .text(item.Value || '')
                            .on('mousedown', function (event) {
                                event.preventDefault();
                            })
                            .on('click', function () {
                                selectReference(item.Key, item.Value || '');
                            })
                            .appendTo(suggestions);
                    });
                    suggestions.show();
                }

                function searchReferences(term) {
                    var baseLink = window.Core && Core.Config && typeof Core.Config.Get === 'function'
                        ? Core.Config.Get('Baselink')
                        : '[% Env("CGIHandle") | html %]?';
                    var query = 'Action=AgentReferenceSearch'
                        + ';Term=' + encodeURIComponent(term || '')
                        + ';Field=' + encodeURIComponent(field.attr('id') || '')
                        + ';MaxResults=20';

                    if (pendingRequest && pendingRequest.abort) {
                        pendingRequest.abort();
                    }

                    pendingRequest = jQuery.ajax({
                        url: baseLink + query,
                        method: 'GET',
                        dataType: 'json',
                        success: renderSuggestions,
                        error: hideSuggestions
                    });
                }

                field.on('input.ZTSMReference', function () {
                    var term = field.val() || '';
                    if (field.val() !== field.data('ZTSMSelectedLabel')) {
                        field.prev('input[type=hidden]').val('');
                    }
                    clearTimeout(requestTimer);
                    if (term.length < 1) {
                        hideSuggestions();
                        return;
                    }
                    requestTimer = setTimeout(function () {
                        searchReferences(term);
                    }, 150);
                });
                field.on('blur.ZTSMReference', function () {
                    setTimeout(hideSuggestions, 150);
                });

                field.data('ZTSMReferenceReady', true);
            });
        }

        if (addButton && body && template) {
            addButton.onclick = function () {
                var html = template.innerHTML.replace(/__INDEX__/g, String(nextIndex++));
                var wrapper = document.createElement('div');
                wrapper.innerHTML = html;
                while (wrapper.firstElementChild) {
                    body.appendChild(wrapper.firstElementChild);
                }
                preventGlobalInputModernizer(body);
                bindRemove(body);
                bindCalculation(body);
                syncRowNumbers();
                initializeReferenceFields();
            };
        }

        bindRemove(document);
        bindCalculation(document);
        syncRowNumbers();
        initializeReferenceFields();
        syncNavigationOffset();
        syncViewportSize();
        window.addEventListener('resize', syncNavigationOffset);
        window.addEventListener('resize', syncViewportSize);
    }());
    </script>
</div>
