<style>
    .TicketZoom #oooMainBox.ZTSMZoomLayout {
        --ZTSMNavigationOffset: 56px;
        display: grid;
        grid-template-columns: minmax(360px, 520px) minmax(0, 1fr);
        gap: 24px;
        align-items: start;
        width: auto;
        max-width: none;
        padding: 24px 28px 42px calc(var(--ZTSMNavigationOffset) + 28px);
        background: #f4f6fb;
        transition: padding-left 0.3s ease;
    }

    .TicketZoom #ZTSMZoomSide {
        position: sticky;
        top: 16px;
        display: flex;
        flex-direction: column;
        gap: 18px;
        min-width: 0;
        max-height: calc(100vh - 120px);
        overflow: auto;
        padding-right: 4px;
    }

    .TicketZoom #ZTSMZoomWork {
        min-width: 0;
    }

    .TicketZoom #oooHeader {
        position: relative;
        z-index: 3200;
        overflow: visible;
    }

    .TicketZoom .ZTSMRequestInfoPanel,
    .TicketZoom #ZTSMStoryLinks,
    .TicketZoom #ZTSMArticleSummaryPanel {
        color: #ffffff;
        background: #02063c;
        border-radius: 10px;
        box-shadow: 0 12px 28px rgba(0, 2, 60, 0.16);
        padding: 22px;
    }

    .TicketZoom .ZTSMSectionHead {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 18px;
    }

    .TicketZoom .ZTSMSectionHead span,
    .TicketZoom .ZTSMRequestDescription span,
    .TicketZoom .ZTSMRequestAttachmentBlock h4,
    .TicketZoom .ZTSMRequestDetailItem > span,
    .TicketZoom .ZTSMRequestSummary dt,
    .TicketZoom .ZTSMRequestContext span,
    .TicketZoom .ZTSMRequesterDetails dt,
    .TicketZoom #ZTSMStoryLinks .ooo12,
    .TicketZoom #ZTSMArticleSummaryPanel .ooo12 {
        color: #9fb2ff;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .TicketZoom .ZTSMSectionHead strong {
        flex: 0 0 auto;
        padding: 5px 10px;
        border-radius: 999px;
        background: #1237ff;
        color: #ffffff;
        font-size: 12px;
    }

    .TicketZoom .ZTSMRequestSummary {
        display: grid;
        grid-template-columns: 1fr;
        gap: 12px;
        margin: 0;
    }

    .TicketZoom .ZTSMRequestSummary div {
        min-width: 0;
    }

    .TicketZoom .ZTSMRequestSummary dt {
        margin-bottom: 3px;
    }

    .TicketZoom .ZTSMRequestSummary dd {
        margin: 0;
        color: #ffffff;
        overflow-wrap: anywhere;
    }

    .TicketZoom .ZTSMRequesterButton,
    .TicketZoom .ZTSMOverlayButton,
    .TicketZoom .ZTSMOverlayClose {
        border: 0;
        border-radius: 999px;
        background: #1237ff;
        color: #ffffff;
        cursor: pointer;
        font-weight: 700;
    }

    .TicketZoom .ZTSMRequesterButton {
        margin: 4px 0 0;
        padding: 0;
        background: transparent;
        color: #ffffff;
        text-align: left;
        overflow-wrap: anywhere;
    }

    .TicketZoom .ZTSMRequesterButton:hover {
        color: #dce3ff;
    }

    .TicketZoom .ZTSMActionMenu {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 3300;
    }

    .TicketZoom .ZTSMActionMenu summary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        padding: 0;
        border: 0;
        border-radius: 50%;
        background: transparent;
        color: #02063c;
        cursor: pointer;
        list-style: none;
    }

    .TicketZoom .ZTSMActionMenu summary::-webkit-details-marker {
        display: none;
    }

    .TicketZoom .ZTSMActionMenu summary:hover,
    .TicketZoom .ZTSMActionMenu summary:focus {
        background: rgba(4, 31, 255, 0.08);
        outline: none;
    }

    .TicketZoom .ZTSMActionMenuList {
        display: none;
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        z-index: 3400;
        min-width: 180px;
        padding: 6px;
        border: 1px solid #dfe4f5;
        border-radius: 8px;
        background: #ffffff;
        box-shadow: 0 16px 36px rgba(0, 2, 60, 0.18);
    }

    .TicketZoom .ZTSMActionMenu[open] .ZTSMActionMenuList {
        display: block;
    }

    .TicketZoom .ZTSMActionMenuList a {
        display: block;
        padding: 10px 12px;
        border-radius: 6px;
        color: #02063c;
        text-decoration: none;
        white-space: nowrap;
    }

    .TicketZoom .ZTSMActionMenuList a:hover,
    .TicketZoom .ZTSMActionMenuList a:focus {
        background: #eef2ff;
        outline: none;
    }

    .TicketZoom .ZTSMRequesterModal,
    .TicketZoom .ZTSMRequestDetailOverlay {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 2300;
        background: rgba(2, 6, 60, 0.54);
        padding: 8vh max(24px, calc(var(--ZTSMNavigationOffset) + 24px)) 24px;
        box-sizing: border-box;
    }

    .TicketZoom .ZTSMRequesterModal.Hidden,
    .TicketZoom .ZTSMRequestDetailOverlay.Hidden {
        display: none;
    }

    .TicketZoom .ZTSMRequesterModal.Visible,
    .TicketZoom .ZTSMRequestDetailOverlay.Visible {
        display: block;
    }

    .TicketZoom .ZTSMOverlayCard {
        width: min(920px, 100%);
        max-height: 84vh;
        overflow: auto;
        margin: 0 auto;
        padding: 24px;
        border-radius: 10px;
        background: #ffffff;
        color: #02063c;
        box-shadow: 0 24px 64px rgba(0, 2, 60, 0.3);
        box-sizing: border-box;
    }

    .TicketZoom .ZTSMOverlayHead {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 18px;
    }

    .TicketZoom .ZTSMOverlayHead h3 {
        margin: 0;
        color: #02063c;
        white-space: normal;
    }

    .TicketZoom .ZTSMOverlayClose {
        flex: 0 0 auto;
        padding: 8px 14px;
    }

    .TicketZoom .ZTSMRequesterDetails {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 14px;
        margin: 0;
    }

    .TicketZoom .ZTSMRequesterDetails dd {
        margin: 4px 0 0;
        color: #02063c;
        overflow-wrap: anywhere;
    }

    .TicketZoom .ZTSMRequestDescription,
    .TicketZoom .ZTSMRequestAttachmentBlock,
    .TicketZoom .ZTSMRequestMore {
        margin-top: 18px;
        padding-top: 16px;
        border-top: 1px solid rgba(255, 255, 255, 0.15);
    }

    .TicketZoom .ZTSMRequestDescription p {
        margin: 8px 0 0;
        color: #eef2ff;
        line-height: 1.5;
        overflow-wrap: anywhere;
    }

    .TicketZoom .ZTSMRequestContext {
        display: grid;
        grid-template-columns: 1fr;
        gap: 10px;
        margin-top: 18px;
    }

    .TicketZoom .ZTSMRequestContext div {
        padding: 12px;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.08);
        min-width: 0;
    }

    .TicketZoom .ZTSMRequestContext strong {
        display: block;
        margin-top: 4px;
        color: #ffffff;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .TicketZoom .ZTSMRequestAttachments {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-top: 10px;
    }

    .TicketZoom .ZTSMRequestAttachment {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
        padding: 10px 12px;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.1);
        color: #ffffff;
        text-decoration: none;
    }

    .TicketZoom .ZTSMRequestAttachment span {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .TicketZoom .ZTSMRequestMore {
        display: block;
    }

    .TicketZoom .ZTSMRequestMore summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .TicketZoom .ZTSMRequestMore summary {
        width: 100%;
        cursor: pointer;
        list-style: none;
    }

    .TicketZoom .ZTSMRequestMore summary::-webkit-details-marker {
        display: none;
    }

    .TicketZoom .ZTSMRequestMore span {
        color: #ffffff;
        font-weight: 700;
    }

    .TicketZoom .ZTSMOverlayButton {
        flex: 0 0 auto;
        padding: 8px 14px;
    }

    .TicketZoom .ZTSMRequestDetailGrid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 10px;
        margin-top: 12px;
        width: 100%;
        max-height: 360px;
        overflow: auto;
        box-sizing: border-box;
    }

    .TicketZoom .ZTSMRequestMore:not([open]) > .ZTSMRequestDetailGrid {
        display: none;
    }

    .TicketZoom .ZTSMRequestDetailItem {
        min-width: 0;
        padding: 12px;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.08);
        color: #ffffff;
        overflow: auto;
    }

    .TicketZoom .ZTSMRequestDetailItem > div {
        min-width: 220px;
        max-width: 100%;
        overflow: auto;
    }

    .TicketZoom .ZTSMRequestDetailItem table,
    .TicketZoom .ZTSMRequestDetailItem .DynamicFieldSet {
        width: 100%;
        border-collapse: collapse;
    }

    .TicketZoom .ZTSMRequestDetailItem th,
    .TicketZoom .ZTSMRequestDetailItem td {
        padding: 8px 10px;
        border: 1px solid #dfe4f5;
        text-align: left;
        vertical-align: top;
    }

    .TicketZoom #ZTSMStoryLinks p,
    .TicketZoom #ZTSMStoryLinks ul,
    .TicketZoom #ZTSMArticleSummaryPanel ul {
        margin: 0;
    }

    .TicketZoom #ZTSMStoryLinks ul,
    .TicketZoom #ZTSMArticleSummaryPanel ul {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 10px;
        padding: 0;
        list-style: none;
    }

    .TicketZoom #ZTSMStoryLinks li,
    .TicketZoom #ZTSMArticleSummaryPanel li,
    .TicketZoom #ZTSMStoryLinks p {
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.1);
        transition: background 0.15s ease, transform 0.15s ease;
    }

    .TicketZoom #ZTSMStoryLinks li.Active,
    .TicketZoom #ZTSMArticleSummaryPanel li.oooActive {
        background: rgba(18, 55, 255, 0.42);
    }

    .TicketZoom #ZTSMStoryLinks li:hover,
    .TicketZoom #ZTSMArticleSummaryPanel li:hover,
    .TicketZoom #ZTSMStoryLinks p:hover {
        background: rgba(255, 255, 255, 0.16);
        transform: translateY(-1px);
    }

    .TicketZoom #ZTSMStoryLinks a {
        display: inline-block;
        padding: 10px 12px;
        color: #ffffff;
        text-decoration: none;
    }

    .TicketZoom #ZTSMStoryLinks li a {
        display: block;
        padding-bottom: 4px;
    }

    .TicketZoom #ZTSMStoryLinks li span {
        display: inline-block;
        margin: 0 0 10px 12px;
        color: #dce3ff;
        font-size: 12px;
    }

    .TicketZoom #ZTSMArticleSummaryPanel #oooArticleList {
        position: static;
        width: 100%;
        max-height: 360px;
        margin: 0;
        border-radius: 0;
        background: transparent;
        color: #ffffff;
        overflow: auto;
    }

    .TicketZoom #ZTSMArticleSummaryPanel #oooArticleList > li {
        height: auto;
        min-height: 58px;
        padding: 10px 12px;
        box-sizing: border-box;
    }

    .TicketZoom #ZTSMArticleSummaryPanel #oooArticleList > li > hr {
        display: none;
    }

    .TicketZoom #ZTSMArticleSummaryPanel #oooArticleList .oooSender,
    .TicketZoom #ZTSMArticleSummaryPanel #oooArticleList .oooSubject,
    .TicketZoom #ZTSMArticleSummaryPanel #oooArticleList .oooAge {
        color: #ffffff;
    }

    .TicketZoom #ProcessActivities {
        margin-bottom: 18px;
    }

    .TicketZoom #NextActivities {
        justify-content: flex-start;
        flex-wrap: wrap;
        gap: 10px;
    }

    .TicketZoom #NextActivities form {
        margin: 0;
    }

    .TicketZoom #oooArticleList,
    .TicketZoom #oooArticleListExpanded {
        width: 100%;
        max-width: none;
        margin-left: 0;
        margin-right: 0;
    }

    .TicketZoom #oooArticleListExpanded > li {
        margin-bottom: 18px;
    }

    @media (max-width: 1100px) {
        .TicketZoom #oooMainBox.ZTSMZoomLayout {
            grid-template-columns: 1fr;
            padding-left: 28px;
        }

        .TicketZoom #ZTSMZoomSide {
            position: static;
            max-height: none;
            overflow: visible;
        }
    }

    .TicketZoom .ZTSMHeaderMeta {
        margin-top: 4px;
    }

    .TicketZoom .ZTSMHeaderMeta p {
        margin: 0;
        overflow: hidden;
        color: #6e7391;
        text-overflow: ellipsis;
    }

    .TicketZoom .ZTSMHeaderOwner {
        min-width: 0;
        align-self: center;
        text-align: right;
    }

    .TicketZoom .ZTSMHeaderOwner p {
        margin: 0;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    @media only screen and (max-width: 767px) {
        .TicketZoom #oooHeader > .ZTSMHeaderOwner {
            grid-row: 2 / 3;
            grid-column: 2 / 4;
            justify-self: stretch;
        }
    }

    @media only screen and (min-width: 768px) {
        .TicketZoom #oooHeader > .ZTSMHeaderOwner {
            grid-column: 3 / 4;
            grid-row: 1 / 2;
        }
    }
</style>

<div id='oooContent' class="TicketZoom ARIARoleMain">
    <div id='oooHeader'[% IF Data.TicketInfoDisplayType == 'Permanent' %] class="oooTicketInfoPermanent"[% END %]>
        <div class='oooWithSub'>
            <h2 title="[% Data.Title | html %]">[% Data.Title | html %]</h2>
            <div class="ZTSMHeaderMeta">
                <p class="ooo12g" title="[% Data.Type | html %]: [% Data.TicketNumber | html %]">[% Data.Type | html %]: [% Data.TicketNumber | html %]</p>
                <p class="ooo12g" title="[% Data.TicketState | html %]">[% Data.TicketState | html %]</p>
            </div>
        </div>
        <div class='oooAvatar'>
            [% IF Data.Avatar %]
                <img src="[% Data.Avatar %]" />
            [% ELSE %]
                <span class="Initials">[% Data.UserInitials | html %]</span>
            [% END %]
        </div>
        <div class="ZTSMHeaderOwner">
            [% IF Data.ZTSMHeaderOwnerGroup %]<p class="ooo12" title="[% Data.ZTSMHeaderOwnerGroup | html %]">[% Data.ZTSMHeaderOwnerGroup | html %]</p>[% END %]
            [% IF Data.ZTSMHeaderOwner %]<p class="ooo12g" title="[% Data.ZTSMHeaderOwner | html %]">[% Data.ZTSMHeaderOwner | html %]</p>[% END %]
        </div>
[% IF Data.TicketInfoDisplayType == 'Header' %]
        <div class='oooInfoBlock'>
            <p class='oooInfo ooo12'><i class="ooofo ooofo-info"></i> <span>[% Translate('Information') | html %]</span></p>
            [% INCLUDE "CustomerTicketZoom/TicketInfo.tt" %]
        </div>
[% END %]
        <div>
[% RenderBlockStart("ReplyButton") %]
        <button id="ReplyButton" class="DontPrint oooM"><span>[% Translate("Reply") | html %] </span><i class="ooofo ooofo-arrow_r2"></i></button>
[% RenderBlockEnd("ReplyButton") %]
        </div>
        <details class="ZTSMActionMenu DontPrint">
            <summary aria-haspopup="true" title="[% Translate("More") | html %]">
                <i class="ooofo ooofo-more_v"></i>
            </summary>
            <div class="ZTSMActionMenuList" role="menu">
[% RenderBlockStart("Print") %]
                <a role="menuitem" href="[% Env("Baselink") %]Action=CustomerTicketPrint;TicketID=[% Data.TicketID | uri %]" class="AsPopup">[% Translate("Print") | html %]</a>
[% RenderBlockEnd("Print") %]
[% RenderBlockStart("Expand") %]
                <a role="menuitem" href="[% Env("Baselink") %]Action=CustomerTicketZoom;TicketID=[% Data.TicketID | uri %];ZoomExpand=[% Data.ZoomExpand | uri %]">[% Translate(Data.ExpandText) | html %]</a>
[% RenderBlockEnd("Expand") %]
            </div>
        </details>
        <div id='oooCategories'>
[% RenderBlockStart("Categories") %]
            [% IF Data.Config.Link %]
                [% IF Data.Config.Translate %]
                    <a class="oooCategory ooo10" style="background-color:[% Data.Color | html %]" href="[% Data.Config.Link | Interpolate | html %]" target="_blank">[% IF Data.Config.Prefix %][% Data.Config.Prefix | html %][% END %][% Data.Text | Interpolate | Translate | html %]</a>
                [% ELSE %]
                    <a class="oooCategory ooo10" style="background-color:[% Data.Color | html %]" href="[% Data.Config.Link | Interpolate | html %]" target="_blank">[% IF Data.Config.Prefix %][% Data.Config.Prefix | html %][% END %][% Data.Text | Interpolate | html %]</a>
                [% END %]
            [% ELSE %]
                [% IF Data.Config.Translate %]
                    <p class="oooCategory ooo10" style="background-color:[% Data.Color | html %]">[% IF Data.Config.Prefix %][% Data.Config.Prefix | html %][% END %][% Data.Text | Interpolate | Translate | html %]</p>
                [% ELSE %]
                    <p class="oooCategory ooo10" style="background-color:[% Data.Color | html %]">[% IF Data.Config.Prefix %][% Data.Config.Prefix | html %][% END %][% Data.Text | Interpolate | html %]</p>
                [% END %]
            [% END %]
[% RenderBlockEnd("Categories") %]
        </div>
    </div>
    <div id='oooMainBox' class="Content ZTSMZoomLayout">
        <div id="ZTSMZoomSide">
            [% Data.ZTSMRequestInfoHTML %]
[% RenderBlockStart("ZTSMStoryLinks") %]
        <div id="ZTSMStoryLinks">
[% RenderBlockStart("ZTSMOriginalTicketLink") %]
            <p>
                <a class="oooM" href="[% Env("Baselink") %]Action=CustomerTicketZoom;TicketID=[% Data.StoryRootTicketID | uri %];ZTSMReadOnlyView=1">[% Translate("Original ticket") | html %]</a>
            </p>
[% RenderBlockEnd("ZTSMOriginalTicketLink") %]
[% RenderBlockStart("ZTSMChildTicketLinks") %]
            <div class="ooo12">[% Translate("Child tickets") | html %]</div>
            <ul>
[% RenderBlockStart("ZTSMChildTicketLink") %]
                <li[% IF Data.IsCurrent %] class="Active"[% END %]>
                    <a href="[% Env("Baselink") %]Action=CustomerTicketZoom;TicketID=[% Data.TicketID | uri %];ZTSMReadOnlyView=1">[% Config('Ticket::Hook') %][% Config('Ticket::HookDivider') %][% Data.TicketNumber | html %]</a>
                    [% IF Data.Title %]<span>[% Data.Title | html %]</span>[% END %]
                    [% IF Data.Type %]<span>[% Data.Type | html %]</span>[% END %]
                    [% IF Data.State %]<span>[% Data.State | html %]</span>[% END %]
                </li>
[% RenderBlockEnd("ZTSMChildTicketLink") %]
            </ul>
[% RenderBlockEnd("ZTSMChildTicketLinks") %]
        </div>
[% RenderBlockEnd("ZTSMStoryLinks") %]
            <div id="ZTSMArticleSummaryPanel">
                <div class="ooo12">[% Translate("Related Activity") | html %]</div>
                <ul id='oooArticleList'[% IF Data.TicketInfoDisplayType == 'Permanent' %] class="oooTicketInfoPermanent"[% END %]>
                </ul>
            </div>
        </div>
        <div id="ZTSMZoomWork">
        <div id="ProcessActivities">
[% RenderBlockStart("NextActivities") %]
            <div id="NextActivities">
[% RenderBlockStart("ActivityDialogDirectSubmit") %]
                <form title="[% Translate(Data.Name) | html %]" action="[% Env("CGIHandle") | html %]" method="post">
                    <input type="hidden" name="Action" value="CustomerTicketZoom"/>
                    <input type="hidden" name="Subaction" value="StoreActivityDialog"/>
                    <input type="hidden" name="TicketID" value="[% Data.TicketID | html %]"/>
                    <input type="hidden" name="ProcessEntityID" value="[% Data.ProcessEntityID | html %]"/>
                    <input type="hidden" name="ActivityDialogEntityID" value="[% Data.ActivityDialogEntityID | html %]"/>
                    <button id="Button_[% Data.ActivityDialogEntityID | uri %]" title="[% Translate(Data.Name) | html %]" class="oooM ActivitySubmitButton" type="submit">[% Translate(Data.Name) | html %]</button>
                </form>
[% RenderBlockEnd("ActivityDialogDirectSubmit") %]
[% RenderBlockStart("ActivityDialog") %]
                <button id="Button_[% Data.ActivityDialogEntityID | uri %]" title="[% Translate(Data.Name) | html %]" class="oooM ActivityStartButton">[% Translate(Data.Name) | html %]</button>
[% RenderBlockEnd("ActivityDialog") %]
[% RenderBlockStart("ZTSMRuntimeAction") %]
[% IF Data.DirectURL %]
                <form title="[% Translate(Data.Label) | html %]" action="[% Env("CGIHandle") | html %]" method="get">
                    <input type="hidden" name="Action" value="CustomerTicketZTSMAction"/>
                    <input type="hidden" name="TicketID" value="[% Data.TicketID | html %]"/>
                    <input type="hidden" name="RuntimeAction" value="[% Data.Action | html %]"/>
                    <button id="Button_ZTSM_[% Data.Action | uri %]" title="[% Translate(Data.Label) | html %]" class="oooM ActivitySubmitButton ZTSMDirectActionButton" type="submit">[% Translate(Data.Label) | html %]</button>
                </form>
[% ELSE %]
                <button id="Button_ZTSM_[% Data.Action | uri %]" title="[% Translate(Data.Label) | html %]" class="oooM ActivityStartButton" type="button" onclick="var Element = document.getElementById('Process_ZTSM_[% Data.Action | uri %]'); if (Element) { Element.classList.toggle('Visible'); } return false;">[% Translate(Data.Label) | html %]</button>
[% END %]
[% RenderBlockEnd("ZTSMRuntimeAction") %]
            </div>
[% RenderBlockEnd("NextActivities") %]
        </div>
        <ul id='oooArticleListExpanded'[% IF Data.TicketInfoDisplayType == 'Permanent' %] class="oooTicketInfoPermanent"[% END %]>
[% RenderBlockStart("ProcessActivity") %]
            <li id="Process_[% Data.ActivityDialogEntityID | uri %]" class="Activity">
                [% Data.ActivityHTML %]
            </li>
[% RenderBlockEnd("ProcessActivity") %]
[% RenderBlockStart("ZTSMRuntimeActionDialog") %]
            <li id="Process_ZTSM_[% Data.Action | uri %]" class="Activity ZTSMRuntimeActionDialog">
[% IF Data.IsRiskAssessment %]
                <div id="ZTSMRiskAssessmentLazy_[% Data.Action | uri %]" class="ZTSMRiskAssessmentLazy" data-loaded="0">
                    <div class="Messenger">
                        <fieldset class="DontPrint">
                            <div class="MessageHeader">
                                <h2>[% Translate(Data.Label) | html %]</h2>
                            </div>
                            <div class="ZTSMRiskAssessmentLazyBody">[% Translate("Loading...") | html %]</div>
                        </fieldset>
                    </div>
                </div>
                <script>
                (function () {
                    var Container = document.getElementById('ZTSMRiskAssessmentLazy_[% Data.Action | uri %]');
                    var Button = document.getElementById('Button_ZTSM_[% Data.Action | uri %]');

                    function ExecuteScripts(Scope) {
                        var Scripts = Scope.querySelectorAll('script');
                        Array.prototype.forEach.call(Scripts, function (Script) {
                            var NewScript = document.createElement('script');
                            if (Script.src) {
                                NewScript.src = Script.src;
                            }
                            else {
                                NewScript.text = Script.text || Script.textContent || Script.innerHTML || '';
                            }
                            Script.parentNode.replaceChild(NewScript, Script);
                        });
                    }

                    function LoadRiskAssessment() {
                        if (!Container || Container.getAttribute('data-loaded') === '1') {
                            return;
                        }

                        Container.setAttribute('data-loaded', '1');
                        var Body = Container.querySelector('.ZTSMRiskAssessmentLazyBody');
                        var BaseLink = window.Core && Core.Config && typeof Core.Config.Get === 'function'
                            ? Core.Config.Get('Baselink')
                            : '[% Env("CGIHandle") | html %]?';
                        var URL = BaseLink
                            + 'Action=CustomerTicketZTSMAction'
                            + ';TicketID=[% Data.TicketID | uri %]'
                            + ';RuntimeAction=[% Data.Action | uri %]'
                            + ';Subaction=RiskAssessmentInline';

                        var Request = new XMLHttpRequest();
                        Request.open('GET', URL, true);
                        Request.onreadystatechange = function () {
                            if (Request.readyState !== 4 || !Body) {
                                return;
                            }
                            if (Request.status >= 200 && Request.status < 300) {
                                Body.innerHTML = Request.responseText;
                                ExecuteScripts(Body);
                                return;
                            }
                            Container.setAttribute('data-loaded', '0');
                            Body.innerHTML = '[% Translate("Could not load risk assessment.") | html %]';
                        };
                        Request.send();
                    }

                    if (Button) {
                        Button.addEventListener('click', function () {
                            window.setTimeout(LoadRiskAssessment, 0);
                        });
                    }
                }());
                </script>
[% ELSIF Data.InlineHTML %]
                [% Data.InlineHTML %]
[% ELSE %]
                <style>
                    .ZTSMRuntimeActionDialog .Messenger .ZTSMRiskField,
                    .ZTSMRuntimeActionDialog .Messenger .ZTSMRuntimeRemarks {
                        position: relative;
                        display: block;
                        min-height: 72px;
                        margin: 0 0 24px;
                        padding: 18px 44px 12px 44px;
                        border: 1px solid #8388b2;
                        border-radius: 10px;
                        background: #fff;
                        box-sizing: border-box;
                    }
                    .ZTSMRuntimeActionDialog .Messenger .ZTSMRiskField > label,
                    .ZTSMRuntimeActionDialog .Messenger .ZTSMRuntimeRemarks > label {
                        position: absolute;
                        top: -10px;
                        left: 32px;
                        display: inline-block;
                        padding: 0 8px;
                        background: #fff;
                        color: #7e7da5;
                        line-height: 1.2;
                        white-space: nowrap;
                    }
                    .ZTSMRuntimeActionDialog .Messenger .ZTSMRiskField .Field,
                    .ZTSMRuntimeActionDialog .Messenger .ZTSMRuntimeRemarks textarea {
                        width: 100%;
                    }
                    .ZTSMRuntimeActionDialog .Messenger .ZTSMRiskField select,
                    .ZTSMRuntimeActionDialog .Messenger .ZTSMRiskField input,
                    .ZTSMRuntimeActionDialog .Messenger .ZTSMRiskField .InputField_Container {
                        width: 100%;
                        min-height: 34px;
                    }
                    .ZTSMRuntimeActionDialog .Messenger .ZTSMRiskField .InputField_Selection {
                        min-height: 34px;
                        padding: 6px 10px;
                    }
                    .ZTSMRuntimeActionDialog .Messenger .ZTSMRuntimeRemarks {
                        min-height: 180px;
                        padding: 22px 44px 18px 44px;
                    }
                    .ZTSMRuntimeActionDialog .Messenger .ZTSMRuntimeRemarks textarea {
                        display: block;
                        min-height: 140px;
                        border: 0;
                        background: transparent;
                        resize: vertical;
                        box-sizing: border-box;
                    }
                    .ZTSMRuntimeActionDialog .Messenger .ZTSMRuntimeRemarks textarea:focus {
                        outline: 0;
                    }
                </style>
                <form action="[% Env("CGIHandle") | html %]" method="post" name="ZTSMRuntimeAction[% Data.Action | html %]" class="Validate PreventMultipleSubmits">
                    <input type="hidden" name="Action" value="CustomerTicketZTSMAction"/>
                    <input type="hidden" name="TicketID" value="[% Data.TicketID | html %]"/>
                    <input type="hidden" name="RuntimeAction" value="[% Data.Action | html %]"/>
                    <div class="Messenger">
                        <fieldset class="DontPrint">
                            <div class="MessageHeader">
                                <h2>[% Translate(Data.Label) | html %]</h2>
                            </div>
                            [% Data.RiskFieldsHTML %]
                            <div class="Row ZTSMRuntimeRemarks">
                                <textarea title="[% Translate("Remarks") | html %]" id="Remarks_[% Data.Action | html %]" name="Remarks" rows="5" cols="[% Config("Ticket::Frontend::TextAreaNote") | html %]"[% IF Data.RemarksRequired %] class="Validate_Required"[% END %]></textarea>
                                <label for="Remarks_[% Data.Action | html %]"[% IF Data.RemarksRequired %] class="Mandatory"[% END %]>[% Translate("Remarks") | html %]:[% IF Data.RemarksRequired %] <span class="Marker">*</span>[% END %]</label>
                                <div class="Clear"></div>
                            </div>
                        </fieldset>
                        <div class="ActionRow">
                            <button type="button" class="CloseButton oooXS">[% Translate("Discard") | html %]</button><!--
                            --><button type="submit" value="[% Translate(Data.Label) | html %]" class="Primary oooXS">[% Translate(Data.Label) | html %]</button>
                        </div>
                    </div>
                </form>
[% END %]
            </li>
[% RenderBlockEnd("ZTSMRuntimeActionDialog") %]
[% RenderBlockStart("FollowUp") %]
<li id="FollowUp" class="[% Data.FollowUpVisible | html %] Activity">
    <form action="[% Env("CGIHandle") %]#FollowUp" method="post" enctype="multipart/form-data" name="compose" id="ReplyCustomerTicket" class="Validate PreventMultipleSubmits">
        <input type="hidden" name="Action" value="CustomerTicketZoom" />
        <input type="hidden" name="Subaction" value="Store" />
        <input type="hidden" name="TicketID" value="[% Data.TicketID | html %]" />
        <input type="hidden" name="ArticleID" value="[% Data.ArticleID | html %]" />
        <input type="hidden" name="FormID" value="[% Data.FormID | html %]" />
        <input type="hidden" name="FromChatID" value="[% Data.FromChatID | html %]" />

        <div class="Messenger">

[% RenderBlockStart("AsteriskExplanation") %]
            <p class="AsteriskExplanation">[% Translate("All fields marked with an asterisk (*) are mandatory.") | html %]</p>
[% RenderBlockEnd("AsteriskExplanation") %]

            <fieldset class="DontPrint">
[% RenderBlockStart("DynamicField_TitleMessage") %]
                <div class="Row Row_DynamicField_[% Data.Name | html %][% Data.HiddenClass | html %]" [% Data.HiddenStyle | html %]>
                    <div class="Field">
                        [% Data.Field %]
                    </div>
                    [% IF Data.Tooltip %]
                        <div class="Tooltip oooTooltip">
                            <i class="ooofo ooofo-help"></i>
                            <div class="Content">
                                <p>[% Translate(Data.Tooltip) | html | html_line_break %]</p>
                            </div>
                        </div>
                    [% END %]
                    [% Data.Label %]
                    <div class="Clear"></div>
                </div>
[% RenderBlockEnd("DynamicField_TitleMessage") %]

                <div class="Row">
                    <input class="DontPrint" type="text" name="Subject" id="Subject" title="[% Translate("Subject") | html %]" value="[% Data.Subject | html %]" />
                    <label for="Subject">
                        [% Translate("Subject") | html %]:
                    </label>
                    <div class="Clear"></div>
                </div>

                <div class="RichTextHolder">
                    <textarea title="[% Translate("Reply") | html %]" id="RichText" class="RichText DontPrint Validate_RequiredRichText [% Data.RichTextInvalid | html %]" name="Body" rows="15" cols="[% Config("Ticket::Frontend::TextAreaNote") | html %]">[% Data.Body | html %]</textarea>
                    <div id="RichTextError" class="TooltipErrorMessage">
                        <p>[% Translate("This field is required.") | html %]</p>
                    </div>
                    <label for="RichText" class="Mandatory">[% Translate("Text") | html %] <span class="Marker">*</span></label>
                    <div id="RichTextServerError" class="TooltipErrorMessage NoJavaScriptMessage[% Data.RichTextInvalid | html %]">
                        <p>[% Translate("This field is required.") | html %]</p>
                    </div>
                </div>

                <div class="Row">
                    <div id="oooAttachments" class="Field">
                        <div class="DnDUploadBox">
[% INCLUDE "FormElements/CustomerAttachmentList.tt" %]
                        </div>
                    </div>
                    <div class="Clear"></div>
                </div>

[% RenderBlockStart("DynamicField_TitleCategory") %]
                <div class="Row Row_DynamicField_[% Data.Name | html %][% Data.HiddenClass | html %]" [% Data.HiddenStyle | html %]>
                    <div class="Field">
                        [% Data.Field %]
                    </div>
                    [% IF Data.Tooltip %]
                        <div class="Tooltip oooTooltip">
                            <i class="ooofo ooofo-help"></i>
                            <div class="Content">
                                <p>[% Translate(Data.Tooltip) | html | html_line_break %]</p>
                            </div>
                        </div>
                    [% END %]
                    [% Data.Label %]
                    <div class="Clear"></div>
                </div>
[% RenderBlockEnd("DynamicField_TitleCategory") %]

[% RenderBlockStart("FollowUpState") %]
                <div class="Row">
                    [% Data.NextStatesStrg %] <label for="StateID">[% Translate("Next state") | html %]:</label>
                </div>
[% RenderBlockEnd("FollowUpState") %]
[% RenderBlockStart("FollowUpPriority") %]
                <div class="Row">
                    [% Data.PriorityStrg %] <label for="PriorityID">[% Translate("Priority") | html %]:</label>
                </div>
[% RenderBlockEnd("FollowUpPriority") %]

[% Data.DynamicFieldHTML %]

            </fieldset>
            <div class="ActionRow">
                <button type="button" class="CloseButton oooXS">[% Translate("Discard") | html %]</button><button type="submit" value="[% Translate("Submit") | html %]" class="oooXS">[% Translate("Submit") | html %]</button>
            </div>
        </div>
    </form>
</li>
[% RenderBlockEnd("FollowUp") %]
[% IF Data.NoArticles %]
            <li class='EmptyMessage'>
                [% Translate("This item has no articles yet.") | html %]
            </li>
[% ELSE %]
            [% Data.Articles %]
[% END %]
        </ul>
        </div>
    </div>
</div>
<script>
(function () {
    function SyncZTSMNavigationOffset() {
        var MainBox = document.querySelector('.TicketZoom #oooMainBox.ZTSMZoomLayout');
        var Navigation = document.getElementById('oooNavigation');
        if (!MainBox || !Navigation) {
            return;
        }
        MainBox.style.setProperty('--ZTSMNavigationOffset', Navigation.getBoundingClientRect().width + 'px');
    }

    function TogglePanel(Trigger) {
        var TargetID = Trigger.getAttribute('data-ztsm-toggle');
        var Target = TargetID ? document.getElementById(TargetID) : null;
        if (Target) {
            var IsVisible = Target.classList.contains('Hidden') || Target.hidden;
            Target.classList.toggle('Hidden', !IsVisible);
            Target.classList.toggle('Visible', IsVisible);
            Target.hidden = !IsVisible;
        }
    }

    function CloseActionMenus() {
        document.querySelectorAll('.TicketZoom .ZTSMActionMenu.Open').forEach(function (Menu) {
            Menu.classList.remove('Open');
            var Button = Menu.querySelector('.ZTSMActionMenuButton');
            if (Button) {
                Button.setAttribute('aria-expanded', 'false');
            }
        });
    }

    document.addEventListener('click', function (Event) {
        var Trigger = Event.target.closest('[data-ztsm-toggle]');
        if (Trigger) {
            Event.preventDefault();
            TogglePanel(Trigger);
            return;
        }

        var ActionButton = Event.target.closest('.TicketZoom .ZTSMActionMenuButton');
        if (ActionButton) {
            Event.preventDefault();
            var ActionMenu = ActionButton.closest('.ZTSMActionMenu');
            var IsOpen = ActionMenu && ActionMenu.classList.contains('Open');
            CloseActionMenus();
            if (ActionMenu && !IsOpen) {
                ActionMenu.classList.add('Open');
                ActionButton.setAttribute('aria-expanded', 'true');
            }
            return;
        }

        if (!Event.target.closest('.TicketZoom .ZTSMActionMenu')) {
            CloseActionMenus();
        }

        var Overlay = Event.target.classList && Event.target.classList.contains('ZTSMOverlayBackdrop')
            ? Event.target
            : null;
        if (Overlay) {
            Overlay.classList.remove('Visible');
            Overlay.classList.add('Hidden');
            Overlay.hidden = true;
        }

        window.setTimeout(SyncZTSMNavigationOffset, 350);
    });

    window.addEventListener('resize', SyncZTSMNavigationOffset);
    window.setTimeout(SyncZTSMNavigationOffset, 0);
    window.setTimeout(SyncZTSMNavigationOffset, 350);
})();
</script>
