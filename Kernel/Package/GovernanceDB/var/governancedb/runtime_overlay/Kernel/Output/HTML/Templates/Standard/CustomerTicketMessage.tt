<div id="oooContent" class="ARIARoleMain TicketCompose">
    <div id="oooHeader">
        <h1>[% Translate("Create a new Ticket") | html %]</h1>
        <div class="ZTSMRequesterLine">
            <span class="ZTSMRequesterLabel">[% Translate("as") | html %]</span>
            <span class="ZTSMRequesterValue" id="ZTSMRequesterValue">[% Data.ZTSMEffectiveCustomerUserLabel | html %]</span>
            <button type="button" class="ZTSMRequesterChange" id="ZTSMRequesterChange">[% Translate("Change") | html %]</button>
        </div>
        <div class="ZTSMRequesterEditor Hidden" id="ZTSMRequesterEditor">
            <input type="text" id="ZTSMRaiseOnBehalfCustomerUserSearch" name="ZTSMRaiseOnBehalfCustomerUserSearch" value="[% Data.ZTSMRaiseOnBehalfCustomerUserLabel | html %]" list="ZTSMRaiseOnBehalfCustomerUserList" autocomplete="off" form="NewCustomerTicket" />
            <datalist id="ZTSMRaiseOnBehalfCustomerUserList"></datalist>
            <p class="FieldExplanation">[% Translate("Search and select the requester for this ticket.") | html %]</p>
        </div>
    </div>
    <div id="oooMainBox" class="Content">
        <form action="[% Env("CGIHandle") %]" method="post" name="compose" id="NewCustomerTicket" enctype="multipart/form-data" class="Validate PreventMultipleSubmits">
            <input type="hidden" name="Action" value="[% Env("Action") %]" />
            <input type="hidden" name="Subaction" value="StoreNew" />
            <input type="hidden" name="Expand" id="Expand" value="" />
            <input type="hidden" name="FormID" value="[% Data.FormID | html %]" />
            <input type="hidden" name="FromChatID" value="[% Data.FromChatID | html %]" />
            <input type="hidden" name="ZTSMRaiseOnBehalfCustomerUserID" id="ZTSMRaiseOnBehalfCustomerUserID" value="[% Data.ZTSMRaiseOnBehalfCustomerUserID | html %]" />
[% IF Data.ZTSMValidationMessages.size %]
            <div role="alert" class="MessageBox Error">
                <p>[% Translate("The ticket was not submitted. Please correct the following fields:") | html %]</p>
                <ul>
[% FOREACH Failure IN Data.ZTSMValidationMessages %]
                    <li><strong>[% Translate(Failure.Label) | html %][% IF Failure.Row %] ([% Translate("Row") | html %] [% Failure.Row | html %])[% END %]:</strong> [% Translate(Failure.Message) | html %]</li>
[% END %]
                </ul>
            </div>
[% END %]
            <fieldset class="ModularForm">

[% RenderBlockStart("AsteriskExplanation") %]
                <p class="AsteriskExplanation">[% Translate("All fields marked with an asterisk (*) are mandatory.") | html %]</p>
[% RenderBlockEnd("AsteriskExplanation") %]

[% RenderBlockStart("DynamicField_TitleCategory") %]
                <div class="Row Row_DynamicField_[% Data.Name | html %][% Data.HiddenClass | html %]" [% Data.HiddenStyle | html %]>
                    <div class="FieldCell">
                        <div class="Field">
                            [% Data.Field %]
                        </div>
    [% IF Data.Tooltip %]
                        <div class="Tooltip oooTooltip">
                            <i class="ooofo ooofo-help"></i>
                            <div class="Content">
                                <p>[% Data.Tooltip | html | html_line_break %]</p>
                            </div>
                        </div>
    [% END %]
                        [% Data.Label %]
                    </div>
                </div>
[% RenderBlockEnd("DynamicField_TitleCategory") %]

[% RenderBlockStart("TicketType") %]
                <div class="Row">
                    <div class="FieldCell">
                        <div class="Field">
                            [% Data.TypeStrg %]
                        </div>
                        <label for="TypeID" class="Mandatory">[% Translate("Type") | html %] <span class="Marker">*</span></label>
                        <div id="TypeIDError" class="TooltipErrorMessage" ><p>[% Translate("This field is required.") | html %]</p></div>
                        <div id="TypeIDServerError" class="TooltipErrorMessage NoJavaScriptMessage[% Data.TypeIDInvalid | html %]" ><p>[% Translate("This field is required.") | html %]</p></div>
                    </div>
                </div>
[% RenderBlockEnd("TicketType") %]

[% RenderBlockStart("TicketService") %]
                <div class="Row">
                    <div class="FieldCell">
                        <div class="Field">
                            [% Data.ServiceStrg %]
                        </div>
    [% IF Data.ServiceMandatory %]
                        <label for="ServiceID" class="Mandatory">[% Translate("Service") | html %] <span class="Marker">*</span></label>
    [% ELSE %]
                        <label for="ServiceID">[% Translate("Service") | html %]:</label>
    [% END %]
    [% IF Data.ServiceMandatory %]
                        <div id="ServiceIDError" class="TooltipErrorMessage" ><p>[% Translate("This field is required.") | html %]</p></div>
                        <div id="ServiceIDServerError" class="TooltipErrorMessage" ><p>[% Translate("This field is required.") | html %]</p></div>
    [% END %]
                    </div>
                </div>
[% RenderBlockEnd("TicketService") %]

[% RenderBlockStart("TicketSLA") %]
                <div class="Row">
                    <div class="FieldCell">
                        <div class="Field">
                            [% Data.SLAStrg %]
                        </div>
    [% IF Data.SLAMandatory %]
                        <label for="SLAID" title="[% Translate("Service level agreement") | html %]" class="Mandatory">[% Translate("SLA") | html %] <span class="Marker">*</span> </label>
    [% ELSE %]
                        <label for="SLAID" title="[% Translate("Service level agreement") | html %]">[% Translate("SLA") | html %]:</label>
    [% END %]
    [% IF Data.SLAMandatory %]
                        <div id="SLAIDError" class="TooltipErrorMessage" ><p>[% Translate("This field is required.") | html %]</p></div>
                        <div id="SLAIDServerError" class="TooltipErrorMessage" ><p>[% Translate("This field is required.") | html %]</p></div>
    [% END %]
                    </div>
                </div>
[% RenderBlockEnd("TicketSLA") %]


[% RenderBlockStart("DynamicField_TitleDynamicFields") %]
                <div class="Row Row_DynamicField_[% Data.Name | html %][% Data.HiddenClass | html %]" [% Data.HiddenStyle | html %]>
                    <div class="FieldCell">
                        <div class="Field">
                            [% Data.Field %]
                        </div>
    [% IF Data.Tooltip %]
                        <div class="Tooltip oooTooltip">
                            <i class="ooofo ooofo-help"></i>
                            <div class="Content">
                                <p>[% Translate(Data.Tooltip) | html | html_line_break %]</p>
                            </div>
                        </div>
    [% END %]
                        [% Data.Label %]
                    </div>
                </div>
[% RenderBlockEnd("DynamicField_TitleDynamicFields") %]


[% RenderBlockStart("DynamicField_TitleMessage") %]
                <div class="Row Row_DynamicField_[% Data.Name | html %][% Data.HiddenClass | html %]" [% Data.HiddenStyle | html %]>
                    <div class="FieldCell">
                        <div class="Field">
                            [% Data.Field %]
                        </div>
    [% IF Data.Tooltip %]
                        <div class="Tooltip oooTooltip">
                            <i class="ooofo ooofo-help"></i>
                            <div class="Content">
                                <p>[% Translate(Data.Tooltip) | html | html_line_break %]</p>
                            </div>
                        </div>
    [% END %]
                        [% Data.Label %]
                    </div>
                </div>
[% RenderBlockEnd("DynamicField_TitleMessage") %]

                <div class="Row [% Data.SubjectHiddenClass | html %]">
                    <div class="FieldCell">
                        <div class="Field">
                            <input title="[% Translate("Subject") | html %]" type="text" id="Subject" name="Subject" value="[% Data.Subject | html %]" class="[% Data.SubjectValidate | html %] [% Data.SubjectInvalid | html %]" />
                        </div>
                        <label for="Subject" class="Mandatory">
                            [% Translate("Subject") | html %] <span class="Marker">*</span>
                        </label>
                        <div id="SubjectError" class="TooltipErrorMessage" ><p>[% Translate("This field is required.") | html %]</p></div>
                        <div id="SubjectServerError" class="TooltipErrorMessage NoJavaScriptMessage[% Data.SubjectInvalid | html %]" ><p>[% Translate("This field is required.") | html %]</p></div>
                    </div>
                </div>

                <div class="Row [% Data.BodyHiddenClass | html %]">
                    <div class="FieldCell">
                        <div class="Field RichTextField">
                            <div class="RichTextHolder">
                                <textarea id="RichText" class="RichText [% Data.BodyValidate | html %] [% Data.BodyInvalid | html %]" name="Body" rows="15" cols="[% Config("Ticket::Frontend::TextAreaNote") %]">[% Data.Body | html %]</textarea>
                            </div>
                            <div id="RichTextError" class="TooltipErrorMessage" ><p>[% Translate("This field is required.") | html %]</p></div>
                            <div id="RichTextServerError" class="TooltipErrorMessage NoJavaScriptMessage[% Data.BodyInvalid | html %]" ><p>[% Translate("This field is required.") | html %]</p></div>
                        </div>
                        <label for="RichText" class="Mandatory">[% Translate("Text") | html %] <span class="Marker">*</span></label>
                    </div>
                </div>

<span id="ZTSMServiceExtensionDynamicFieldsStart" class="Hidden"></span>
[% Data.DynamicFieldHTML %]
<span id="ZTSMServiceExtensionDynamicFieldsEnd" class="Hidden"></span>

[% InsertTemplate("ZTSMCustomerTicketMessageServiceFields.tt") %]

                <div class="Row [% Data.AttachmentsHiddenClass | html %]">
                    <div class="FieldCell">
                        <div id="oooAttachments" class="Field">
                            <div class="DnDUploadBox">
[% INCLUDE "FormElements/CustomerAttachmentList.tt" %]
                            </div>
                        </div>
                    </div>
                </div>

[% RenderBlockStart("Priority") %]
                <div class="Row">
                    <div class="FieldCell">
                        <div class="Field">
                            [% Data.PriorityStrg %]
                        </div>
                        <label for="PriorityID">[% Translate("Priority") | html %]</label>
                    </div>
                </div>
[% RenderBlockEnd("Priority") %]

            </fieldset>
            <div id="BottomActionRow" class="ActionRow">
                <button id="submitRichText" class="oooL" accesskey="g" title="[% Translate("Submit") | html %] (g)" type="submit" value="[% Translate("Submit") | html %]">[% Translate("Submit") | html %]</button>
            </div>
        </form>
    </div>
</div>

<style>
.ZTSMRequesterLine {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin: 8px 0 0;
    color: #151a45;
    font-size: 15px;
    line-height: 22px;
}

.ZTSMRequesterLabel {
    color: #616486;
}

.ZTSMRequesterValue {
    font-weight: 600;
}

.ZTSMRequesterChange {
    width: auto !important;
    min-width: 0 !important;
    min-height: 0 !important;
    border: 0 !important;
    border-radius: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
    color: #0707a8 !important;
    cursor: pointer;
    font: inherit !important;
    font-weight: 600;
    line-height: 22px !important;
    margin: 0 !important;
    padding: 0 2px !important;
    text-decoration: underline;
}

.ZTSMRequesterChange:hover,
.ZTSMRequesterChange:focus,
.ZTSMRequesterChange:active {
    border: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
    color: #0707a8 !important;
    outline: none;
    text-decoration: underline;
}

.ZTSMRequesterEditor {
    width: min(600px, calc(100vw - 24px));
    margin: 6px auto 0;
    text-align: left;
}

.ZTSMRequesterEditor input {
    width: 100%;
    box-sizing: border-box;
}

.ZTSMRequesterEditor .FieldExplanation {
    margin: 3px 0 0;
    color: #616486;
    font-size: 12px;
    line-height: 15px;
}
</style>
<script>
(function () {
    var Input = document.getElementById('ZTSMRaiseOnBehalfCustomerUserSearch');
    var Hidden = document.getElementById('ZTSMRaiseOnBehalfCustomerUserID');
    var List = document.getElementById('ZTSMRaiseOnBehalfCustomerUserList');
    var ChangeButton = document.getElementById('ZTSMRequesterChange');
    var Editor = document.getElementById('ZTSMRequesterEditor');
    var RequesterValue = document.getElementById('ZTSMRequesterValue');
    var Timer;
    var Choices = {};
    var SelectedUserID = Hidden ? Hidden.value : '';

    if (!Input || !Hidden || !List) {
        return;
    }

    function Debug(Stage, Data) {
        if (!window.console || typeof window.console.log !== 'function') {
            return;
        }
        window.console.log('[TESSERA requester]', Stage, Data || {});
    }

    function DebugError(Stage, Data) {
        if (!window.console || typeof window.console.error !== 'function') {
            Debug(Stage, Data);
            return;
        }
        window.console.error('[TESSERA requester]', Stage, Data || {});
    }

    function BaseLink() {
        return window.Core && Core.Config && typeof Core.Config.Get === 'function'
            ? Core.Config.Get('Baselink')
            : '[% Env("CGIHandle") | html %]?';
    }

    function RefreshForm() {
        var Form = document.getElementById('NewCustomerTicket');

        Debug('refresh-form-start', {
            hiddenValue: Hidden.value || '',
            inputValue: Input.value || '',
            hasFormUpdate: !!(window.Core && Core.AJAX && typeof Core.AJAX.FormUpdate === 'function'),
            hasJQuery: !!window.jQuery,
            hasForm: !!Form,
            hasServiceRefresh: typeof window.ZTSMServiceExtensionRefresh === 'function',
            hasVisibleRefresh: typeof window.ZTSMServicePayloadVisibleSelectionRefresh === 'function'
        });

        if (window.Core && Core.AJAX && typeof Core.AJAX.FormUpdate === 'function' && window.jQuery && Form) {
            Core.AJAX.FormUpdate(
                window.jQuery(Form),
                'AJAXUpdate',
                'ZTSMRaiseOnBehalfCustomerUserID',
                function () {
                    Debug('form-update-callback', {
                        hiddenValue: Hidden.value || '',
                        inputValue: Input.value || '',
                        valuesAfterFormUpdate: typeof window.ZTSMServiceExtensionPreferenceSnapshot === 'function'
                            ? window.ZTSMServiceExtensionPreferenceSnapshot(document)
                            : 'snapshot-helper-unavailable'
                    });
                    if (typeof window.ZTSMServiceExtensionRefresh === 'function') {
                        window.ZTSMServiceExtensionRefresh({
                            ElementChanged: 'ZTSMRaiseOnBehalfCustomerUserID'
                        });
                    }
                    if (typeof window.ZTSMServicePayloadVisibleSelectionRefresh === 'function') {
                        window.ZTSMServicePayloadVisibleSelectionRefresh();
                    }
                }
            );
            return;
        }

        DebugError('form-update-unavailable-fallback', {
            hasCore: !!window.Core,
            hasAJAX: !!(window.Core && Core.AJAX),
            hasFormUpdate: !!(window.Core && Core.AJAX && typeof Core.AJAX.FormUpdate === 'function'),
            hasJQuery: !!window.jQuery,
            hasForm: !!Form
        });

        if (typeof window.ZTSMServiceExtensionRefresh === 'function') {
            window.ZTSMServiceExtensionRefresh({
                ElementChanged: 'ZTSMRaiseOnBehalfCustomerUserID'
            });
        }
        if (typeof window.ZTSMServicePayloadVisibleSelectionRefresh === 'function') {
            window.ZTSMServicePayloadVisibleSelectionRefresh();
        }
    }

    function TriggerHiddenChange() {
        var Event;

        Debug('hidden-change-trigger', {
            hiddenValue: Hidden.value || '',
            inputValue: Input.value || ''
        });

        if (window.jQuery) {
            window.jQuery(Hidden).trigger('change');
        }
        Event = document.createEvent('Event');
        Event.initEvent('change', true, true);
        Hidden.dispatchEvent(Event);
    }

    function ShowEditor() {
        if (Editor) {
            Editor.classList.remove('Hidden');
        }
        Debug('editor-open', {
            hiddenValue: Hidden.value || '',
            inputValue: Input.value || ''
        });
        window.setTimeout(function () {
            Input.focus();
            Input.select();
        }, 0);
    }

    function HideEditor() {
        if (Editor) {
            Editor.classList.add('Hidden');
        }
    }

    function SelectRequester() {
        var UserID = Choices[Input.value] || '';

        if (!UserID) {
            DebugError('select-requester-no-match', {
                inputValue: Input.value || '',
                choices: Object.keys(Choices || {}).slice(0, 10)
            });
            return;
        }

        if (UserID === SelectedUserID) {
            Debug('select-requester-same-user', {
                userID: UserID,
                inputValue: Input.value || ''
            });
            HideEditor();
            return;
        }

        Debug('select-requester-commit', {
            previousUserID: SelectedUserID || '',
            userID: UserID,
            inputValue: Input.value || ''
        });
        Hidden.value = UserID;
        SelectedUserID = UserID;
        TriggerHiddenChange();
        if (RequesterValue) {
            RequesterValue.textContent = Input.value;
        }
        HideEditor();
        RefreshForm();
    }

    function Search() {
        var Term = Input.value || '';
        if (Term.length < 2) {
            Debug('search-skip-short-term', {
                term: Term
            });
            return;
        }

        var Request = new XMLHttpRequest();
        Debug('search-start', {
            term: Term
        });
        Request.open('GET', BaseLink() + 'Action=CustomerTicketMessage;Subaction=ZTSMCustomerUserSearch;Term=' + encodeURIComponent(Term), true);
        Request.onreadystatechange = function () {
            if (Request.readyState !== 4) {
                return;
            }
            if (Request.status < 200 || Request.status >= 300) {
                DebugError('search-http-error', {
                    status: Request.status,
                    responseText: (Request.responseText || '').slice(0, 500)
                });
                return;
            }

            var Payload;
            try {
                Payload = JSON.parse(Request.responseText);
            }
            catch (Error) {
                DebugError('search-json-error', {
                    message: Error && Error.message ? Error.message : String(Error),
                    responseText: (Request.responseText || '').slice(0, 500)
                });
                return;
            }

            Payload = Payload && Payload.Data ? Payload.Data : Payload;
            Choices = {};
            List.innerHTML = '';
            (Payload || []).forEach(function (Item) {
                var Option = document.createElement('option');
                Option.value = Item.Label;
                Choices[Item.Label] = Item.Value;
                List.appendChild(Option);
            });
            Debug('search-results', {
                term: Term,
                count: (Payload || []).length,
                inputValue: Input.value || ''
            });
            if (Choices[Input.value]) {
                SelectRequester();
            }
        };
        Request.send();
    }

    Input.addEventListener('input', function () {
        Hidden.value = Choices[Input.value] || '';
        Debug('input-event', {
            inputValue: Input.value || '',
            hiddenValue: Hidden.value || '',
            hasChoice: !!Hidden.value
        });
        if (Hidden.value) {
            SelectRequester();
            return;
        }
        window.clearTimeout(Timer);
        Timer = window.setTimeout(Search, 250);
    });

    Input.addEventListener('change', function () {
        SelectRequester();
    });

    if (ChangeButton) {
        ChangeButton.addEventListener('click', ShowEditor);
    }
}());
</script>


