<main class="ChangeDecision" aria-labelledby="DecisionTitle"><h1 id="DecisionTitle">Change classification</h1><p>Review assessment evidence, classify the change and prepare its portal announcement.</p>
[% IF Data.Error %]<p role="alert" class="ChangeDecision__notice">[% Data.Error | html %]</p>[% END %]
[% IF Data.View %]
[% V = Data.View %]<h2>[% V.Context.TicketNumber | html %] &mdash; [% V.Context.Title | html %]</h2>
<p>Requester: [% V.Context.Requester | html %] &middot; Environment: [% V.Context.Environment || 'Not specified' | html %] &middot; Application: [% V.Context.Application || 'Not specified' | html %]</p><p>Schedule: [% V.Context.Start || 'Not scheduled' | html %] &mdash; [% V.Context.Finish | html %]</p>
[% UNLESS V.AssessmentComplete %]<p class="ChangeDecision__notice">Linked assessment tickets have not all completed successfully. Normal classification requires completed assessment.[% IF V.Actor.IPC %] IPC may explicitly override this prerequisite with a recorded reason.[% END %]</p>[% END %]
<form action="[% Env('CGIHandle') | html %]" method="post" class="ChangeDecision__form"><input type="hidden" name="Action" value="[% Data.Action | html %]"/><input type="hidden" name="Subaction" value="Save"/><input type="hidden" name="TicketID" value="[% Data.TicketID | html %]"/><input type="hidden" name="Revision" value="[% V.Revision | html %]"/><input type="hidden" name="ChallengeToken" value="[% Env('ChallengeToken') | html %]"/>
<label for="ChangeType">Change Type</label><select name="ChangeType" id="ChangeType">[% FOREACH Type IN ['Normal','Standard','Emergency'] %]<option value="[% Type | html %]"[% IF Type == V.ChangeType %] selected[% END %]>[% Type | html %]</option>[% END %]</select>
<label for="ChangeClassification">Change Classification</label><select name="ChangeClassification" id="ChangeClassification">[% FOREACH Type IN ['Normal','Not-Assessed','Major'] %]<option value="[% Type | html %]"[% IF Type == V.ChangeClassification %] selected[% END %]>[% Type | html %]</option>[% END %]</select>
<label for="Reason">Decision / amendment reason</label><textarea name="Reason" id="Reason" maxlength="4000" required rows="3">[% V.Reason | html %]</textarea>
<label for="PublicSummary">Public summary</label><textarea name="Summary" id="PublicSummary" maxlength="20000" rows="3">[% V.Summary | html %]</textarea>
<label for="PublicDescription">Public description</label><textarea name="Description" id="PublicDescription" maxlength="20000" rows="6">[% V.Description | html %]</textarea>
<section class="ChangeDecision__review"><h2>Portal-wide announcement preview</h2><p>Saving Major prepares the announcement. Once the change is approved, all active portal users can see the requester, affected CI names, environment, application/system, schedule, description, summary and the runbook below. Ticket history and full CI records remain restricted.</p><p>Affected CIs: [% V.Context.Assets.join(', ') | html %]</p>[% FOREACH Phase IN V.Context.Phases %]<details open><summary>[% Phase.Name | html %]</summary><ol>[% FOREACH Step IN Phase.Steps %]<li value="[% Step.Sequence | html %]"><span class="ChangePortal__schedule">Level [% Step.Level | html %] &middot; Step [% Step.Sequence | html %]</span><br/><strong>[% Step.Activity | html %]</strong><p class="ChangePortal__text">[% Step.Description | html %]</p></li>[% END %]</ol></details>[% END %]</section>
[% IF V.Actor.IPC %]<label><input type="checkbox" name="AssessmentOverride" value="1"/> IPC override: classify before assessment completion. The reason and actor will be recorded.</label>[% END %]
<button type="submit">Save decision</button></form>
[% ELSE %]
<form action="[% Env('CGIHandle') | html %]" method="get" class="ChangeDecision__form"><input type="hidden" name="Action" value="[% Data.Action | html %]"/><label for="ChangeNumber">Change ticket number</label><input id="ChangeNumber" name="TicketNumber" required/><button type="submit">Review change</button></form>
[% END %]</main>
