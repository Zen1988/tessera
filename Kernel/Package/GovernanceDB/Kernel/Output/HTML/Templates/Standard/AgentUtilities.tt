<main class="UtilityAdmin" aria-labelledby="UtilityAdminTitle">
<header><h1 id="UtilityAdminTitle">Utilities</h1><p>Manage customer tools and Workplace shortcuts. Target system permissions continue to apply.</p><a href="[% Env('Baselink') | html %]Action=AgentNetworkSimulationAccess">Network simulation access</a> &middot; <a href="[% Env('Baselink') | html %]Action=AgentUtilities">Create a utility</a></header>
[% IF Data.Error %]<p class="UtilityAdmin__error" role="alert">[% Data.Error | html %]</p>[% END %]
<div class="UtilityAdmin__layout">
<nav aria-label="Configured utilities"><h2>Tools</h2><ul>[% FOREACH T IN Data.Tools %]<li><a href="[% Env('Baselink') | html %]Action=AgentUtilities;ID=[% T.ID | uri %]">[% T.Name | html %]</a>[% UNLESS T.Enabled %] (disabled)[% END %]</li>[% END %]</ul></nav>
<section><h2>[% IF Data.Tool.ID %]Edit [% Data.Tool.Name | html %][% ELSE %]Create utility[% END %]</h2>
<form action="[% Env('CGIHandle') | html %]" method="post" enctype="multipart/form-data" class="UtilityAdmin__form">
<input type="hidden" name="Action" value="AgentUtilities"/><input type="hidden" name="Subaction" value="Save"/><input type="hidden" name="ID" value="[% Data.Tool.ID | html %]"/><input type="hidden" name="Revision" value="[% Data.Revision | html %]"/><input type="hidden" name="ChallengeToken" value="[% Env('ChallengeToken') | html %]"/>
<label for="UtilityName">Name</label><input id="UtilityName" name="Name" maxlength="100" required value="[% Data.Tool.Name | html %]"/>
<label for="UtilityDescription">Description</label><textarea id="UtilityDescription" name="Description" maxlength="500">[% Data.Tool.Description | html %]</textarea>
<label for="UtilityIcon">Icon (PNG/JPEG, up to 256 KB)</label><input id="UtilityIcon" name="Icon" type="file" accept="image/png,image/jpeg"/><label><input type="checkbox" name="RemoveIcon" value="1"/> Remove existing icon</label>
<label for="UtilityType">Tool type</label><select id="UtilityType" name="Type"><option value="External"[% IF Data.Tool.Type == 'External' %] selected[% END %]>External system</option><option value="Internal"[% IF Data.Tool.Type == 'Internal' %] selected[% END %]>Registered internal tool</option></select>
<label for="UtilityURL">External HTTPS URL</label><input id="UtilityURL" name="URL" type="url" maxlength="2048" value="[% Data.Tool.URL | html %]" placeholder="https://vault.example.org/"/>
<label for="UtilityHandler">Internal tool</label><select id="UtilityHandler" name="Handler"><option value="">Choose an installed tool</option>[% FOREACH H IN Data.Handlers %]<option value="[% H.ID | html %]"[% IF Data.Tool.Handler == H.ID %] selected[% END %]>[% H.Name | html %]</option>[% END %]</select>
<label for="UtilityAudience">Customer access</label><select id="UtilityAudience" name="Audience"><option value="none"[% IF Data.Tool.Audience == 'none' %] selected[% END %]>No customers</option><option value="users"[% IF Data.Tool.Audience == 'users' %] selected[% END %]>Selected customer accounts</option><option value="all"[% IF Data.Tool.Audience == 'all' %] selected[% END %]>All active customer accounts</option></select>
<label for="UtilityUsers">Exact customer logins (one per line)</label><textarea id="UtilityUsers" name="Users" rows="4">[% Data.UsersText | html %]</textarea>
<label for="UtilityParameters">Parameter mapping (JSON)</label><textarea id="UtilityParameters" name="Parameters" rows="7" spellcheck="false" aria-describedby="UtilityParameterHelp">[% Data.ParametersText | html %]</textarea>
<p id="UtilityParameterHelp">Example: <code>{"username":{"Source":"CustomerUserLogin","Required":1}}</code>. Sources: Literal (with Value), CustomerUserLogin, CustomerUserEmail, TicketNumber, ConfigItemNumber. Object context must be authorized; missing required context prevents launch. Do not put credentials in URLs.</p>
<label for="UtilityOrder">Display order</label><input id="UtilityOrder" name="Order" type="number" min="0" max="99999" required value="[% Data.Tool.Order | html %]"/>
<label><input type="checkbox" name="Enabled" value="1"[% IF Data.Tool.Enabled %] checked[% END %]/> Enabled</label><label><input type="checkbox" name="Workplace" value="1"[% IF Data.Tool.Workplace %] checked[% END %]/> Show as a Workplace shortcut</label>
<button type="submit">Save utility</button><p>Disable a tool to retire it while retaining its configuration. Save changes before previewing customer access.</p>
</form></section></div>
<section><h2>Preview customer access</h2><form class="UtilityAdmin__preview" action="[% Env('CGIHandle') | html %]" method="post"><input type="hidden" name="Action" value="AgentUtilities"/><input type="hidden" name="Subaction" value="Preview"/><input type="hidden" name="ID" value="[% Data.Tool.ID | html %]"/><input type="hidden" name="ChallengeToken" value="[% Env('ChallengeToken') | html %]"/><label for="PreviewLogin">Customer login</label> <input id="PreviewLogin" name="CustomerLogin" required value="[% Data.Preview.CustomerLogin | html %]"/> <label for="PreviewTicket">Ticket ID (optional)</label> <input id="PreviewTicket" name="TicketID" inputmode="numeric"/> <label for="PreviewAsset">ConfigItem ID (optional)</label> <input id="PreviewAsset" name="ConfigItemID" inputmode="numeric"/> <button type="submit">Preview access and launch</button></form>
[% IF Data.Preview %][% IF Data.Preview.Destination %]<p>Saved tool destination (preview only; no request sent): <code>[% Data.Preview.Destination | html %]</code></p>[% ELSIF Data.Preview.LaunchDenied %]<p>The selected tool cannot launch for this customer or supplied context.</p>[% END %]<ul>[% FOREACH T IN Data.Preview.Tools %]<li>[% T.Name | html %][% IF T.Workplace %] (Workplace shortcut)[% END %]</li>[% END %]</ul>[% UNLESS Data.Preview.Tools.size %]<p>No tools are available to this account.</p>[% END %][% END %]</section>
</main>
