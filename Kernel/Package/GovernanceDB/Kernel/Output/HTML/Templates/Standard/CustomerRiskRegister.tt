<main id="oooContent" class="ZTSMRiskRegister">
    <header id="oooHeader">
    <div class="ZTSMRiskHeaderRow"><h1>[% Translate("Risk Register") | html %]</h1>
    [% IF Data.Display == 'List' %]<form class="ZTSMRiskSearch" action="[% Env('CGIHandle') %]" method="get"><input type="hidden" name="Action" value="CustomerRiskRegister"/><input type="hidden" name="Display" value="List"/><input type="hidden" name="View" value="[% Data.View | html %]"/><label for="RiskSearch">Risk Search</label><input id="RiskSearch" name="RiskSearch" type="search" value="[% Data.RiskSearch | html %]"/><button type="submit">Search</button></form>[% END %]
    <div class="ZTSMRiskToolbar">    <a class="ZTSMRiskExport" href="[% Env('Baselink') %]Action=CustomerRiskRegister;Display=[% Data.Display | uri %];View=[% Data.View | uri %];RiskSearch=[% Data.RiskSearch | uri %];Subaction=Export"><i class="fa fa-download" aria-hidden="true"></i> Export Risk Register</a>
    <div class="ZTSMRiskToggle">
    <a href="[% Env('Baselink') %]Action=CustomerRiskRegister;Display=List;View=[% Data.View | uri %]" [% IF Data.Display == 'List' %]aria-current="page"[% END %]>List</a>
    <a href="[% Env('Baselink') %]Action=CustomerRiskRegister;Display=Dashboard;View=[% Data.View | uri %]" [% IF Data.Display == 'Dashboard' %]aria-current="page"[% END %]>Dashboard</a></div></div></div>
    <p>[% Translate("Assessment risk rows with governed lifecycle and approval from their master tickets. Acceptance expires after a maximum of 365 days. Historical tickets remain audit evidence.") | html %]</p>
    </header>
    <section id="oooMainBox">
    

    [% IF Data.Display == 'Dashboard' %]
    <div class="ZTSMRiskMetrics">
    <div>Open risks<strong>[% Data.Dashboard.Open | html %]</strong></div>
    <div>Upcoming review<strong>[% Data.Dashboard.Upcoming | html %]</strong><small>Next month, including overdue or missing governance dates</small></div>
    <div>Newly discovered<strong>[% Data.Dashboard.New | html %]</strong><small>Assessment created within the last calendar month</small></div></div>
    <p>Counts are assessment rows visible to you across Current and Review required. Inherent and residual severity colours follow each row's current Framework.</p>
    <div class="ZTSMRiskComparison">[% FOREACH Basis IN Data.Dashboard.Bases %]
    <section class="ZTSMRiskBasis" aria-label="[% Basis.Measure | html %] risk"><h2>[% Basis.Measure | html %] risk</h2>
    <div class="ZTSMRiskCharts">[% FOREACH Chart IN Basis.Charts %]
    <section class="ZTSMRiskCard"><h2>[% Chart.Title | html %]</h2>
    [% FOREACH Group IN Chart.Groups %]
    <a class="ZTSMRiskBarLink" href="[% Env('Baselink') %]Action=CustomerRiskRegister;Display=Dashboard;CategoryField=[% Group.Field | uri %];CategoryID=[% Group.ID | uri %]#RiskMatrices[% Basis.Measure | uri %]">
    <span>[% Group.Label | html %] <strong>[% Group.Count | html %]</strong></span>
    <span class="ZTSMRiskBar" style="width:[% Group.Width | html %]%">[% FOREACH Band IN Group.Bands %]<span style="width:[% Band.Width | html %]%;background:[% Band.Color | html %];color:[% Band.Foreground | html %]" title="[% Band.Label | html %]: [% Band.Count | html %]">[% Band.Count | html %]</span>[% END %]</span>
    <span class="ZTSMRiskLegend">[% FOREACH Band IN Group.Bands %]<span><i style="background:[% Band.Color | html %]"></i>[% Band.Label | html %]: [% Band.Count | html %]</span>[% END %]</span></a>
    [% END %][% IF !Chart.Groups.size %]<p>No applicable risks.</p>[% END %]</section>[% END %]</div>
    <section id="RiskMatrices[% Basis.Measure | html %]"><h2>Risk matrices</h2><p>Select a category above. Each Framework has its own matrix; likelihood runs vertically and impact horizontally.</p>
    [% FOREACH Matrix IN Basis.Matrices %]<div class="ZTSMRiskCard ZTSMRiskMatrix"><h3>[% Matrix.Name | html %] — [% Basis.Measure | html %]</h3>
    <table><thead><tr><th scope="col">Likelihood / Impact</th>[% FOREACH Impact IN Matrix.Impacts %]<th scope="col">[% Impact | html %]</th>[% END %]</tr></thead><tbody>
    [% FOREACH Line IN Matrix.Lines %]<tr><th scope="row">[% Line.Likelihood | html %]</th>[% FOREACH Cell IN Line.Cells %]<td style="background:[% Cell.Color || '#e4e6ef' | html %];color:[% Cell.Foreground || '#000539' | html %]">
    [% IF Cell.Count %]<details><summary aria-label="Likelihood [% Cell.Likelihood | html %], impact [% Cell.Impact | html %], [% Cell.Count | html %] risks">[% Cell.Count | html %]</summary><ul>[% FOREACH Entry IN Cell.Entries %]<li><a href="[% Env('Baselink') %]Action=CustomerTicketZoom;TicketID=[% Entry.TicketID | uri %]">[% Entry.TicketNumber | html %] / row [% Entry.RowNumber | html %]</a></li>[% END %]</ul></details>[% ELSE %]0[% END %]<small>[% Cell.Label || 'Unmapped' | html %]</small></td>[% END %]</tr>[% END %]</tbody></table>
    [% IF Matrix.Unplaced.size %]<p>Rows without valid coordinates:</p>[% FOREACH Entry IN Matrix.Unplaced %]<a href="[% Env('Baselink') %]Action=CustomerTicketZoom;TicketID=[% Entry.TicketID | uri %]">[% Entry.TicketNumber | html %] / [% Entry.RowNumber | html %]</a>[% END %][% END %]</div>[% END %]</section>
    </section>[% END %]</div>
    [% ELSE %]
    <nav aria-label="[% Translate("Risk Register views") | html %]">
        <a href="[% Env('Baselink') %]Action=CustomerRiskRegister;Display=List;RiskSearch=[% Data.RiskSearch | uri %];View=Current" [% IF Data.View == 'Current' %]aria-current="page"[% END %]>[% Translate("Current") | html %] ([% Data.CurrentCount | html %])</a>
        <a href="[% Env('Baselink') %]Action=CustomerRiskRegister;Display=List;RiskSearch=[% Data.RiskSearch | uri %];View=Review" [% IF Data.View == 'Review' %]aria-current="page"[% END %]>[% Translate("Review required") | html %] ([% Data.ReviewCount | html %])</a>

    </nav>
    [% IF Data.View == 'Review' %]<p>[% Translate("These records require governance review. This view does not renew acceptance or start a workflow automatically.") | html %]</p>[% END %]
    <div class="ZTSMRiskRegisterTable">
    [% IF Data.Rows.size %]
        <table>
            <caption>[% IF Data.View == 'Review' %][% Translate("Risk assessments requiring review") | html %][% ELSE %][% Translate("Current Risk Register") | html %][% END %]</caption>
            <thead><tr><th scope="col">[% Translate("Open Assessment") | html %]</th>[% FOREACH Column IN Data.Columns %]<th scope="col">[% Column.Label | html %]</th>[% END %]</tr></thead>
            <tbody>[% FOREACH Row IN Data.Rows %]<tr>
                <td><a href="[% Env('Baselink') %]Action=CustomerTicketZoom;TicketID=[% Row.TicketID | uri %]">[% Row.TicketNumber | html %] / [% Row.RowNumber | html %]</a></td>
                [% FOREACH Cell IN Row.Cells %]
                [% Decoration = Row.Decorations.${loop.index} %]
                <td>[% IF Decoration.Color %]<span class="ZTSMRiskRegisterScore" style="background-color:[% Decoration.Color | html %];color:[% Decoration.Foreground | html %]" title="[% Decoration.Title | html %]">[% Cell | html %] · [% Decoration.Label | html %]</span>[% ELSE %][% Cell | html %][% END %]</td>
                [% END %]
            </tr>[% END %]</tbody>
        </table>
    [% ELSE %]<p>[% Translate("No applicable Risk Assessments in this view.") | html %]</p>[% END %]
    </div>
    [% END %]
    </section>
</main>
<style>
.ZTSMRiskRegister { color:#000539; background:#f7f7f9; }
.ZTSMRiskRegisterScore { display:inline-block; padding:6px 12px; border-radius:16px; font-weight:600; white-space:nowrap; }
.ZTSMRiskRegister #oooHeader { display:flex; flex-direction:column; align-items:flex-start; justify-content:center; gap:12px; height:auto; min-height:145px; padding-top:32px; padding-bottom:32px; background:white; }
.ZTSMRiskRegister #oooHeader h1 { margin:0; }
.ZTSMRiskRegister #oooHeader p { max-width:1000px; margin:0; line-height:1.5; }
.ZTSMRiskRegister #oooMainBox { padding-top:24px; padding-bottom:48px; }
.ZTSMRiskRegister nav { display:flex; flex-wrap:wrap; gap:12px; margin:0 0 24px; }
.ZTSMRiskRegister nav a { padding:12px 20px; border:1px solid #cbd0e4; border-radius:24px; background:white; }
.ZTSMRiskRegister nav a[aria-current="page"] { background:#000539; color:white; }
.ZTSMRiskRegister a:focus-visible { outline:3px solid #7c89ff; outline-offset:3px; }
.ZTSMRiskRegisterTable { padding:24px; background:white; border:1px solid #e4e6ef; border-radius:16px; overflow-x:auto; }
.ZTSMRiskRegister table { width:100%; border-collapse:collapse; }
.ZTSMRiskRegister caption { text-align:left; font-size:20px; padding-bottom:20px; }
.ZTSMRiskRegister th,.ZTSMRiskRegister td { padding:12px; text-align:left; border-bottom:1px solid #e4e6ef; overflow-wrap:anywhere; min-width:110px; }
@media(max-width:767px) { .ZTSMRiskRegister #oooHeader { min-height:0; padding-top:24px; padding-bottom:24px; padding-left:16px; padding-right:16px; border-radius:20px 20px 0 0; } .ZTSMRiskRegister #oooMainBox { padding:16px 8px 32px; } .ZTSMRiskRegisterTable { padding:16px; } }
</style>

<style>
.ZTSMRiskHeaderRow{display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap;width:100%}.ZTSMRiskToolbar{display:flex;align-items:center;gap:16px;flex-wrap:wrap}.ZTSMRiskToggle{display:flex;border:1px solid #cbd0e4;border-radius:24px;overflow:hidden}.ZTSMRiskToggle a{padding:12px 20px;background:white}.ZTSMRiskToggle a[aria-current=page]{background:#000539;color:white}.ZTSMRiskExport{position:static;padding:14px 24px;border-radius:28px;background:#1428ff;color:white}
.ZTSMRiskMetrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin-bottom:24px}.ZTSMRiskMetrics>div,.ZTSMRiskCard{padding:24px;background:white;border:1px solid #e4e6ef;border-radius:16px;min-width:0}.ZTSMRiskMetrics strong{display:block;font-size:32px;margin:10px 0}.ZTSMRiskMetrics small{display:block}.ZTSMRiskComparison{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.ZTSMRiskBasis{min-width:0}.ZTSMRiskCharts{display:grid;grid-template-columns:1fr;gap:24px;margin-bottom:24px}.ZTSMRiskBarLink{display:block;margin:20px 0}.ZTSMRiskBarLink>span:first-child{display:flex;justify-content:space-between;gap:12px}.ZTSMRiskBar{display:flex;height:32px;margin:8px 0;min-width:24px}.ZTSMRiskBar>span{display:flex;align-items:center;justify-content:center;overflow:hidden;font-weight:bold}.ZTSMRiskLegend{display:flex;flex-wrap:wrap;gap:12px;font-size:12px}.ZTSMRiskLegend i{display:inline-block;width:12px;height:12px;margin-right:6px}.ZTSMRiskRegister .ZTSMRiskMatrix{overflow-x:auto;margin-bottom:20px;padding:16px}.ZTSMRiskRegister .ZTSMRiskMatrix h3{font-size:16px;margin:0 0 12px}.ZTSMRiskRegister .ZTSMRiskMatrix table{table-layout:fixed;width:100%;min-width:320px}.ZTSMRiskRegister .ZTSMRiskMatrix th,.ZTSMRiskRegister .ZTSMRiskMatrix td{min-width:0;width:auto;padding:6px 4px;font-size:12px;text-align:center;white-space:normal;overflow-wrap:anywhere}.ZTSMRiskRegister .ZTSMRiskMatrix th:first-child{width:62px}.ZTSMRiskRegister .ZTSMRiskMatrix td{height:44px}.ZTSMRiskRegister .ZTSMRiskMatrix td small{display:block;font-size:11px;line-height:1.25}.ZTSMRiskRegister .ZTSMRiskMatrix summary{cursor:pointer;font-size:16px}.ZTSMRiskRegister .ZTSMRiskMatrix summary:focus-visible{outline:2px solid currentColor;outline-offset:2px}.ZTSMRiskMatrix ul{padding:12px;list-style:none;background:white;color:#000539}.ZTSMRiskMatrix a{color:#000539}
@media(max-width:767px){.ZTSMRiskMetrics,.ZTSMRiskCharts,.ZTSMRiskComparison{grid-template-columns:1fr}.ZTSMRiskToolbar{gap:12px}.ZTSMRiskHeaderRow{gap:16px}}
</style>

<style>.ZTSMRiskRegister .ZTSMRiskToolbar>.ZTSMRiskToggle{display:inline-flex;margin:0}.ZTSMRiskSearch{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.ZTSMRiskSearch input{padding:10px;border:1px solid #cbd0e4;border-radius:16px}.ZTSMRiskSearch button{padding:10px 16px;border-radius:20px}</style>
