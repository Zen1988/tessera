    <Setting Name="GovernanceDB::Permission::Group" Required="1" Valid="1">
        <Description Translatable="1">Defines the primary group for GovernanceDB access. The agent frontend also keeps admin access to avoid installer lockout.</Description>
        <Navigation>Core::GovernanceDB</Navigation>
        <Value>
            <Item ValueType="String">governance-db</Item>
        </Value>
    </Setting>

    <Setting Name="GovernanceDB::GeneralCatalogClasses" Required="1" Valid="1">
        <Description Translatable="1">Defines the GeneralCatalog namespaces owned by GovernanceDB.</Description>
        <Navigation>Core::GovernanceDB</Navigation>
        <Value>
            <Hash>
                <Item Key="Class">ZTSM::GovernanceObject::Class</Item>
                <Item Key="ClassCategory">ZTSM::GovernanceObject::Class::Category</Item>
                <Item Key="Status">ZTSM::GovernanceObject::Status</Item>
            </Hash>
        </Value>
    </Setting>

    <Setting Name="GovernanceDB::StatusValues" Required="1" Valid="1">
        <Description Translatable="1">Defines the official governance lifecycle statuses used by ZTSM-Status.</Description>
        <Navigation>Core::GovernanceDB</Navigation>
        <Value>
            <Hash>
                <Item Key="Draft">Draft</Item>
                <Item Key="Review">Review</Item>
                <Item Key="Approved">Approved</Item>
                <Item Key="Active">Active</Item>
                <Item Key="Retired">Retired</Item>
            </Hash>
        </Value>
    </Setting>

    <Setting Name="GovernanceDB::ServiceSupportMap::Condition" Required="1" Valid="1">
        <Description Translatable="1">Defines how a GovernanceDB ServiceSupportMap matches a ticket. The hash key is the ServiceSupportMap field and the value is the ticket field. Extend this hash for more matching conditions.</Description>
        <Navigation>Core::GovernanceDB</Navigation>
        <Value>
            <Hash>
                <Item Key="ZTSMSupportAssignment-Application">ZTicket-Application</Item>
                <Item Key="ZTSMSupportAssignment-Environment">ZTicket-Env</Item>
                <Item Key="ZTSMSupportAssignment-Location">ZTicket-Location</Item>
            </Hash>
        </Value>
    </Setting>

    <Setting Name="GovernanceDB::OfficialFields" Required="1" Valid="1">
        <Description Translatable="1">Defines first-class GovernanceDB fields. These names are reserved and must not be duplicated with ad hoc dynamic fields.</Description>
        <Navigation>Core::GovernanceDB</Navigation>
        <Value>
            <Hash>
                <Item Key="GOID">goid</Item>
                <Item Key="ZTSM-Code">ztsm_code</Item>
                <Item Key="ZTSM-Status">ztsm_status</Item>
                <Item Key="Name">name</Item>
                <Item Key="Description">description</Item>
            </Hash>
        </Value>
    </Setting>

    <Setting Name="GovernanceDB::OfficialDynamicFields" Required="1" Valid="1">
        <Description Translatable="1">Defines optional GovernanceObject dynamic fields. Identity, status, name, and description are first-class fields, not dynamic fields.</Description>
        <Navigation>Core::GovernanceDB</Navigation>
        <Value>
            <Hash>
                <Item Key="ZTSM-Definition">
                    <Hash>
                        <Item Key="Label" Translatable="1">Governance Definition</Item>
                        <Item Key="FieldType">TextArea</Item>
                        <Item Key="ObjectType">GovernanceObject</Item>
                        <Item Key="Required">0</Item>
                    </Hash>
                </Item>
            </Hash>
        </Value>
    </Setting>

    <Setting Name="GovernanceDB::Frontend::AdminGovernanceObjectDefinition###EditorRows" Required="1" Valid="1">
        <Description Translatable="1">Defines the number of rows for the GovernanceObject definition editor in the admin interface.</Description>
        <Navigation>Frontend::Admin::View::GovernanceObjectDefinition</Navigation>
        <Value>
            <Item ValueType="String" ValueRegex="^\d+$">30</Item>
        </Value>
    </Setting>

    <Setting Name="GovernanceDB::MigrationReadiness" Required="1" Valid="1">
        <Description Translatable="1">Documents the source CMDB classes that are expected to be copied into GovernanceDB later. This package does not delete those source records.</Description>
        <Navigation>Core::GovernanceDB</Navigation>
        <Value>
            <Hash>
                <Item Key="SourceObjectType">ITSMConfigItem</Item>
                <Item Key="SourceClasses">
                    <Array>
                        <Item>Book</Item>
                        <Item>StateBook</Item>
                        <Item>BlueBook</Item>
                        <Item>ServiceSupportMap</Item>
                    </Array>
                </Item>
                <Item Key="DeleteSourceAfterCopy">0</Item>
            </Hash>
        </Value>
    </Setting>

</otobo_config>
