    <Setting Name="Ticket::NumberGenerator::TESSERAIdentity" Required="0" Valid="1">
        <Description Translatable="1">Defines the TESSERA generated ticket identity format and ticket-type code mapping.</Description>
        <Navigation>Core::Ticket</Navigation>
        <Value>
            <Hash>
                <Item Key="SystemIdentity" ValueType="String">ICAT</Item>
                <Item Key="TypeCodeLength" ValueType="String" ValueRegex="^[1-9][0-9]*$">2</Item>
                <Item Key="SequencePadding" ValueType="String" ValueRegex="^[1-9][0-9]*$">7</Item>
                <Item Key="SequenceScope" ValueType="String">SystemYear</Item>
                <Item Key="ResetPolicy" ValueType="String">Yearly</Item>
                <Item Key="TypeCodes">
                    <Hash>
                        <DefaultItem ValueType="String"></DefaultItem>
                        <Item Key="ServiceRequest">SE</Item>
                        <Item Key="Change">CH</Item>
                        <Item Key="Incident">IN</Item>
                        <Item Key="Problem">PR</Item>
                        <Item Key="Assessment">AS</Item>
                        <Item Key="Approval">AP</Item>
                        <Item Key="Task">TA</Item>
                        <Item Key="Verification">VE</Item>
                        <Item Key="Endorsement">EN</Item>
                        <Item Key="FollowUp">FU</Item>
                        <Item Key="Exception">EX</Item>
                    </Hash>
                </Item>
            </Hash>
        </Value>
    </Setting>
