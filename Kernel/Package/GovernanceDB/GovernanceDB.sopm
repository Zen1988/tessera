    <CodeInstall Type="post"><![CDATA[
        my $BootstrapObject = $Kernel::OM->Get('Kernel::System::GovernanceDB::Bootstrap');
        $BootstrapObject->InstallDefaults();
    ]]></CodeInstall>

    <CodeUpgrade Type="post"><![CDATA[
        my $BootstrapObject = $Kernel::OM->Get('Kernel::System::GovernanceDB::Bootstrap');
        $BootstrapObject->InstallDefaults();
    ]]></CodeUpgrade>

    <DatabaseInstall Type="post">
        <Insert Type="post" Table="groups_table">
            <Data Key="name" Type="Quote">governance-db</Data>
            <Data Key="comments" Type="Quote">GovernanceDB access group.</Data>
            <Data Key="valid_id">1</Data>
            <Data Key="create_time">current_timestamp</Data>
            <Data Key="create_by">1</Data>
            <Data Key="change_time">current_timestamp</Data>
            <Data Key="change_by">1</Data>
        </Insert>

        <TableCreate Type="post" Name="governance_object">
            <Column Name="id" Required="true" PrimaryKey="true" AutoIncrement="true" Type="BIGINT"/>
            <Column Name="goid" Required="true" Size="100" Type="VARCHAR"/>
            <Column Name="ztsm_code" Required="true" Size="100" Type="VARCHAR"/>
            <Column Name="ztsm_status" Required="true" Size="50" Type="VARCHAR"/>
            <Column Name="class_id" Required="true" Type="INTEGER"/>
            <Column Name="last_version_id" Required="false" Type="BIGINT"/>
            <Column Name="create_time" Required="true" Type="DATE"/>
            <Column Name="create_by" Required="true" Type="INTEGER"/>
            <Column Name="change_time" Required="true" Type="DATE"/>
            <Column Name="change_by" Required="true" Type="INTEGER"/>
            <Unique Name="governance_object_goid">
                <UniqueColumn Name="goid"/>
            </Unique>
            <Unique Name="governance_object_ztsm_code">
                <UniqueColumn Name="ztsm_code"/>
            </Unique>
            <Index Name="governance_object_ztsm_status">
                <IndexColumn Name="ztsm_status"/>
            </Index>
            <Index Name="governance_object_class_id">
                <IndexColumn Name="class_id"/>
            </Index>
            <Index Name="governance_object_last_version_id">
                <IndexColumn Name="last_version_id"/>
            </Index>
            <ForeignKey ForeignTable="general_catalog">
                <Reference Foreign="id" Local="class_id"/>
            </ForeignKey>
        </TableCreate>

        <TableCreate Type="post" Name="governance_object_definition">
            <Column Name="id" Required="true" PrimaryKey="true" AutoIncrement="true" Type="BIGINT"/>
            <Column Name="class_id" Required="true" Type="INTEGER"/>
            <Column Name="definition" Required="true" Type="LONGBLOB"/>
            <Column Name="version" Required="true" Type="INTEGER"/>
            <Column Name="create_time" Required="true" Type="DATE"/>
            <Column Name="create_by" Required="true" Type="INTEGER"/>
            <ForeignKey ForeignTable="general_catalog">
                <Reference Foreign="id" Local="class_id"/>
            </ForeignKey>
        </TableCreate>

        <TableCreate Type="post" Name="governance_object_version">
            <Column Name="id" Required="true" PrimaryKey="true" AutoIncrement="true" Type="BIGINT"/>
            <Column Name="governance_object_id" Required="true" Type="BIGINT"/>
            <Column Name="name" Required="true" Size="250" Type="VARCHAR"/>
            <Column Name="description" Required="false" Size="250" Type="VARCHAR"/>
            <Column Name="definition_id" Required="true" Type="BIGINT"/>
            <Column Name="version_string" Required="true" Size="50" Type="VARCHAR"/>
            <Column Name="create_time" Required="true" Type="DATE"/>
            <Column Name="create_by" Required="true" Type="INTEGER"/>
            <Index Name="governance_object_version_object_id">
                <IndexColumn Name="governance_object_id"/>
            </Index>
            <Index Name="governance_object_version_definition_id">
                <IndexColumn Name="definition_id"/>
            </Index>
            <ForeignKey ForeignTable="governance_object">
                <Reference Foreign="id" Local="governance_object_id"/>
            </ForeignKey>
            <ForeignKey ForeignTable="governance_object_definition">
                <Reference Foreign="id" Local="definition_id"/>
            </ForeignKey>
        </TableCreate>

        <TableCreate Type="post" Name="governance_object_counter">
            <Column Name="counter_key" Required="true" PrimaryKey="true" Size="100" Type="VARCHAR"/>
            <Column Name="counter_value" Required="true" Type="BIGINT"/>
        </TableCreate>

        <TableCreate Type="post" Name="governance_object_history_type">
            <Column Name="id" Required="true" PrimaryKey="true" AutoIncrement="true" Type="SMALLINT"/>
            <Column Name="name" Required="true" Size="100" Type="VARCHAR"/>
            <Column Name="comments" Required="false" Size="250" Type="VARCHAR"/>
            <Column Name="valid_id" Required="true" Type="SMALLINT"/>
            <Column Name="create_time" Required="true" Type="DATE"/>
            <Column Name="create_by" Required="true" Type="INTEGER"/>
            <Column Name="change_time" Required="true" Type="DATE"/>
            <Column Name="change_by" Required="true" Type="INTEGER"/>
            <Unique Name="governance_object_history_type_name">
                <UniqueColumn Name="name"/>
            </Unique>
        </TableCreate>

        <TableCreate Type="post" Name="governance_object_history">
            <Column Name="id" Required="true" PrimaryKey="true" AutoIncrement="true" Type="BIGINT"/>
            <Column Name="governance_object_id" Required="true" Type="BIGINT"/>
            <Column Name="history_type_id" Required="true" Type="SMALLINT"/>
            <Column Name="name" Required="true" Size="200" Type="VARCHAR"/>
            <Column Name="create_time" Required="true" Type="DATE"/>
            <Column Name="create_by" Required="true" Type="INTEGER"/>
            <ForeignKey ForeignTable="governance_object">
                <Reference Foreign="id" Local="governance_object_id"/>
            </ForeignKey>
            <ForeignKey ForeignTable="governance_object_history_type">
                <Reference Foreign="id" Local="history_type_id"/>
            </ForeignKey>
        </TableCreate>

        <TableCreate Type="post" Name="governance_object_definition_sync">
            <Column Name="class_id" Required="true" PrimaryKey="true" Type="INTEGER"/>
            <Column Name="definition_hash" Required="true" Size="32" Type="VARCHAR"/>
            <Column Name="create_time" Required="true" Type="DATE"/>
            <Column Name="create_by" Required="true" Type="INTEGER"/>
            <Column Name="change_time" Required="true" Type="DATE"/>
            <Column Name="change_by" Required="true" Type="INTEGER"/>
        </TableCreate>

        <TableCreate Type="post" Name="governance_object_link">
            <Column Name="id" Required="true" PrimaryKey="true" AutoIncrement="true" Type="BIGINT"/>
            <Column Name="source_governance_object_id" Required="false" Type="BIGINT"/>
            <Column Name="source_governance_object_version_id" Required="false" Type="BIGINT"/>
            <Column Name="target_governance_object_id" Required="false" Type="BIGINT"/>
            <Column Name="target_governance_object_version_id" Required="false" Type="BIGINT"/>
            <Column Name="link_type_id" Required="true" Type="SMALLINT"/>
            <Column Name="create_time" Required="true" Type="DATE"/>
            <Column Name="create_by" Required="true" Type="INTEGER"/>
            <ForeignKey ForeignTable="governance_object">
                <Reference Foreign="id" Local="source_governance_object_id"/>
            </ForeignKey>
            <ForeignKey ForeignTable="governance_object_version">
                <Reference Foreign="id" Local="source_governance_object_version_id"/>
            </ForeignKey>
            <ForeignKey ForeignTable="governance_object">
                <Reference Foreign="id" Local="target_governance_object_id"/>
            </ForeignKey>
            <ForeignKey ForeignTable="governance_object_version">
                <Reference Foreign="id" Local="target_governance_object_version_id"/>
            </ForeignKey>
        </TableCreate>

        <TableCreate Type="post" Name="governance_object_item">
            <Column Name="id" Required="true" PrimaryKey="true" AutoIncrement="true" Type="BIGINT"/>
            <Column Name="goid" Required="true" Size="100" Type="VARCHAR"/>
            <Column Name="class_id" Required="true" Type="INTEGER"/>
            <Column Name="last_version_id" Required="false" Type="BIGINT"/>
            <Column Name="ztsm_status_id" Required="false" Type="INTEGER"/>
            <Column Name="create_time" Required="true" Type="DATE"/>
            <Column Name="create_by" Required="true" Type="INTEGER"/>
            <Column Name="change_time" Required="true" Type="DATE"/>
            <Column Name="change_by" Required="true" Type="INTEGER"/>
            <Unique Name="governance_object_item_goid"><UniqueColumn Name="goid"/></Unique>
            <Index Name="governance_object_item_class_id"><IndexColumn Name="class_id"/></Index>
            <Index Name="governance_object_item_last_version_id"><IndexColumn Name="last_version_id"/></Index>
            <Index Name="governance_object_item_ztsm_status_id"><IndexColumn Name="ztsm_status_id"/></Index>
        </TableCreate>

        <TableCreate Type="post" Name="governance_object_item_definition">
            <Column Name="id" Required="true" PrimaryKey="true" AutoIncrement="true" Type="INTEGER"/>
            <Column Name="class_id" Required="true" Type="INTEGER"/>
            <Column Name="governance_object_item_definition" Required="true" Type="LONGBLOB"/>
            <Column Name="dynamicfield_definition" Required="false" Type="LONGBLOB"/>
            <Column Name="version" Required="true" Type="INTEGER"/>
            <Column Name="create_time" Required="true" Type="DATE"/>
            <Column Name="create_by" Required="true" Type="INTEGER"/>
        </TableCreate>

        <TableCreate Type="post" Name="governance_object_item_version">
            <Column Name="id" Required="true" PrimaryKey="true" AutoIncrement="true" Type="BIGINT"/>
            <Column Name="governance_object_id" Required="true" Type="BIGINT"/>
            <Column Name="name" Required="true" Size="191" Type="VARCHAR"/>
            <Column Name="version_string" Required="true" Size="191" Type="VARCHAR"/>
            <Column Name="definition_id" Required="true" Type="INTEGER"/>
            <Column Name="ztsm_status_id" Required="false" Type="INTEGER"/>
            <Column Name="description" Required="false" Size="1800000" Type="VARCHAR"/>
            <Column Name="create_time" Required="true" Type="DATE"/>
            <Column Name="create_by" Required="true" Type="INTEGER"/>
            <Column Name="change_time" Required="true" Type="DATE"/>
            <Column Name="change_by" Required="true" Type="INTEGER"/>
            <Index Name="governance_object_item_version_object_id"><IndexColumn Name="governance_object_id"/></Index>
            <Index Name="governance_object_item_version_status_id"><IndexColumn Name="ztsm_status_id"/></Index>
        </TableCreate>

        <TableCreate Type="post" Name="governance_object_item_counter">
            <Column Name="class_id" PrimaryKey="true" Required="true" Type="INTEGER"/>
            <Column Name="counter_type" Required="true" Size="50" Type="VARCHAR"/>
            <Column Name="counter" Required="true" Size="50" Type="VARCHAR"/>
        </TableCreate>

        <TableCreate Type="post" Name="governance_object_item_history_type">
            <Column Name="id" Required="true" PrimaryKey="true" AutoIncrement="true" Type="INTEGER"/>
            <Column Name="name" Required="true" Size="191" Type="VARCHAR"/>
            <Column Name="comments" Required="false" Size="191" Type="VARCHAR"/>
            <Column Name="valid_id" Required="true" Type="SMALLINT"/>
            <Column Name="create_time" Required="true" Type="DATE"/>
            <Column Name="create_by" Required="true" Type="INTEGER"/>
            <Column Name="change_time" Required="false" Type="DATE"/>
            <Column Name="change_by" Required="false" Type="INTEGER"/>
            <Unique Name="governance_object_item_history_type_name"><UniqueColumn Name="name"/></Unique>
        </TableCreate>

