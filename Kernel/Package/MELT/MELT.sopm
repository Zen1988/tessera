    <CodeInstall Type="post"><![CDATA[
        my $BootstrapObject = $Kernel::OM->Get('Kernel::System::MELT::Bootstrap');
        $BootstrapObject->InstallDefaults();
    ]]></CodeInstall>

    <CodeUpgrade Type="post"><![CDATA[
        my $BootstrapObject = $Kernel::OM->Get('Kernel::System::MELT::Bootstrap');
        $BootstrapObject->InstallDefaults();
    ]]></CodeUpgrade>
    <CodeUpgrade Type="post" Version="0.0.6"><![CDATA[
        my $BootstrapObject = $Kernel::OM->Get('Kernel::System::MELT::Bootstrap');
        $BootstrapObject->CopiedObjectDataClear();
    ]]></CodeUpgrade>
