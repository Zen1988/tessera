<?xml version="1.0" encoding="utf-8"?>
<otobo_package version="1.1">
    <Name>MELT</Name>
    <Version>0.0.25</Version>
    <Framework>11.1.x</Framework>
    <Vendor>TESSERA</Vendor>
    <URL>https://tessera.local/</URL>
    <License>GNU GENERAL PUBLIC LICENSE Version 3, 29 June 2007</License>
    <Description Lang="en">Standalone MELT object database foundation for ZTSM MELT records, definitions, and runtime evidence.</Description>
    <IntroInstall Type="post" Lang="en" Title="MELT">
        This package creates a separate MELT schema. It does not remove or migrate existing ITSM ConfigItem or GovernanceDB data.
    </IntroInstall>
    <IntroUninstall Type="pre" Lang="en" Title="MELT">
        This package owns only MELT tables and settings. Existing ITSM ConfigItem and GovernanceDB tables are not touched.
    </IntroUninstall>

