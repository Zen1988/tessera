<style>
    .oooTile_NewTicket,
    .oooTile_FeaturedLink {
        min-height: 150px !important;
        height: 150px !important;
        padding: 28px 40px !important;
    }

    .oooTile_NewTicket h1,
    .oooTile_FeaturedLink h2,
    .oooTile_FeaturedLink h3 {
        font-size: 34px !important;
        line-height: 1.18 !important;
    }

    .oooTile_FeaturedLink h3 {
        font-size: 20px !important;
    }

    .oooTile_TicketList.ztsmDashboardWorkspace {
        display: grid;
        grid-template-rows: auto minmax(0, 1fr);
        gap: 24px;
        padding: 0;
        background: transparent;
        box-shadow: none;
        overflow: visible;
    }

    .ztsmWorkspacePanel,
    .ztsmMajorChangePanel {
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 2px 9px rgba(0, 0, 0, 0.13);
        padding: 26px 30px;
    }

    .ztsmMajorChangePanel {
        min-height: 150px;
    }

    .ztsmWorkspacePanel {
        min-height: 0;
    }

    .ztsmWorkspaceHeader {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 18px;
        margin-bottom: 18px;
    }

    .ztsmWorkspaceHeader h2,
    .ztsmMajorChangePanel h2 {
        margin: 0;
        color: #000044;
        font-size: 26px;
        font-weight: 400;
    }

    .ztsmWorkspaceCount {
        color: #81779f;
        font-size: 14px;
        white-space: nowrap;
    }

    .ztsmWorkspaceHeaderActions {
        align-items: center;
        display: flex;
        gap: 14px;
    }

    .ztsmWorkspaceToggle {
        border: 1px solid #e1deeb;
        border-radius: 999px;
        color: #000044;
        font-size: 13px;
        padding: 6px 12px;
        text-decoration: none;
        white-space: nowrap;
    }

    .ztsmWorkspaceToggle:hover {
        border-color: #001bff;
        color: #001bff;
        text-decoration: none;
    }

    .ztsmWorkspaceScroll {
        max-height: 430px;
        overflow: auto;
        padding-right: 4px;
    }

    .ztsmWorkspaceTable {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 10px;
        table-layout: fixed;
    }

    .ztsmWorkspaceTable th {
        color: #81779f;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0;
        padding: 0 12px 2px;
        text-align: left;
        text-transform: uppercase;
    }

    .ztsmWorkspaceTable th + th {
        border-left: 4px solid transparent;
    }

    .ztsmWorkspaceTable td {
        background: #f8f8fb;
        box-sizing: border-box;
        color: #000044;
        font-size: 14px;
        line-height: 1.3;
        padding: 13px 12px;
        vertical-align: middle;
    }

    .ztsmWorkspaceTable td + td {
        border-left: 4px solid transparent;
    }

    .ztsmWorkspaceTable td:first-child {
        border-radius: 10px 0 0 10px;
        width: 130px;
    }

    .ztsmWorkspaceTable td:last-child {
        border-radius: 0 10px 10px 0;
    }

    .ztsmWorkspaceTable a {
        color: #000044;
        text-decoration: none;
    }

    .ztsmWorkspaceTable a:hover {
        text-decoration: underline;
    }

    .ztsmWorkspaceTable td:nth-child(2) a {
        overflow-wrap: anywhere;
        word-break: break-word;
    }

    .ztsmTypeBadge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 92px;
        max-width: 120px;
        border-radius: 999px;
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        padding: 5px 10px;
        white-space: nowrap;
    }

    .ztsmTicketTitle,
    .ztsmOwnerGroup {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .ztsmWorkspaceEmpty,
    .ztsmMajorEmpty {
        color: #81779f;
        font-size: 16px;
        padding: 26px 0 8px;
    }

    .ztsmMajorChangeList {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-top: 18px;
    }

    .ztsmMajorChangeItem {
        border: 1px solid #ececf4;
        border-radius: 12px;
        padding: 14px 16px;
    }

    .ztsmMajorChangeItem a {
        color: #000044;
        display: block;
        font-size: 15px;
        text-decoration: none;
    }

    .ztsmMajorChangeMeta {
        color: #81779f;
        font-size: 12px;
        margin-top: 6px;
    }

    @media only screen and (min-width: 1280px) {
        #oooTile07 {
            display: none !important;
        }

        #oooTile01 {
            grid-area: 1 / 9 / 5 / 13 !important;
        }

        #oooTile02 {
            grid-area: 5 / 9 / 13 / 13 !important;
        }

        #oooTile03 {
            grid-area: 1 / 1 / 17 / 9 !important;
        }

        #oooTile05 {
            grid-area: 13 / 9 / 17 / 13 !important;
        }
    }

    @media only screen and (min-width: 880px) and (max-width: 1279px) {
        #oooTile07 {
            display: none !important;
        }

        #oooTile01 {
            grid-area: 1 / 4 / 4 / 7 !important;
        }

        #oooTile03 {
            grid-area: 1 / 1 / 10 / 4 !important;
        }

        #oooTile02 {
            grid-area: 4 / 4 / 10 / 7 !important;
        }
    }
</style>

<div id="oooTile[% Data.TileID | html %]" class="oooTile oooTile_TicketList ztsmDashboardWorkspace">
    <section class="ztsmWorkspacePanel">
        <div class="ztsmWorkspaceHeader">
            <h2 title="My workspace">My workspace</h2>
            <div class="ztsmWorkspaceHeaderActions">
                <span class="ztsmWorkspaceCount">[% Data.WorkspaceCountText | html %] item(s)</span>
                [% IF Data.ShowAllWorkspace %]
                    <a class="ztsmWorkspaceToggle" href="[% Env("Baselink") %]Action=CustomerDashboard">Outstanding only</a>
                [% ELSE %]
                    <a class="ztsmWorkspaceToggle" href="[% Env("Baselink") %]Action=CustomerDashboard;ShowAllWorkspace=1">Show all</a>
                [% END %]
            </div>
        </div>

        [% IF Data.WorkspaceCount %]
            <div class="ztsmWorkspaceScroll">
                <table class="ztsmWorkspaceTable">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>TicketID</th>
                            <th>Title</th>
                            <th>State</th>
                            <th>OwnerGroup</th>
                            <th>Updated</th>
                        </tr>
                    </thead>
                    <tbody>
                        [% FOREACH Row IN Data.WorkspaceRows %]
                            <tr>
                                <td><span class="ztsmTypeBadge" style="background-color: [% Row.TypeColor | html %]">[% Row.Type | html %]</span></td>
                                <td><a href="[% Env("Baselink") %]Action=CustomerTicketZoom;TicketNumber=[% Row.TicketNumber | html %]">[% Row.TicketNumber | html %]</a></td>
                                <td><div class="ztsmTicketTitle" title="[% Row.Title | html %]">[% Row.Title | html %]</div></td>
                                <td>[% Row.State | html %]</td>
                                <td><div class="ztsmOwnerGroup" title="[% Row.OwnerGroup | html %]">[% Row.OwnerGroup | html %]</div></td>
                                <td>[% Row.Changed | html %]</td>
                            </tr>
                        [% END %]
                    </tbody>
                </table>
            </div>
        [% ELSE %]
            <div class="ztsmWorkspaceEmpty">No assigned workspace tickets right now.</div>
        [% END %]
    </section>

    <aside class="ztsmMajorChangePanel">
        <h2>Major changes</h2>
        [% IF Data.MajorChangeCount %]
            <div class="ztsmMajorChangeList">
                [% FOREACH Row IN Data.MajorChangeRows %]
                    <div class="ztsmMajorChangeItem">
                        <a href="[% Env("Baselink") %]Action=CustomerTicketZoom;TicketNumber=[% Row.TicketNumber | html %]">[% Row.Title | html %]</a>
                        <div class="ztsmMajorChangeMeta">Ticket#[% Row.TicketNumber | html %] - [% Row.State | html %] - [% Row.Changed | html %]</div>
                    </div>
                [% END %]
            </div>
        [% ELSE %]
            <div class="ztsmMajorEmpty">No Major Change Announced!</div>
        [% END %]
    </aside>
</div>
