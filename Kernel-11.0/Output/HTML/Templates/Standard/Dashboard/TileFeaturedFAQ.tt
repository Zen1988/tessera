<style>
    .ztsmKnowledgeAnnouncements {
        display: flex;
        flex-direction: column;
        gap: 14px;
        padding: 28px 30px;
        box-sizing: border-box;
        width: 100%;
        height: 100%;
        max-height: 100%;
        background: #ffffff;
        color: #172033;
        overflow: hidden;
    }

    .ztsmAnnouncementHeader span {
        display: block;
        color: #5d6678;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0;
        text-transform: uppercase;
    }

    .ztsmAnnouncementHeader h2 {
        margin: 4px 0 0;
        color: #172033;
        font-size: 28px;
        line-height: 1.1;
    }

    .ztsmAnnouncementList {
        display: flex;
        flex-direction: column;
        gap: 10px;
        flex: 1 1 auto;
        min-height: 0;
        max-height: 100%;
        overflow: auto;
        overscroll-behavior: contain;
        padding-right: 4px;
    }

    .ztsmAnnouncementItem {
        display: flex;
        flex-direction: column;
        gap: 4px;
        flex: 0 0 auto;
        padding: 10px 0;
        border-top: 1px solid rgba(23, 32, 51, 0.12);
        color: #172033;
        text-decoration: none;
    }

    .ztsmAnnouncementItem:hover strong {
        color: #0047d9;
    }

    .ztsmAnnouncementDate {
        color: #6f7788;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0;
        text-transform: uppercase;
    }

    .ztsmAnnouncementItem strong {
        display: -webkit-box;
        overflow: hidden;
        font-size: 15px;
        line-height: 1.25;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
    }

    .ztsmAnnouncementItem em,
    .ztsmAnnouncementEmpty {
        color: #5d6678;
        font-size: 13px;
        font-style: normal;
        line-height: 1.35;
    }

    .ztsmAnnouncementItem em {
        display: -webkit-box;
        overflow: hidden;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
    }
</style>
<section id="oooTile[% Data.TileID | html %]" class="oooTile oooTile_FeaturedFAQ ztsmKnowledgeAnnouncements">
    <div class="ztsmAnnouncementHeader">
        <span>Knowledge</span>
        <h2>Announcements</h2>
    </div>

    [% IF Data.AnnouncementCount %]
        <div class="ztsmAnnouncementList">
            [% FOREACH Announcement IN Data.Announcements %]
                <a class="ztsmAnnouncementItem" href="[% Env("Baselink") %]Action=CustomerFAQZoom;ItemID=[% Announcement.ItemID | uri %]">
                    <span class="ztsmAnnouncementDate">[% Announcement.DisplayDate | html %]</span>
                    <strong>[% Announcement.Title | html %]</strong>
                    [% IF Announcement.Summary %]
                        <em>[% Announcement.Summary | html %]</em>
                    [% END %]
                </a>
            [% END %]
        </div>
    [% ELSE %]
        <div class="ztsmAnnouncementEmpty">[% Data.EmptyText | html %]</div>
    [% END %]
</section>
