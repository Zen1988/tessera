use strict;use warnings;use Test::More;use lib 'Kernel/Package/GovernanceDB','.';
use Kernel::System::TESSERA::RiskRegister;
my $R=Kernel::System::TESSERA::RiskRegister->new();
my $Start=Kernel::System::TESSERA::RiskRegister::Epoch('2026-10-07 00:00:00');
my %T=(TicketID=>1,Service=>'Risk::Management',Type=>'ServiceRequest',State=>'in-progress',StateType=>'open','DynamicField_RiskAssessmentOutcome'=>'Risk Mitigated','DynamicField_ITSMDecisionDate'=>'2026-10-07 00:00:00');
my @H=({HistoryType=>'StateUpdate',Name=>'%%new%%assess%%',CreateTime=>'2026-10-06 00:00:00'}, {HistoryType=>'StateUpdate',Name=>'%%assess%%endorse%%',CreateTime=>'2026-10-07 00:00:00'});
push @H,{HistoryType=>'Misc',Name=>'ZTSM Risk Governance Decision '.('a'x64)};
sub E {my(%P)=@_;$R->Evaluate(Ticket=>\%T,History=>\@H,AcceptedValue=>'Risk Accepted',Now=>$Start+100,%P)}
is(E()->{Status},'Current','approved active master included');
is(E()->{GovernanceDate},'2026-10-07 00:00:00','final approval date is governance start');
is(E(Now=>$Start+365*86400-1)->{Status},'Current','one second before expiry still current');
is(E(Now=>$Start+365*86400)->{Status},'Review','exact maximum 365 days expires');
is(E(History=>[grep {$_->{HistoryType} ne 'Misc'} @H])->{Status},'Excluded','state progression into approval does not grant approval');
$T{State}='approve';is(E(History=>[])->{Status},'Excluded','pending approval excluded even with copied outcome and date');
$T{State}='in-progress';
$T{State}='closed successful';$T{StateType}='closed';is(E()->{Status},'Excluded','closed nonaccepted excluded');
$T{'DynamicField_RiskAssessmentOutcome'}='Risk Accepted';$T{'DynamicField_ITSMDecisionDate'}='2026-10-07 00:00:00';
is(E()->{Status},'Current','closed accepted master included');
is(E(Now=>$Start+365*86400)->{Status},'Review','closed accepted risk expires');
$T{'DynamicField_ITSMDecisionDate'}='2027-10-07 00:00:00';is(E()->{Status},'Review','future governance date cannot authorize current acceptance');
$T{'DynamicField_ITSMDecisionDate'}='2026-02-30 00:00:00';is(E()->{Status},'Review','invalid decision date review');
delete $T{'DynamicField_ITSMDecisionDate'};is(E()->{Status},'Review','missing acceptance date never uses ticket creation');
$T{Created}='2026-10-07 00:00:00';is(E()->{Status},'Review','recent Created is not effective acceptance');
$T{'DynamicField_ZTicket-Parent'}=99;is(E()->{Status},'Excluded','child never independently registered');delete $T{'DynamicField_ZTicket-Parent'};
$T{Service}='Other';is(E()->{Status},'Excluded','other services excluded');$T{Service}='Risk::Management';
$T{Type}='Assessment';is(E()->{Status},'Excluded','execution ticket type excluded');$T{Type}='ServiceRequest';
$T{'DynamicField_RiskAssessmentOutcome'}='Risk Mitigated';is(E()->{Status},'Excluded','closed mitigated not current register');
$T{StateType}='open';$T{State}='in-progress';is(E(History=>[])->{Status},'Excluded','active without final approval evidence excluded');
delete $T{'DynamicField_ITSMDecisionDate'};is(E()->{Status},'Review','approved active missing decision date needs review');
$T{'DynamicField_RiskAssessmentOutcome'}=['Risk Accepted','Other'];$T{StateType}='closed';is(E()->{Status},'Excluded','ambiguous outcome cannot grant acceptance');
$T{'DynamicField_RiskAssessmentOutcome'}='Risk Accepted';$T{'DynamicField_ITSMDecisionDate'}='2024-02-29 12:00:00';my $Leap=Kernel::System::TESSERA::RiskRegister::Epoch($T{'DynamicField_ITSMDecisionDate'});is(E(Now=>$Leap+365*86400)->{Status},'Review','leap year never exceeds maximum 365 elapsed days');
{package RegisterOM;sub Get{$_[0]}sub TicketGet{return(CustomerUserID=>'requester')}sub TicketCustomerPermission{$_[0]{Native}}sub Run{$_[0]{Governed}}}
local $Kernel::OM=bless {Native=>0,Governed=>0},'RegisterOM';
ok(!$R->Visible(TicketID=>1,CustomerUserID=>'other'),'unrelated viewer denied');
$Kernel::OM->{Governed}=1;ok($R->Visible(TicketID=>1,CustomerUserID=>'participant'),'governed story participation allowed');
$Kernel::OM->{Governed}=0;$Kernel::OM->{Native}=1;ok($R->Visible(TicketID=>1,CustomerUserID=>'requester'),'native requester read allowed');
ok(!$R->Visible(TicketID=>1),'anonymous denied');
ok(!$R->Visible(TicketID=>1,CustomerUserID=>'company-only'),'native company or queue grant alone does not disclose register');
delete $T{'DynamicField_RiskAssessmentOutcome'};$T{State}='closed successful';$T{'DynamicField_ZRM-OriginatedEvent'}=21;is(E()->{Status},'Excluded','legacy master without rolled-up decision cannot declare an approved risk');
