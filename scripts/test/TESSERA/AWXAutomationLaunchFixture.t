use strict;
use warnings;
use Test::More;
use lib '.';
use Kernel::System::TESSERA::ScriptEngine;
open my $FH, '<', 'examples/awx/automation-launch-test.example.yml' or die $!;
local $/; my $Source=<$FH>;close $FH;
my $Calls=0;
my @Received;
my $Provider=sub {my %P=@_;++$Calls;push @Received,\%P;return {Success=>1,Data=>{ExecutionUID=>'A'x40,Status=>'PENDING'}};};
my $Default=Kernel::System::TESSERA::ScriptEngine->new();
ok($Default->ScriptParse(Source=>$Source)->{Success},'launch fixture parses using actual ScriptEngine');
ok(!$Default->ScriptEvaluate(Source=>$Source,UserID=>7)->{Success},'stored script has no ambient outbound authority');
my $Engine=Kernel::System::TESSERA::ScriptEngine->new(WebServiceProvider=>$Provider);
my $Result=$Engine->ScriptEvaluate(Source=>$Source,UserID=>7);
ok($Result->{Success},'authorized script chains launch response');
is($Result->{Value},'A'x40,'returns durable execution reference rather than claiming completion');
is($Calls,1,'one provider call per evaluation');
is($Received[0]{Service},'AWX','exact AWX service alias');
is($Received[0]{Invoker},'JobLaunchCallback','uses durable callback dispatch');
is($Received[0]{UserID},7,'caller identity propagated');
is_deeply($Received[0]{Data},{TemplateID=>42,inventory=>7,verbosity=>3,extra_vars=>{tessera_request=>{reference=>'scriptengine-awx-launch-test',data=>{message=>'hello from the TESSERA ScriptEngine automation test'}}}},'only reviewed non-secret launch payload sent');
ok(!$Engine->ScriptEvaluate(Source=>$Source,UserID=>7,AllowedSearchType=>'ConfigItem')->{Success},'selection scripts cannot launch even with a provider');
is($Calls,1,'selection rejection occurs before outbound call');
done_testing();
