use strict;
use warnings;
use Test::More;
use Template;
open my $FH, '<', 'Kernel/Package/GovernanceDB/var/governancedb/runtime_overlay/Kernel/Output/HTML/Templates/Standard/CustomerITSMConfigItem.tt' or die $!;
my $Source = do { local $/; <$FH> };
$Source =~ s{\[\% RenderBlockStart\("(FilterHeader|FilterDelete)"\) \%\].*?\[\% RenderBlockEnd\("\1"\) \%\]}{}sg;
my $TT = Template->new();
my $Data = { IsDashboard => 1, ListLink => 'Action=CustomerITSMConfigItem;AssetView=List', DashboardLink => 'Action=CustomerITSMConfigItem;AssetView=Dashboard', ExportLink => 'Action=CustomerITSMConfigItem;Subaction=Export', ITSMConfigItemListHTML => '<div>LIST_SENTINEL</div>', Dashboard => { Total => 2, RiskCount => 1, Distribution => [{Type => '<Appliance>', Count => 2, Percent => '100.0'}], RiskAssets => [{ID => 1, Name => '<Server>', Type => '<Appliance>'}] }};
my $Vars = { Data => $Data, Env => sub { return $_[0] eq 'Baselink' ? '/otobo/customer.pl?' : '' }, Translate => sub { $_[0] } };
my $Output;
ok($TT->process(\$Source, $Vars, \$Output), 'dashboard template renders') or diag($TT->error());
like($Output, qr/<meter min="0" max="2" value="2"/, 'distribution meter reflects total');
like($Output, qr/&lt;Server&gt;/, 'asset name escaped');
like($Output, qr/&lt;Appliance&gt;/, 'type escaped');
unlike($Output, qr/LIST_SENTINEL/, 'dashboard hides list');
like($Output, qr/AssetView=Dashboard" aria-current="page"/, 'dashboard selected');
like($Output, qr/Subaction=Export/, 'export remains available');
$Data->{IsDashboard} = 0; $Output = '';
ok($TT->process(\$Source, $Vars, \$Output), 'list template renders');
like($Output, qr/LIST_SENTINEL/, 'list view retained');
unlike($Output, qr/<meter /, 'list hides dashboard');
$Data->{IsDashboard} = 1; $Data->{Dashboard} = {Total => 0, RiskCount => 0}; $Output = '';
ok($TT->process(\$Source, $Vars, \$Output), 'empty dashboard renders');
like($Output, qr/No assets match the current filters/, 'empty distribution explained');
like($Output, qr/No matching assets are tagged/, 'empty risk state explained');
done_testing();
