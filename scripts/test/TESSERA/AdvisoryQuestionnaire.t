use strict;
use warnings;
use Test::More;
use YAML::XS;
use Kernel::System::TESSERA::Questionnaire;
my $Engine=YAML::XS::LoadFile('Kernel/Package/GovernanceDB/var/governancedb/policy/vulnerability_questionnaire_scoring.yml');
my $Q=Kernel::System::TESSERA::Questionnaire->new;
my $Framework={'DynamicField_ZRM-LikelihoodScale'=>5,'DynamicField_ZRM-ImpactScale'=>5};
my $Object={};
my $R=$Q->Evaluate(Config=>$Engine->{BASE},Object=>$Object,Framework=>$Framework);
is($R->{LIKELIHOOD}{Base},5,'missing answers use authored Skip mapping at maximum');
is($R->{IMPACT}{Base},5,'impact Skip also remains maximum');
is($R->{LIKELIHOOD}{Modifier},1,'neutral product');
$Object->{'DynamicField_ZRM-PrivilegeRequired'}='Administrator privileges';
$Object->{'DynamicField_ZRM-AttackVector'}='Physical access';
$Object->{'DynamicField_ZRM-Complexity'}='High complexity';
$Object->{'DynamicField_ZRM-Reproducibility'}='Condition-dependent';
$R=$Q->Evaluate(Config=>$Engine->{BASE},Object=>$Object,Framework=>$Framework);
is($R->{LIKELIHOOD}{Modifier},'21/320','exact decimal product without intermediate rounding');
is($R->{LIKELIHOOD}{Base},1,'ceiling after multiplying scale');
$Object->{'DynamicField_ZRM-Confidentiality'}='Sensitive information or credentials';
$Object->{'DynamicField_ZRM-Integrity'}='Significant manipulation';
$R=$Q->Evaluate(Config=>$Engine->{BASE},Object=>$Object,Framework=>$Framework);
is($R->{IMPACT}{Modifier},'16/25','impact uses product, not maximum');
is($R->{IMPACT}{Base},4,'ceil of 5 times 0.64');
$Object->{'DynamicField_ZRM-Integrity'}='No unauthorized modification';
$R=$Q->Evaluate(Config=>$Engine->{BASE},Object=>$Object,Framework=>$Framework);
is($R->{IMPACT}{Modifier},0,'zero modifier preserved in evidence');
is($R->{IMPACT}{Base},1,'authored one-to-five minimum is applied');
$Object->{'DynamicField_ZRM-Integrity'}='fake';
eval {$Q->Evaluate(Config=>$Engine->{BASE},Object=>$Object,Framework=>$Framework)};
like($@,qr/Unmapped questionnaire answer/,'unknown key rejected rather than silently neutralized');
$Object->{'DynamicField_ZRM-Integrity'}='Unknown / Skip';
$Framework->{'DynamicField_ZRM-LikelihoodScale'}=4;
$Object={};
$R=$Q->Evaluate(Config=>$Engine->{BASE},Object=>$Object,Framework=>$Framework);
is($R->{LIKELIHOOD}{Base},4,'scale comes from Framework rather than literal five or RiskStatement');
my $Original=$Engine->{BASE}{IMPACT}{QUESTIONS}[0]{VALUES}{'No unauthorized disclosure'};
$Engine->{BASE}{IMPACT}{QUESTIONS}[0]{VALUES}{'No unauthorized disclosure'}='2';
eval {$Q->Evaluate(Config=>$Engine->{BASE},Object=>$Object,Framework=>$Framework)};
like($@,qr/modifier must be/, 'invalid unselected weights rejected');
$Engine->{BASE}{IMPACT}{QUESTIONS}[0]{VALUES}{'No unauthorized disclosure'}=$Original;
done_testing;
