{
  "name": "redis-recovery",
  "kind": "redis-replica-replace",
  "namespace": "tessera",
  "cluster": "tessera-redis-ha",
  "master_name": "mymaster",
  "member_dns": "{pod}.tessera-redis-ha-headless.tessera.svc.cluster.local",
  "sentinel_hosts": [
    "tessera-redis-ha-s-0.tessera-redis-ha-s-hl.tessera.svc.cluster.local",
    "tessera-redis-ha-s-1.tessera-redis-ha-s-hl.tessera.svc.cluster.local",
    "tessera-redis-ha-s-2.tessera-redis-ha-s-hl.tessera.svc.cluster.local"
  ],
  "redis_port": 6379,
  "sentinel_port": 26379,
  "credentials": {
    "secret": "tessera-redis-auth",
    "password_key": "password",
    "sentinel_password_key": "password"
  },
  "tls": false
}
